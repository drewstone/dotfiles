#!/usr/bin/env python3
"""Render a brief spec (JSON) into a self-contained HTML page with the brief kit.

usage: brief-build SPEC.json OUT.html

Schema errors exit 2. Missing hillclimb parts (hill, method, a chart, decisions)
print warnings, because a brief without them usually answers the wrong question.
"""
import json
import pathlib
import sys

KIT = pathlib.Path(__file__).resolve().parent.parent / "assets" / "brief-kit.html"
BLOCKS = {"text", "callout", "cols", "board", "tiles", "hist", "hbars", "stack", "dots",
          "heatmap", "timeline", "steps", "table", "bets", "decisions"}
CHARTS = {"hist", "hbars", "stack", "dots", "heatmap", "timeline"}
TONES = {"good", "warn", "serious", "crit", "blind", "accent", None}
TEXT_TONES = {"bad", "ok", "warn", None}


def walk(blocks, where, errors, seen):
    for i, b in enumerate(blocks):
        at = f"{where}[{i}]"
        t = b.get("type")
        if t not in BLOCKS:
            errors.append(f"{at}: unknown block type {t!r}")
            continue
        seen.add(t)
        if t == "cols":
            walk(b.get("blocks", []), at + ".blocks", errors, seen)
        if t == "hist" and len(b.get("values", [])) == 0:
            errors.append(f"{at}: hist needs values")
        if t == "hist" and b.get("labels") and len(b["labels"]) != len(b["values"]):
            errors.append(f"{at}: hist labels and values differ in length")
        if t == "hbars" and not all(isinstance(r, list) and len(r) >= 2 for r in b.get("rows", [])):
            errors.append(f"{at}: hbars rows must be [label, value, inner?, tip?]")
        if t == "heatmap":
            for r in b.get("rows", []):
                if len(r.get("cells", [])) > b.get("cols", 0):
                    errors.append(f"{at}: heatmap row {r.get('label')!r} has more cells than cols")
        if t in ("dots", "timeline") and not (b.get("start") and b.get("end")):
            errors.append(f"{at}: {t} needs ISO start and end")
        # Tiles color their number like text (bad/ok/warn); everything else uses status tones.
        allowed = TEXT_TONES if t == "tiles" else TONES
        for key in ("rows", "items", "points", "parts"):
            for x in b.get(key, []) or []:
                if isinstance(x, dict) and x.get("tone") not in allowed:
                    errors.append(f"{at}: unknown tone {x.get('tone')!r} for {t}")


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    spec = json.loads(pathlib.Path(sys.argv[1]).read_text())
    errors, seen = [], set()
    for k in ("title", "thesis", "sections"):
        if not spec.get(k):
            errors.append(f"missing {k}")
    for i, sec in enumerate(spec.get("sections", [])):
        if not sec.get("title"):
            errors.append(f"sections[{i}]: missing title")
        walk(sec.get("blocks", []), f"sections[{i}].blocks", errors, seen)
    if errors:
        print("\n".join("error: " + e for e in errors), file=sys.stderr)
        sys.exit(2)
    warnings = []
    if not spec.get("hill"):
        warnings.append("no hill: name the metric, baseline, target and owner this brief moves")
    if not spec.get("method"):
        warnings.append("no method: state each source, query, window and denominator")
    if not seen & CHARTS:
        warnings.append("no chart: a brief with more than one dimension shows its shape")
    if "decisions" not in seen:
        warnings.append("no decisions block: state what the reader must decide, or say none")
    for w in warnings:
        print("warning: " + w, file=sys.stderr)
    page = KIT.read_text()
    body = json.dumps(spec, ensure_ascii=False).replace("</", "<\\/")
    title = spec["title"].replace("<", "&lt;")
    pathlib.Path(sys.argv[2]).write_text(page.replace("__TITLE__", title).replace("__SPEC__", body))
    print(f"wrote {sys.argv[2]} ({len(warnings)} warnings)")


main()
