#!/usr/bin/env bash
# Append one structured line to the repository's off-repo skill-runs.jsonl per skill invocation.
#
# Usage:
#   skill-run-log <skill> [--target X] [--prompt "..."] [--duration MIN] [--verdict V] [--next /SKILL]
#                         [--score N] [--project NAME] [--transcript PATH] [--trace-dir PATH]
#   skill-run-log --dir    print the state directory for the current repository
#   skill-run-log -h|--help
# Use --option=-literal when a value starts with '-' (for example, --prompt=--help).
#
# Example:
#   skill-run-log /evolve --target accuracy --duration 12.4 --verdict KEEP --next /reflect \
#                 --trace-dir .agent/runs/evolve-2026-04-25/
#
# Writes to ${XDG_STATE_HOME:-~/.local/state}/agent-work/<repo>/skill-runs.jsonl, where <repo>
# names the main checkout, so every worktree of a repository shares one log; outside a git
# repository <repo> is the basename of $PWD. The log lives outside the checkout because an
# append inside it left main checkouts permanently dirty (discovery-lab, 2026-10-05: 210
# unmerged rows blocking a fast-forward). Rows written before then remain in each repo's
# .agent/skill-runs.jsonl or .evolve/skill-runs.jsonl as history.
# Creates the directory and file if missing. Append-only; never rewrites prior lines.
#
# Schema (see ~/dotfiles/claude/skills/_common.md):
#   { skill, ts, project, target, operatorPrompt, durationMin, verdict, dispatchedTo, operatorOverride,
#     transcriptPath, traceDir, score }
#
# `score` is an independent judge's score of the deliverable (brief-judge totals out of 30),
# null when the run was not judged. Rows written before it existed simply lack the field.
#
# `operatorOverride` is left null by this script. Later findings can link an
# observed correction to this row without rewriting the original record.

set -euo pipefail

usage() {
  cat <<'EOF'
usage: skill-run-log <skill> [--target X] [--prompt TEXT] [--duration MIN] [--verdict V] [--next /SKILL] [--score N] [--project NAME] [--transcript PATH] [--trace-dir PATH]
       skill-run-log --dir
       skill-run-log -h|--help
Use --option=-literal for a value beginning with '-'.
EOF
}

invalid_args() {
  echo "skill-run-log: $1" >&2
  usage >&2
  exit 2
}

# The main checkout's name, shared by its linked worktrees.
repo_name() {
  local common
  if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    case "$common" in
      */.git) basename "$(dirname "$common")" ;;
      *) basename "${common%.git}" ;;
    esac
  else
    basename "$PWD"
  fi
}

state_dir() {
  printf '%s/agent-work/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" "$(repo_name)"
}

[ $# -ge 1 ] || invalid_args 'skill is required'
case "$1" in
  -h|--help) usage; exit 0 ;;
  --dir) state_dir; echo; exit 0 ;;
  -*) invalid_args "unknown flag: $1" ;;
esac

skill="$1"; shift

target=""
prompt=""
duration="null"
score="null"
verdict="n/a"
next_skill="stop"
project=""
transcript=""
trace_dir=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --target|--prompt|--duration|--verdict|--next|--score|--project|--transcript|--trace-dir)
      option="$1"
      shift
      [ $# -ge 1 ] || invalid_args "$option requires a value"
      case "$1" in
        -h|--help) usage; exit 0 ;;
        -*) invalid_args "$option requires a value; use $option=-literal for a value beginning with '-'" ;;
      esac
      value="$1"
      shift
      ;;
    --target=*|--prompt=*|--duration=*|--verdict=*|--next=*|--score=*|--project=*|--transcript=*|--trace-dir=*)
      option="${1%%=*}"
      value="${1#*=}"
      shift
      ;;
    *) invalid_args "unknown argument: $1" ;;
  esac
  case "$option" in
    --target) target="$value" ;;
    --prompt) prompt="$value" ;;
    --duration) duration="$value" ;;
    --verdict) verdict="$value" ;;
    --next) next_skill="$value" ;;
    --score) score="$value" ;;
    --project) project="$value" ;;
    --transcript) transcript="$value" ;;
    --trace-dir) trace_dir="$value" ;;
  esac
done

if [ "$duration" != null ] && ! [[ "$duration" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$ ]]; then
  invalid_args 'duration must be a nonnegative JSON number'
fi
if [ "$score" != null ] && ! [[ "$score" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?$ ]]; then
  invalid_args 'score must be a nonnegative number'
fi

if [ -z "$project" ]; then
  project="$(repo_name)"
fi
target_dir="$(state_dir)"

mkdir -p "$target_dir"
log="$target_dir/skill-runs.jsonl"

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# JSON-escape strings (handles quotes, backslashes, newlines)
esc() {
  printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")' 2>/dev/null \
    || printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//' | awk '{print "\""$0"\""}'
}

skill_j="$(esc "$skill")"
project_j="$(esc "$project")"
target_j="$(esc "$target")"
prompt_j="$(esc "$prompt")"
verdict_j="$(esc "$verdict")"
next_j="$(esc "$next_skill")"

# transcript and traceDir: emit as JSON null when empty, escaped string otherwise
if [ -z "$transcript" ]; then transcript_j="null"; else transcript_j="$(esc "$transcript")"; fi
if [ -z "$trace_dir" ];  then trace_j="null";       else trace_j="$(esc "$trace_dir")"; fi

printf '{"skill":%s,"ts":"%s","project":%s,"target":%s,"operatorPrompt":%s,"durationMin":%s,"verdict":%s,"dispatchedTo":%s,"operatorOverride":null,"transcriptPath":%s,"traceDir":%s,"score":%s}\n' \
  "$skill_j" "$ts" "$project_j" "$target_j" "$prompt_j" "$duration" "$verdict_j" "$next_j" "$transcript_j" "$trace_j" "$score" >> "$log"

echo "logged: $skill -> $next_skill ($verdict) [$log]"
