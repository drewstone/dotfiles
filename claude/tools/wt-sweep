#!/usr/bin/env bash
# Remove stale agent checkouts from the pools where sessions leave them.
#
# A tree is removed only when ALL are true:
#   - it is a git checkout with a working `git status`
#   - the status is clean (no staged, unstaged, or untracked files)
#   - no process is sitting in it or below it
#   - it has no commit that exists on no remote
#   - no file outside .git/ and node_modules/ changed in the last 2 days
# A tree with a broken .git pointer is reported, never removed.
#
# TWO WAYS THIS GOES SILENTLY INERT. Both have already cost days.
#
# 1. A dangling symlink. `~/bin/wt-sweep` is linked by claude/install.sh. If the
#    install ran from a git worktree (`dotfiles/.worktrees/<name>/`) and that
#    worktree was later removed, the link dangles, cron prints
#    "No such file or directory" to stderr, and the cron job still reports
#    success. Found 2026-09-18 after weeks dead: free disk had fallen 71 -> 12
#    GiB with the warning printed every night and the cause never surfaced.
#    Always link from the durable checkout, never from a worktree path.
#    Audit with: for f in ~/bin/*; do [ -L "$f" ] && [ ! -e "$f" ] && echo "$f"; done
#
# 2. Removing files is not reclaiming space. macOS Time Machine LOCAL SNAPSHOTS
#    pin deleted blocks, so a sweep can remove 50 trees and free zero bytes,
#    which reads as "the sweep is broken" when it worked perfectly. Check and
#    clear them as the second half of any reclamation pass:
#      tmutil listlocalsnapshots /
#      tmutil deletelocalsnapshots <YYYY-MM-DD-HHMMSS>
#    On 2026-09-18 that step alone took free space from 30 GiB to 57 GiB.
#
# Blast radius when this is dead: another session hit 133 MiB free with 680
# abandoned worktrees, which hung every Chrome debug tab of a browser fleet at
# once and cost hours to diagnose (ops-board #1387). The cron is the root cause
# of that class, not the fleet.
#
# For a worktree, commits, branches and stashes live in the shared repository, so
# removal loses nothing; the unpushed check still runs because a pool also holds
# standalone clones, where a local commit exists nowhere else.
#
# On 2026-09-11 this sweep ran nightly and the host still reached 15 GiB free on a
# 926 GB disk. It was watching two pools under ~/webb while sessions had left 374 GB
# in /private/tmp: 1,083 adc-* checkouts at about 6 GB each plus roughly 60 other
# agent trees. A manual pass removed 253 of them and freed 228.5 GiB. That pool is
# now swept here so the nightly run reaches it.
set -uo pipefail

# Report the version actually running, and say so when it is behind its own remote.
#
# Installed tools are symlinks into a dotfiles worktree, and a worktree has no mechanism to
# advance itself. On 2026-09-11 that bit twice in one day: `~/.claude/skills` resolved into a
# worktree LOCKED at a commit predating a skill, so the skill did not exist as far as the
# session was concerned; and the replacement worktree was a merge behind by the same evening,
# so cron would have run the previous day's sweep logic.
#
# A nightly job silently running stale code is the failure that hides longest, so the run
# announces its commit. This only reports: a sweep that deletes must not also mutate the
# checkout it is running from, and `git -C` on a detached worktree mid-run is exactly the kind
# of surprise this tool exists to avoid.
self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink "$0" || echo "$0")")" && pwd)
if git -C "$self_dir" rev-parse --git-dir >/dev/null 2>&1; then
  self_sha=$(git -C "$self_dir" rev-parse --short HEAD 2>/dev/null)
  self_remote=$(git -C "$self_dir" rev-parse --short origin/main 2>/dev/null)
  if [ -n "$self_sha" ] && [ -n "$self_remote" ] && [ "$self_sha" != "$self_remote" ]; then
    behind=$(git -C "$self_dir" rev-list --count "HEAD..origin/main" 2>/dev/null)
    self_root=$(git -C "$self_dir" rev-parse --show-toplevel 2>/dev/null || echo "$self_dir")
    echo "wt-sweep: running $self_sha, ${behind:-?} commit(s) behind origin/main ($self_remote) — refresh with: git -C $self_root checkout --detach origin/main"
  else
    echo "wt-sweep: running $self_sha (current)"
  fi
fi

pools=(
  "$HOME/webb/_wt"
  "$HOME/webb/agent-dev-container/.worktrees"
  "$HOME/code/_wt"
)

# /private/tmp also holds live session state, editor scratch and OS files, so it is
# swept by name: only directories an agent session created for a checkout.
tmp_pool="/private/tmp"
tmp_globs=(adc-* disco-* discovery-* lab-* ph0ny-* phony-* router-* devops-* gtm-* creative-* customers-* cust*-* eval-* agent-eval-* cli-bridge-* blueprint-* proof* api-urgent-* platform-peer-proof* codex-*)

# Paths that are generated, not authored. A `git status` reporting only these is still clean
# in the sense that matters: nothing here exists solely in this tree.
artifact_only='^(node_modules/?|\.agent/|program\.mjs$|context/?$|\.venv/?|__pycache__/?|dist/?|build/?|\.turbo/?|\.next/?|coverage/?|.*\.log$)'

status_file=$(mktemp -t wt-sweep-status)
trap 'rm -f "$status_file"' EXIT

# Every directory a running process has as its working directory. A tree in use is
# never removed, however clean it looks: another agent is mid-task inside it.
live=$(lsof -a -d cwd 2>/dev/null | awk 'NR>1 {print $NF}' | grep '^/' | sort -u)

is_live() {
  printf '%s\n' "$live" | grep -q "^$1\(/\|$\)"
}

removed=0 kept=0 broken=0 freed=0

sweep_tree() {
  local d=$1
  [ -d "$d" ] || return 0
  [ -e "$d/.git" ] || return 0

  if ! git -C "$d" status --porcelain >"$status_file" 2>/dev/null; then
    echo "wt-sweep: BROKEN git in $d — inspect by hand"
    broken=$((broken + 1))
    return 0
  fi
  # A tree whose only changes are build output or an agent's own append-only log holds no
  # work. On 2026-09-11, 85 trees in the tmp pool reported dirty; across them the commonest
  # entries were an untracked node_modules (14) and a modified .agent/skill-runs.jsonl (13),
  # with agent-runtime's in-place scratch (program.mjs, context/) behind them. Treating those
  # as work kept 12.5 GiB of pure artifact. A single changed source file still keeps the tree.
  if [ -s "$status_file" ]; then
    if awk '{print $2}' "$status_file" | grep -qvE "$artifact_only"; then
      kept=$((kept + 1)); return 0
    fi
  fi
  if is_live "$d"; then
    kept=$((kept + 1)); return 0
  fi
  # Empty output means the count could not be taken; treat that as "might have work".
  #
  # This check OVER-reports, on purpose. Many agent checkouts carry a narrow fetch refspec
  # (+refs/heads/master:refs/remotes/origin/master), so a branch that is genuinely pushed has
  # no refs/remotes/* ref locally and every commit on it counts as unpushed. Measured on
  # lab-collab-decoder-r3, whose branch was on the remote and whose content was already merged:
  # this reports 6 unpushed. The tree is kept and a little space is left behind.
  #
  # Do not "fix" this by asking the remote (`git ls-remote`) per tree. That is a network call
  # for every candidate, it fails closed in the wrong direction when the network is down, and
  # it turns a local decision into a remote one. For a nightly job that DELETES, leaving space
  # on the table is the correct error to make.
  local unpushed
  unpushed=$(git -C "$d" rev-list --count HEAD --not --remotes 2>/dev/null)
  if [ -z "$unpushed" ] || [ "$unpushed" != "0" ]; then
    kept=$((kept + 1)); return 0
  fi
  local recent
  recent=$(find "$d" -type f -mtime -2 -not -path "*/node_modules/*" -not -path "*/.git/*" -print -quit 2>/dev/null)
  if [ -n "$recent" ]; then
    kept=$((kept + 1)); return 0
  fi

  local size parent
  size=$(du -sm "$d" 2>/dev/null | cut -f1)
  if [ -f "$d/.git" ]; then
    # A worktree: let the parent drop its administrative entry in the same step.
    parent=$(sed 's/gitdir: //; s#/\.git/worktrees/.*##' "$d/.git" 2>/dev/null)
    if [ -n "$parent" ] && [ -d "$parent" ]; then
      git -C "$parent" worktree remove --force "$d" >/dev/null 2>&1 || rm -rf "$d"
    else
      rm -rf "$d"
    fi
  else
    rm -rf "$d"
  fi

  if [ -d "$d" ]; then
    echo "wt-sweep: could not remove $d — inspect by hand"
    broken=$((broken + 1))
  else
    removed=$((removed + 1))
    freed=$((freed + ${size:-0}))
    echo "wt-sweep: removed $d (${size:-?}M)"
  fi
}

for pool in "${pools[@]}"; do
  [ -d "$pool" ] || continue
  for d in "$pool"/*/; do
    d=${d%/}
    [ "$(basename "$d")" = "bin" ] && continue
    sweep_tree "$d"
  done
done

if [ -d "$tmp_pool" ]; then
  for glob in "${tmp_globs[@]}"; do
    for d in "$tmp_pool"/$glob; do
      [ -d "$d" ] || continue
      sweep_tree "$d"
    done
  done
fi

# Drop stale administrative entries for trees removed outside `worktree remove`.
for repo in "$HOME/webb"/*/ "$HOME/code"/*/; do
  [ -e "$repo/.git" ] && git -C "$repo" worktree prune 2>/dev/null
done

# Deleting files frees nothing while a local Time Machine snapshot still references
# them. On 2026-09-11, 18.7 GiB of removals moved `df` by zero until the snapshots
# were thinned, and a snapshot taken mid-sweep pinned about 52 GiB more. Ask for the
# space back explicitly, or a nightly sweep reports success and the disk stays full.
if [ "$removed" -gt 0 ] && command -v tmutil >/dev/null 2>&1; then
  tmutil thinlocalsnapshots / $((freed * 1024 * 1024)) 4 >/dev/null 2>&1
fi

free_gib=$(df -g / 2>/dev/null | awk 'NR==2 {print $4}')
echo "wt-sweep: removed=$removed freed=$((freed / 1024))GiB kept=$kept broken=$broken free=${free_gib:-?}GiB"
