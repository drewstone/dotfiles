#!/usr/bin/env bash
# Remove stale agent checkouts from the pools where sessions leave them.
#
# A tree is removed only when ALL are true:
#   - it is a git checkout with a working `git status`
#   - the status is clean (no staged, unstaged, or untracked files)
#   - no process is sitting in it or below it
#   - it has no commit that exists on no remote
#   - no file outside .git/ and node_modules/ changed in the last 2 days
# A tree with a broken .git pointer is reported, never removed.
#
# For a worktree, commits, branches and stashes live in the shared repository, so
# removal loses nothing; the unpushed check still runs because a pool also holds
# standalone clones, where a local commit exists nowhere else.
#
# On 2026-09-11 this sweep ran nightly and the host still reached 15 GiB free on a
# 926 GB disk. It was watching two pools under ~/webb while sessions had left 374 GB
# in /private/tmp: 1,083 adc-* checkouts at about 6 GB each plus roughly 60 other
# agent trees. A manual pass removed 253 of them and freed 228.5 GiB. That pool is
# now swept here so the nightly run reaches it.
set -uo pipefail

pools=(
  "$HOME/webb/_wt"
  "$HOME/webb/agent-dev-container/.worktrees"
  "$HOME/code/_wt"
)

# /private/tmp also holds live session state, editor scratch and OS files, so it is
# swept by name: only directories an agent session created for a checkout.
tmp_pool="/private/tmp"
tmp_globs=(adc-* disco-* discovery-* lab-* ph0ny-* phony-* router-* devops-* gtm-* creative-* customers-* cust*-* eval-* agent-eval-* cli-bridge-* blueprint-* proof* api-urgent-* platform-peer-proof* codex-*)

status_file=$(mktemp -t wt-sweep-status)
trap 'rm -f "$status_file"' EXIT

# Every directory a running process has as its working directory. A tree in use is
# never removed, however clean it looks: another agent is mid-task inside it.
live=$(lsof -a -d cwd 2>/dev/null | awk 'NR>1 {print $NF}' | grep '^/' | sort -u)

is_live() {
  printf '%s\n' "$live" | grep -q "^$1\(/\|$\)"
}

removed=0 kept=0 broken=0 freed=0

sweep_tree() {
  local d=$1
  [ -d "$d" ] || return 0
  [ -e "$d/.git" ] || return 0

  if ! git -C "$d" status --porcelain >"$status_file" 2>/dev/null; then
    echo "wt-sweep: BROKEN git in $d — inspect by hand"
    broken=$((broken + 1))
    return 0
  fi
  if [ -s "$status_file" ]; then
    kept=$((kept + 1)); return 0
  fi
  if is_live "$d"; then
    kept=$((kept + 1)); return 0
  fi
  # Empty output means the count could not be taken; treat that as "might have work".
  local unpushed
  unpushed=$(git -C "$d" rev-list --count HEAD --not --remotes 2>/dev/null)
  if [ -z "$unpushed" ] || [ "$unpushed" != "0" ]; then
    kept=$((kept + 1)); return 0
  fi
  local recent
  recent=$(find "$d" -type f -mtime -2 -not -path "*/node_modules/*" -not -path "*/.git/*" -print -quit 2>/dev/null)
  if [ -n "$recent" ]; then
    kept=$((kept + 1)); return 0
  fi

  local size parent
  size=$(du -sm "$d" 2>/dev/null | cut -f1)
  if [ -f "$d/.git" ]; then
    # A worktree: let the parent drop its administrative entry in the same step.
    parent=$(sed 's/gitdir: //; s#/\.git/worktrees/.*##' "$d/.git" 2>/dev/null)
    if [ -n "$parent" ] && [ -d "$parent" ]; then
      git -C "$parent" worktree remove --force "$d" >/dev/null 2>&1 || rm -rf "$d"
    else
      rm -rf "$d"
    fi
  else
    rm -rf "$d"
  fi

  if [ -d "$d" ]; then
    echo "wt-sweep: could not remove $d — inspect by hand"
    broken=$((broken + 1))
  else
    removed=$((removed + 1))
    freed=$((freed + ${size:-0}))
    echo "wt-sweep: removed $d (${size:-?}M)"
  fi
}

for pool in "${pools[@]}"; do
  [ -d "$pool" ] || continue
  for d in "$pool"/*/; do
    d=${d%/}
    [ "$(basename "$d")" = "bin" ] && continue
    sweep_tree "$d"
  done
done

if [ -d "$tmp_pool" ]; then
  for glob in "${tmp_globs[@]}"; do
    for d in "$tmp_pool"/$glob; do
      [ -d "$d" ] || continue
      sweep_tree "$d"
    done
  done
fi

# Drop stale administrative entries for trees removed outside `worktree remove`.
for repo in "$HOME/webb"/*/ "$HOME/code"/*/; do
  [ -e "$repo/.git" ] && git -C "$repo" worktree prune 2>/dev/null
done

# Deleting files frees nothing while a local Time Machine snapshot still references
# them. On 2026-09-11, 18.7 GiB of removals moved `df` by zero until the snapshots
# were thinned, and a snapshot taken mid-sweep pinned about 52 GiB more. Ask for the
# space back explicitly, or a nightly sweep reports success and the disk stays full.
if [ "$removed" -gt 0 ] && command -v tmutil >/dev/null 2>&1; then
  tmutil thinlocalsnapshots / $((freed * 1024 * 1024)) 4 >/dev/null 2>&1
fi

free_gib=$(df -g / 2>/dev/null | awk 'NR==2 {print $4}')
echo "wt-sweep: removed=$removed freed=$((freed / 1024))GiB kept=$kept broken=$broken free=${free_gib:-?}GiB"
