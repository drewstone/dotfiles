class GH:
    def __init__(self, cmd: list[str], cache_dir: str, ttl: float, budget: int, refresh: bool):
        self.cmd, self.ttl, self.budget, self.refresh = cmd, ttl, budget, refresh
        self.dir = os.path.join(cache_dir, "gh")
        self.calls = 0
        self.cached = 0
        self.stopped = ""

    def api(self, path: str):
        """One API read, answered from the cache when it is younger than the TTL."""
        if self.stopped:
            return None, self.stopped
        key = hashlib.sha1("\0".join([*self.cmd, path]).encode()).hexdigest()
        cache = os.path.join(self.dir, key + ".json")
        try:
            if not self.refresh and time.time() - os.path.getmtime(cache) < self.ttl:
                with open(cache, encoding="utf-8") as f:
                    data = json.load(f)
                self.cached += 1
                return data, ""
        except (OSError, ValueError):
            pass
        if self.calls >= self.budget:
            self.stopped = f"call budget of {self.budget} used (HAVE_GH_BUDGET)"
            return None, self.stopped
        self.calls += 1
        rc, out, err = run([*self.cmd, "api", path], timeout=60)
        if rc != 0:
            msg = trunc((err or out).decode("utf-8", "replace") or "failed", 110)
            if re.search(r"rate limit|refus|quota|abuse|secondary", msg, re.I):
                self.stopped = msg
            return None, msg
        try:
            data = json.loads(out)
        except ValueError:
            return None, "unreadable answer"
        try:
            os.makedirs(self.dir, mode=0o700, exist_ok=True)
            tmp = f"{cache}.{os.getpid()}"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(data, f)
            os.replace(tmp, cache)
        except OSError:
            pass
        return data, ""


def list_workflows(gh: GH, slug: str, wanted: set[str] | None, max_pages: int = 5):
    """The repository's workflows, one call per 100. With `wanted` (workflow paths already known
    from the tree) it stops at the page that holds the last of them, so most repositories cost
    one call. Returns (path -> workflow, note)."""
    found: dict[str, dict] = {}
    note, page, total = "", 1, None
    while page <= max_pages and (total is None or len(found) < total):
        data, err = gh.api(f"repos/{slug}/actions/workflows?per_page=100&page={page}")
        if data is None:
            return found, err
        total = data.get("total_count", 0)
        for w in data.get("workflows", []):
            found[w.get("path", "")] = w
        page += 1
        if wanted is not None and wanted <= set(found):
            break
    if wanted is not None and not wanted <= set(found):
        note = f"{len(found)} of {total} workflows listed" if total else "listing unavailable"
    elif wanted is None and total is not None and len(found) < total:
        note = f"{len(found)} of {total} workflows listed"
    return found, note


def last_run(gh: GH, slug: str, wid: int) -> str:
    data, err = gh.api(f"repos/{slug}/actions/workflows/{wid}/runs?per_page=1")
    if data is None:
        return f"last run unread ({err})"
    runs = data.get("workflow_runs") or []
    if not runs:
        return "never run"
    r = runs[0]
    return f"last run {r.get('conclusion') or r.get('status') or '?'} {str(r.get('created_at') or '')[:10]}"


def github_phase(gh: GH | None, results: list[RepoResult], remote: list[str], q: Query, sweeps: set[str],
                 top: int) -> tuple[list[RepoResult], list[str]]:
    """Read the repositories that have no checkout here, then attach each shown workflow's state
    and latest run. Only the best `top` workflows cost run calls."""
    notes: list[str] = []
    extra: list[RepoResult] = []
    have = {r.repo.slug for r in results if r.repo.slug}
    wf_on = "workflows" in sweeps
    for slug in remote:
        if slug in have:
            continue
        res = RepoResult(Repo(path="", slug=slug), fetch="api only")
        extra.append(res)
        if gh is None:
            res.skipped.append("offline: not read")
            continue
        data, err = gh.api(f"repos/{slug}/git/trees/HEAD?recursive=1")
        if data is None:
            res.skipped.append(f"tree not read ({err})")
            continue
        tree = [e["path"] for e in data.get("tree", []) if e.get("type") == "blob"]
        res.files = len(tree)
        if data.get("truncated"):
            res.skipped.append("tree truncated by GitHub")
        if "paths" in sweeps:
            res.groups = path_groups(tree, q, wf_on)
        if wf_on:
            listed, note = list_workflows(gh, slug, None)
            if note:
                notes.append(f"{slug}: {note}")
            for path, w in listed.items():
                s = q.hits(os.path.basename(path) + " " + w.get("name", ""), True)
                if s:
                    res.workflows.append(Workflow(path, clean(w.get("name", "")), s, w.get("state", "?"), w.get("id", 0)))
    if not wf_on:
        return extra, notes
    everyone = results + extra
    ranked = sorted(((w.score, r.repo.label, w.path, r, w) for r in everyone for w in r.workflows),
                    key=lambda t: (-t[0], t[1], t[2]))[:top]
    if gh is None:
        notes.append("workflow state and runs not read (offline)")
        for *_, w in ranked:
            w.state = w.state or "state unread"
        return extra, notes
    by_repo: dict[str, list] = {}
    for item in ranked:
        by_repo.setdefault(item[3].repo.slug or item[3].repo.label, []).append(item)
    for slug, items in by_repo.items():
        res = items[0][3]
        need = {w.path for *_, w in items if not w.state}
        if need and res.repo.slug:
            listed, note = list_workflows(gh, res.repo.slug, need)
            if note:
                notes.append(f"{res.repo.slug}: {note}")
            for *_, w in items:
                api = listed.get(w.path)
                if api and not w.state:
                    w.state, w.wid = api.get("state", "?"), api.get("id", 0)
                    if not w.name:
                        w.name = clean(api.get("name", ""))
                elif not w.state:
                    w.state = "state unread"
    for *_, r, w in ranked:
        if w.wid and r.repo.slug:
            w.run = last_run(gh, r.repo.slug, w.wid)
        elif not w.state:
            w.state = "state unread"
    if gh.stopped:
        notes.append(f"GitHub reads stopped: {gh.stopped}")
    return extra, notes


