# processes


LIVE: set[int] = set()  # process groups of running children, killed on an interrupt


def run(cmd, cwd=None, timeout=30, data=None) -> tuple[int, bytes, bytes]:
    """Run a command in its own session, so nothing can prompt on the terminal, and kill the
    whole group on a timeout."""
    env = dict(os.environ)
    env.update({"GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0", "LC_ALL": "C"})
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=10")
    try:
        proc = subprocess.Popen(
            cmd, cwd=cwd, env=env, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
        )
    except OSError as exc:
        return 127, b"", str(exc).encode()
    LIVE.add(proc.pid)
    try:
        out, err = proc.communicate(data, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        return 124, b"", b"timed out"
    finally:
        LIVE.discard(proc.pid)
    return proc.returncode, out, err


def git(path: str, *args: str, timeout: float = 30) -> tuple[int, str]:
    rc, out, err = run(["git", "-C", path, *args], timeout=timeout)
    return rc, (out if rc == 0 else err).decode("utf-8", "replace").strip()


