# configuration


@dataclass
class Config:
    roots: list = field(default_factory=list)
    repos: list = field(default_factory=list)
    github: list = field(default_factory=list)
    gh: str = ""
    depth: int = 2
    exclude: list = field(default_factory=list)
    synonyms: list = field(default_factory=list)
    tasks: list = field(default_factory=list)
    notes: list = field(default_factory=list)


def expand(path: str) -> str:
    return os.path.expanduser(os.path.expandvars(path))


def parse_config(text: str, warn) -> Config:
    cfg = Config()
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            warn(f"config line {n}: expected `key = value`")
            continue
        left, value = (s.strip() for s in line.split("=", 1))
        parts = left.split(None, 1)
        key, label = parts[0].lower(), (parts[1].strip() if len(parts) > 1 else "")
        if not value:
            warn(f"config line {n}: `{key}` has no value")
        elif key == "root":
            cfg.roots.append(expand(value))
        elif key == "repo":
            cfg.repos.append(expand(value))
        elif key == "github":
            cfg.github.append(value)
        elif key == "gh":
            cfg.gh = value
        elif key == "depth" and value.isdigit():
            cfg.depth = int(value)
        elif key == "exclude":
            cfg.exclude.append(expand(value))
        elif key == "synonyms":
            cfg.synonyms.append([w.strip() for w in value.replace(",", " ").split() if w.strip()])
        elif key == "tasks":
            cfg.tasks.append((label or f"tasks{len(cfg.tasks) + 1}", value))
        elif key == "notes":
            cfg.notes.append((label or f"notes{len(cfg.notes) + 1}", expand(value)))
        else:
            warn(f"config line {n}: unknown key `{key}`")
    return cfg


