def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="have", add_help=False, usage="have [options] TERMS...")
    parser.add_argument("terms", nargs="*")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--config")
    parser.add_argument("--root", action="append", default=[])
    parser.add_argument("--in", dest="within", action="append", default=[])
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--no-fetch", action="store_true")
    parser.add_argument("--refresh", action="store_true")
    parser.add_argument("--only")
    parser.add_argument("--skip")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--jobs", type=int, default=int(os.environ.get("HAVE_JOBS") or 6))
    parser.add_argument("--timeout", type=float, default=240)
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 2
    if args.help:
        print(__doc__.strip())
        return 0

    def warn(msg: str) -> None:
        print(f"have: {msg}", file=sys.stderr)

    sweeps = set(SWEEPS)
    for flag, only in ((args.only, True), (args.skip, False)):
        if flag:
            names = {n.strip() for n in flag.split(",") if n.strip()}
            if names - set(SWEEPS):
                warn(f"unknown sweep {', '.join(sorted(names - set(SWEEPS)))}; choose from {', '.join(SWEEPS)}")
                return 2
            sweeps = names if only else sweeps - names

    explicit = args.config or os.environ.get("HAVE_CONFIG")
    config_path = explicit or os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                                           "have", "config")
    cfg = Config()
    try:
        with open(config_path, encoding="utf-8") as f:
            cfg = parse_config(f.read(), warn)
    except FileNotFoundError:
        if explicit:
            warn(f"config {config_path} not found")
            return 2
    except OSError as exc:
        warn(f"config {config_path}: {exc}")
        return 2
    q = Query(args.terms, cfg.synonyms)
    if not q.concepts:
        warn("usage: have [options] TERMS...   (have --help)")
        return 2

    cache_dir = os.environ.get("HAVE_CACHE_DIR") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "have")
    ttl = float(os.environ.get("HAVE_FETCH_TTL") or 600)
    roots = cfg.roots + [expand(r) for r in args.root]
    candidates = list(cfg.repos)
    notes: list[str] = []
    searched: list[str] = []
    if not (roots or candidates or cfg.github):
        rc, top = git(os.getcwd(), "rev-parse", "--show-toplevel")
        if rc == 0:
            candidates.append(top)
        notes.append(f"no config at {config_path}; searched {top if rc == 0 else 'no repository'} only "
                     "(see `have --help` for the config format)")

    results: list[RepoResult] = []
    stragglers = False
    if sweeps & {"paths", "scripts", "workflows", "content"}:
        started = time.time()
        paths = candidates + discover(cfg, roots, cfg.depth)
        pool = cf.ThreadPoolExecutor(max_workers=max(1, args.jobs))
        chosen: dict[str, Repo] = {}
        for repo in pool.map(identify, paths):
            if repo is None:
                continue
            key = repo.slug or repo.common  # clones of one repository count once
            chosen[key] = prefer(chosen[key], repo) if key in chosen else repo
        repos = [r for r in chosen.values()
                 if not args.within or any(w.lower() in f"{r.label} {r.path}".lower() for w in args.within)]
        if sys.stderr.isatty():
            warn(f"reading {len(repos)} repositories...")
        futures = {pool.submit(sweep_repo, r, q, args, sweeps, ttl, cache_dir): r for r in repos}
        done, pending = cf.wait(futures, timeout=args.timeout)
        for fut in pending:
            fut.cancel()
            notes.append(f"{futures[fut].label}: not finished in {args.timeout:g}s, not searched")
        for fut in done:
            try:
                results.append(fut.result())
            except Exception as exc:  # one repository must not hide the rest
                notes.append(f"{futures[fut].label}: {trunc(str(exc), 80)}")
        if "content" in sweeps:  # the slow sweep runs last, in what is left of the time
            grep_timeout = float(os.environ.get("HAVE_GREP_TIMEOUT") or 25)
            readable = [r for r in results if r.repo.ref and not r.repo.partial]
            grep = {pool.submit(content_grep, r.repo.path, r.repo.ref, q, grep_timeout): r for r in readable}
            finished, late = cf.wait(grep, timeout=max(1.0, args.timeout - (time.time() - started)))
            for fut in finished:
                grep[fut].content = fut.result() or {}
                if fut.result() is None:
                    grep[fut].content_unread = f"not finished in {grep_timeout:g}s"
            for fut in late:
                fut.cancel()
                grep[fut].content_unread = "not started"
            pending = pending | late
        pool.shutdown(wait=not pending, cancel_futures=True)
        stragglers = bool(pending)
        results.sort(key=lambda r: r.repo.label)

    gh_cmd = (os.environ.get("GH") or cfg.gh or "gh").split()
    gh = None
    if not args.offline and sweeps & {"workflows", "paths"}:
        gh = GH(gh_cmd, cache_dir, float(os.environ.get("HAVE_GH_TTL") or 900),
                int(os.environ.get("HAVE_GH_BUDGET") or 60), args.refresh)
    extra, gh_notes = github_phase(gh, results, cfg.github if sweeps & {"workflows", "paths"} else [], q, sweeps,
                                   max(1, args.limit))
    notes += gh_notes
    results += extra

    boards: list[Hit] = []
    board_names: list[str] = []
    if "boards" in sweeps:
        for label, command in cfg.tasks:
            boards += task_records(label, command, q, notes)
            board_names.append(f"tasks:{label}")
        for label, root in cfg.notes:
            boards += note_hits(label, root, q, notes)
            board_names.append(f"notes:{label}")

    if results:
        states: dict[str, int] = {}
        for res in results:
            states[res.fetch or "?"] = states.get(res.fetch or "?", 0) + 1
            if res.fetch == "fetch failed":
                notes.append(f"{res.repo.label}: fetch failed ({res.note}); read at the last fetched state")
            elif res.fetch.startswith("local branch"):
                notes.append(f"{res.repo.label}: local branch, no origin")
            for why in res.skipped:
                notes.append(f"{res.repo.label}: {why}")
            if res.content_unread:
                notes.append(f"{res.repo.label}: content grep {res.content_unread}")
        detail = ", ".join(f"{n} {s}" for s, n in sorted(states.items()))
        searched.append(f"searched: {len(results)} repositories at their default branch ({detail}); "
                        f"{sum(r.files for r in results)} tracked files")
    if gh is not None:
        searched.append(f"github: {gh.calls} API calls, {gh.cached} answered from cache ({' '.join(gh_cmd)})")
    elif "workflows" in sweeps:
        searched.append("github: not read (offline)")
    if board_names:
        searched.append("boards: " + ", ".join(board_names))

    lines, total = build_report(q, results, boards, collapse(notes), searched, max(1, args.limit))
    code = 0 if total else 1
    try:
        print("\n".join(lines))
        sys.stdout.flush()
    except BrokenPipeError:
        code = 0
    if stragglers:  # threads still waiting on a slow repository must not hold the exit
        os._exit(code)
    return code


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        for pid in list(LIVE):
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass
        os._exit(130)
