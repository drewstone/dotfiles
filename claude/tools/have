def samples_for(g: Group, q: Query, count: int = 8) -> list[str]:
    """Files that, together, show the most different matched words: a directory of 243 files
    reads better as `perf-gate.ts, speed-board.ts, ratchet.json` than as five `sandbox-*` names."""
    prefix = (g.anchor + "/") if g.anchor else ""
    anchor_words = q.matched_tokens(g.anchor)
    ranked = sorted(g.files)
    chosen, covered = [], set(anchor_words)
    for _ in range(count):
        best, gain = None, 0
        for item in ranked:
            if item[2] in chosen:
                continue
            new = len(q.matched_tokens(item[2].rsplit("/", 1)[-1]) - covered)
            if new > gain:
                best, gain = item[2], new
                if gain >= 2:
                    break
        if best is None:
            break
        chosen.append(best)
        covered |= q.matched_tokens(best.rsplit("/", 1)[-1])
    for item in ranked:  # fill with the files named for the most concepts
        if len(chosen) >= count:
            break
        if item[2] not in chosen:
            chosen.append(item[2])
    names = [p.rsplit("/", 1)[-1] for p in chosen]
    return [n if names.count(n) == 1 else (p[len(prefix):] if p.startswith(prefix) else p)
            for n, p in zip(names, chosen)]


def group_hit(res: RepoResult, g: Group, q: Query) -> Hit:
    label = res.repo.label
    where = (g.anchor + "/") if g.anchor else "(repo root)"
    total = score(g.best) + 60 * len(g.anchor_strengths) + 3 * math.log2(1 + g.count)
    noun = "file" if g.count == 1 else "files"
    samples = samples_for(g, q)
    more = [f"also {trunc(', '.join(samples[3:]), 150)}"] if len(samples) > 3 else []
    return Hit("path", f"{label}:{where}", total, trunc(f"{g.count} {noun}; e.g. {', '.join(samples[:3])}", 120),
               lines=more, repo=label)


def workflow_hit(label: str, w: Workflow) -> Hit:
    state = w.state or "state not read"
    head = state + (f"; {w.run}" if w.run else "")
    return Hit("workflow", f"{label}:{w.path}", w.score, head, lines=[f"name: {w.name}"] if w.name else [], repo=label)


def spread(hits: list[Hit], per_parent: int = 2) -> tuple[list[Hit], str]:
    """Keep the best `per_parent` directories under one parent, so a folder of 40 run
    directories does not fill the list. Returns the kept hits and a note on what was folded."""
    kept, seen, folded = [], {}, 0
    for h in hits:
        where = h.loc.split(":", 1)[1].rstrip("/")
        if "/" not in where:  # top-level directories are not siblings of one kind
            kept.append(h)
            continue
        key = (h.repo, where.rsplit("/", 1)[0])
        seen[key] = seen.get(key, 0) + 1
        if seen[key] <= per_parent:
            kept.append(h)
        else:
            folded += 1
    return kept, (f"; {folded} sibling directories folded" if folded else "")


def build_report(q: Query, results: list[RepoResult], boards: list[Hit], notes: list[str], searched: list[str],
                 limit: int) -> tuple[list[str], int]:
    path_hits, script_list, wf_hits = [], [], []
    for res in results:
        label = res.repo.label
        path_hits += [group_hit(res, g, q) for g in res.groups]
        script_list += res.scripts
        wf_hits += [workflow_hit(label, w) for w in res.workflows]
    path_hits.sort(key=lambda h: (-h.score, h.loc))
    wf_hits.sort(key=lambda h: (-h.score, h.loc))
    script_list.sort(key=lambda h: (-h.score, h.loc, h.head))
    path_hits, path_siblings = spread(path_hits)
    shown_dirs = {(h.repo, h.loc.split(":", 1)[1].rstrip("/")) for h in path_hits[:limit]}
    shown_wf = {h.loc for h in wf_hits[:limit]}
    content = []
    for res in results:
        label = res.repo.label
        for p, lines in res.content.items():
            if f"{label}:{p}" in shown_wf:
                continue
            if any(r == label and a and p.startswith(a + "/") for r, a in shown_dirs):
                continue
            content.append((score(q.hits(p, True), lines), lines, label, p))
    content.sort(key=lambda t: (-t[0], t[2], t[3]))
    content_hits = [Hit("content", f"{l}:{p}", sc, f"{n} matching lines", repo=l) for sc, n, l, p in content[:20]]
    tasks = sorted((h for h in boards if h.kind == "task"), key=lambda h: (-h.score, h.loc))
    notes_list = sorted((h for h in boards if h.kind == "note"), key=lambda h: (-h.score, h.loc))

    out = [f"have: {' '.join(q.words)}", f"concepts: {q.describe()}", *searched, ""]
    total = len(path_hits) + len(wf_hits) + len(script_list) + len(content_hits) + len(tasks) + len(notes_list)
    if not total:
        out += ["NO HITS. This holds only for what the `searched` lines list; it is not proof of absence elsewhere.", ""]
        return out + [f"note: {n}" for n in notes], 0

    other = len(path_hits) + len(wf_hits) + len(tasks) + len(script_list)
    quotas = ((path_hits, 3), (wf_hits, 3), (tasks, 3), (script_list, 1), (notes_list, 1),
              (content_hits, 0 if other >= 4 else 2))  # one block per kind, each best first
    first = [h for hits, n in quotas for h in hits[:n]]
    out.append("WHERE TO LOOK FIRST")
    for i, h in enumerate(first, 1):
        out.append(f"{i:>3}  {h.kind:<8} {h.loc}   {h.head}")

    def section(title: str, hits: list[Hit], extra: str = "") -> None:
        if not hits:
            return
        out.extend(["", f"{title} ({len(hits)}{'; ' + extra if extra else ''})"])
        for h in hits[:limit]:
            out.append(f"  {h.loc}   {h.head}")
            out.extend(f"      {line}" for line in h.lines)
        if len(hits) > limit:
            out.append(f"  ... {len(hits) - limit} more (--limit {len(hits)})")

    section("PATHS", path_hits, "directories on each default branch, with file counts" + path_siblings)
    section("WORKFLOWS", wf_hits, "state and latest run from the GitHub API; the top ones are read")
    section("SCRIPTS", script_list, "package.json")
    section("CONTENT", content_hits, "files with a typed word of every concept, by matching lines")
    section("TASKS", tasks)
    section("NOTES", notes_list)
    return out + ["", *[f"note: {n}" for n in notes]], total


def collapse(notes: list[str]) -> list[str]:
    """One line for each kind of repeated note."""
    kinds = {"local branch": [], "fetch failed": [], "no default": []}
    rest = []
    for n in notes:
        for key in kinds:
            if f": {key}" in n:
                kinds[key].append(n.split(":", 1)[0])
                break
        else:
            rest.append(n)
    out = rest
    for key, names in kinds.items():
        if names:
            more = f" and {len(names) - 5} more" if len(names) > 5 else ""
            out.append(f"{len(names)} checkouts: {key}: {', '.join(names[:5])}{more}")
    return out


