SWEEPS = ("paths", "scripts", "workflows", "content", "boards")

STOP = frozenset(
    "a an the do does did we have has had our us is are was there any exist exists existing "
    "anything something for of to in on at and or with already yet".split()
)

# Words that stand for one idea. A member ending in $ matches the whole word (and its plural);
# the rest match any word that starts with them. Add more with `synonyms =`.
CLUSTERS = [
    "eval bench harness perf latenc waterfall canary probe ratchet baseline scorecard "
    "scoreboard speed loadtest regression",
    "trace span$ telemetry otel opentelemetry metric monitor alert alarm uptime observab "
    "dashboard health",
    "deploy release ship$ publish rollout rollback",
    "test spec$ e2e$ smoke integration",
    "auth login oauth sso signin signup",
    "billing invoice payment stripe pricing",
    "cron schedul timer",
    "backup snapshot restor recover",
    "doc$ document readme runbook guide handbook",
]

SKIP_DIRS = frozenset({"node_modules", "vendor", "third_party", "dist", ".git"})
WORKFLOW_RX = re.compile(r"^\.github/workflows/[^/]+\.ya?ml$")
GREP_EXCLUDES = ("*.lock", "*-lock.*", "*.min.*", "*.map", "*.svg", "*.snap")
TEXT_EXTENSIONS = (".md", ".markdown", ".txt", ".org", ".rst")
LOCAL_BRANCHES = ("main", "master", "develop", "trunk")
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
CAMEL_A = re.compile(r"([a-z0-9])([A-Z])")
CAMEL_B = re.compile(r"([A-Z]+)([A-Z][a-z])")
NONALNUM = re.compile(r"[^a-z0-9]+")
GITHUB_SLUG = re.compile(r"github\.com[:/]+([^/]+)/([^/]+?)(?:\.git)?/?$")
TASK_HEAD = re.compile(r"^\s*\W?\s*(#\d+|[A-Z][A-Z0-9]+-\d+)\b")
ID_FIELDS = ("id", "key", "number", "identifier")
TITLE_FIELDS = ("title", "display_title", "name", "summary", "subject")


def clean(text: str) -> str:
    """Repository text must not move the terminal cursor."""
    return CONTROL.sub("?", text)


def trunc(text: str, width: int) -> str:
    text = clean(" ".join(str(text).split()))
    return text if len(text) <= width else text[: width - 3] + "..."


def tokenize(text: str) -> list[str]:
    text = CAMEL_B.sub(r"\1 \2", CAMEL_A.sub(r"\1 \2", text))
    return [t for t in NONALNUM.split(text.lower()) if t]


def stem(word: str) -> str:
    w = word.lower()
    if len(w) > 4 and w.endswith("ies"):
        return w[:-3] + "y"
    if len(w) > 4 and w.endswith(("sses", "xes", "ches", "shes")):
        return w[:-2]
    if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
        return w[:-1]
    return w


class Stem:
    """One word to look for. Four or more letters match as a word prefix; shorter ones, or a
    member written with $, match the whole word."""

    __slots__ = ("value", "exact", "rx", "ere")

    def __init__(self, value: str, exact: bool = False):
        self.value = value
        self.exact = exact or len(value) < 4
        escaped = re.escape(value)
        if self.exact:
            self.rx = re.compile(r"(?<![a-z0-9])" + escaped + r"(?:s|es)?(?![a-z0-9])", re.I)
            self.ere = "(^|[^[:alnum:]])" + escaped + "(s|es)?($|[^[:alnum:]])"
        else:
            self.rx = re.compile(r"(?<![a-z0-9])" + escaped, re.I)
            self.ere = "(^|[^[:alnum:]])" + escaped

    def hit(self, token: str) -> bool:
        if self.exact:
            return token in (self.value, self.value + "s", self.value + "es")
        return token.startswith(self.value)

    def shown(self) -> str:
        return self.value if self.exact else self.value + "*"


def parse_member(member: str) -> Stem:
    return Stem(member.rstrip("$").lower(), member.endswith("$"))


def in_cluster(word: str, members: list[Stem]) -> bool:
    for m in members:
        if m.hit(word) or (not m.exact and len(word) >= 4 and m.value.startswith(word)):
            return True
    return False


class Concept:
    def __init__(self, words: list[str], cluster: list[Stem]):
        self.words = words
        self.literals = [Stem(w) for w in words]
        typed = {s.value for s in self.literals}
        self.synonyms = [s for s in cluster if s.value not in typed]
        self.label = "+".join(words)
        self.ere = "(" + "|".join("(" + s.ere + ")" for s in self.literals) + ")"


class Query:
    """The terms folded into concepts, and the matching of text against them."""

    def __init__(self, raw_terms: list[str], extra_clusters: list[list[str]]):
        words: list[str] = []
        for raw in raw_terms:
            for part in raw.split():
                w = stem(part.strip("\"'.,;:()"))
                if w and w not in STOP and w not in words:
                    words.append(w)
        self.words = words
        clusters = [[parse_member(m) for m in c.split()] for c in CLUSTERS]
        clusters += [[parse_member(m) for m in c] for c in extra_clusters if c]
        grouped: dict[int, list[str]] = {}
        order: list[int] = []  # a cluster index, or -1 - n for the nth word with no cluster
        for w in words:
            idx = next((i for i, c in enumerate(clusters) if in_cluster(w, c)), -1)
            if idx < 0:
                order.append(-1 - len(order))
                grouped[order[-1]] = [w]
            else:
                if idx not in grouped:
                    order.append(idx)
                grouped.setdefault(idx, []).append(w)
        self.concepts = [Concept(grouped[k], clusters[k] if k >= 0 else []) for k in order]
        stems = {s.value for c in self.concepts for s in c.literals + c.synonyms}
        self.any_rx = re.compile("|".join(re.escape(s) for s in sorted(stems, key=lambda s: (-len(s), s))))
        self._cache: dict[tuple[str, bool], dict[int, int]] = {}

    def hits(self, text: str, primary: bool) -> dict[int, int]:
        """Concepts whose words appear as tokens of `text`. Strength 4 for a typed word and 3 for
        a synonym when `text` is a name; 2 and 1 when it is body text."""
        key = (text, primary)
        found = self._cache.get(key)
        if found is None:
            found = {}
            for tok in tokenize(text):
                for i, c in enumerate(self.concepts):
                    if any(s.hit(tok) for s in c.literals):
                        strength = 4 if primary else 2
                    elif any(s.hit(tok) for s in c.synonyms):
                        strength = 3 if primary else 1
                    else:
                        continue
                    if strength > found.get(i, 0):
                        found[i] = strength
            if len(self._cache) < 300000:
                self._cache[key] = found
        return dict(found)

    def matched_tokens(self, text: str) -> set[str]:
        """The words of `text` that any concept matches, by literal or synonym."""
        return {t for t in tokenize(text) if any(s.hit(t) for c in self.concepts for s in c.literals + c.synonyms)}

    def typed_in(self, text: str) -> dict[int, int]:
        """Concepts whose typed words appear anywhere in `text`, even inside a longer word."""
        return {i: 2 for i, c in enumerate(self.concepts) if any(s.rx.search(text) for s in c.literals)}

    def describe(self) -> str:
        parts = []
        for c in self.concepts:
            also = [s.shown() for s in c.synonyms]
            parts.append(c.label + (" (also " + ", ".join(also[:7]) + (", ..." if len(also) > 7 else "") + ")"
                                    if also else ""))
        return " | ".join(parts)


def merge(into: dict[int, int], more: dict[int, int]) -> dict[int, int]:
    for k, v in more.items():
        if v > into.get(k, 0):
            into[k] = v
    return into


def score(strengths: dict[int, int], count: int = 1, bonus: float = 0.0) -> float:
    return 60 * len(strengths) + 10 * sum(strengths.values()) + bonus + 3 * math.log2(1 + count)


