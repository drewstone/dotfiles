@dataclass
class Repo:
    path: str
    common: str = ""
    origin: str = ""
    slug: str = ""
    ref: str = ""
    local_only: bool = False
    partial: bool = False

    @property
    def label(self) -> str:
        return self.slug or os.path.basename(self.path.rstrip("/"))


def discover(cfg: Config, roots: list[str], depth: int) -> list[str]:
    found: list[str] = []
    seen: set[str] = set()

    def add(path: str) -> None:
        real = os.path.realpath(path)
        if real not in seen and not any(fnmatch.fnmatch(real, pat) for pat in cfg.exclude):
            seen.add(real)
            found.append(path)

    def walk(path: str, level: int, is_root: bool) -> None:
        if os.path.exists(os.path.join(path, ".git")):
            add(path)
            if not is_root:
                return
        if level >= depth:
            return
        try:
            entries = sorted(os.scandir(path), key=lambda e: e.name)
        except OSError:
            return
        for entry in entries:
            if entry.name.startswith((".", "_")) or entry.name in SKIP_DIRS:
                continue
            try:
                if entry.is_dir(follow_symlinks=False):
                    walk(entry.path, level + 1, False)
            except OSError:
                continue

    for root in roots:
        if os.path.isdir(root):
            walk(root.rstrip("/") or "/", 0, True)
    return found


def pick_ref(refs: dict[str, str]) -> tuple[str, bool]:
    """The default branch: origin/HEAD, else a conventional name under origin, else a local
    branch (marked local-only)."""
    head = refs.get("refs/remotes/origin/HEAD", "")
    if head.startswith("refs/remotes/") and head in refs:
        return head[len("refs/remotes/"):], False
    for name in LOCAL_BRANCHES:
        if f"refs/remotes/origin/{name}" in refs:
            return f"origin/{name}", False
    for name in LOCAL_BRANCHES:
        if f"refs/heads/{name}" in refs:
            return name, True
    return "", True


def read_refs(path: str) -> dict[str, str]:
    """Every origin and local branch ref, with the target of a symbolic one (origin/HEAD)."""
    rc, out = git(path, "for-each-ref", "--format=%(refname) %(symref)", "refs/remotes/origin", "refs/heads")
    refs: dict[str, str] = {}
    for line in out.splitlines() if rc == 0 else []:
        name, _, target = line.partition(" ")
        refs[name] = target
    return refs


def identify(path: str) -> Repo | None:
    rc, common = git(path, "rev-parse", "--git-common-dir")
    if rc != 0:
        return None
    repo = Repo(path=path, common=os.path.realpath(os.path.join(path, common)))
    rc, cfg = git(path, "config", "--get-regexp", r"^remote\.origin\.(url|promisor)$")
    for line in cfg.splitlines() if rc == 0 else []:
        key, _, value = line.partition(" ")
        if key.endswith(".url"):
            repo.origin = value.strip()
        elif key.endswith(".promisor"):
            repo.partial = value.strip().lower() == "true"
    m = GITHUB_SLUG.search(repo.origin)
    repo.slug = f"{m.group(1)}/{m.group(2)}" if m else ""
    repo.ref, repo.local_only = pick_ref(read_refs(path))
    if not repo.origin:
        repo.local_only = True
    return repo


def prefer(a: Repo, b: Repo) -> Repo:
    """Of two clones of one repository, the one that reads fastest and fullest."""
    return min((a, b), key=lambda r: (r.partial, r.local_only, not r.ref, r.path))


@dataclass
class Group:
    anchor: str
    anchor_strengths: dict
    count: int = 0
    best: dict = field(default_factory=dict)
    best_score: float = -1
    files: list = field(default_factory=list)


@dataclass
class Hit:
    kind: str
    loc: str
    score: float
    head: str
    lines: list = field(default_factory=list)
    repo: str = ""


@dataclass
class Workflow:
    path: str
    name: str
    strengths: dict  # by concept; 3 or 4 when the file name or workflow name matched, 2 or less in its text
    state: str = ""
    wid: int = 0
    run: str = ""

    @property
    def score(self) -> float:
        named = any(v >= 3 for v in self.strengths.values())
        return score(self.strengths, bonus=10 if named else -30)


@dataclass
class RepoResult:
    repo: Repo
    fetch: str = ""
    note: str = ""
    files: int = 0
    groups: list = field(default_factory=list)
    scripts: list = field(default_factory=list)
    workflows: list = field(default_factory=list)
    content: dict = field(default_factory=dict)
    content_unread: str = ""
    skipped: list = field(default_factory=list)


def path_groups(paths: list[str], q: Query, skip_workflows: bool) -> list[Group]:
    groups: dict[str, Group] = {}
    for p in paths:
        if not q.any_rx.search(p.lower()):
            continue
        if skip_workflows and WORKFLOW_RX.match(p):
            continue
        comps = p.split("/")
        if any(c in SKIP_DIRS for c in comps[:-1]):
            continue
        strengths: dict[int, int] = {}
        deepest, name_hits = -1, 0
        for i, comp in enumerate(comps):
            found = q.hits(comp, True)
            if not found:
                continue
            merge(strengths, found)
            if i < len(comps) - 1:
                deepest = i
            else:
                name_hits = len(found)
        if not strengths:
            continue
        anchor = "/".join(comps[: deepest + 1]) if deepest >= 0 else "/".join(comps[:-1])
        g = groups.get(anchor)
        if g is None:
            anchor_strengths: dict[int, int] = {}
            for comp in anchor.split("/") if anchor else []:
                merge(anchor_strengths, q.hits(comp, True))
            g = groups[anchor] = Group(anchor, anchor_strengths)
        g.count += 1
        s = score(strengths)
        if s > g.best_score:
            g.best, g.best_score = strengths, s
        g.files.append((-name_hits, len(comps), p))
    return list(groups.values())


def cat_files(path: str, ref: str, names: list[str], cap: int = 200000) -> dict[str, str]:
    names = [n for n in names if "\n" not in n]
    if not names:
        return {}
    payload = "".join(f"{ref}:{n}\n" for n in names).encode()
    rc, out, _ = run(["git", "-C", path, "cat-file", "--batch"], data=payload, timeout=60)
    if rc != 0:
        return {}
    result: dict[str, str] = {}
    pos = 0
    for n in names:
        nl = out.find(b"\n", pos)
        if nl < 0:
            break
        head = out[pos:nl].split()
        if len(head) == 3 and head[1] == b"blob":
            size = int(head[2])
            result[n] = out[nl + 1: nl + 1 + min(size, cap)].decode("utf-8", "replace")
            pos = nl + 1 + size + 1
        else:
            pos = nl + 1
    return result


def script_hits(label: str, files: dict[str, str], q: Query) -> list[Hit]:
    hits = []
    for name, text in files.items():
        try:
            scripts = json.loads(text).get("scripts") or {}
        except (ValueError, AttributeError):
            continue
        if not isinstance(scripts, dict):
            continue
        for key, command in scripts.items():
            if not isinstance(command, str):
                continue
            strengths = merge(q.hits(key, True), q.hits(command, False))
            if strengths:
                hits.append(Hit("script", f"{label}:{name}", score(strengths),
                                f"scripts.{clean(key)} = {trunc(command, 90)}", repo=label))
    return hits


def workflow_candidates(files: dict[str, str], q: Query) -> list[Workflow]:
    found = []
    for path, text in files.items():
        m = re.search(r"^name:\s*(.+?)\s*$", text, re.M)
        name = m.group(1).strip("\"'") if m else ""
        strengths = merge(q.hits(path.rsplit("/", 1)[-1] + " " + name, True), q.typed_in(text))
        if strengths:
            found.append(Workflow(path, clean(name), strengths))
    return found


def content_grep(path: str, ref: str, q: Query, timeout: float) -> dict[str, int] | None:
    """Files holding a word of every concept (`git grep -c --all-match`, one -e per concept),
    with the number of matching lines. None when the grep did not finish."""
    cmd = ["git", "-C", path, "grep", "--threads=2", "-c", "-z", "-i", "-I", "-E"]
    if len(q.concepts) > 1:
        cmd.append("--all-match")
    for c in q.concepts:
        cmd += ["-e", c.ere]
    cmd += [ref, "--", "."] + [f":(exclude){pat}" for pat in GREP_EXCLUDES]
    rc, out, _ = run(cmd, timeout=timeout)
    if rc not in (0, 1):
        return None
    prefix = f"{ref}:".encode()
    found: dict[str, int] = {}
    for line in out.split(b"\n"):
        name, sep, count = line.rpartition(b"\0")
        if sep and name.startswith(prefix) and count.isdigit():
            found[name[len(prefix):].decode("utf-8", "replace")] = int(count)
    return found


def fetch_repo(repo: Repo, res: RepoResult, ttl: float, cache_dir: str, enabled: bool) -> None:
    if repo.local_only:
        res.fetch = "local branch, no origin"
        return
    if not enabled:
        res.fetch = "not refreshed"
        return
    marker = os.path.join(cache_dir, "fetched", hashlib.sha1(repo.common.encode()).hexdigest())
    try:
        if repo.ref and time.time() - os.path.getmtime(marker) < ttl:
            res.fetch = "fetched recently"
            return
    except OSError:
        pass
    cmd = ["fetch", "-q", "--no-tags", "origin"]
    if repo.ref:
        branch = repo.ref.split("/", 1)[1]
        cmd.append(f"+refs/heads/{branch}:refs/remotes/origin/{branch}")
    rc, msg = git(repo.path, *cmd, timeout=45)
    if rc != 0:
        res.fetch = "fetch failed"
        res.note = trunc(msg.splitlines()[-1] if msg else "unknown error", 70)
        return
    res.fetch = "fetched"
    try:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        with open(marker, "w"):
            pass
    except OSError:
        pass
    if not repo.ref:
        repo.ref, _ = pick_ref(read_refs(repo.path))


def sweep_repo(repo: Repo, q: Query, args, sweeps: set[str], ttl: float, cache_dir: str) -> RepoResult:
    res = RepoResult(repo)
    fetch_repo(repo, res, ttl, cache_dir, not (args.offline or args.no_fetch))
    if not repo.ref:
        res.skipped.append("no default branch")
        return res
    rc, out, _ = run(["git", "-C", repo.path, "ls-tree", "-r", "-z", "--name-only", repo.ref], timeout=60)
    if rc != 0:
        res.skipped.append("ls-tree failed")
        return res
    tree = [p for p in out.decode("utf-8", "replace").split("\0") if p]
    res.files = len(tree)
    if "paths" in sweeps:
        res.groups = path_groups(tree, q, "workflows" in sweeps)
    if repo.partial:
        # A blob read in a partial clone is a network fetch per file; names alone are searched.
        res.skipped.append("partial clone: package.json, workflow text and content not read")
        if "workflows" in sweeps:
            for p in tree:
                if WORKFLOW_RX.match(p):
                    s = q.hits(p.rsplit("/", 1)[-1], True)
                    if s:
                        res.workflows.append(Workflow(p, "", s))
        return res
    want_scripts = "scripts" in sweeps
    want_flows = "workflows" in sweeps
    names = []
    if want_scripts:
        names += [p for p in tree if (p == "package.json" or p.endswith("/package.json")) and "node_modules/" not in p][:300]
    if want_flows:
        names += [p for p in tree if WORKFLOW_RX.match(p)]
    texts = cat_files(repo.path, repo.ref, names)
    if want_scripts:
        res.scripts = script_hits(repo.label, {n: t for n, t in texts.items() if n.endswith("package.json")}, q)
    if want_flows:
        res.workflows = workflow_candidates({n: t for n, t in texts.items() if WORKFLOW_RX.match(n)}, q)
    return res


