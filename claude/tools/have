def json_records(data) -> list[dict] | None:
    if isinstance(data, dict):
        data = next((v for v in data.values() if isinstance(v, list)), None)
    if isinstance(data, list) and data and all(isinstance(x, dict) for x in data):
        return data
    return None


def pick(rec: dict, names) -> str:
    for n in names:
        v = rec.get(n)
        if v not in (None, "") and not isinstance(v, (dict, list)):
            return str(v)
    return ""


def flatten(value) -> str:
    if isinstance(value, dict):
        return " ".join(flatten(v) for v in value.values())
    if isinstance(value, list):
        return " ".join(flatten(v) for v in value)
    return "" if value is None or isinstance(value, (bool, int, float)) else str(value)


def task_records(label: str, command: str, q: Query, notes: list[str]) -> list[Hit]:
    rc, out, err = run(["sh", "-c", command], timeout=60)
    if rc != 0:
        notes.append(f"tasks {label}: `{trunc(command, 40)}` failed ({trunc(err.decode('utf-8', 'replace'), 60)})")
        return []
    text = out.decode("utf-8", "replace")
    records: list[tuple[str, str, str]] = []  # id, head, body
    try:
        listing = json_records(json.loads(text))
    except ValueError:
        listing = None
    if listing is not None:
        for rec in listing:
            ident = pick(rec, ID_FIELDS)
            title = pick(rec, TITLE_FIELDS) or "(no title)"
            state = pick(rec, ("state", "status"))
            ident = f"#{ident}" if ident.isdigit() else ident or "?"
            body = " ".join(flatten(v) for k, v in rec.items() if k not in ("title", "display_title", "name"))
            records.append((ident, f"[{state}] {title}" if state else title, body))
    else:
        lines = [l for l in text.splitlines() if l.strip()]
        indent_of = lambda l: len(l) - len(l.lstrip())
        heads = [indent_of(l) for l in lines if TASK_HEAD.match(l)]
        if heads:  # a task starts at a line that begins with an id, at the usual indent for those
            usual = max(set(heads), key=heads.count)
            starts = lambda l: bool(TASK_HEAD.match(l)) and indent_of(l) == usual
        else:  # no ids: every line at the least indent starts a task
            least = min((indent_of(l) for l in lines), default=0)
            starts = lambda l: indent_of(l) <= least
        for n, l in enumerate(lines, 1):
            if starts(l):
                m = TASK_HEAD.match(l)
                records.append((m.group(1) if m else f"line {n}", l.strip(), ""))
            elif records:
                ident, head, body = records[-1]
                records[-1] = (ident, head, body + "\n" + l)
    if not records:
        notes.append(f"tasks {label}: no tasks in the output")
        return []
    hits = []
    for ident, head, body in records:
        shown = re.sub(r"^\W*" + re.escape(ident) + r"\s*", "", head) if ident and ident in head else head
        strengths = merge(q.hits(shown, True), merge(q.typed_in(body), {k: min(v, 2) for k, v in q.hits(body, False).items()}))
        if strengths:
            hits.append(Hit("task", f"tasks:{label} {ident}", score(strengths, bonus=10), trunc(shown, 120)))
    return hits


def note_hits(label: str, root: str, q: Query, notes: list[str]) -> list[Hit]:
    if not os.path.isdir(root):
        notes.append(f"notes {label}: {root} is not a directory")
        return []
    hits, scanned = [], 0
    for base, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in SKIP_DIRS)
        for name in sorted(files):
            if not name.lower().endswith(TEXT_EXTENSIONS):
                continue
            scanned += 1
            if scanned > 5000:
                break
            full = os.path.join(base, name)
            rel = os.path.relpath(full, root)
            try:
                if os.path.getsize(full) > 1 << 20:
                    continue
                with open(full, encoding="utf-8", errors="replace") as f:
                    lines = f.read().splitlines()
            except OSError:
                continue
            strengths = q.hits(rel, True)
            best_line, best_n = 0, 0
            for ln, text in enumerate(lines[:5000], 1):
                found = q.typed_in(text)
                merge(strengths, found)
                if len(found) > best_n:
                    best_line, best_n = ln, len(found)
            if strengths:
                shown = lines[best_line - 1] if best_line else (lines[0] if lines else "")
                hits.append(Hit("note", f"notes:{label}:{rel}:{best_line or 1}", score(strengths), trunc(shown, 120)))
    return hits


