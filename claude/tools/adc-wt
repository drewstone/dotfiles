#!/usr/bin/env bash
# Warm worktree pool for agent-dev-container.
#
# A fresh `git worktree add` is not ready to work in. Measured on 2026-08-13,
# one fresh worktree cost:
#   checkout 7865 files      ~60s
#   pnpm install             ~10s
#   cold turbo cache         619s of rebuilds (dist freshness 322s + types 297s)
#   missing native addons    120 phantom test failures (better-sqlite3 binding)
# The last one is the expensive kind of slow: it looks like a code regression.
#
# So the pool pre-pays all four, exactly as the product's sandbox warm pool
# pre-pays a container boot. An agent CLAIMS a ready tree instead of building
# one.
#
# usage:
#   adc-wt warm [N]        keep N ready trees (default 3)
#   adc-wt claim <branch>  print the path of a ready tree, on a new branch
#   adc-wt release <path>  return a tree to the pool (reset + refresh)
#   adc-wt status
set -uo pipefail

# The checkout lives at ~/webb on the laptop and ~/code on the desktop; probe both, like the
# ai-agent-hooks shim does, so one machine's layout is never baked into the other's tool.
if [ -n "${ADC_REPO:-}" ]; then
  REPO="$ADC_REPO"
else
  REPO="$HOME/webb/agent-dev-container"
  [ -d "$REPO/.git" ] || REPO="$HOME/code/agent-dev-container"
fi
POOL="${ADC_WT_POOL:-$REPO/.worktrees}"
SEED_PREFIX="wt-warm-"
export TURBO_CACHE_DIR="${TURBO_CACHE_DIR:-$HOME/.cache/turbo/adc}"

log() { echo "[adc-wt $(date +%H:%M:%S)] $*"; }

# The repo owns this: scripts/bootstrap-worktree.sh runs the frozen install, the
# workspace build, and the native-addon heal in one idempotent shot. Run it with
# cwd INSIDE the tree — `pnpm -C <dir>` leaves the addon heal pointed at the
# wrong instance, which is how a worktree reaches a test run with no
# better-sqlite3 binding and reports 120 failures that look like a code defect.
# Bootstrap output goes to a log rather than /dev/null. A bare "bootstrap
# FAILED" sends the caller to re-run the same script by hand to learn the
# reason, and a transient failure then looks like a broken tool.
prepare_tree() {
  local dir="$1"
  local logfile
  logfile="$(mktemp -t adc-wt-bootstrap-XXXXXX.log)"
  if ! ( cd "$dir" && bash scripts/bootstrap-worktree.sh >"$logfile" 2>&1 ); then
    log "bootstrap FAILED in $dir — last 20 lines of $logfile:"
    tail -20 "$logfile" >&2
    return 1
  fi
  rm -f "$logfile"
  log "ready: $dir"
}

cmd_warm() {
  local want="${1:-3}" have=0 i=0
  mkdir -p "$POOL" "$TURBO_CACHE_DIR"
  ( cd "$REPO" && git fetch origin --quiet ) || true
  for d in "$POOL"/${SEED_PREFIX}*; do [ -d "$d" ] && have=$((have + 1)); done
  log "pool has $have, want $want (shared cache: $TURBO_CACHE_DIR)"
  while [ "$have" -lt "$want" ]; do
    i=$((i + 1))
    local dir="$POOL/${SEED_PREFIX}$(date +%s)-$i"
    ( cd "$REPO" && git worktree add --detach "$dir" origin/develop >/dev/null 2>&1 ) \
      || { log "worktree add FAILED"; return 1; }
    prepare_tree "$dir" || return 1
    have=$((have + 1))
  done
  log "pool warm: $have tree(s)"
}

cmd_claim() {
  local branch="${1:?usage: adc-wt claim <branch>}"
  local dir
  # Git refuses to check a branch out in two worktrees, so a branch that is
  # already live somewhere can never be claimed into a pooled tree. That tree
  # IS the claim: print it and stop, instead of burning a warm tree on a
  # checkout that cannot succeed.
  local existing
  existing="$(cd "$REPO" && git worktree list --porcelain 2>/dev/null \
    | awk -v want="refs/heads/$branch" '
        /^worktree /{path=substr($0,10)}
        /^branch /{if (substr($0,8) == want) {print path; exit}}
      ')"
  if [ -n "$existing" ] && [ -d "$existing" ]; then
    log "branch already checked out; reusing that tree"
    printf '%s\n' "$existing"
    return 0
  fi
  for d in "$POOL"/${SEED_PREFIX}*; do
    [ -d "$d" ] || continue
    dir="$d"; break
  done
  if [ -z "${dir:-}" ]; then
    log "pool empty — building one now (slow path)"
    dir="$POOL/${SEED_PREFIX}$(date +%s)-cold"
    ( cd "$REPO" && git worktree add --detach "$dir" origin/develop >/dev/null 2>&1 ) || return 1
    prepare_tree "$dir" || return 1
  fi
  local claimed="$POOL/${branch//\//-}"
  mv "$dir" "$claimed" 2>/dev/null || claimed="$dir"
  ( cd "$REPO" && git worktree repair "$claimed" >/dev/null 2>&1 ) || true
  if ! ( cd "$claimed" \
    && git fetch origin --quiet \
    && git checkout -B "$branch" origin/develop >/dev/null 2>&1 ); then
    # Leave the tree in the pool under its seed name. A tree stranded under a
    # branch name is claimed by nobody and warms nothing.
    local reason
    reason="$( cd "$claimed" && git checkout -B "$branch" origin/develop 2>&1 | tail -2 )"
    mv "$claimed" "$POOL/${SEED_PREFIX}$(date +%s)-recycled" 2>/dev/null || true
    ( cd "$REPO" && git worktree prune >/dev/null 2>&1 ) || true
    log "branch checkout FAILED: ${reason:-unknown}"
    return 1
  fi
  # A pooled tree carries the dependencies of the develop it was warmed from.
  # The checkout above moves it to current develop, so a dependency bump since
  # then leaves the installed tree behind the lockfile. That reads as a code
  # failure — five agents on 2026-08-14 each lost a gate run to "Cannot find
  # module" before finding the cause. pnpm no-ops when the tree already
  # matches, so this costs nothing in the common case.
  ( cd "$claimed" && CI=true pnpm install --frozen-lockfile >/dev/null 2>&1 ) \
    || log "dependency refresh failed — run 'CI=true pnpm install --frozen-lockfile' in $claimed"
  echo "$claimed"
}

cmd_release() {
  local dir="${1:?usage: adc-wt release <path>}"
  ( cd "$REPO" && git worktree remove --force "$dir" >/dev/null 2>&1 ) || rm -rf "$dir"
  log "released $dir"
}

cmd_status() {
  echo "repo:         $REPO"
  echo "pool:         $POOL"
  echo "shared cache: $TURBO_CACHE_DIR ($(du -sh "$TURBO_CACHE_DIR" 2>/dev/null | cut -f1 || echo 0))"
  local ready=0 claimed=0
  for d in "$POOL"/*; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in
      ${SEED_PREFIX}*) ready=$((ready + 1)) ;;
      *) claimed=$((claimed + 1)) ;;
    esac
  done
  echo "ready:        $ready"
  echo "claimed:      $claimed"
}

case "${1:-status}" in
  warm)    shift; cmd_warm "$@" ;;
  claim)   shift; cmd_claim "$@" ;;
  release) shift; cmd_release "$@" ;;
  status)  cmd_status ;;
  *) echo "usage: adc-wt {warm [N]|claim <branch>|release <path>|status}" >&2; exit 2 ;;
esac
