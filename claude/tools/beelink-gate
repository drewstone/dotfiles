  # and better-sqlite3 failed with "Module did not self-register". With an nvm Node
  # first on PATH, a login shell keeps it.
  if [ -s .nvmrc ]; then
    if [ -s "$HOME/.nvm/nvm.sh" ]; then
      # shellcheck disable=SC1091
      . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
      nvm use >/dev/null 2>&1 || nvm install >/dev/null 2>&1 || die "cannot select Node $(cat .nvmrc) with nvm on $beelink"
    else
      die ".nvmrc asks for Node $(cat .nvmrc) and $beelink has no nvm to select it"
    fi
  fi
  gate_node=$(node -v 2>/dev/null || true)
  # Install and run with the repo's pnpm, not the beelink's: pnpm 11 enforces
  # minimumReleaseAge and pnpm 10 ignores it, so a gate on 10 passed an install
  # that CI on 11 refused. The shim covers the install, the command and ship.sh.
  local want_pnpm have_pnpm
  if [ -f pnpm-lock.yaml ] && want_pnpm=$(repo_pnpm_version); then
    have_pnpm=$(pnpm --version 2>/dev/null || true)
    if [ "$want_pnpm" != "$have_pnpm" ]; then
      mkdir -p "$checkout/.git/beelink-gate-bin" || exit $?
      printf '#!/usr/bin/env bash\nexec npx --yes "pnpm@%s" "$@"\n' "$want_pnpm" > "$checkout/.git/beelink-gate-bin/pnpm" || exit $?
      chmod +x "$checkout/.git/beelink-gate-bin/pnpm" || exit $?
      export PATH="$checkout/.git/beelink-gate-bin:$PATH"
      echo "beelink-gate: using the repo's pnpm $want_pnpm (beelink has ${have_pnpm:-none})" >&2
    fi
  fi
  if [ "$install_mode" = ship ]; then
    [ -f scripts/ship.sh ] || die "--ship: $owner/$repo at ${sha:0:12} has no scripts/ship.sh"
    # Size the test pool to the cores the host has spare: other gates and lanes
    # share it, and a real-browser test starved beside eight workers on a host
    # at load 50 timed out at 120 s.
    local cores load spare workers
    cores=$(nproc)
    load=${BEELINK_GATE_LOAD:-$(cut -d' ' -f1 /proc/loadavg)}
    spare=$(( cores - ${load%.*} ))
    workers=${ship_workers:-$spare}
    (( workers <= cores / 2 )) || workers=$(( cores / 2 ))
    # Two workers stretched a GTM verify to 15 min at load 23; four keeps most of
    # the relief now that the real-browser test has a budget sized to load.
    (( workers >= 4 )) || workers=4
    if [ "${starved:-0}" = 1 ]; then workers=$(( workers / 2 )); (( workers >= 2 )) || workers=2; fi
    export SHIP_MAX_WORKERS=$workers
    echo "beelink-gate: --ship runs scripts/ship.sh verify with node $(node -v 2>/dev/null) and SHIP_MAX_WORKERS=$workers (load $load on $cores cores)" >&2
  elif [ "$install_mode" = no-install ] || [ "$install_mode" = light ]; then
    echo "beelink-gate: skipping dependency install for this check" >&2
  elif [ -f pnpm-lock.yaml ]; then
    command -v pnpm >/dev/null || die "pnpm unavailable on beelink"
    step pnpm install --frozen-lockfile --store-dir "$HOME/.local/share/pnpm/store" || exit $?
  elif [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
    command -v npm >/dev/null || die "npm unavailable on beelink"
    step npm ci --cache "$HOME/.npm" || exit $?
  elif [ -f package.json ]; then
    # A dependency-free package needs no install. A package with dependencies
    # and no lock cannot have a frozen install, so fail the gate.
    node -e 'const p=require("./package.json"); process.exit(Object.keys(p.dependencies||{}).length || Object.keys(p.devDependencies||{}).length || Object.keys(p.optionalDependencies||{}).length ? 1 : 0)' \
      || die "package.json has dependencies but no pnpm/npm lockfile"
    echo "beelink-gate: dependency-free package; no frozen install needed" >&2
  fi
  if [ "$install_mode" != ship ] && [ -d node_modules/.pnpm ]; then
    rebuild_native_addons || exit $?
  fi
  recover_floor_from_cache "$beelink" "$cache_root" "$cache_max" "$cache_root/.locks/no-current-checkout"
  floor_ok=0
  check_floor "$beelink" || floor_ok=1
  observe_install_reserve
  (( floor_ok == 0 )) || tempfail "$(utc_in_minutes 15)" "$beelink is below its disk floor"
  cancel_if_requested
  echo "beelink-gate: running ${display% }" >&2
  pre_command_s=$((SECONDS - started))
  local command_started=$SECONDS
  local tick cpu_before cpu_after
  tick=$(getconf CLK_TCK 2>/dev/null || echo 100)
  cpu_before=$(children_cpu_ticks)
  # The submitted user unit can inherit umask 0002. Give the requested command
  # a predictable non-group-writable default without changing the gate shell's
  # mask for receipts, bundles, and other state written after the command.
  local -a command_with_umask=(/usr/bin/bash -c 'umask 022; exec "$@"' beelink-gate-command "${command[@]}")
  if (( light )); then
    # No browser: Playwright finds no installed browser and fails the test that wants one.
    mkdir -p "$checkout/.git/beelink-gate-no-browsers"
    PLAYWRIGHT_BROWSERS_PATH="$checkout/.git/beelink-gate-no-browsers" step "${command_with_umask[@]}"
  else
    step "${command_with_umask[@]}"
  fi
  local status=$?
  command_s=$((SECONDS - command_started))
  cpu_after=$(children_cpu_ticks)
  cpu_s=$(awk -v a="$cpu_before" -v b="$cpu_after" -v t="$tick" 'BEGIN { printf "%.1f", (b - a) / t }')
  if (( light )) && awk -v c="$cpu_s" -v l="$light_cpu" 'BEGIN { exit !(c + 0 > l + 0) }'; then
    echo "beelink-gate: LIGHT GATE OVER BUDGET: the command used ${cpu_s} core-seconds of the ${light_cpu} it declared; run it as a normal gate" >&2
    status=1
  fi
  if [ "$status" -eq 0 ] && [ "$install_mode" = ship ]; then
    run_preview
    status=$?
    [ "$status" -ne 0 ] || publish_proof
  fi
  exit "$status"
}

if [ "${1:-}" = --window-probe ]; then
  shift
  check_update_window "$@"
  exit $?
fi
if [ "${1:-}" = --remote ]; then
  shift
  remote_gate "$@"
fi
job_dir_for() {
  [[ "$1" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "invalid gate id"
  echo "$STATE_DIR/jobs/$1"
}
job_submit() {
  local id=$1 dir unit name lock_fd
  shift
  dir=$(job_dir_for "$id")
  mkdir -p "$STATE_DIR/jobs/.locks" "$STATE_DIR/jobs/.canceled" || return 75
  exec {lock_fd}> "$STATE_DIR/jobs/.locks/$id.lock" || return 75
  flock "$lock_fd" || return 75
  if [ -f "$STATE_DIR/jobs/.canceled/$id" ]; then
    echo "beelink-gate: gate_id=$id canceled before submission; TEMPFAIL 75" >&2
    [ ! -d "$dir" ] || printf '75\n' > "$dir/exit"
    return 75
  fi
  [ -f "$dir/gate.sh" ] && [ ! -L "$dir/gate.sh" ] || die "gate source was not staged for $id"
  # Jobs can emit large logs. Keep completed reconnect records for one day;
  # active jobs have no exit file and their receipt also lives in receipts.jsonl.
  python3 - "$STATE_DIR/jobs" "$id" <<'PY' || true
import pathlib, re, shutil, stat, sys, time
root, current = pathlib.Path(sys.argv[1]), sys.argv[2]
for job in root.iterdir():
    if job.name == current or not re.fullmatch(r"beelink[12]-[0-9a-f]{32}", job.name):
        continue
    if job.is_symlink() or not job.is_dir():
        continue
    try:
        done = (job / "exit").lstat()
    except FileNotFoundError:
        continue
    if stat.S_ISREG(done.st_mode) and time.time() - done.st_mtime > 86400:
        shutil.rmtree(job)
PY
  cat > "$dir/runner.sh" <<'RUNNER'
#!/usr/bin/env bash
dir=$(cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
set +e
child= stop_requested=0
stop_child() {
  stop_requested=1
  : > "$dir/../.canceled/${dir##*/}"
  [ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true
}
trap stop_child TERM INT HUP
bash "$dir/gate.sh" --remote "$@" > "$dir/stdout.log" 2> "$dir/stderr.log" &
child=$!
birth=$(awk '{print $22}' "/proc/$child/stat" 2>/dev/null)
printf '%s %s\n' "$child" "$birth" > "$dir/gate.pid.tmp"
mv -- "$dir/gate.pid.tmp" "$dir/gate.pid"
[ "$stop_requested" = 0 ] || kill -TERM "$child" 2>/dev/null || true
wait "$child"; rc=$?
if [ "$stop_requested" = 1 ]; then
  # A TERM interrupts bash's wait even when gate.sh moved to a different
  # cgroup. Never publish a terminal exit while that exact child still lives.
  for ((i=0; i<100; i++)); do
    state=$(awk '{print $3}' "/proc/$child/stat" 2>/dev/null)
    [ "$state" = Z ] && break
    kill -0 "$child" 2>/dev/null || break
    sleep 0.1
  done
  state=$(awk '{print $3}' "/proc/$child/stat" 2>/dev/null)
  if [ "$state" != Z ] && kill -0 "$child" 2>/dev/null; then
    echo "beelink-gate: gate child $child survived unit stop" >&2
    exit 75
  fi
  wait "$child" 2>/dev/null || true
  rc=75
fi
exec {lock_fd}> "$dir/../.locks/${dir##*/}.lock"
flock "$lock_fd"
printf '%s\n' "$rc" > "$dir/exit.tmp"
mv -- "$dir/exit.tmp" "$dir/exit"
RUNNER
  chmod 700 "$dir/runner.sh"
  local -a vars=("BEELINK_GATE_ID=$id")
  for name in BEELINK_GATE_LAUNCHER BEELINK_GATE_MAX_HOLD BEELINK_GATE_BRANCH BEELINK_GATE_LOAD_WAIT BEELINK_GATE_CACHE_MAX_BYTES \
    BEELINK_GATE_MAX_CPU_PRESSURE BEELINK_GATE_HOST_PRESSURE_CEILING BEELINK_GATE_STARVE_AFTER \
    BEELINK_GATE_CLASS BEELINK_GATE_SHIP_WORKERS BEELINK_GATE_PR BEELINK_GATE_LANE BEELINK_GATE_RESERVATION_TOKEN BEELINK_GATE_MAX_CONCURRENT \
    BEELINK_GATE_REPO_CHECKOUTS BEELINK_GATE_LIGHT_CPU BEELINK_GATE_LIGHT_SLOTS \
    BEELINK_GATE_URGENT BEELINK_GATE_AUTO BEELINK_GATE_ADMIT_WAIT BEELINK_GATE_PLACED_WAIT; do
    [ -z "${!name:-}" ] || vars+=("$name=${!name}")
  done
  unit="beelink-gate-$id"
  if ! systemd-run --user --collect --unit="$unit" /usr/bin/env "${vars[@]}" /usr/bin/bash "$dir/runner.sh" "$@" {lock_fd}>&- >&2; then
    printf '75\n' > "$dir/exit"
    return 75
  fi
  : > "$dir/submitted"
  echo "beelink-gate: submitted gate_id=$id" >&2
}
gate_process_alive() {
  local dir=$1 pid birth actual state
  [ -f "$dir/gate.pid" ] && [ ! -L "$dir/gate.pid" ] || return 1
  read -r pid birth < "$dir/gate.pid" || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$birth" =~ ^[1-9][0-9]*$ ]] || return 1
  read -r state actual < <(awk '{print $3, $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
  [ "$actual" = "$birth" ] && [ "$state" != Z ] && [ "$state" != X ] || return 1
  gate_pid=$pid
}
job_cancel_remote() {
  local id=$1 dir unit state lock_fd gate_pid i
  dir=$(job_dir_for "$id")
  mkdir -p "$STATE_DIR/jobs/.locks" "$STATE_DIR/jobs/.canceled" || return 75
  exec {lock_fd}> "$STATE_DIR/jobs/.locks/$id.lock" || return 75
  flock "$lock_fd" || return 75
  : > "$STATE_DIR/jobs/.canceled/$id" || return 75
  if [ -d "$dir" ] && [ ! -f "$dir/exit" ]; then
    unit="beelink-gate-$id.service"
    systemctl --user stop "$unit" >&2 || true
    state=$(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null) || return 75
    case "$state" in
      inactive|failed) ;;
      *) echo "beelink-gate: $unit remains $state; retry cancellation" >&2; return 75 ;;
    esac
    if [ -f "$dir/submitted" ] && [ ! -f "$dir/gate.pid" ] && [ ! -f "$dir/exit" ]; then
      echo "beelink-gate: cannot confirm gate child for $id after unit stop; retry cancellation" >&2
      return 75
    fi
    if gate_process_alive "$dir"; then
      kill -TERM "$gate_pid" 2>/dev/null || true
      for ((i=0; i<100; i++)); do
        gate_process_alive "$dir" || break
        sleep 0.1
      done
      if gate_process_alive "$dir"; then
        echo "beelink-gate: gate child $gate_pid survived unit stop; retry cancellation" >&2
        return 75
      fi
    fi
    # The unit's cgroup may have killed runner.sh before it wrote its exit.
    # An attach then sees a terminal TEMPFAIL instead of waiting indefinitely.
    printf '75\n' > "$dir/exit.cancel.tmp" && mv -- "$dir/exit.cancel.tmp" "$dir/exit"
  fi
  echo "beelink-gate: canceled gate_id=$id" >&2
}
job_attach_remote() {
  local dir
  dir=$(job_dir_for "$1")
  [ -d "$dir" ] || die "unknown gate id: $1"
  python3 -u - "$dir" <<'PY'
import pathlib, subprocess, sys, time
directory = pathlib.Path(sys.argv[1])
streams = [(directory / "stdout.log", sys.stdout.buffer), (directory / "stderr.log", sys.stderr.buffer)]
offsets = [0, 0]
result = directory / "exit"
started = time.monotonic()
while True:
    for i, (log, output) in enumerate(streams):
        if log.exists():
            with log.open("rb") as stream:
                stream.seek(offsets[i])
                data = stream.read()
            if data:
                output.write(data)
                output.flush()
                offsets[i] += len(data)
    if result.exists():
        code = result.read_text().strip()
        if any(log.exists() and log.stat().st_size > offsets[i] for i, (log, _) in enumerate(streams)):
            continue
        sys.exit(int(code) if code.isdigit() and 0 <= int(code) <= 255 else 75)
    if time.monotonic() - started > 60:
        unit = f"beelink-gate-{directory.name}.service"
        status = subprocess.run(["systemctl", "--user", "show", unit, "-p", "ActiveState", "--value"], capture_output=True, text=True)
        if status.returncode != 0 or status.stdout.strip() in ("failed", "inactive"):
            print(f"beelink-gate: {directory.name} stopped without an exit receipt; TEMPFAIL 75", file=sys.stderr)
            sys.exit(75)
        started = time.monotonic()
    time.sleep(0.2)
PY
}
job_result_remote() {
  local dir code
  dir=$(job_dir_for "$1")
  [ -f "$dir/exit" ] && [ ! -L "$dir/exit" ] || return 1
  code=$(cat "$dir/exit") || return 1
  [[ "$code" =~ ^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$ ]] || return 1
  printf '%s\n' "$code"
}
