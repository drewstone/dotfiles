#!/usr/bin/env bash
# Associative arrays below require Bash 4+. macOS's system Bash 3.2 otherwise
# fails during initialization before validating the request, which can look like
# a successful gate to callers that do not enable errexit. Re-exec an installed
# compatible Bash so callers using the normal CLI keep working without a new install.
bash_major=0
if [ -n "${BASH_VERSION:-}" ]; then bash_major=${BASH_VERSION%%.*}; fi
case "$bash_major" in ''|*[!0-9]*) bash_major=0 ;; esac
if [ "$bash_major" -lt 4 ]; then
  compatible_bash=
  path_bash=$(command -v bash 2>/dev/null || true)
  for bash_candidate in "$path_bash" /opt/homebrew/bin/bash /usr/local/bin/bash /opt/local/bin/bash; do
    [ -n "$bash_candidate" ] && [ -x "$bash_candidate" ] || continue
    if "$bash_candidate" -c "test \"\${BASH_VERSINFO[0]}\" -ge 4" >/dev/null 2>&1; then
      compatible_bash=$bash_candidate
      break
    fi
  done
  if [ -n "$compatible_bash" ]; then
    exec "$compatible_bash" "$0" "$@"
  fi
  echo "beelink-gate: requires Bash 4 or newer; no compatible Bash was found on PATH or in standard macOS locations" >&2
  exit 2
fi
# shellcheck disable=SC2317 # receipt, finish and signal handlers run through traps.
# Gate a pushed revision in a locked Beelink cache; see README.md for the full contract.
# Usage: beelink-gate [--no-install|--light|--dev] [--branch NAME] [--merge PR]
#                    [--urgent] [--pin-host] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
#        beelink-gate --ship <beelink1|beelink2|auto> <repo-url> <sha>
#        beelink-gate --attach <gate-id>
#        beelink-gate --receipt <repo-url> <sha>
#        beelink-gate --report [hours] [--json] [--since timestamp]
# --cancel-on-term cancels an exact submitted gate; --retry MINUTES retries TEMPFAIL.
# --light is dependency/browser free and capped at120 command core-seconds and10minutes.
# --dev has separate checkout/slots at low priority; gate the final head without it.
# --ship runs the release owner's scripts/ship.sh verify with the repository's Node.
# Each gate keeps its checkout locked through install and command under one hold budget.
# Managed system units contain every gate; host PSI some avg10 admits all classes.
# Host update windows, disk floors, checkout locks and slots always apply.
# Exit: the command status,2 for invalid requests/cache,75 for an unconfirmed result,
# or128+signal for an explicit frontend stop. Transport loss never cancels a job.
set -uo pipefail
die() { echo "beelink-gate: $*" >&2; exit 2; }
TEMPFAIL=75

# Resolve installed symlinks here; staging replaces this block with the helper
# and source helper so submitted gates depend only on their immutable source file.
# BEELINK_GATE_INSTALLER_START
gate_source_root=$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}") || exit $?
gate_installer_source="$gate_source_root/beelink-gate-lib/install.sh"
gate_staging_source="$gate_source_root/beelink-gate-lib/source.sh"
gate_cache_source="$gate_source_root/beelink-gate-lib/cache.sh"
gate_admission_source="$gate_source_root/beelink-gate-lib/admission.sh"
gate_resources_source="$gate_source_root/beelink-gate-lib/resources.sh"
gate_jobs_source="$gate_source_root/beelink-gate-lib/jobs.sh"
gate_execution_source="$gate_source_root/beelink-gate-lib/execution.sh"
gate_placement_source="$gate_source_root/beelink-gate-lib/placement.sh"
gate_disk_source="$gate_source_root/beelink_gate_disk.py"
gate_release_source="$gate_source_root/beelink_gate_release.py"
gate_metrics_source="$gate_source_root/beelink_gate_metrics.py"
beelink_gate_metrics_source=$(cat "$gate_metrics_source") || exit $?
beelink_gate_release_source=$(cat "$gate_release_source") || exit $?
beelink_gate_disk_source=$(cat "$gate_disk_source") || exit $?
# shellcheck source=beelink-gate-lib/install.sh
. "$gate_installer_source" || exit $?
# shellcheck source=beelink-gate-lib/source.sh
. "$gate_staging_source" || exit $?
# shellcheck source=beelink-gate-lib/cache.sh
. "$gate_cache_source" || exit $?
# shellcheck source=beelink-gate-lib/admission.sh
. "$gate_admission_source" || exit $?
# shellcheck source=beelink-gate-lib/resources.sh
. "$gate_resources_source" || exit $?
# shellcheck source=beelink-gate-lib/jobs.sh
. "$gate_jobs_source" || exit $?
# shellcheck source=beelink-gate-lib/execution.sh
. "$gate_execution_source" || exit $?
# shellcheck source=beelink-gate-lib/placement.sh
. "$gate_placement_source" || exit $?
# BEELINK_GATE_INSTALLER_END


tempfail_line() { echo "beelink-gate: TEMPFAIL next_allowed=$1 $2" >&2; }
tempfail() { tempfail_line "$1" "$2"; exit "$TEMPFAIL"; }
utc_in_minutes() {
  python3 -c 'import datetime as d, sys; print((d.datetime.now(d.timezone.utc) + d.timedelta(minutes=int(sys.argv[1]))).strftime("%Y-%m-%dT%H:%M:%SZ"))' "$1"
}

decode() { printf '%s' "$1" | base64 --decode; }

# Older launchers can emit a newly deployed main file with an older helper list.
# A missing admission owner must refuse before any probe, reserve or cache work.
if [ "$(type -t admit_release_priority)" != function ] || [ -z "${beelink_gate_release_source:-}" ] || ! grep -qxF '# BEELINK_GATE_PHASE_SPANS_V1' <<< "${beelink_gate_metrics_source:-}" || [ "$(type -t verify_gate_unit)" != function ] || [ "$(type -t job_submit)" != function ] || [ "$(type -t job_attach_remote)" != function ] || [ "$(type -t job_result_remote)" != function ] || [ "$(type -t prepare_gate_turbo_cache)" != function ] || [ "$(type -t release_gate_turbo_cache)" != function ] || [ "$(type -t gate_turbo_node_cache)" != function ] || [ "${gate_shared_turbo_install:-}" != 1 ] || [ "$(type -t admission_begin)" != function ] || [ "$(type -t initial_disk_admission)" != function ] || ! grep -qxF '# BEELINK_GATE_ADMISSION_TIMING_V1' <<< "${beelink_gate_metrics_source:-}" || [ "$(type -t frontend_start)" != function ] || ! grep -qxF '# BEELINK_GATE_FRONTEND_TIMING_V1' <<< "${beelink_gate_metrics_source:-}" || [ "$(type -t probe_transport)" != function ] || [ "$(type -t probe_of)" != function ] || [ "$(type -t remote_gate)" != function ] || [ "$(type -t execute_gate_checkout)" != function ] || [ "$(type -t reserve_checkout)" != function ]; then
  tempfail "$(utc_in_minutes 5)" "complete gate source unavailable; use the maintained gate launcher"
fi

gate_disk() { python3 -c "$beelink_gate_disk_source" "$@"; }

# Admission ends early for a placement that may move: the remote gate gives the host back (exit 76, which
# only the launcher sees) and the launcher places the gate again. Nothing is checked out before admission.

# A waiting gate leaves a ticket named <prefix>.<enqueued epoch>.<pid>. A free
# checkout goes to the oldest live ticket, not to whichever gate polls first: on
# 2026-10-12 an ADC gate waited 2,290 s on beelink1 while later gates took each
# checkout as it freed. The epoch is the gate's first enqueue, carried across
# re-placements through BEELINK_GATE_PLACED_WAIT, so moving hosts keeps its place.
# A ticket or marker names its gate's pid, and kill -0 alone also answers for
# a later process that reused that pid after the gate was killed or the host
# rebooted; such a stale ticket would hold a checkout until that process exits.
# Its owner is live only if the process started no later than the file was written.

declare -A BEELINK_IPS=([beelink1]=100.98.195.7 [beelink2]=100.127.22.51)
SSH_OPTIONS=(-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=10)
REG_EXE=${BEELINK_GATE_REG:-/mnt/c/Windows/System32/reg.exe}
STATE_DIR="${BEELINK_GATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/beelink-gate}"

# Durations such as 45m, 90s, 2h or plain seconds.
seconds_of() {
  local value=$1
  case "$value" in
    *h) value=$(( ${value%h} * 3600 )) ;;
    *m) value=$(( ${value%m} * 60 )) ;;
    *s) value=${value%s} ;;
  esac
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
  echo "$value"
}

# Sets host, owner and repo from a Git URL; they are cache path components.
parse_repo_url() {
  local url=$1 key
  if [[ "$url" =~ ^git@([A-Za-z0-9.-]+):([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[1]}"; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  elif [[ "$url" =~ ^(https|ssh)://(git@)?([A-Za-z0-9.-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[3]}"; owner="${BASH_REMATCH[4]}"; repo="${BASH_REMATCH[5]}"
  elif [[ "$url" =~ ^file:///([A-Za-z0-9_./-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host=local; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  else
    die "expected a Git URL ending in owner/repo[.git]"
  fi
  repo="${repo%.git}"
  for key in "$host" "$owner" "$repo"; do
    if [ "$key" = . ] || [ "$key" = .. ] || [[ "$key" = -* ]]; then die "unsafe repository path"; fi
  done
}

# A branch name the gate may check out: Git's own rules, plus no leading dash.
valid_branch_name() {
  [[ "$1" =~ ^[A-Za-z0-9._/-]{1,200}$ && "$1" != -* ]] && git check-ref-format --branch "$1" >/dev/null 2>&1
}

if [ "${1:-}" = --window-probe ]; then
  shift
  check_update_window "$@"
  exit $?
fi
if [ "${1:-}" = --remote ]; then
  shift; [ "${1:-}" != --args-file ] || { mapfile -d '' -t gate_args < "$2" && set -- "${gate_args[@]}"; } || die "unreadable gate args file"
  remote_gate "$@"
fi
if [ "${1:-}" = --job-submit ]; then
  [ "$#" -ge 2 ] || die "invalid job submission"
  id=$2; shift 2
  job_submit "$id" "$@"
  exit $?
fi
if [ "${1:-}" = --job-attach ]; then
  [ "$#" = 2 ] || die "invalid job attach"
  job_attach_remote "$2"
  exit $?
fi
if [ "${1:-}" = --job-cancel ]; then
  [ "$#" = 2 ] || die "invalid job cancellation"
  job_cancel_remote "$2"
  exit $?
fi
if [ "${1:-}" = --job-result ]; then
  [ "$#" = 2 ] || die "invalid job result"
  job_result_remote "$2"
  exit $?
fi
# This host's newest install reserve for one checkout shape, for the other beelink.
if [ "${1:-}" = --reserve-match ]; then
  [ "$#" = 4 ] || die "invalid reserve query"
  parse_repo_url "$(decode "$3")"
  last_install_reserve_bytes "$(decode "$2")" "$host/$owner/$repo" install "$(decode "$4")" "" "" cold match-only | sed 's/^/beelink-gate-reserve /'
  exit $?
fi
if [ "${1:-}" = --probe ]; then
  shift
  remote_probe "$@"
  exit $?
fi
# The beelink's receipts, for --report.
if [ "${1:-}" = --receipts ]; then
  cat "$STATE_DIR/receipts.jsonl" 2>/dev/null || exit 75
  if [ -n "${3:-}" ]; then
    BEELINK_GATE_RELEASE_STATE="$STATE_DIR/release-priority.json" BEELINK_GATE_ADMISSION_SAMPLE="$(host_psi_admission || echo '{"mode":"host_psi","held":true,"reason":"unavailable"}')" python3 -c "$(decode "$3")" || echo '{"kind":"host_cpu_sample","error":"CPU sample unavailable"}'
  fi
  retained_admission_observations "${2:-48}"
  exit $?
fi

# ---- launcher: runs on the Mac, GTR or a beelink ----

# The beelink this launcher runs on, if any.

SELF=$(self_beelink)
# Each beelink's newest install reserve for the gated commit's checkout shape;
# a gate on one host falls back to the other's.
declare -A matched_reserve=() matched_warm_reserve=()

# Connection timeouts and SSH keepalives do not bound a hung WSL command.
# Only short control calls use this deadline; submitted gates keep their hold.
TRANSPORT_TIMEOUT_SECONDS=30
TRANSPORT_KILL_GRACE_SECONDS=2
# Staging writes the whole gate script through a fresh WSL session, which starts slowly
# on a loaded host: at load 120 on 16 cores, beelink1 staging passed 30 s
# (ci-zero Braid #173) and the gate gave up before submitting. The checkout reservation
# below waits as long for the same reason (pr-closer gateway #65 lost its place at 30 s).
STAGE_TIMEOUT_SECONDS=${BEELINK_GATE_STAGE_TIMEOUT:-120}

if [ "${1:-}" = --disk-floor-bytes ]; then
  disk_floor_query "$@"; exit $?
fi


if [ "${1:-}" = --urgent-reserve ]; then
  { [ "$#" = 4 ] || [ "$#" = 7 ]; } || die "invalid checkout reservation"
  reserve_checkout "${@:2}"
  exit 0
fi

# --receipt <repo-url> <sha>: every receipt both beelinks hold for that repo and
# SHA, one JSON line each with its gate_id and the host it came from ("from").
# gh-drew reads this before it merges a release-path PR, so a merge rests on the
# gate's own receipt, never on a wrapper's exit code: a lane script
# recorded exit=0 for gate beelink2-b1b7743870eff2dc7da8260d77e65fcd, whose
# receipt says exit=1, and discovery-lab#2009 merged on it. Exit 0 with rows,
# 1 with none, 75 when a beelink cannot be read and the others hold no row (a partial read is never "none").
# Rows from the beelinks that answered still print with exit 0: a passing receipt is enough, and on
# 2026-10-18 beelink2 offline for hours made every discovery-lab merge refuse despite beelink1 receipts.
if [ "${1:-}" = --receipt ]; then
  [ "$#" = 3 ] && [[ "$3" =~ ^[0-9a-f]{40}$ ]] || die "usage: beelink-gate --receipt <repo-url> <sha (40 hex)>"
  key=$(python3 -c 'import re,sys; u=sys.argv[1]; m=re.match(r"^(?:git@([^:]+):|ssh://git@([^/]+)/|https?://([^/]+)/)(.+?)(?:\.git)?/?$", u); print(f"{m.group(1) or m.group(2) or m.group(3)}/{m.group(4)}" if m else "")' "$2")
  [ -n "$key" ] || die "--receipt: cannot read a host/owner/repo from $2"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  host_rows=$(mktemp) found=$(mktemp) unread=""
  for host in beelink1 beelink2; do
    if heartbeat=0 on_beelink "$host" --receipts 720 > "$host_rows" 2>/dev/null \
      || { sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"; heartbeat=0 on_beelink "$host" --receipts 720 > "$host_rows" 2>/dev/null; }; then
      python3 - "$host_rows" "$host" "$key" "$3" >> "$found" <<'PY'
import json, sys
path, host, key, sha = sys.argv[1:]
for line in open(path, errors="replace"):
    try:
        row = json.loads(line)
    except ValueError:
        continue
    if row.get("repo") == key and row.get("sha") == sha:
        print(json.dumps({"from": host, **row}))
PY
    else
      echo "beelink-gate: --receipt could not read $host's receipts" >&2
      unread="$unread $host"
    fi
  done
  cat "$found"
  if [ -s "$found" ]; then rc=0; elif [ -n "$unread" ]; then rc=$TEMPFAIL; else rc=1; fi
  # Name what was read, so a refusal is not mistaken for the down host's fault:
  # agent-runtime#1832 refused with only "could not read beelink2" while beelink1 held no receipt either.
  # Only with a host unread: gh-drew reads any stderr here as "a beelink was not read".
  if [ ! -s "$found" ] && [ -n "$unread" ]; then
    read_hosts=$(for host in beelink1 beelink2; do [[ " $unread " == *" $host "* ]] || printf '%s ' "$host"; done)
    echo "beelink-gate: --receipt found no receipt for $3 on ${read_hosts:-no reachable beelink}(unknown:$unread)" >&2
  fi
  rm -f "$host_rows" "$found"
  exit "$rc"
fi

# --report [hours]: gate runs per merged PR by repo, from both beelinks' receipts
# and GitHub's merged-PR counts, with each repo's modes, exit classes and
# exact-input repeats (same SHA, mode and command), to tell rework from re-runs.
if [ "${1:-}" = --report ]; then
  shift
  hours=24 report_format="" report_since=""
  if [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then hours=$1; shift; fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) report_format=--json; shift ;;
      --since) [ "$#" -ge 2 ] || die "--since needs a UTC timestamp"; report_since=$2; shift 2 ;;
      *) die "usage: beelink-gate --report [hours] [--json] [--since timestamp]" ;;
    esac
  done
  report_dir=$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")
  cpu_source=$(encode "$(cat "$report_dir/beelink_gate_cpu.py")") || die "cannot load CPU sampler"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  receipts_file=$(mktemp) host_rows=$(mktemp) missing=""
  for host in beelink1 beelink2; do
    # One retry, then a loud partial: one dropped B1 read silently
    # turned a 352-run window into a B2-only 115 runs at 1.0 runs per merged PR.
    if heartbeat=0 on_beelink "$host" --receipts "$hours" "$cpu_source" > "$host_rows" 2>/dev/null \
      || { sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"; heartbeat=0 on_beelink "$host" --receipts "$hours" "$cpu_source" > "$host_rows" 2>/dev/null; }; then
      sed "s/^{/{\"from\": \"$host\", /" "$host_rows" >> "$receipts_file"
    else
      echo "beelink-gate: --report could not read $host's receipts" >&2
      missing+="${missing:+,}$host"
    fi
  done
  rm -f "$host_rows"
  frontend_local_records "$hours" >> "$receipts_file"
  merged_lookup=$(command -v gh-drew || command -v gh || true)
  report_module=$report_dir/beelink_gate_report.py
  python3 "$report_module" "$receipts_file" "$hours" "$merged_lookup" "$missing" "$report_format" "$report_since"
  status=$?
  rm -f "$receipts_file"
  exit "$status"
fi

# The same cancellation flag applies to an explicit reconnect. Its exact leaf
# is the supplied ID; an ordinary lost reconnect never requests cancellation.
if [ "${1:-}" = --cancel-on-term ] && [ "${2:-}" = --attach ]; then
  cancel_on_term=1
  shift
fi
# Remote/control/read-only paths above never create a launcher observation.
[ "${1:-}" = --cancel-job ] || frontend_start
if [ "${1:-}" = --attach ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "usage: beelink-gate --attach <gate-id>"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  frontend_record placement attached "$2" attach
  frontend_phase attach
  frontend_cancel_gate=$2
  heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$2"
  rc=$?
  resolve_attachment_exit "$target" "$2" "$rc"
  frontend_record placement returned "$2" attach "$rc"
  exit "$rc"
fi
if [ "${1:-}" = --cancel-job ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "invalid cancellation id"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  # A manager's cgroup can vanish immediately after scheduling this unit.
  # Limit the existing retry loop to five elapsed minutes. Never
  # start a call or sleep unless its full transport bound still fits.
  cancel_deadline=$((SECONDS + 300))
  cancel_call_bound=$((TRANSPORT_TIMEOUT_SECONDS + TRANSPORT_KILL_GRACE_SECONDS))
  for ((attempt=0; attempt<60 && SECONDS + cancel_call_bound <= cancel_deadline; attempt++)); do
    heartbeat=0 on_beelink "$target" --job-cancel "$2"
    cancel_status=$?
    case "$cancel_status" in
      0) exit 0 ;;
      130|143)
        echo "beelink-gate: cancellation unconfirmed for $2; cancellation transport interrupted, remote state unknown" >&2
        exit "$cancel_status"
        ;;
    esac
    (( SECONDS + 5 + cancel_call_bound <= cancel_deadline )) || break
    sleep 5
  done
  tempfail "$(utc_in_minutes 5)" "cancellation unconfirmed for $2; remote gate may still be running under its existing hold; retry beelink-gate --cancel-job $2"
fi

# --merge PR: after a green gate, `gh-drew pr merge PR -R owner/repo --squash
# --match-head-commit SHA`, so the merge lands exactly the commit the gate ran.
# gh-drew owns the merge preconditions (merge-on-green's hold, unanswered review
# threads, a running Codex review), so they are not repeated here. Lanes had
# each written a wait-for-gate-then-merge script (graph-canary flow.sh and
# merge-1818.sh). A red or TEMPFAIL gate never merges; a merge
# gh-drew refuses exits MERGE_REFUSED with its reason.
MERGE_REFUSED=78
merge_pr="" merge_repo="" merge_sha=""

# The source owner runs retry/summary wrappers and retains their one request scope.
install_mode=install gate_branch="" gate_class="" pin_host=0 cancel_on_term=${cancel_on_term:-0} retry_minutes="" summary=0
launch_options=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --retry) [[ "${2:-}" =~ ^[1-9][0-9]{0,3}$ ]] && (( 10#$2 <= 1440 )) || die "--retry needs whole minutes from 1 to 1440"
      retry_minutes=$((10#$2)); shift 2; continue ;;
    --summary) summary=1; shift; continue ;;
    --merge) [[ "${2:-}" =~ ^[1-9][0-9]{0,8}$ ]] || die "--merge needs a pull request number"
      merge_pr=$2; shift 2; continue ;;
    --urgent|--pin-host|--cancel-on-term|--no-install|--light|--dev|--ship) launch_options+=("$1") ;;
    --branch) launch_options+=("$1" "${2:-}") ;;
  esac
  case "$1" in
    --urgent) export BEELINK_GATE_URGENT=1; shift ;;
    --pin-host) pin_host=1; shift ;;
    --cancel-on-term) cancel_on_term=1; shift ;;
    --no-install) [ "$install_mode" = light ] || install_mode=no-install; shift ;;
    --light) [ "$install_mode" != ship ] || die "--light cannot be combined with --ship"; install_mode=light; shift ;;
    --dev) gate_class=dev; shift ;;
    --ship) [ "$install_mode" != light ] || die "--light cannot be combined with --ship"; install_mode=ship; shift ;;
    --branch) [ "$#" -ge 2 ] || die "--branch needs a branch name"
      valid_branch_name "$2" || die "invalid --branch: $2"
      gate_branch=$2; shift 2 ;;
    *) break ;;
  esac
done
usage="usage: beelink-gate [--no-install|--light|--dev] [--urgent] [--pin-host] [--cancel-on-term] [--branch <name>] [--retry <minutes>] [--summary] [--merge <pr>] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
       beelink-gate --ship [--retry <minutes>] [--summary] <beelink1|beelink2|auto> <repo-url> <sha>"
if [ "$gate_class" = dev ]; then
  case "$install_mode" in ship|light) die "--dev cannot be combined with --$install_mode" ;; esac
fi
if [ -n "${BEELINK_GATE_RETRY_SECONDS:-}" ] && [[ ! "$BEELINK_GATE_RETRY_SECONDS" =~ ^[1-9][0-9]{0,4}$ ]]; then
  die "invalid BEELINK_GATE_RETRY_SECONDS: $BEELINK_GATE_RETRY_SECONDS"
fi
if [ -n "$merge_pr" ]; then
  [ "$gate_class" != dev ] || die "--merge cannot be combined with --dev: a dev gate is not the merge gate; gate the final head without --dev"
  [ "$install_mode" != ship ] || die "--merge cannot be combined with --ship"
  { [ "$#" -ge 5 ] && [ "$4" = -- ]; } || die "$usage"
  merge_repo=$(github_repo "$2") || die "--merge needs a GitHub repo URL, not $2"
  merge_sha=$3
fi
if [ -n "$retry_minutes" ] || [ "$summary" = 1 ] || [ -n "$merge_pr" ]; then
  run_wrapped "$retry_minutes" "$summary" ${launch_options[@]+"${launch_options[@]}"} "$@"
fi
if [ "$install_mode" = ship ]; then
  [ "$#" -eq 3 ] || die "$usage"
  set -- "$1" "$2" "$3" -- bash scripts/ship.sh verify
fi
if [ "$#" -lt 5 ] || [ "$4" != -- ]; then
  die "$usage"
fi
target=$1 repo_url=$2 sha=$3
if [ "$pin_host" = 1 ] && [ "$target" = auto ]; then die "--pin-host requires a named beelink"; fi
shift 4
# agent-container stopped merging on a local signoff (agent-dev-container
# #10892): its PRs merge on green CI and develop runs the full suite after merge. Sessions
# that loaded the old rule kept holding Beelink slots the CI runners on the same hosts need.
if [[ "$repo_url" =~ tangle-network/agent-(dev-)?container(\.git)?$ ]] && [ "$gate_class" != dev ] \
  && [[ " $* " =~ [[:space:]/](signoff(\.sh)?|revision-receipt\.mjs)[[:space:]] ]]; then
  die "agent-container no longer merges on a local signoff. Push and stop: merge-on-green merges the PR once Fast Checks, Build and Type Check pass, and develop runs the full suite after merge (agent-dev-container docs/processes/shipping.md). For an iterative run of affected tests use --dev."
fi
if [ -n "${BEELINK_GATE_MAX_CONCURRENT:-}" ]; then
  [[ "$BEELINK_GATE_MAX_CONCURRENT" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_MAX_CONCURRENT"
fi
if [ -n "${BEELINK_GATE_MAX_CPU_PRESSURE:-}" ]; then
  max_cpu_pressure >/dev/null
fi
if [ -n "${BEELINK_GATE_STARVE_AFTER:-}" ]; then
  seconds_of "$BEELINK_GATE_STARVE_AFTER" >/dev/null || die "invalid BEELINK_GATE_STARVE_AFTER: $BEELINK_GATE_STARVE_AFTER"
fi
if [ -n "${BEELINK_GATE_LOAD_WAIT:-}" ]; then
  seconds_of "$BEELINK_GATE_LOAD_WAIT" >/dev/null || die "invalid BEELINK_GATE_LOAD_WAIT: $BEELINK_GATE_LOAD_WAIT"
fi
[[ "$sha" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || die "SHA must be a full commit ID"
[[ -z "${BEELINK_GATE_PR:-}" || "${BEELINK_GATE_PR:-}" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_PR"
if [ -z "${BEELINK_GATE_LANE:-}" ]; then
  BEELINK_GATE_LANE=${FLEET_LANE:-}
  if [ -z "$BEELINK_GATE_LANE" ] && [[ "${FLEET_STATUS_FILE:-}" =~ /([^/]+)--([^/]+)\.md$ ]]; then
    BEELINK_GATE_LANE="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
  fi
fi
[[ "$BEELINK_GATE_LANE" =~ ^[A-Za-z0-9._:-]{0,128}$ ]] || die "invalid gate lane"
export BEELINK_GATE_LANE
unset BEELINK_GATE_RESERVATION_TOKEN
launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
frontend_key=$(parse_repo_url "$repo_url"; printf '%s/%s/%s' "$host" "$owner" "$repo")
frontend_record metadata "$frontend_key" "$sha" "${gate_class:-$([ "$install_mode" = light ] && echo light || echo normal)}"
frontend_phase reserve_lookup
BEELINK_GATE_SPARSE_SPEC=""
case "$install_mode" in
  install|ship)
    frontend_capture BEELINK_GATE_SPARSE_SPEC commit_sparse_spec "$repo_url" "$sha" || BEELINK_GATE_SPARSE_SPEC=""
    if [ -n "$BEELINK_GATE_SPARSE_SPEC" ]; then
      for reserve_host in beelink1 beelink2; do
        heartbeat=0 frontend_capture reserve_lines on_beelink "$reserve_host" --reserve-match "$(encode "$reserve_host")" "$(encode "$repo_url")" "$(encode "$BEELINK_GATE_SPARSE_SPEC")"
        reserve_status=$?
        case "$reserve_status" in
          0) ;;
          130|143) exit "$reserve_status" ;;
          *)
            echo "beelink-gate: optional install reserve hint unavailable on $reserve_host (read exit $reserve_status); target admission still reads its own receipts and enforces its disk floor" >&2
            continue
            ;;
        esac
        matched_reserve[$reserve_host]=$(sed -n 's/^beelink-gate-reserve cold \([0-9]*\)$/\1/p' <<<"$reserve_lines" | tail -1)
        matched_warm_reserve[$reserve_host]=$(sed -n 's/^beelink-gate-reserve warm \([0-9]*\)$/\1/p' <<<"$reserve_lines" | tail -1)
      done
    fi
    ;;
esac
export BEELINK_GATE_SPARSE_SPEC
requested=$target admit_wait_launch="" placed_wait_launch=0
# An --urgent gate stays on the first host auto places it on: giving the host
# back drops its urgent marker and with it its place ahead of every normal gate.
# An urgent fix for a red ADC develop (#10345) was re-placed for
# 1413 s while normal gates re-took the checkout each time it let go.
if [ "$requested" = auto ] && [ "${BEELINK_GATE_URGENT:-0}" != 1 ]; then
  admit_wait_launch=$(seconds_of "${BEELINK_GATE_REPLACE_WAIT:-60s}") || die "invalid BEELINK_GATE_REPLACE_WAIT: ${BEELINK_GATE_REPLACE_WAIT:-}"
fi
starve_after_launch=$(seconds_of "${BEELINK_GATE_STARVE_AFTER:-10m}") || die "invalid BEELINK_GATE_STARVE_AFTER: ${BEELINK_GATE_STARVE_AFTER:-}"
if [ "$requested" = auto ]; then
  frontend_phase reservation_setup
  if [ "${BEELINK_GATE_URGENT:-0}" = 1 ]; then
    start_checkout_reservations
  else
    reservation_epoch=$(date +%s)
    reservation_token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    export BEELINK_GATE_RESERVATION_TOKEN=$reservation_token
    start_checkout_reservations normal
  fi
fi
launched=$SECONDS placements=0
while :; do
  frontend_phase placement_probe_wait
  frontend_select || exit $?
  encoded=()
  for arg in "$target" "$repo_url" "$sha" "$install_mode" "$window_day" "$window_hour" "$@"; do
    encoded+=("$(encode "$arg")")
  done
  placed_wait_launch=$((SECONDS - launched))
  # A gate past the starvation backstop keeps its checkout queue place on this host.
  # --dev has no starvation backstop and continues moving between hosts.
  if [ -n "$admit_wait_launch" ] && [ "${gate_class:-}" != dev ] && (( placed_wait_launch >= starve_after_launch )); then
    admit_wait_launch=""
    echo "beelink-gate: waited ${placed_wait_launch}s across placements; staying on $target in its place in line" >&2
  fi
  gate_id="$target-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  frontend_cancel_gate=$gate_id
  echo "beelink-gate: gate_id=$gate_id; reconnect with beelink-gate --attach $gate_id" >&2
  frontend_record placement allocated "$gate_id"
  frontend_phase stage
  frontend_record snapshot
  run_cancelable stage_job "$target" "$gate_id" || tempfail "$(utc_in_minutes 5)" "staging unconfirmed for $gate_id on $target; submission not attempted, remote staging may be partial"
  frontend_record placement staged "$gate_id"
  frontend_phase submit
  frontend_record placement submission_unknown "$gate_id"
  submit_bytes="$(printf '%s ' "${encoded[@]}" | wc -c | tr -d ' ') bytes of encoded arguments"
  submit_err=$(mktemp) || die "cannot create a temporary file"
  BEELINK_GATE_ID="$gate_id" heartbeat=0 run_cancelable on_beelink "$target" --job-submit "$gate_id" "${encoded[@]}" 2>"$submit_err"
  rc=$?
  cat "$submit_err" >&2
  if [ "$rc" = 255 ] && grep -q "exec request failed" "$submit_err"; then
    rm -f "$submit_err"
    die "$target refused the SSH exec request for $gate_id ($submit_bytes); no gate was submitted, and retrying the same command fails the same way"
  fi
  rm -f "$submit_err"
  case "$rc" in
    129|130|137|141|143|255)
      tempfail "$(utc_in_minutes 1)" "submit transport unconfirmed for $gate_id ($submit_bytes); run beelink-gate --attach $gate_id before retrying" ;;
  esac
  [ "$rc" = 0 ] || exit "$rc"
  frontend_record placement submitted "$gate_id"
  frontend_phase attach
  # Preserve the original FIFO place until this exact placement passes its
  # final reversible guard, including both post-fetch disk-floor checks.
  if [ -n "$checkout_reservation_dir" ]; then
    admission_log="$checkout_reservation_dir/admission.log"
    : > "$admission_log"
    start_frontend_group watch_checkout_admission "$admission_log" "$gate_id"
    checkout_monitor_pid=$frontend_spawned_pid
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id" 2> >(tee "$admission_log" >&2)
    rc=$?
    stop_frontend_group "$checkout_monitor_pid" || frontend_tainted=1
    checkout_monitor_pid=""
  else
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id"
    rc=$?
  fi
  resolve_attachment_exit "$target" "$gate_id" "$rc"
  frontend_record placement "$([ "$rc" = "$NOT_ADMITTED" ] && echo not_admitted || echo returned)" "$gate_id" "" "$rc"
  # Only an auto placement may move; a named host keeps waiting there, as it always has.
  [ "$rc" = "$NOT_ADMITTED" ] && [ "$requested" = auto ] || exit "$rc"
  placements=$((placements + 1))
  echo "beelink-gate: placement $placements on $target gave the host back after waiting; probing both again" >&2
done
# BEELINK_GATE_SOURCE_END
