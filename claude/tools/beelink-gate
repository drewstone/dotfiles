# The beelink this launcher runs on, if any.
self_beelink() {
  [ -x "$REG_EXE" ] || return 0
  case "${BEELINK_GATE_SELF:-$(hostname)}" in
    beelink1|DESKTOP-18IR33V) echo beelink1 ;;
    beelink2) echo beelink2 ;;
  esac
}
SELF=$(self_beelink)

# Runs this script with arguments on a beelink: locally on itself, else in WSL
# over SSH. stdin carries the script (SSH) and then stays open as the heartbeat.
on_beelink() {
  local target=$1; shift
  local -a envs=("BEELINK_GATE_LAUNCHER=$launcher_name")
  [ -z "${BEELINK_GATE_MAX_HOLD:-}" ] || envs+=("BEELINK_GATE_MAX_HOLD=$BEELINK_GATE_MAX_HOLD")
  [ -z "${gate_branch:-}" ] || envs+=("BEELINK_GATE_BRANCH=$gate_branch")
  [ -z "${BEELINK_GATE_LOAD_WAIT:-}" ] || envs+=("BEELINK_GATE_LOAD_WAIT=$BEELINK_GATE_LOAD_WAIT")
  [ -z "${BEELINK_GATE_CACHE_MAX_BYTES:-}" ] || envs+=("BEELINK_GATE_CACHE_MAX_BYTES=$BEELINK_GATE_CACHE_MAX_BYTES")
  [ -z "${BEELINK_GATE_MAX_CPU_PRESSURE:-}" ] || envs+=("BEELINK_GATE_MAX_CPU_PRESSURE=$BEELINK_GATE_MAX_CPU_PRESSURE")
  [ -z "${BEELINK_GATE_HOST_PRESSURE_CEILING:-}" ] || envs+=("BEELINK_GATE_HOST_PRESSURE_CEILING=$BEELINK_GATE_HOST_PRESSURE_CEILING")
  [ -z "${BEELINK_GATE_STARVE_AFTER:-}" ] || envs+=("BEELINK_GATE_STARVE_AFTER=$BEELINK_GATE_STARVE_AFTER")
  [ "${gate_class:-}" != dev ] || envs+=("BEELINK_GATE_CLASS=dev")
  [ -z "${BEELINK_GATE_SHIP_WORKERS:-}" ] || envs+=("BEELINK_GATE_SHIP_WORKERS=$BEELINK_GATE_SHIP_WORKERS")
  [[ "${BEELINK_GATE_PR:-}" =~ ^[0-9]+$ ]] && envs+=("BEELINK_GATE_PR=$BEELINK_GATE_PR")
  [ -z "${BEELINK_GATE_LANE:-}" ] || envs+=("BEELINK_GATE_LANE=$BEELINK_GATE_LANE")
  [ -z "${BEELINK_GATE_RESERVATION_TOKEN:-}" ] || envs+=("BEELINK_GATE_RESERVATION_TOKEN=$BEELINK_GATE_RESERVATION_TOKEN")
  [ -z "${BEELINK_GATE_MAX_CONCURRENT:-}" ] || envs+=("BEELINK_GATE_MAX_CONCURRENT=$BEELINK_GATE_MAX_CONCURRENT")
  [ -z "${BEELINK_GATE_REPO_CHECKOUTS:-}" ] || envs+=("BEELINK_GATE_REPO_CHECKOUTS=$BEELINK_GATE_REPO_CHECKOUTS")
  [ -z "${BEELINK_GATE_LIGHT_CPU:-}" ] || envs+=("BEELINK_GATE_LIGHT_CPU=$BEELINK_GATE_LIGHT_CPU")
  [ -z "${BEELINK_GATE_LIGHT_SLOTS:-}" ] || envs+=("BEELINK_GATE_LIGHT_SLOTS=$BEELINK_GATE_LIGHT_SLOTS")
  [ "${BEELINK_GATE_URGENT:-0}" != 1 ] || envs+=("BEELINK_GATE_URGENT=1")
  [ -z "${BEELINK_GATE_ID:-}" ] || envs+=("BEELINK_GATE_ID=$BEELINK_GATE_ID")
  [ "${requested:-}" != auto ] || envs+=("BEELINK_GATE_AUTO=1")
  [ -z "${admit_wait_launch:-}" ] || envs+=("BEELINK_GATE_ADMIT_WAIT=$admit_wait_launch")
  # The wait so far rides along even when the gate may no longer move, so it keeps its
  # age in the checkout queue and its starvation clock.
  (( ${placed_wait_launch:-0} == 0 )) || envs+=("BEELINK_GATE_PLACED_WAIT=$placed_wait_launch")
  [ "${heartbeat:-0}" = 1 ] && envs+=("BEELINK_GATE_HEARTBEAT=1")
  local me=$$ rc heartbeat_fd heartbeat_pid command_pid
  heartbeat_input() {
    local sleeper="" include_script=${1:-0}
    trap 'if [ -n "$sleeper" ]; then kill -TERM "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; fi; exit 0' TERM INT
    [ "$include_script" = 1 ] && cat "$0"
    while kill -0 "$me" 2>/dev/null && { [ -z "${BEELINK_GATE_HEARTBEAT_STOP:-}" ] || [ ! -e "$BEELINK_GATE_HEARTBEAT_STOP" ]; }; do
      sleep 5 & sleeper=$!
      wait "$sleeper" || true
      sleeper=""
    done
  }
  stop_heartbeat() {
    kill -TERM "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true
    exec {heartbeat_fd}<&-
  }
  if [ "$target" = "$SELF" ] && [ "${heartbeat:-0}" = 1 ]; then
    exec {heartbeat_fd}< <(heartbeat_input)
    heartbeat_pid=$!
    env "${envs[@]}" bash "$0" "$@" <&"$heartbeat_fd" &
    command_pid=$!
    wait "$command_pid"; rc=$?
    stop_heartbeat
  elif [ "$target" = "$SELF" ]; then
    env "${envs[@]}" bash "$0" "$@" </dev/null
    rc=$?
  elif [ "${heartbeat:-0}" = 1 ]; then
    exec {heartbeat_fd}< <(heartbeat_input 1)
    heartbeat_pid=$!
    ssh "${SSH_OPTIONS[@]}" "${BEELINK_IPS[$target]}" wsl.exe -- env "${envs[@]}" bash -s -- "$@" <&"$heartbeat_fd" &
    command_pid=$!
    wait "$command_pid"; rc=$?
    stop_heartbeat
  else
    ssh "${SSH_OPTIONS[@]}" "${BEELINK_IPS[$target]}" wsl.exe -- env "${envs[@]}" bash -s -- "$@" \
      < <(cat "$0")
    rc=$?
  fi
  return "$rc"
}

stage_job() {
  local target=$1 id=$2 dir marker
  dir="$STATE_DIR/jobs/$id"
  if [ "$target" = "$SELF" ]; then
    mkdir -p "$STATE_DIR/jobs" && mkdir -m 700 "$dir" || return 1
    cp -- "$0" "$dir/gate.sh" && chmod 700 "$dir/gate.sh"
    return $?
  fi
  marker="__BEELINK_GATE_SOURCE_${id//-/_}__"
  {
    printf 'id=%q\n' "$id"
    cat <<'BOOT'
set -euo pipefail
umask 077
root="${BEELINK_GATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/beelink-gate}/jobs"
mkdir -p "$root"
dir="$root/$id"
mkdir -m 700 "$dir"
BOOT
    printf "cat > \"\$dir/gate.sh\" <<'%s'\n" "$marker"
    cat "$0"
    printf '\n%s\nchmod 700 "$dir/gate.sh"\n' "$marker"
  } | ssh "${SSH_OPTIONS[@]}" "${BEELINK_IPS[$target]}" wsl.exe -- bash -s
}

# The policy rarely changes, so the last good read is kept per host. WSL interop
# (reg.exe) fails under load, and SSH can time out; a read up to seven days old
# still keeps gates out of the update window.
read_policy() {
  local target=$1 key='HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' policy="" cache
  cache="$STATE_DIR/policy-$target"
  if [ "$target" = "$SELF" ]; then
    policy=$(timeout 20 "$REG_EXE" query "$key" 2>/dev/null) || policy=""
  fi
  if ! grep -q ScheduledInstallDay <<<"$policy"; then
    policy=$(ssh "${SSH_OPTIONS[@]}" "${BEELINK_IPS[$target]}" reg query "$key" 2>/dev/null) || policy=""
  fi
  if grep -q ScheduledInstallDay <<<"$policy"; then
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$policy" > "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" 2>/dev/null
    printf '%s\n' "$policy"
    return 0
  fi
  if [ -f "$cache" ] && [ -n "$(find "$cache" -mmin -10080 2>/dev/null)" ]; then
    echo "beelink-gate: using the cached Windows Update policy for $target" >&2
    cat "$cache"
    return 0
  fi
  return 1
}

# Sets window_day and window_hour from the beelink's Windows Update policy.
update_window_of() {
  local target=$1 policy day_hex hour_hex
  policy=$(read_policy "$target") || { echo "beelink-gate: cannot read Windows Update schedule from $target; refusing to start" >&2; return 2; }
  policy=$(printf '%s' "$policy" | tr -d '\r')
  day_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallDay" && $2 == "REG_DWORD" {print $3}')
  hour_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallTime" && $2 == "REG_DWORD" {print $3}')
  [[ "$day_hex" =~ ^0x[0-9a-fA-F]{1,8}$ && "$hour_hex" =~ ^0x[0-9a-fA-F]{1,8}$ ]] \
    || { echo "beelink-gate: invalid Windows Update schedule from $target; refusing to start" >&2; return 2; }
  window_day=$((16#${day_hex#0x}))
  window_hour=$((16#${hour_hex#0x}))
  (( window_day <= 7 && window_hour <= 23 )) \
    || { echo "beelink-gate: invalid Windows Update day/hour from $target; refusing to start" >&2; return 2; }
}

encode() { printf '%s' "$1" | base64 | tr -d '\n'; }

# One probe line for a beelink, or nothing when it cannot be read.
probe_of() {
  local target=$1 attempt line
  # A busy beelink's sshd drops some new connections (MaxStartups) while
  # hundreds of lane sessions are open; one dropped probe made auto treat the
  # host as unreachable for a whole placement round (ADC #10352, 2026-10-12
  # 00:01Z, beelink2 at load 70 answering SSH in under a second).
  for attempt in 1 2 3; do
    if update_window_of "$target" 2>/dev/null; then
      line=$(heartbeat=0 on_beelink "$target" --probe "$(encode "$target")" "$(encode "$repo_url")" "$(encode "$window_day")" "$(encode "$window_hour")" "$(encode "$([ "${gate_class:-}" = dev ] && echo dev || echo "$install_mode")")" "$(encode "$install_mode")" 2>/dev/null \
        | grep '^beelink-gate-probe ' | tail -1)
      [ -z "$line" ] || { echo "$line"; return 0; }
    fi
    (( attempt == 3 )) || sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"
  done
  return 1
}
field() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<<"$2"; }
overloaded() { local load limit; load=$(field load "$1") limit=$(field limit "$1"); [ -n "$load" ] && [ -n "$limit" ] && over_limit "$load" "$limit"; }

# A named beelink over its load limit hands the gate to the other one when that
# one can start it under its own limit; otherwise the gate stays and waits there.
place_named() {
  local named=$1 other line other_line
  if [ "${pin_host:-0}" = 1 ]; then echo "$named"; return 0; fi
  other=$([ "$named" = beelink1 ] && echo beelink2 || echo beelink1)
  line=$(probe_of "$named") || line=""
  if [ -z "$line" ] || ! overloaded "$line"; then echo "$named"; return 0; fi
  other_line=$(probe_of "$other") || other_line=""
  if [ -n "$other_line" ] && [ "$(field state "$other_line")" != refused ] && ! overloaded "$other_line"; then
    echo "beelink-gate: $named load $(field load "$line") is over its limit of $(field limit "$line"); running on $other (load $(field load "$other_line"), limit $(field limit "$other_line"))" >&2
    echo "$other"; return 0
  fi
  echo "$named"
}

# Probes both beelinks and prints the one to use; waits while both are busy.
choose_beelink() {
  local target line state cache load slots best="" best_rank=9 best_load rank waited=0 reported=-60 light_busy next
  local -A seen=()
  local auto_started=$SECONDS
  while :; do
    if [ -n "${checkout_reservation_dir:-}" ]; then
      local reserve_pid
      for reserve_pid in "${checkout_reservation_pids[@]}"; do
        kill -0 "$reserve_pid" 2>/dev/null || tempfail "$(utc_in_minutes 5)" "checkout reservation disconnected before admission"
      done
    fi
    best="" best_rank=9 best_load="" light_busy=""
    for target in beelink1 beelink2; do
      line=$(probe_of "$target") || line=""
      [ -n "$line" ] || { seen[$target]="unreachable"; continue; }
      seen[$target]=${line#beelink-gate-probe }
      state=$(sed -n 's/.* state=\([a-z]*\).*/\1/p' <<<"$line"); cache=$(sed -n 's/.* cache=\([a-z]*\).*/\1/p' <<<"$line")
      load=$(sed -n 's/.* load=\([0-9.]*\).*/\1/p' <<<"$line")
      slots=$(sed -n 's/.* slots=\([0-9]*\).*/\1/p' <<<"$line")
      if [ "$state" = busy ] && ! overloaded "$line"; then light_busy=$target; fi
      # A free repo lock with no free host slot still queues, behind any gate.
      case "$state:$cache:$([ "${slots:-1}" -gt 0 ] && echo slot || echo full)" in
        free:warm:slot) rank=0 ;; free:cold:slot) rank=1 ;; free:*:full) rank=2 ;; *) continue ;;
      esac
      # Any host that can admit beats an overloaded one. If both would wait,
      # a warm cache cannot admit sooner than a cold cache: prefer the host
      # closer to its pressure limit while keeping a free slot ahead of a full pool.
      if overloaded "$line"; then
        case "$rank" in 0|1) rank=3 ;; *) rank=5 ;; esac
      fi
      if (( rank < best_rank )) || { (( rank == best_rank )) && awk -v a="${load:-0}" -v b="${best_load:-1e9}" 'BEGIN{exit !(a < b)}'; }; then
        best=$target best_rank=$rank best_load=$load
      fi
    done
    # A repo lock frees in minutes; load over the limit can last the whole
    # load wait. Keep probing rather than queue on an overloaded host while
    # the other one is under its limit and only busy with this repo.
    if (( best_rank >= 3 )) && [ -n "$light_busy" ]; then best=""; fi
    if [ -n "$best" ]; then
      if [ -n "${checkout_reservation_dir:-}" ]; then
        for reserve_pid in "${checkout_reservation_pids[@]}"; do
          kill -0 "$reserve_pid" 2>/dev/null || tempfail "$(utc_in_minutes 5)" "checkout reservation disconnected before admission"
        done
      fi
      echo "beelink-gate: auto chose $best after ${waited}s (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      echo "$best"; return 0
    fi
    if [ "${seen[beelink1]:-}" = unreachable ] && [ "${seen[beelink2]:-}" = unreachable ]; then
      tempfail "$(utc_in_minutes 5)" "no beelink is reachable from $(hostname)"
    fi
    if [[ "${seen[beelink1]:-}" != *state=busy* && "${seen[beelink2]:-}" != *state=busy* ]]; then
      echo "beelink-gate: no beelink can start this gate (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      # The earliest time either refusing host names.
      next=$(printf '%s\n' "$(field next "${seen[beelink1]:-}")" "$(field next "${seen[beelink2]:-}")" | grep -E '^[0-9]{4}-' | sort | head -1)
      tempfail "${next:-$(utc_in_minutes 5)}" "no beelink can start this gate"
    fi
    if (( waited - reported >= 60 )); then
      echo "beelink-gate: no beelink is both free for this repo and under its load limit after ${waited}s; waiting (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      reported=$waited
    fi
    sleep "${BEELINK_GATE_AUTO_POLL_SECONDS:-$([ "${BEELINK_GATE_URGENT:-0}" = 1 ] && echo 2 || echo 20)}"; waited=$((SECONDS - auto_started))
  done
}

# Auto gates need a place on both hosts before they probe. Without a durable
# normal ticket, a gate spending minutes between probes can lose every freed
# checkout to a newly arrived gate. Urgent gates use their priority marker.
reserve_checkout() {
  local beelink repo_url gate_class host owner repo cache_root suffix="" marker rc priority=urgent epoch="" token=""
  beelink=$(decode "$1") repo_url=$(decode "$2") gate_class=$(decode "$3")
  if [ "$#" = 6 ]; then
    priority=$(decode "$4") epoch=$(decode "$5") token=$(decode "$6")
    [ "$priority" = normal ] && [[ "$epoch" =~ ^[0-9]+$ && "$token" =~ ^[0-9a-f]{32}$ ]] || die "invalid normal checkout reservation"
  fi
  parse_repo_url "$repo_url"
  cache_root="${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}"
  [ "$gate_class" = dev ] && suffix=@dev
  [ "$gate_class" = light ] && suffix=@light
  if [ "$priority" = normal ]; then
    marker="$cache_root/.locks/queue-$host-$owner-$repo$suffix.$epoch.$$"
  else
    marker="$cache_root/.locks/urgent-$host-$owner-$repo$suffix.$$"
  fi
  mkdir -p "$cache_root/.locks" || die "cannot create checkout reservation"
  printf '%s' "$token" > "$marker" || die "cannot create checkout reservation"
  trap 'rm -f "$marker"; exit 143' HUP INT TERM
  echo "beelink-gate-$priority-reserved $beelink"
  # The launcher keeps stdin open. EOF removes the reservation even if its
  # session dies; a timeout merely means that no heartbeat bytes arrived.
  while :; do
    IFS= read -r -t 5 _; rc=$?
    (( rc == 0 || rc > 128 )) || break
  done
  rm -f "$marker"
  trap - HUP INT TERM
}

checkout_reservation_pids=() checkout_reservation_files=() checkout_reservation_dir="" checkout_monitor_pid=""
stop_checkout_reservations() {
  local pid file
  [ -z "$checkout_monitor_pid" ] || kill -TERM "$checkout_monitor_pid" 2>/dev/null || true
  for file in "${checkout_reservation_files[@]}"; do : > "$file.stop"; done
  for pid in "${checkout_reservation_pids[@]}"; do wait "$pid" 2>/dev/null || true; done
  [ -z "$checkout_reservation_dir" ] || rm -rf "$checkout_reservation_dir"
}

watch_checkout_admission() {
  local log=$1 file
  while :; do
    if grep -q '^beelink-gate: lock, host slot .* admitted on ' "$log" 2>/dev/null; then
      for file in "${checkout_reservation_files[@]}"; do : > "$file.stop"; done
      return 0
    fi
    sleep 0.2
  done
}
start_checkout_reservations() {
  local priority=${1:-urgent} host file pid tries
  local -a args=()
  checkout_reservation_dir=$(mktemp -d) || die "cannot allocate checkout reservation state"
  trap stop_checkout_reservations EXIT
  trap 'exit 143' HUP INT TERM
  for host in beelink1 beelink2; do
    file="$checkout_reservation_dir/$host"
    args=("$(encode "$host")" "$(encode "$repo_url")" "$(encode "$([ "$gate_class" = dev ] && echo dev || echo "$install_mode")")")
    if [ "$priority" = normal ]; then
      args+=("$(encode normal)" "$(encode "$reservation_epoch")" "$(encode "$reservation_token")")
    fi
    BEELINK_GATE_HEARTBEAT_STOP="$file.stop" heartbeat=1 on_beelink "$host" --urgent-reserve "${args[@]}" >"$file" 2>"$file.err" &
    checkout_reservation_pids+=("$!")
    checkout_reservation_files+=("$file")
  done
  for file in "${checkout_reservation_files[@]}"; do
    for ((tries = 0; tries < 300; tries++)); do
      grep -q "^beelink-gate-$priority-reserved " "$file" 2>/dev/null && break
      sleep 0.1
    done
    grep -q "^beelink-gate-$priority-reserved " "$file" 2>/dev/null || {
      cat "$file.err" >&2
      tempfail "$(utc_in_minutes 5)" "cannot reserve checkout priority on both beelinks"
    }
  done
  if [ "$priority" = urgent ]; then
    echo "beelink-gate: urgent priority reserved on both beelinks" >&2
  else
    echo "beelink-gate: normal FIFO place reserved on both beelinks" >&2
  fi
}

if [ "${1:-}" = --urgent-reserve ]; then
  { [ "$#" = 4 ] || [ "$#" = 7 ]; } || die "invalid checkout reservation"
  reserve_checkout "${@:2}"
  exit 0
fi

# --report [hours]: gate runs per merged PR by repo, from both beelinks' receipts
# and GitHub's merged-PR counts, with each repo's modes, exit classes and
# exact-input repeats (same SHA, mode and command), to tell rework from re-runs.
if [ "${1:-}" = --report ]; then
  hours=${2:-24}
  [[ "$hours" =~ ^[1-9][0-9]*$ ]] || die "usage: beelink-gate --report [hours]"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  receipts_file=$(mktemp)
  for host in beelink1 beelink2; do
    heartbeat=0 on_beelink "$host" --receipts 2>/dev/null | sed "s/^{/{\"from\": \"$host\", /" >> "$receipts_file" \
      || echo "beelink-gate: --report could not read $host's receipts" >&2
  done
  merged_lookup=$(command -v gh-drew || command -v gh || true)
  python3 - "$receipts_file" "$hours" "$merged_lookup" <<'PY'
import collections, datetime as dt, json, subprocess, sys
path, hours, gh = sys.argv[1], int(sys.argv[2]), sys.argv[3]
now = dt.datetime.now(dt.timezone.utc)
since = (now - dt.timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%SZ")
history = []
for line in open(path):
    try:
        r = json.loads(line)
    except ValueError:
        continue
    history.append(r)
rows = [r for r in history if r.get("at", "") >= since]
def exit_class(code):
    return {0: "pass", 1: "fail", 2: "usage", 3: "refused", 75: "tempfail", 76: "replaced", 124: "timeout", 143: "stopped"}.get(code, "other")
by_repo = collections.defaultdict(list)
for r in rows:
    by_repo[r.get("repo", "?")].append(r)
def merged(repo):
    if not gh or not repo.startswith("github.com/"):
        return None
    q = f"repo:{repo[len('github.com/'):]} is:pr is:merged merged:>={since}"
    out = subprocess.run([gh, "api", "-X", "GET", "search/issues", "-f", f"q={q}", "--jq", ".total_count"],
                         capture_output=True, text=True)
    return int(out.stdout.strip()) if out.returncode == 0 and out.stdout.strip().isdigit() else None
print(f"beelink-gate report: {since} to {now:%Y-%m-%dT%H:%M:%SZ} ({len(rows)} gate runs)")
print(f"{'repo':38} {'runs':>5} {'merged':>6} {'runs/PR':>7} {'p50 wait':>8} {'repeats':>7}  modes / exits")
total_runs = total_merged = 0
for repo, rs in sorted(by_repo.items(), key=lambda kv: -len(kv[1])):
    m = merged(repo)
    waits = sorted(r.get("waited_s", 0) for r in rs)
    keys = collections.Counter((r.get("sha"), r.get("mode"), r.get("command")) for r in rs)
    repeats = sum(n - 1 for n in keys.values())
    modes = collections.Counter(r.get("class") if r.get("class") in ("dev", "light") else r.get("mode") for r in rs)
    exits = collections.Counter(exit_class(r.get("exit")) for r in rs)
    ratio = f"{len(rs) / m:.1f}" if m else "-"
    total_runs += len(rs)
    total_merged += m or 0
    print(f"{repo[len('github.com/'):] if repo.startswith('github.com/') else repo:38} {len(rs):5} {m if m is not None else '?':>6} {ratio:>7} {waits[len(waits) // 2]:7}s {repeats:7}  "
          + " ".join(f"{k}={v}" for k, v in modes.most_common()) + " / " + " ".join(f"{k}={v}" for k, v in exits.most_common()))
if total_merged:
    print(f"TOTAL {total_runs} runs / {total_merged} merged PRs = {total_runs / total_merged:.1f} runs per merged PR (target <= 1.5)")
# Recompute across both hosts: a receipt's own reason only sees its host's
# history. A prior checkout on the other Beelink must not look like a first run.
last_head, last_exact = {}, {}
reasons = collections.Counter()
repeat_repos, repeat_lanes = collections.Counter(), collections.Counter()
for r in sorted(history, key=lambda item: item.get("at", "")):
    head = (r.get("repo"), r.get("sha"))
    exact = head + (r.get("mode"), r.get("command"))
    prior = last_exact.get(exact)
    if prior is None:
        reason = "different_command" if head in last_head else "first"
    elif prior.get("exit") == 0 and r.get("base_sha") and prior.get("base_sha") and r["base_sha"] != prior["base_sha"]:
        reason = "after_base_move"
    elif prior.get("exit") != 0:
        reason = "after_red"
    elif not r.get("base_sha") or not prior.get("base_sha"):
        reason = "after_green_base_unknown"
    else:
        reason = "after_green"
    if r.get("at", "") >= since:
        reasons[reason] += 1
        if reason != "first":
            repeat_repos[r.get("repo") or "?"] += 1
            repeat_lanes[r.get("lane") or "unknown"] += 1
    last_head[head], last_exact[exact] = r, r
measured = sum("base_sha" in r for r in rows)
print(f"METADATA base_sha={sum(bool(r.get('base_sha')) for r in rows)}/{len(rows)} "
      f"pr_number={sum(r.get('pr_number') is not None for r in rows)}/{len(rows)} "
      f"lane={sum(bool(r.get('lane')) for r in rows)}/{len(rows)}")
print(f"REASONS {measured}/{len(rows)} receipts have new metadata; "
      + " ".join(f"{key}={reasons[key]}" for key in ("first", "different_command", "after_red", "after_green", "after_base_move", "after_green_base_unknown")))
print(f"AVOIDABLE CANDIDATES {reasons['after_green'] + reasons['after_base_move']} "
      "(same head + command after green, with unchanged or moved base; a moved base alone does not prove motive)")
for label, counts in (("REPEAT_REPO", repeat_repos), ("REPEAT_LANE", repeat_lanes)):
    for name, count in counts.most_common(5):
        print(f"{label} {name} {count}")
# Host pressure at admission, per host: the numbers to beat are host some avg60 < 40
# while gates run, and no gate admitted above that.
by_host = collections.defaultdict(list)
for r in rows:
    by_host[r.get("host", "?")].append(r)
for host, rs in sorted(by_host.items()):
    hp = sorted(r["start_host_cpu_pressure"] for r in rs if isinstance(r.get("start_host_cpu_pressure"), (int, float)))
    waits = sorted(r.get("waited_s", 0) for r in rs)
    over = sum(1 for v in hp if v > 40)
    p50 = f"{hp[len(hp) // 2]:.1f}" if hp else "-"
    print(f"HOST {host}: {len(rs)} runs, p50 wait {waits[len(waits) // 2]}s, host cpu avg60 at admission p50 {p50} "
          f"({len(hp)} measured, {over} over 40), timeouts {sum(1 for r in rs if r.get('exit') == 124 or r.get('timed_out'))}")
PY
  status=$?
  rm -f "$receipts_file"
  exit "$status"
fi

if [ "${1:-}" = --attach ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "usage: beelink-gate --attach <gate-id>"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  heartbeat=0 on_beelink "$target" --job-attach "$2"
  rc=$?
  if [ "$rc" = 255 ]; then
    # SSH also exits 255 on transport loss. A completed command may itself
    # have returned 255; ask the job's exit file before calling it a loss.
    result=$(heartbeat=0 on_beelink "$target" --job-result "$2" 2>/dev/null) || result=""
    [ "$result" = 255 ] || tempfail "$(utc_in_minutes 5)" "attach connection lost for $2; run beelink-gate --attach $2 again"
  fi
  exit "$rc"
fi
if [ "${1:-}" = --cancel-job ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "invalid cancellation id"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  # A manager's cgroup can vanish immediately after scheduling this unit.
  # Retry transport failures here, outside that cgroup, until the marker lands.
  for ((attempt=0; attempt<60; attempt++)); do
    if heartbeat=0 on_beelink "$target" --job-cancel "$2"; then exit 0; fi
    sleep 5
  done
  tempfail "$(utc_in_minutes 5)" "could not confirm cancellation of $2"
fi

install_mode=install gate_branch="" gate_class="" pin_host=0 cancel_on_term=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --urgent) export BEELINK_GATE_URGENT=1; shift ;;
    --pin-host) pin_host=1; shift ;;
    --cancel-on-term) cancel_on_term=1; shift ;;
    --no-install) [ "$install_mode" = light ] || install_mode=no-install; shift ;;
    --light) [ "$install_mode" != ship ] || die "--light cannot be combined with --ship"; install_mode=light; shift ;;
    --dev) gate_class=dev; shift ;;
    --ship) [ "$install_mode" != light ] || die "--light cannot be combined with --ship"; install_mode=ship; shift ;;
    --branch) [ "$#" -ge 2 ] || die "--branch needs a branch name"
      valid_branch_name "$2" || die "invalid --branch: $2"
      gate_branch=$2; shift 2 ;;
    *) break ;;
  esac
done
usage="usage: beelink-gate [--no-install|--light|--dev] [--urgent] [--pin-host] [--cancel-on-term] [--branch <name>] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
       beelink-gate --ship <beelink1|beelink2|auto> <repo-url> <sha>"
if [ "$gate_class" = dev ]; then
  case "$install_mode" in ship|light) die "--dev cannot be combined with --$install_mode" ;; esac
fi
if [ "$install_mode" = ship ]; then
  [ "$#" -eq 3 ] || die "$usage"
  set -- "$1" "$2" "$3" -- bash scripts/ship.sh verify
fi
if [ "$#" -lt 5 ] || [ "$4" != -- ]; then
  die "$usage"
fi
target=$1 repo_url=$2 sha=$3
if [ "$pin_host" = 1 ] && [ "$target" = auto ]; then die "--pin-host requires a named beelink"; fi
shift 4
if [ -n "${BEELINK_GATE_MAX_CONCURRENT:-}" ]; then
  [[ "$BEELINK_GATE_MAX_CONCURRENT" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_MAX_CONCURRENT"
fi
if [ -n "${BEELINK_GATE_MAX_CPU_PRESSURE:-}" ]; then
  max_cpu_pressure >/dev/null
fi
if [ -n "${BEELINK_GATE_STARVE_AFTER:-}" ]; then
  seconds_of "$BEELINK_GATE_STARVE_AFTER" >/dev/null || die "invalid BEELINK_GATE_STARVE_AFTER: $BEELINK_GATE_STARVE_AFTER"
fi
if [ -n "${BEELINK_GATE_LOAD_WAIT:-}" ]; then
  seconds_of "$BEELINK_GATE_LOAD_WAIT" >/dev/null || die "invalid BEELINK_GATE_LOAD_WAIT: $BEELINK_GATE_LOAD_WAIT"
fi
[[ "$sha" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || die "SHA must be a full commit ID"
[[ -z "${BEELINK_GATE_PR:-}" || "${BEELINK_GATE_PR:-}" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_PR"
if [ -z "${BEELINK_GATE_LANE:-}" ]; then
  BEELINK_GATE_LANE=${FLEET_LANE:-}
  if [ -z "$BEELINK_GATE_LANE" ] && [[ "${FLEET_STATUS_FILE:-}" =~ /([^/]+)--([^/]+)\.md$ ]]; then
    BEELINK_GATE_LANE="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
  fi
fi
[[ "$BEELINK_GATE_LANE" =~ ^[A-Za-z0-9._:-]{0,128}$ ]] || die "invalid gate lane"
export BEELINK_GATE_LANE
unset BEELINK_GATE_RESERVATION_TOKEN
launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
requested=$target admit_wait_launch="" placed_wait_launch=0
# An --urgent gate stays on the first host auto places it on: giving the host
# back drops its urgent marker and with it its place ahead of every normal gate.
# On 2026-10-12 an urgent fix for a red ADC develop (#10345) was re-placed for
# 1413 s while normal gates re-took the checkout each time it let go.
if [ "$requested" = auto ] && [ "${BEELINK_GATE_URGENT:-0}" != 1 ]; then
  admit_wait_launch=$(seconds_of "${BEELINK_GATE_REPLACE_WAIT:-60s}") || die "invalid BEELINK_GATE_REPLACE_WAIT: ${BEELINK_GATE_REPLACE_WAIT:-}"
fi
starve_after_launch=$(seconds_of "${BEELINK_GATE_STARVE_AFTER:-10m}") || die "invalid BEELINK_GATE_STARVE_AFTER: ${BEELINK_GATE_STARVE_AFTER:-}"
if [ "$requested" = auto ]; then
  if [ "${BEELINK_GATE_URGENT:-0}" = 1 ]; then
    start_checkout_reservations
  else
    reservation_epoch=$(date +%s)
    reservation_token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    export BEELINK_GATE_RESERVATION_TOKEN=$reservation_token
    start_checkout_reservations normal
  fi
fi
cancel_launcher_job() {
  trap - HUP INT TERM
  if [ -n "${gate_id:-}" ]; then
    echo "beelink-gate: manager stopped; scheduling cancellation of gate_id=$gate_id" >&2
    systemd-run --user --collect --unit="beelink-gate-cancel-$gate_id" /usr/bin/bash "$0" --cancel-job "$gate_id" >&2 \
      || /usr/bin/bash "$0" --cancel-job "$gate_id" >&2
  fi
  exit 143
}
run_cancelable() {
  if [ "$cancel_on_term" = 1 ]; then
    "$@" &
    local child=$! rc
    wait "$child"; rc=$?
    return "$rc"
  fi
  "$@"
}
launched=$SECONDS placements=0
while :; do
  case "$requested" in
    beelink1|100.98.195.7) target=$(place_named beelink1) ;;
    beelink2|100.127.22.51) target=$(place_named beelink2) ;;
    auto) target=$(choose_beelink) || exit $? ;;
    *) die "unknown beelink: $requested" ;;
  esac
  update_window_of "$target" || tempfail "$(utc_in_minutes 5)" "cannot read the Windows Update schedule of $target"
  encoded=()
  for arg in "$target" "$repo_url" "$sha" "$install_mode" "$window_day" "$window_hour" "$@"; do
    encoded+=("$(encode "$arg")")
  done
  placed_wait_launch=$((SECONDS - launched))
  # A gate past the starvation backstop keeps its checkout queue place on this host.
  # --dev has no starvation backstop and continues moving between hosts.
  if [ -n "$admit_wait_launch" ] && [ "${gate_class:-}" != dev ] && (( placed_wait_launch >= starve_after_launch )); then
    admit_wait_launch=""
    echo "beelink-gate: waited ${placed_wait_launch}s across placements; staying on $target in its place in line" >&2
  fi
  gate_id="$target-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [ "$cancel_on_term" != 1 ] || trap cancel_launcher_job HUP INT TERM
  echo "beelink-gate: gate_id=$gate_id; reconnect with beelink-gate --attach $gate_id" >&2
  run_cancelable stage_job "$target" "$gate_id" || tempfail "$(utc_in_minutes 5)" "could not stage $gate_id on $target"
  BEELINK_GATE_ID="$gate_id" heartbeat=0 run_cancelable on_beelink "$target" --job-submit "$gate_id" "${encoded[@]}"
  rc=$?
  [ "$rc" != 255 ] || tempfail "$(utc_in_minutes 5)" "submit connection lost for $gate_id; run beelink-gate --attach $gate_id before retrying"
  [ "$rc" = 0 ] || exit "$rc"
  # Keep reservations until the submitted gate itself has joined the checkout
  # queue. Its own urgent marker then survives a lost launcher or SSH session.
  if [ -n "$checkout_reservation_dir" ]; then
    admission_log="$checkout_reservation_dir/admission.log"
    : > "$admission_log"
    watch_checkout_admission "$admission_log" & checkout_monitor_pid=$!
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id" 2> >(tee "$admission_log" >&2)
    rc=$?
    kill -TERM "$checkout_monitor_pid" 2>/dev/null || true
    wait "$checkout_monitor_pid" 2>/dev/null || true
    checkout_monitor_pid=""
  else
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id"
    rc=$?
  fi
  if [ "$rc" = 255 ]; then
    result=$(heartbeat=0 on_beelink "$target" --job-result "$gate_id" 2>/dev/null) || result=""
    [ "$result" = 255 ] || tempfail "$(utc_in_minutes 5)" "attach connection lost for $gate_id; run beelink-gate --attach $gate_id again"
  fi
  # Only an auto placement may move; a named host keeps waiting there, as it always has.
  [ "$rc" = "$NOT_ADMITTED" ] && [ "$requested" = auto ] || exit "$rc"
  placements=$((placements + 1))
  echo "beelink-gate: placement $placements on $target gave the host back after waiting; probing both again" >&2
done
