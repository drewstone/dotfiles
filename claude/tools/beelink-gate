# The command as a gate runs it, in command_with_umask. The submitted user unit can inherit
# umask 0002, so the command gets a non-group-writable default without changing the gate
# shell's mask for receipts and bundles. A pipeline exits with its last stage: `sh -c 'node --test ... | tail -12'`
# exited 0 on a failing test, and --merge merged discovery-lab #2097 red. A shell -c command runs under
# pipefail, so a failing stage fails the gate; the receipt still names the command as requested.
# Any single-dash option cluster holding c counts: beelink1's receipts held 89 `bash -lc` gates (16 piped) and a
# `bash -euc` (gtr-disk review of dotfiles #535).
gate_command_argv() {
  local -a run=("$@")
  [[ "${1##*/}" =~ ^(sh|dash|bash)$ && "${2:-}" =~ ^-[A-Za-z]*c[A-Za-z]*$ ]] && run=(/usr/bin/bash -o pipefail "${@:2}")
  command_with_umask=(/usr/bin/bash -c 'umask 022; exec "$@"' beelink-gate-command "${run[@]}")
}

