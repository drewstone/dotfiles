#!/usr/bin/env bash
# shellcheck disable=SC2317 # receipt, finish and signal handlers run through traps.
# Gate one commit in a reusable, locked checkout on a beelink.
#
# Usage:
#   beelink-gate [--no-install] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
#   beelink-gate --ship <beelink1|beelink2|auto> <repo-url> <sha>
#
# auto probes both beelinks and runs on a free one, preferring one under its
# load limit (1-minute load at most 1.5x its cores), then one that already
# caches the repo; when both are busy it waits for whichever frees first.
# A named beelink over its load limit hands the gate to the other one when that
# one is under its limit. On the beelink, a gate starts only under the load limit;
# it waits up to BEELINK_GATE_LOAD_WAIT (default 30m), printing why, then refuses.
# --ship runs exactly the repo's `scripts/ship.sh verify` (the release's own
# verification) with the repo's .nvmrc Node and SHIP_MAX_WORKERS sized to the
# host; ship verify does its own frozen install, so the gate does not.
#
# Runs from any host: the Mac, GTR or either beelink. On the target beelink
# itself it runs locally; elsewhere it pipes itself over SSH into WSL.
# The launcher keeps the gate's stdin open; when the launcher dies the gate sees
# EOF and kills its own process groups, so a lost session never holds the lock.
# Every step runs under one hold budget (BEELINK_GATE_MAX_HOLD, default 45m).
# Each gate appends a JSON line to ~/.local/state/beelink-gate/receipts.jsonl
# on the beelink: host, repo, sha, waited_s, ran_s, exit, timed_out, watchdog.
set -uo pipefail
die() { echo "beelink-gate: $*" >&2; exit 2; }

decode() { printf '%s' "$1" | base64 --decode; }

check_floor() {
  local host="$1" floor_gib available
  case "$host" in
    beelink1) floor_gib=100 ;;
    beelink2) floor_gib=162 ;;
    *) die "unknown remote beelink: $host" ;;
  esac
  available=$(df -B1 --output=avail "$HOME" | tail -n 1 | tr -d ' ') || die "cannot read free disk space"
  [[ "$available" =~ ^[0-9]+$ ]] || die "invalid free disk reading: $available"
  if (( available < floor_gib * 1024 * 1024 * 1024 )); then
    printf 'beelink-gate: REFUSED %s has %s bytes free, below its %s GiB disk floor; use the other beelink or ask the host owner to recover capacity\n' \
      "$host" "$available" "$floor_gib" >&2
    return 3
  fi
}

# Windows owns the update policy; WSL owns the local clock and time-zone rules.
# Check again after waiting for the repo lock, before any checkout is touched.
# A gate admitted before the window keeps running, including its install.
check_update_window() {
  python3 - "$@" <<'PY'
from datetime import datetime, time, timedelta, timezone
import os
from pathlib import Path
import sys
from zoneinfo import ZoneInfo

host, raw_day, raw_hour = sys.argv[1:4]
try:
    day, hour = int(raw_day), int(raw_hour)
    if not 0 <= day <= 7 or not 0 <= hour <= 23:
        raise ValueError("day or hour out of range")
    if len(sys.argv) > 4:
        zone = ZoneInfo(sys.argv[4])
    elif os.environ.get("TZ"):
        zone = ZoneInfo(os.environ["TZ"])
    else:
        with Path("/etc/localtime").open("rb") as zonefile:
            zone = ZoneInfo.from_file(zonefile)
    now = (datetime.fromisoformat(sys.argv[5].replace("Z", "+00:00"))
           if len(sys.argv) > 5 else datetime.now(timezone.utc))
    if now.tzinfo is None:
        raise ValueError("probe time requires a UTC offset")
    now = now.astimezone(timezone.utc)
except (OSError, ValueError, IndexError) as exc:
    print(f"beelink-gate: cannot evaluate Windows Update window: {exc}", file=sys.stderr)
    sys.exit(2)

local_day = now.astimezone(zone).date()
for offset in range(-7, 8):
    candidate = local_day + timedelta(days=offset)
    # Registry day 0 is daily; 1=Sunday through 7=Saturday.
    if day and candidate.isoweekday() % 7 + 1 != day:
        continue
    scheduled_local = datetime.combine(candidate, time(hour), zone)
    scheduled = scheduled_local.astimezone(timezone.utc)
    start = scheduled - timedelta(minutes=60)
    end = scheduled + timedelta(minutes=30)
    if start <= now < end:
        next_local = end.astimezone(zone)
        print(
            f"beelink-gate: REFUSED {host} Windows Update is scheduled "
            f"{scheduled.astimezone(zone):%A %Y-%m-%d %H:%M %Z}; "
            f"new gates are blocked from {start.astimezone(zone):%Y-%m-%d %H:%M %Z} "
            f"until {next_local:%Y-%m-%d %H:%M %Z}; "
            f"next allowed {next_local:%Y-%m-%d %H:%M %Z} "
            f"({end:%Y-%m-%d %H:%M} UTC)",
            file=sys.stderr,
        )
        sys.exit(3)
PY
}

# Cache directories are owned by this command. A global lock serializes size
# decisions; per-repo locks keep active gates out of the eviction set.
prune_cache() {
  python3 - "$1" "$2" "$3" <<'PY'
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys

root, current, cap = Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])
locks = root / ".locks"

def size(path):
    result = subprocess.run(
        ["du", "-s", "-B1", "--", str(path)],
        text=True, capture_output=True, env={**os.environ, "LC_ALL": "C"},
    )
    warnings = result.stderr.splitlines()
    # Other repo gates can remove node_modules entries during this scan. GNU du
    # still prints a total; only that expected race may use its partial result.
    if result.returncode and not (
        result.returncode == 1 and warnings and all(
            line.startswith("du: cannot access ") and line.endswith(": No such file or directory")
            for line in warnings
        )
    ):
        raise OSError(f"du {path}: {result.stderr.strip() or f'exit {result.returncode}'}")
    fields = result.stdout.split()
    if not fields:
        raise OSError(f"du {path}: no size result")
    return int(fields[0])

try:
    with (locks / ".capacity.lock").open("a+") as global_lock:
        fcntl.flock(global_lock, fcntl.LOCK_EX)
        candidates = []
        for host in root.iterdir():
            if host.name == ".locks" or host.is_symlink() or not host.is_dir():
                continue
            for owner in host.iterdir():
                if owner.is_symlink() or not owner.is_dir():
                    continue
                for repo in owner.iterdir():
                    git_dir = repo / ".git"
                    if repo.is_symlink() or not repo.is_dir() or git_dir.is_symlink() or not git_dir.is_dir():
                        continue
                    used = git_dir / "beelink-gate-used"
                    stamp = used if used.is_file() and not used.is_symlink() else git_dir / "FETCH_HEAD"
                    if not stamp.exists() or stamp.is_symlink():
                        stamp = git_dir
                    candidates.append((stamp.stat().st_mtime_ns, repo, size(repo), host.name, owner.name))
        total = size(root)
        for _, repo, bytes_used, host, owner in sorted(candidates):
            if total <= cap:
                break
            lock_path = locks / f"{host}-{owner}-{repo.name}.lock"
            fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                if repo != current:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        continue
                shutil.rmtree(repo)
                total -= bytes_used
                print(f"beelink-gate: evicted LRU cache {repo} ({bytes_used} bytes)", file=sys.stderr)
            finally:
                os.close(fd)
        total = size(root)
        if total > cap:
            print(f"beelink-gate: cache cap exceeded: {total} > {cap} bytes; active checkouts cannot be evicted", file=sys.stderr)
            sys.exit(3)
except (OSError, ValueError) as exc:
    print(f"beelink-gate: cache prune failed: {exc}", file=sys.stderr)
    sys.exit(3)
PY
}

# Lanes may point CARGO_TARGET_DIR at ~/.cache/<repo>-build, outside the capped
# cache. Sweep entries of those cargo target dirs (CACHEDIR.TAG) untouched for
# 24 h. Each sweep holds every gate lock for <repo> and cargo's own profile
# locks, so no gate or cargo build is using the files it removes; a removed
# artifact only costs a rebuild. Failure is reported but never fails a gate.
prune_build_dirs() {
  python3 - "$@" <<'PY'
import fcntl
import os
from pathlib import Path
import shutil
import sys
import time

build_root, locks, current_lock = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
max_age = int(sys.argv[4])
cutoff = time.time() - max_age
TAG = "Signature: 8a477f597d28d172789f06886806bc55"
ARTIFACT_DIRS = ("deps", "build", ".fingerprint", "incremental", "examples")
CARGO_LOCKS = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")

def try_lock(path, held):
    try:
        fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    except FileNotFoundError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return False
    held.append(fd)
    return True

def release(held):
    while held:
        os.close(held.pop())

def newest(path):
    # relatime refreshes atime on a read at most daily; cargo's locks, not
    # this age, are what keep an active build's inputs safe.
    st = path.lstat()
    latest = max(st.st_atime, st.st_mtime)
    if path.is_dir() and not path.is_symlink():
        for parent, dirs, files in os.walk(path):
            for name in dirs + files:
                st = os.lstat(os.path.join(parent, name))
                latest = max(latest, st.st_atime, st.st_mtime)
    return latest

def reclaimable(path):
    if not path.is_dir() or path.is_symlink():
        st = path.lstat()
        return st.st_blocks * 512 if st.st_nlink == 1 else 0
    total = 0
    for parent, _, files in os.walk(path):
        for name in files:
            st = os.lstat(os.path.join(parent, name))
            if st.st_nlink == 1:
                total += st.st_blocks * 512
    return total

def profiles(target):
    # <target>/<profile> and <target>/<triple>/<profile>
    for child in target.iterdir():
        if child.is_symlink() or not child.is_dir():
            continue
        if (child / ".fingerprint").is_dir():
            yield child
            continue
        for grandchild in child.iterdir():
            if not grandchild.is_symlink() and (grandchild / ".fingerprint").is_dir():
                yield grandchild

try:
    with (locks / ".build-prune.lock").open("a+") as sweep_lock:
        try:
            fcntl.flock(sweep_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(0)
        for target in sorted(build_root.glob("*-build")):
            tag = target / "CACHEDIR.TAG"
            if target.is_symlink() or not target.is_dir() or tag.is_symlink() or not tag.is_file():
                continue
            with tag.open() as tagfile:
                if not tagfile.read(len(TAG)) == TAG:
                    continue
            repo = target.name[:-len("-build")]
            held = []
            try:
                busy = [lock for lock in sorted([*locks.glob(f"*-{repo}.lock"), *locks.glob(f"*-{repo}@*.lock")])
                        if lock != current_lock and not try_lock(lock, held)]
                if busy:
                    print(f"beelink-gate: skipped {target}; a {repo} gate holds its lock", file=sys.stderr)
                    continue
                freed = 0
                for profile in profiles(target):
                    profile_held = []
                    try:
                        if not all(try_lock(profile / name, profile_held) for name in CARGO_LOCKS):
                            print(f"beelink-gate: skipped {profile}; cargo is building there", file=sys.stderr)
                            continue
                        for name in ARTIFACT_DIRS:
                            area = profile / name
                            if area.is_symlink() or not area.is_dir():
                                continue
                            for entry in area.iterdir():
                                if newest(entry) >= cutoff:
                                    continue
                                bytes_used = reclaimable(entry)
                                if entry.is_dir() and not entry.is_symlink():
                                    shutil.rmtree(entry)
                                else:
                                    entry.unlink()
                                freed += bytes_used
                    finally:
                        release(profile_held)
                if freed:
                    print(f"beelink-gate: pruned {freed} bytes of cargo output untouched for {max_age}s from {target}", file=sys.stderr)
            finally:
                release(held)
except OSError as exc:
    print(f"beelink-gate: build cache sweep failed: {exc}", file=sys.stderr)
PY
}

# Gates for different repos run in parallel; cap them per host with flock slots
# so a burst of lanes cannot drive the load past the cores. The slot is taken
# after the repo lock, so gates queued behind one repo hold no slot.
acquire_slot() {
  local slots_dir="$1" max="$2" i announced=
  while :; do
    for ((i = 0; i < max; i++)); do
      exec {slot_fd}>"$slots_dir/slot-$i.lock" || die "cannot open host slot"
      if flock -n -x "$slot_fd"; then return 0; fi
      exec {slot_fd}>&-
    done
    if [ -z "$announced" ]; then
      echo "beelink-gate: waiting for a host gate slot ($max running)" >&2
      announced=1
    fi
    sleep "${BEELINK_GATE_SLOT_POLL_SECONDS:-2}"
  done
}

# Load beyond 1.5x the cores turns timing-sensitive tests red for reasons that
# have nothing to do with the change under test.
load_now() { cut -d' ' -f1 "${BEELINK_GATE_LOADAVG:-/proc/loadavg}"; }
load_limit() { echo $(( $(nproc) * 3 / 2 )); }
# gawk reserves the name `load`; any awk failure counts as over the limit, so a
# broken comparison holds gates instead of admitting them.
over_limit() {
  awk -v cur="$1" -v cap="$2" 'BEGIN { exit !(cur + 0 > cap + 0) }'
  [ "$?" -ne 1 ]
}

# Holds a gate that has its lock and slot until the host is under its load
# limit, the way the disk floor refuses: bounded, with the reason printed.
wait_for_load() {
  local beelink=$1 budget limit load since=$SECONDS reported=-60
  budget=$(seconds_of "${BEELINK_GATE_LOAD_WAIT:-30m}") || die "invalid BEELINK_GATE_LOAD_WAIT: ${BEELINK_GATE_LOAD_WAIT:-}"
  limit=$(load_limit)
  while load=$(load_now) && over_limit "$load" "$limit"; do
    if (( SECONDS - since >= budget )); then
      printf 'beelink-gate: REFUSED %s load %s stayed over its limit of %s (1.5x %s cores) for %ss; use the other beelink or retry later\n' \
        "$beelink" "$load" "$limit" "$(nproc)" "$((SECONDS - since))" >&2
      return 3
    fi
    if (( SECONDS - reported >= 60 )); then
      echo "beelink-gate: waiting $((SECONDS - since))s of ${budget}s: $beelink load $load is over its limit of $limit (1.5x $(nproc) cores)" >&2
      reported=$SECONDS
    fi
    sleep "${BEELINK_GATE_LOAD_POLL_SECONDS:-15}" & wait $!
  done
  start_load=$load
}

declare -A BEELINK_IPS=([beelink1]=100.98.195.7 [beelink2]=100.127.22.51)
REG_EXE=${BEELINK_GATE_REG:-/mnt/c/Windows/System32/reg.exe}
STATE_DIR="${BEELINK_GATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/beelink-gate}"

# Durations such as 45m, 90s, 2h or plain seconds.
seconds_of() {
  local value=$1
  case "$value" in
    *h) value=$(( ${value%h} * 3600 )) ;;
    *m) value=$(( ${value%m} * 60 )) ;;
    *s) value=${value%s} ;;
  esac
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
  echo "$value"
}

# Sets host, owner and repo from a Git URL; they are cache path components.
parse_repo_url() {
  local url=$1 key
  if [[ "$url" =~ ^git@([A-Za-z0-9.-]+):([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[1]}"; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  elif [[ "$url" =~ ^(https|ssh)://(git@)?([A-Za-z0-9.-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[3]}"; owner="${BASH_REMATCH[4]}"; repo="${BASH_REMATCH[5]}"
  elif [[ "$url" =~ ^file:///([A-Za-z0-9_./-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host=local; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  else
    die "expected a Git URL ending in owner/repo[.git]"
  fi
  repo="${repo%.git}"
  for key in "$host" "$owner" "$repo"; do
    if [ "$key" = . ] || [ "$key" = .. ] || [[ "$key" = -* ]]; then die "unsafe repository path"; fi
  done
}

# The cache is keyed by host/owner/repo, so any spelling of that repo (https or
# SSH, with or without .git) owns it; a different repo in that path is refused.
# The checkout keeps the origin it was created with: that transport has already
# fetched on this host, while the caller's spelling may need credentials the
# beelink does not have (an https URL without a token prompts and hangs).
adopt_origin() {
  local checkout=$1 url=$2 origin origin_key
  origin=$(git -C "$checkout" remote get-url origin) || return $?
  origin_key=$(parse_repo_url "$origin" 2>/dev/null && printf '%s/%s/%s' "$host" "$owner" "$repo")
  [ "$origin_key" = "$host/$owner/$repo" ] || die "cache origin mismatch at $checkout: $origin is not $url"
}

# The pnpm version the repo's own CI installs with: package.json packageManager
# (what corepack and pnpm/action-setup read), else the version pinned on
# pnpm/action-setup in a workflow. Only an exact x.y.z is used.
repo_pnpm_version() {
  local version
  version=$(node -e 'const m = /^pnpm@([^+]+)/.exec(require("./package.json").packageManager || ""); if (m) console.log(m[1])' 2>/dev/null)
  local -a workflows=()
  local had_nullglob=0
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob; workflows=(.github/workflows/*.yml .github/workflows/*.yaml)
  [ "$had_nullglob" = 1 ] || shopt -u nullglob
  if [ -z "$version" ] && [ "${#workflows[@]}" -gt 0 ]; then
    version=$(awk '/uses:[[:space:]]*pnpm\/action-setup/ { inside = 1; next }
      inside && /^[[:space:]]*-[[:space:]]/ { inside = 0 }
      inside && $1 == "version:" { gsub(/["\047]/, "", $2); print $2; exit }' "${workflows[@]}" 2>/dev/null)
  fi
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?$ ]] && echo "$version"
}

# One line describing the holder of a lock, from the metadata its gate wrote.
holder_line() {
  local info="$1.holder" pid started sha launcher
  [ -f "$info" ] && [ ! -L "$info" ] || { echo "holder unknown (no metadata; an older gate version)"; return; }
  pid=$(sed -n 's/^pid=//p' "$info"); started=$(sed -n 's/^started=//p' "$info")
  sha=$(sed -n 's/^sha=//p' "$info"); launcher=$(sed -n 's/^launcher=//p' "$info")
  local state=dead
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && state=alive
  echo "holder pid=$pid ($state) sha=${sha:0:12} launcher=${launcher:-unknown} held=$(( $(date +%s) - ${started:-0} ))s"
}

# A gate whose main process is gone can leave children that inherited the lock
# descriptor (gates before this version passed it to the command). Kill only
# processes that hold this lock file open, are in the dead holder's session and
# are not themselves gates. A live holder is never touched.
reclaim_dead_holder() {
  local lock=$1 info="$1.holder" pid sid p fd target self_sid candidates=()
  [ -f "$info" ] && [ ! -L "$info" ] || return 0
  pid=$(sed -n 's/^pid=//p' "$info"); sid=$(sed -n 's/^sid=//p' "$info")
  [[ "$pid" =~ ^[0-9]+$ && "$sid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null && return 0
  self_sid=$(ps -o sid= -p $$ | tr -d ' ')
  [ "$sid" != "$self_sid" ] || return 0
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    [ "$p" != $$ ] || continue
    [ "$(ps -o sid= -p "$p" 2>/dev/null | tr -d ' ')" = "$sid" ] || continue
    for fd in /proc/"$p"/fd/*; do
      target=$(readlink "$fd" 2>/dev/null) || continue
      if [ "$target" = "$lock" ]; then
        case "$(tr '\0' ' ' < /proc/"$p"/cmdline 2>/dev/null)" in *--remote*|*beelink-gate*) ;; *) candidates+=("$p") ;; esac
        break
      fi
    done
  done
  [ "${#candidates[@]}" -gt 0 ] || return 0
  for p in "${candidates[@]}"; do
    echo "beelink-gate: reclaiming lock from dead gate $pid: killing leftover pid $p ($(tr '\0' ' ' < /proc/"$p"/cmdline 2>/dev/null | cut -c1-120))" >&2
    kill -TERM "$p" 2>/dev/null
  done
  sleep 5
  for p in "${candidates[@]}"; do kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null; done
  return 0
}

# Prints one line for `auto`: state=free|busy|refused, cache=warm|cold, load.
remote_probe() {
  [ "$#" -eq 4 ] || die "invalid probe request"
  local beelink repo_url window_day window_hour host owner repo cache_root lock fd state=free cache=cold reason=""
  beelink=$(decode "$1") repo_url=$(decode "$2") window_day=$(decode "$3") window_hour=$(decode "$4") || die "invalid probe encoding"
  parse_repo_url "$repo_url"
  cache_root="${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}"
  reason=$(check_floor "$beelink" 2>&1) || state=refused
  [ "$state" = refused ] || { reason=$(check_update_window "$beelink" "$window_day" "$window_hour" 2>&1) || state=refused; }
  # A repo has BEELINK_GATE_REPO_CHECKOUTS checkouts per host; one free is enough.
  local copies=${BEELINK_GATE_REPO_CHECKOUTS:-2} k suffix free_copy=""
  [[ "$copies" =~ ^[1-9][0-9]*$ ]] || copies=2
  if [ "$state" = free ]; then
    state=busy
    for ((k = 0; k < copies; k++)); do
      suffix=$([ "$k" = 0 ] || echo "@$k")
      lock="$cache_root/.locks/$host-$owner-$repo$suffix.lock"
      if [ ! -e "$lock" ]; then state=free free_copy=$suffix; break; fi
      exec {fd}<"$lock" || die "cannot open lock"
      if flock -n -s "$fd"; then state=free free_copy=$suffix; exec {fd}<&-; break; fi
      exec {fd}<&-
      reason=$(holder_line "$lock")
    done
    [ "$state" = busy ] || reason=""
  fi
  [ -d "$cache_root/$host/$owner/$repo$free_copy/.git" ] && cache=warm
  local max_slots=${BEELINK_GATE_MAX_CONCURRENT:-4} free_slots=0 i slot
  for ((i = 0; i < max_slots; i++)); do
    slot="$cache_root/.locks/slot-$i.lock"
    if [ ! -e "$slot" ]; then free_slots=$((free_slots + 1)); continue; fi
    exec {fd}<"$slot" || continue
    flock -n -s "$fd" && free_slots=$((free_slots + 1))
    exec {fd}<&-
  done
  printf 'beelink-gate-probe host=%s state=%s cache=%s slots=%s load=%s limit=%s reason=%s\n' \
    "$beelink" "$state" "$cache" "$free_slots" "$(load_now)" "$(load_limit)" "$(printf '%s' "$reason" | tr '\n' ' ' | cut -c1-240)"
}

# After a green --ship run, sign what ran and on which tree with this beelink's
# own key, and publish it at refs/ship-proofs/<tree> so the repo's deploy can
# skip repeating the same checks (gtm-agent scripts/ship-proof.mjs). Only repos
# that pin signers in scripts/ship-proof-signers get a proof. The key never
# reaches a command, and a failure here never changes the gate's result.
publish_proof() {
  local key="$HOME/.config/beelink-gate/ship-proof-key" gh="$HOME/bin/gh-drew" tmp tree empty commit status version
  [ -f scripts/ship-proof-signers ] || return 0
  [ "$host" = github.com ] || { echo "beelink-gate: no proof published: $host is not GitHub" >&2; return 0; }
  [ -f "$key" ] || { echo "beelink-gate: no proof published: $beelink has no ship-proof key" >&2; return 0; }
  [ -x "$gh" ] || gh=$(command -v gh-drew) || { echo "beelink-gate: no proof published: gh-drew unavailable on $beelink" >&2; return 0; }
  tree=$(git rev-parse 'HEAD^{tree}') || return 0
  version=$(declare -f remote_gate publish_proof | sha256sum | cut -d' ' -f1)
  tmp=$(mktemp -d) || return 0
  printf 'ship-proof v1\nrepo=%s\ntree=%s\ncommit=%s\ncommand=%s\ngate=%s\nhost=%s\nat=%s\nexit=0\n' \
    "$host/$owner/$repo" "$tree" "$(git rev-parse HEAD)" "${command[*]}" "$version" "$beelink" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp/receipt"
  if ! ssh-keygen -Y sign -q -f "$key" -n ship-proof "$tmp/receipt" </dev/null >/dev/null 2>&1; then
    echo "beelink-gate: no proof published: signing failed" >&2; rm -rf "$tmp"; return 0
  fi
  cat "$tmp/receipt" "$tmp/receipt.sig" > "$tmp/message"
  empty=$("$gh" api -X POST "repos/$owner/$repo/git/trees" --input - --jq .sha <<<'{"tree":[]}' 2>/dev/null) &&
    commit=$("$gh" api -X POST "repos/$owner/$repo/git/commits" -F "message=@$tmp/message" -f "tree=$empty" --jq .sha 2>/dev/null) &&
    status=$("$gh" api -X POST "repos/$owner/$repo/git/refs" -f "ref=refs/ship-proofs/$tree" -f "sha=$commit" --jq .ref 2>&1)
  case "$?:$status" in
    0:refs/ship-proofs/*) echo "beelink-gate: published ship proof for tree $tree at refs/ship-proofs/$tree" >&2 ;;
    *already\ exists*) echo "beelink-gate: a ship proof for tree $tree already exists" >&2 ;;
    *) echo "beelink-gate: no proof published: GitHub refused ($(printf '%s' "${status:-no response}" | tr '\n' ' ' | cut -c1-160))" >&2 ;;
  esac
  rm -rf "$tmp"
  return 0
}

# After a green --ship verify, run the repo's pre-merge chat canary when it
# offers one (`scripts/ship.sh preview <base>`) and names the vault files its
# credentials come from (scripts/ship-preview.vault, one file per line under
# ~/company/devops/secrets). The credentials reach that step only. Exit: 0 when
# the preview passed or the change needs none, 0 when it was refused (ship
# verify stands alone; the reason is printed), 75 when a release preempted it,
# 1 when it failed. The preview's receipt goes into this gate's receipt row.
run_preview() {
  local vault="$HOME/company/devops/secrets" line receipt_file rc
  local -a files=()
  grep -q '^  preview) ' scripts/ship.sh 2>/dev/null && [ -f scripts/ship-preview.vault ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}; line=${line//[[:space:]]/}
    [ -n "$line" ] || continue
    [[ "$line" =~ ^[A-Za-z0-9._-]+\.env$ ]] || { echo "beelink-gate: preview not run: '$line' is not a vault file name" >&2; return 1; }
    [ -f "$vault/$line" ] || { echo "beelink-gate: preview not run: $vault/$line is missing on $beelink" >&2; return 1; }
    files+=(-f "$vault/$line")
  done < scripts/ship-preview.vault
  [ -n "$default_branch" ] || { echo "beelink-gate: preview not run: the remote default branch is unknown" >&2; return 1; }
  receipt_file=$(mktemp) || return 1
  echo "beelink-gate: running the pre-merge preview against origin/$default_branch" >&2
  step npx -y @dotenvx/dotenvx run "${files[@]}" --quiet -- \
    env SHIP_PREVIEW_RECEIPT="$receipt_file" SHIP_PREVIEW_PR="$gate_pr" bash scripts/ship.sh preview "origin/$default_branch"
  rc=$?
  preview_result=$(tail -n 1 "$receipt_file" 2>/dev/null)
  rm -f "$receipt_file"
  case "$rc" in
    0|2) return 0 ;;
    3) return 75 ;;
    *) return 1 ;;
  esac
}

remote_gate() {
  [ "$#" -ge 7 ] || die "invalid remote request"
  local beelink repo_url sha install_mode key host owner repo cache_root checkout origin actual cache_max
  local remote_refs left ref branch window_day window_hour max_hold launcher
  local -a command=()
  beelink=$(decode "$1") || die "invalid beelink encoding"
  repo_url=$(decode "$2") || die "invalid repository encoding"
  sha=$(decode "$3") || die "invalid SHA encoding"
  install_mode=$(decode "$4") || die "invalid install mode encoding"
  window_day=$(decode "$5") || die "invalid update day encoding"
  window_hour=$(decode "$6") || die "invalid update hour encoding"
  case "$install_mode" in install|no-install|ship) ;; *) die "unknown install mode: $install_mode" ;; esac
  shift 6
  while [ "$#" -gt 0 ]; do
    command+=("$(decode "$1")") || die "invalid command encoding"
    shift
  done
  if [ "${#command[@]}" -eq 0 ] || [ -z "${command[0]}" ]; then die "empty command"; fi
  [[ "$sha" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || die "SHA must be a full commit ID"
  max_hold=$(seconds_of "${BEELINK_GATE_MAX_HOLD:-45m}") || die "invalid BEELINK_GATE_MAX_HOLD: ${BEELINK_GATE_MAX_HOLD:-}"
  launcher=${BEELINK_GATE_LAUNCHER:-unknown}
  [[ "$launcher" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || launcher=unknown
  parse_repo_url "$repo_url"

  # The launcher holds stdin open for the gate's whole life. EOF means it died
  # (a killed session, a lost SSH connection), so the gate stops itself.
  watchdog=0 timed_out=0 current="" waited=0 start_load=""
  stop() {
    trap - TERM INT HUP
    [ -z "$current" ] || { kill -TERM -- "-$current" 2>/dev/null; sleep 2; kill -KILL -- "-$current" 2>/dev/null; }
    exit 143
  }
  # Nobody reads the output of a gate whose launcher is gone; writing to the
  # closed channel would end this shell before it stops the step's group.
  trap 'watchdog=1; exec >/dev/null 2>&1; stop' USR1
  trap stop TERM INT HUP
  if [ "${BEELINK_GATE_HEARTBEAT:-0}" = 1 ]; then
    # A background job's stdin defaults to /dev/null, so pass the heartbeat
    # through its own descriptor.
    exec {heartbeat_fd}<&0
    ( exec >/dev/null 2>&1; cat <&"$heartbeat_fd"; kill -USR1 $$ ) &
  fi
  # The launcher's settings are this gate's; a gate the command starts gets its own.
  local ship_workers=${BEELINK_GATE_SHIP_WORKERS:-} gate_pr=${BEELINK_GATE_PR:-}
  [[ "$gate_pr" =~ ^[0-9]*$ ]] || gate_pr=""
  unset BEELINK_GATE_PR
  preview_result="" default_branch=""
  unset BEELINK_GATE_HEARTBEAT BEELINK_GATE_LAUNCHER BEELINK_GATE_MAX_HOLD BEELINK_GATE_SHIP_WORKERS

  export PATH="$HOME/.local/bin:$PATH"
  # Nobody can answer a prompt in a gate: Git fails at once instead of waiting
  # for a password or a host-key confirmation.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"
  check_floor "$beelink" || exit $?
  check_update_window "$beelink" "$window_day" "$window_hour" || exit $?
  cache_root="${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}"
  cache_max="${BEELINK_GATE_CACHE_MAX_BYTES:-42949672960}"
  local max_concurrent="${BEELINK_GATE_MAX_CONCURRENT:-4}"
  local build_root="${XDG_CACHE_HOME:-$HOME/.cache}"
  [[ "$cache_root" = /* ]] || die "cache root must be absolute"
  [[ "$cache_max" =~ ^[1-9][0-9]*$ ]] || die "invalid cache size cap"
  [[ "$max_concurrent" =~ ^[1-9][0-9]*$ ]] || die "invalid concurrent gate cap"
  unset BEELINK_GATE_MAX_CONCURRENT
  # Each repo gets BEELINK_GATE_REPO_CHECKOUTS checkouts per host (default 2):
  # <repo> and <repo>@1, each with its own lock, so two lanes gating one repo do
  # not take both beelinks. On 2026-10-11, 38 gates of one repo from one lane
  # waited 527 min in total behind a single checkout per host.
  local copies=${BEELINK_GATE_REPO_CHECKOUTS:-2} k suffix candidate fd
  [[ "$copies" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_REPO_CHECKOUTS: $copies"
  unset BEELINK_GATE_REPO_CHECKOUTS
  if [ -L "$cache_root" ] || [ -L "$cache_root/.locks" ] || [ -L "$cache_root/$host" ] || [ -L "$cache_root/$host/$owner" ]; then
    die "cache path contains a symlink"
  fi
  mkdir -p "$cache_root/.locks" "$cache_root/$host/$owner" || die "cannot create cache"
  local lock="" waiting_since=$SECONDS last_report=-60
  checkout=""
  while [ -z "$lock" ]; do
    for ((k = 0; k < copies; k++)); do
      suffix=$([ "$k" = 0 ] || echo "@$k")
      candidate="$cache_root/.locks/$host-$owner-$repo$suffix.lock"
      [ ! -L "$candidate" ] && [ ! -L "$candidate.holder" ] || die "lock metadata is a symlink"
      exec {fd}>"$candidate" || die "cannot open lock"
      if flock -n -x "$fd"; then
        lock_fd=$fd lock=$candidate checkout="$cache_root/$host/$owner/$repo$suffix"
        break
      fi
      exec {fd}>&-
      reclaim_dead_holder "$candidate"
    done
    [ -z "$lock" ] || break
    if (( SECONDS - last_report >= 60 )); then
      echo "beelink-gate: waiting $((SECONDS - waiting_since))s for one of $copies $host/$owner/$repo checkouts on $beelink; $(holder_line "$cache_root/.locks/$host-$owner-$repo.lock")" >&2
      last_report=$SECONDS
    fi
    sleep 5 & wait $!
  done
  if [ -L "$checkout" ] || [ -L "$checkout/.git" ]; then die "cache path contains a symlink"; fi
  [ "$checkout" = "$cache_root/$host/$owner/$repo" ] || echo "beelink-gate: using second checkout ${checkout##*/}" >&2
  printf 'pid=%s\nsid=%s\nstarted=%s\nsha=%s\nlauncher=%s\n' \
    $$ "$(ps -o sid= -p $$ | tr -d ' ')" "$(date +%s)" "$sha" "$launcher" > "$lock.holder" || die "cannot write lock metadata"
  acquire_slot "$cache_root/.locks" "$max_concurrent"
  wait_for_load "$beelink" || exit $?
  unset BEELINK_GATE_LOAD_WAIT
  waited=$((SECONDS - waiting_since))
  echo "beelink-gate: lock, host slot and load ($start_load, limit $(load_limit)) admitted on $beelink after ${waited}s" >&2
  local started=$SECONDS deadline=$((SECONDS + max_hold)) display
  printf -v display '%q ' "${command[@]}"
  # Each step is its own process group (timeout's), bounded by the remaining
  # hold budget, without the lock descriptor and without the launcher's stdin.
  step() {
    local left=$((deadline - SECONDS)) rc
    if (( left <= 0 )); then timed_out=1; return 124; fi
    timeout -k 30 "$left" "$@" {lock_fd}>&- {slot_fd}>&- </dev/null &
    current=$!
    wait "$current"; rc=$?
    current=""
    if [ "$rc" = 124 ] && (( SECONDS >= deadline )); then
      timed_out=1
      echo "beelink-gate: hold limit of ${max_hold}s reached; stopped $1" >&2
    fi
    return "$rc"
  }
  receipt() {
    local status="$1" ran=$((SECONDS - started))
    local preview_verdict
    preview_verdict=$(printf '%s' "$preview_result" | python3 -c 'import json,sys; t=sys.stdin.read().strip(); print(json.loads(t).get("verdict","?") if t else "none")' 2>/dev/null || echo "?")
    printf 'beelink-gate receipt: sha=%s install=%s command=%s exit=%s duration=%ss waited=%ss host=%s timed_out=%s watchdog=%s load=%s preview=%s\n' \
      "$sha" "$install_mode" "${display% }" "$status" "$ran" "$waited" "$beelink" "$timed_out" "$watchdog" "${start_load:-?}" "$preview_verdict" >&2
    mkdir -p "$STATE_DIR" 2>/dev/null && python3 - "$STATE_DIR/receipts.jsonl" "$beelink" "$host/$owner/$repo" "$sha" "$install_mode" \
      "${display% }" "$status" "$waited" "$ran" "$timed_out" "$watchdog" "$launcher" "${start_load:-}" "${preview_result:-}" <<'PY' || true
import json, sys, time
path, beelink, repo, sha, mode, command, status, waited, ran, timed_out, watchdog, launcher, load, preview = sys.argv[1:]
row = {"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "host": beelink, "repo": repo, "sha": sha,
       "mode": mode, "command": command, "exit": int(status), "waited_s": int(waited), "ran_s": int(ran),
       "timed_out": timed_out == "1", "watchdog": watchdog == "1", "launcher": launcher,
       "start_load": float(load) if load else None}
if preview:
    try:
        row["preview"] = json.loads(preview)
    except ValueError:
        row["preview"] = {"unreadable": True}
with open(path, "a") as out:
    out.write(json.dumps(row) + "\n")
PY
  }
  finish() {
    local status=$?
    trap - EXIT
    [ -z "$current" ] || { kill -TERM -- "-$current" 2>/dev/null; sleep 2; kill -KILL -- "-$current" 2>/dev/null; }
    if [ -d "$checkout/.git" ]; then
      if ! touch "$checkout/.git/beelink-gate-used" && [ "$status" -eq 0 ]; then status=3; fi
    fi
    # A gate whose launcher is gone frees its lock now; the next gate prunes
    # before it fetches.
    if [ "$watchdog" = 1 ]; then
      :
    elif cd "$cache_root"; then
      if ! prune_cache "$cache_root" "$checkout" "$cache_max" && [ "$status" -eq 0 ]; then status=3; fi
      prune_build_dirs "$build_root" "$cache_root/.locks" "$lock" "${BEELINK_GATE_BUILD_MAX_AGE_SECONDS:-86400}"
    elif [ "$status" -eq 0 ]; then
      status=3
    fi
    rm -f "$lock.holder"
    receipt "$status"
    exit "$status"
  }
  trap finish EXIT
  # The final admission checks run after lock and slot acquisition so their
  # refusals need the same cleanup and receipt path as later failures.
  check_floor "$beelink" || exit $?
  check_update_window "$beelink" "$window_day" "$window_hour" || exit $?
  prune_cache "$cache_root" "$checkout" "$cache_max" || exit $?

  if [ -e "$checkout/.git" ] && [ ! -d "$checkout/.git" ]; then
    die "cache path is not an owned checkout: $checkout"
  fi
  if [ -e "$checkout/.git" ]; then
    adopt_origin "$checkout" "$repo_url" || exit $?
    # A blame or history check can otherwise fetch hundreds of missing blobs
    # one by one. The cache is disposable, and the repo lock is held here.
    if git -C "$checkout" config --get-regexp '^(remote\.origin\.(promisor|partialclonefilter)|extensions\.partialclone)$' >/dev/null; then
      echo "beelink-gate: rebuilding partial cache with complete history at $checkout" >&2
      rm -rf -- "$checkout" || exit $?
    fi
  fi
  if [ ! -e "$checkout/.git" ]; then
    [ ! -e "$checkout" ] || die "cache path exists without .git: $checkout"
    git init -q "$checkout" || exit $?
    git -C "$checkout" remote add origin "$repo_url" || exit $?
  fi
  adopt_origin "$checkout" "$repo_url" || exit $?
  # A step, not a command substitution: bash runs the launcher watchdog's trap
  # only between commands, so a hung ls-remote in $(...) held the lock for 34m.
  local refs_file="$checkout/.git/beelink-gate-remote-refs"
  step timeout 120 git -C "$checkout" ls-remote --symref origin HEAD 'refs/heads/*' > "$refs_file" || exit $?
  remote_refs=$(cat "$refs_file") || exit $?
  local -a tracking_refspecs=()
  local -A seen_branches=()
  while IFS=$'\t' read -r left ref; do
    branch=
    if [[ "$left" == 'ref: refs/heads/'* && "$ref" == HEAD ]]; then
      branch=${left#ref: refs/heads/}
      default_branch=$branch
    elif [[ "$ref" == refs/heads/* ]]; then
      if [[ "$ref" == refs/heads/main || "$ref" == refs/heads/develop || "${left,,}" == "${sha,,}" ]]; then
        branch=${ref#refs/heads/}
      fi
    fi
    if [ -n "$branch" ] && [ -z "${seen_branches[$branch]:-}" ]; then
      tracking_refspecs+=("+refs/heads/$branch:refs/remotes/origin/$branch")
      seen_branches[$branch]=1
    fi
  done <<< "$remote_refs"
  echo "beelink-gate: fetching $sha and ${#tracking_refspecs[@]} tracking branch(es) into $checkout" >&2
  step timeout 1200 git -C "$checkout" fetch --no-tags origin "$sha" "${tracking_refspecs[@]}" || exit $?
  git -C "$checkout" checkout --detach --force "$sha" || exit $?
  git -C "$checkout" clean -ffdx || exit $?
  actual=$(git -C "$checkout" rev-parse HEAD) || exit $?
  [ "${actual,,}" = "${sha,,}" ] || die "checkout SHA mismatch: $actual"
  check_floor "$beelink" || exit $?

  # Rust output lives inside .git, which checkout and clean leave alone, so it
  # survives between gates and the LRU cap counts and evicts it with its repo.
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$checkout/.git/beelink-gate-target}"
  # Incremental state is a third of a debug target and gates rarely reuse it.
  export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
  cd "$checkout" || exit $?
  # Install and run with the repo's pnpm, not the beelink's: pnpm 11 enforces
  # minimumReleaseAge and pnpm 10 ignores it, so a gate on 10 passed an install
  # that CI on 11 refused. The shim covers the install, the command and ship.sh.
  local want_pnpm have_pnpm
  if [ -f pnpm-lock.yaml ] && want_pnpm=$(repo_pnpm_version); then
    have_pnpm=$(pnpm --version 2>/dev/null || true)
    if [ "$want_pnpm" != "$have_pnpm" ]; then
      mkdir -p "$checkout/.git/beelink-gate-bin" || exit $?
      printf '#!/usr/bin/env bash\nexec npx --yes "pnpm@%s" "$@"\n' "$want_pnpm" > "$checkout/.git/beelink-gate-bin/pnpm" || exit $?
      chmod +x "$checkout/.git/beelink-gate-bin/pnpm" || exit $?
      export PATH="$checkout/.git/beelink-gate-bin:$PATH"
      echo "beelink-gate: using the repo's pnpm $want_pnpm (beelink has ${have_pnpm:-none})" >&2
    fi
  fi
  if [ "$install_mode" = ship ]; then
    [ -f scripts/ship.sh ] || die "--ship: $owner/$repo at ${sha:0:12} has no scripts/ship.sh"
    if [ -s .nvmrc ]; then
      [ -s "$HOME/.nvm/nvm.sh" ] || die "--ship: .nvmrc needs nvm on $beelink"
      # shellcheck disable=SC1091
      . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
      nvm use >/dev/null 2>&1 || nvm install >/dev/null 2>&1 || die "--ship: cannot select Node $(cat .nvmrc)"
    fi
    # Size the test pool to the cores the host has spare: other gates and lanes
    # share it, and a real-browser test starved beside eight workers on a host
    # at load 50 timed out at 120 s.
    local cores load spare workers
    cores=$(nproc)
    load=${BEELINK_GATE_LOAD:-$(cut -d' ' -f1 /proc/loadavg)}
    spare=$(( cores - ${load%.*} ))
    workers=${ship_workers:-$spare}
    (( workers <= cores / 2 )) || workers=$(( cores / 2 ))
    # Two workers stretched a GTM verify to 15 min at load 23; four keeps most of
    # the relief now that the real-browser test has a budget sized to load.
    (( workers >= 4 )) || workers=4
    export SHIP_MAX_WORKERS=$workers
    echo "beelink-gate: --ship runs scripts/ship.sh verify with node $(node -v 2>/dev/null) and SHIP_MAX_WORKERS=$workers (load $load on $cores cores)" >&2
  elif [ "$install_mode" = no-install ]; then
    echo "beelink-gate: skipping dependency install for this check" >&2
  elif [ -f pnpm-lock.yaml ]; then
    command -v pnpm >/dev/null || die "pnpm unavailable on beelink"
    step pnpm install --frozen-lockfile --store-dir "$HOME/.local/share/pnpm/store" || exit $?
  elif [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
    command -v npm >/dev/null || die "npm unavailable on beelink"
    step npm ci --cache "$HOME/.npm" || exit $?
  elif [ -f package.json ]; then
    # A dependency-free package needs no install. A package with dependencies
    # and no lock cannot have a frozen install, so fail the gate.
    node -e 'const p=require("./package.json"); process.exit(Object.keys(p.dependencies||{}).length || Object.keys(p.devDependencies||{}).length || Object.keys(p.optionalDependencies||{}).length ? 1 : 0)' \
      || die "package.json has dependencies but no pnpm/npm lockfile"
    echo "beelink-gate: dependency-free package; no frozen install needed" >&2
  fi
  check_floor "$beelink" || exit $?
  echo "beelink-gate: running ${display% }" >&2
  step "${command[@]}"
  local status=$?
  if [ "$status" -eq 0 ] && [ "$install_mode" = ship ]; then
    run_preview
    status=$?
    [ "$status" -ne 0 ] || publish_proof
  fi
  exit "$status"
}

if [ "${1:-}" = --window-probe ]; then
  shift
  check_update_window "$@"
  exit $?
fi
if [ "${1:-}" = --remote ]; then
  shift
  remote_gate "$@"
fi
if [ "${1:-}" = --probe ]; then
  shift
  remote_probe "$@"
  exit $?
fi

# ---- launcher: runs on the Mac, GTR or a beelink ----

# The beelink this launcher runs on, if any.
self_beelink() {
  [ -x "$REG_EXE" ] || return 0
  case "${BEELINK_GATE_SELF:-$(hostname)}" in
    beelink1|DESKTOP-18IR33V) echo beelink1 ;;
    beelink2) echo beelink2 ;;
  esac
}
SELF=$(self_beelink)

# Runs this script with arguments on a beelink: locally on itself, else in WSL
# over SSH. stdin carries the script (SSH) and then stays open as the heartbeat.
on_beelink() {
  local target=$1; shift
  local -a envs=("BEELINK_GATE_LAUNCHER=$launcher_name")
  [ -z "${BEELINK_GATE_MAX_HOLD:-}" ] || envs+=("BEELINK_GATE_MAX_HOLD=$BEELINK_GATE_MAX_HOLD")
  [ -z "${BEELINK_GATE_LOAD_WAIT:-}" ] || envs+=("BEELINK_GATE_LOAD_WAIT=$BEELINK_GATE_LOAD_WAIT")
  [ -z "${BEELINK_GATE_SHIP_WORKERS:-}" ] || envs+=("BEELINK_GATE_SHIP_WORKERS=$BEELINK_GATE_SHIP_WORKERS")
  [[ "${BEELINK_GATE_PR:-}" =~ ^[0-9]+$ ]] && envs+=("BEELINK_GATE_PR=$BEELINK_GATE_PR")
  [ -z "${BEELINK_GATE_MAX_CONCURRENT:-}" ] || envs+=("BEELINK_GATE_MAX_CONCURRENT=$BEELINK_GATE_MAX_CONCURRENT")
  [ -z "${BEELINK_GATE_REPO_CHECKOUTS:-}" ] || envs+=("BEELINK_GATE_REPO_CHECKOUTS=$BEELINK_GATE_REPO_CHECKOUTS")
  [ "${heartbeat:-0}" = 1 ] && envs+=("BEELINK_GATE_HEARTBEAT=1")
  local me=$$ rc heartbeat_fd heartbeat_pid command_pid
  heartbeat_input() {
    local sleeper="" include_script=${1:-0}
    trap 'if [ -n "$sleeper" ]; then kill -TERM "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; fi; exit 0' TERM INT
    [ "$include_script" = 1 ] && cat "$0"
    while kill -0 "$me" 2>/dev/null; do
      sleep 5 & sleeper=$!
      wait "$sleeper" || true
      sleeper=""
    done
  }
  stop_heartbeat() {
    kill -TERM "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true
    exec {heartbeat_fd}<&-
  }
  if [ "$target" = "$SELF" ] && [ "${heartbeat:-0}" = 1 ]; then
    exec {heartbeat_fd}< <(heartbeat_input)
    heartbeat_pid=$!
    env "${envs[@]}" bash "$0" "$@" <&"$heartbeat_fd" &
    command_pid=$!
    wait "$command_pid"; rc=$?
    stop_heartbeat
  elif [ "$target" = "$SELF" ]; then
    env "${envs[@]}" bash "$0" "$@" </dev/null
    rc=$?
  elif [ "${heartbeat:-0}" = 1 ]; then
    exec {heartbeat_fd}< <(heartbeat_input 1)
    heartbeat_pid=$!
    ssh -o BatchMode=yes -o ConnectTimeout=15 "${BEELINK_IPS[$target]}" wsl.exe -- env "${envs[@]}" bash -s -- "$@" <&"$heartbeat_fd" &
    command_pid=$!
    wait "$command_pid"; rc=$?
    stop_heartbeat
  else
    ssh -o BatchMode=yes -o ConnectTimeout=15 "${BEELINK_IPS[$target]}" wsl.exe -- env "${envs[@]}" bash -s -- "$@" \
      < <(cat "$0")
    rc=$?
  fi
  return "$rc"
}

# The policy rarely changes, so the last good read is kept per host. WSL interop
# (reg.exe) fails under load, and SSH can time out; a read up to seven days old
# still keeps gates out of the update window.
read_policy() {
  local target=$1 key='HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' policy="" cache
  cache="$STATE_DIR/policy-$target"
  if [ "$target" = "$SELF" ]; then
    policy=$(timeout 20 "$REG_EXE" query "$key" 2>/dev/null) || policy=""
  fi
  if ! grep -q ScheduledInstallDay <<<"$policy"; then
    policy=$(ssh -o BatchMode=yes -o ConnectTimeout=15 "${BEELINK_IPS[$target]}" reg query "$key" 2>/dev/null) || policy=""
  fi
  if grep -q ScheduledInstallDay <<<"$policy"; then
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$policy" > "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" 2>/dev/null
    printf '%s\n' "$policy"
    return 0
  fi
  if [ -f "$cache" ] && [ -n "$(find "$cache" -mmin -10080 2>/dev/null)" ]; then
    echo "beelink-gate: using the cached Windows Update policy for $target" >&2
    cat "$cache"
    return 0
  fi
  return 1
}

# Sets window_day and window_hour from the beelink's Windows Update policy.
update_window_of() {
  local target=$1 policy day_hex hour_hex
  policy=$(read_policy "$target") || { echo "beelink-gate: cannot read Windows Update schedule from $target; refusing to start" >&2; return 2; }
  policy=$(printf '%s' "$policy" | tr -d '\r')
  day_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallDay" && $2 == "REG_DWORD" {print $3}')
  hour_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallTime" && $2 == "REG_DWORD" {print $3}')
  [[ "$day_hex" =~ ^0x[0-9a-fA-F]{1,8}$ && "$hour_hex" =~ ^0x[0-9a-fA-F]{1,8}$ ]] \
    || { echo "beelink-gate: invalid Windows Update schedule from $target; refusing to start" >&2; return 2; }
  window_day=$((16#${day_hex#0x}))
  window_hour=$((16#${hour_hex#0x}))
  (( window_day <= 7 && window_hour <= 23 )) \
    || { echo "beelink-gate: invalid Windows Update day/hour from $target; refusing to start" >&2; return 2; }
}

encode() { printf '%s' "$1" | base64 | tr -d '\n'; }

# One probe line for a beelink, or nothing when it cannot be read.
probe_of() {
  local target=$1
  update_window_of "$target" 2>/dev/null || return 1
  heartbeat=0 on_beelink "$target" --probe "$(encode "$target")" "$(encode "$repo_url")" "$(encode "$window_day")" "$(encode "$window_hour")" 2>/dev/null \
    | grep '^beelink-gate-probe ' | tail -1
}
field() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<<"$2"; }
overloaded() { local load limit; load=$(field load "$1") limit=$(field limit "$1"); [ -n "$load" ] && [ -n "$limit" ] && over_limit "$load" "$limit"; }

# A named beelink over its load limit hands the gate to the other one when that
# one can start it under its own limit; otherwise the gate stays and waits there.
place_named() {
  local named=$1 other line other_line
  other=$([ "$named" = beelink1 ] && echo beelink2 || echo beelink1)
  line=$(probe_of "$named") || line=""
  if [ -z "$line" ] || ! overloaded "$line"; then echo "$named"; return 0; fi
  other_line=$(probe_of "$other") || other_line=""
  if [ -n "$other_line" ] && [ "$(field state "$other_line")" != refused ] && ! overloaded "$other_line"; then
    echo "beelink-gate: $named load $(field load "$line") is over its limit of $(field limit "$line"); running on $other (load $(field load "$other_line"), limit $(field limit "$other_line"))" >&2
    echo "$other"; return 0
  fi
  echo "$named"
}

# Probes both beelinks and prints the one to use; waits while both are busy.
choose_beelink() {
  local target line state cache load slots best="" best_rank=9 best_load rank waited=0 reported=-60 light_busy
  local -A seen=()
  local auto_started=$SECONDS
  while :; do
    best="" best_rank=9 best_load="" light_busy=""
    for target in beelink1 beelink2; do
      line=$(probe_of "$target") || line=""
      [ -n "$line" ] || { seen[$target]="unreachable"; continue; }
      seen[$target]=${line#beelink-gate-probe }
      state=$(sed -n 's/.* state=\([a-z]*\).*/\1/p' <<<"$line"); cache=$(sed -n 's/.* cache=\([a-z]*\).*/\1/p' <<<"$line")
      load=$(sed -n 's/.* load=\([0-9.]*\).*/\1/p' <<<"$line")
      slots=$(sed -n 's/.* slots=\([0-9]*\).*/\1/p' <<<"$line")
      if [ "$state" = busy ] && ! overloaded "$line"; then light_busy=$target; fi
      # A free repo lock with no free host slot still queues, behind any gate.
      case "$state:$cache:$([ "${slots:-1}" -gt 0 ] && echo slot || echo full)" in
        free:warm:slot) rank=0 ;; free:cold:slot) rank=1 ;; free:*:full) rank=2 ;; *) continue ;;
      esac
      # Any host under its load limit beats one over it; the gate on an
      # overloaded host would only wait for the load to fall.
      ! overloaded "$line" || rank=$((rank + 3))
      if (( rank < best_rank )) || { (( rank == best_rank )) && awk -v a="${load:-0}" -v b="${best_load:-1e9}" 'BEGIN{exit !(a < b)}'; }; then
        best=$target best_rank=$rank best_load=$load
      fi
    done
    # A repo lock frees in minutes; load over the limit can last the whole
    # load wait. Keep probing rather than queue on an overloaded host while
    # the other one is under its limit and only busy with this repo.
    if (( best_rank >= 3 )) && [ -n "$light_busy" ]; then best=""; fi
    if [ -n "$best" ]; then
      echo "beelink-gate: auto chose $best after ${waited}s (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      echo "$best"; return 0
    fi
    if [ "${seen[beelink1]:-}" = unreachable ] && [ "${seen[beelink2]:-}" = unreachable ]; then
      echo "beelink-gate: no beelink is reachable from $(hostname)" >&2; return 2
    fi
    if [[ "${seen[beelink1]:-}" != *state=busy* && "${seen[beelink2]:-}" != *state=busy* ]]; then
      echo "beelink-gate: no beelink can start this gate (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2; return 3
    fi
    if (( waited - reported >= 60 )); then
      echo "beelink-gate: no beelink is both free for this repo and under its load limit after ${waited}s; waiting (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      reported=$waited
    fi
    sleep "${BEELINK_GATE_AUTO_POLL_SECONDS:-20}"; waited=$((SECONDS - auto_started))
  done
}

install_mode=install
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-install) install_mode=no-install; shift ;;
    --ship) install_mode=ship; shift ;;
    *) break ;;
  esac
done
usage="usage: beelink-gate [--no-install] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
       beelink-gate --ship <beelink1|beelink2|auto> <repo-url> <sha>"
if [ "$install_mode" = ship ]; then
  [ "$#" -eq 3 ] || die "$usage"
  set -- "$1" "$2" "$3" -- bash scripts/ship.sh verify
fi
if [ "$#" -lt 5 ] || [ "$4" != -- ]; then
  die "$usage"
fi
target=$1 repo_url=$2 sha=$3
shift 4
if [ -n "${BEELINK_GATE_MAX_CONCURRENT:-}" ]; then
  [[ "$BEELINK_GATE_MAX_CONCURRENT" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_MAX_CONCURRENT"
fi
if [ -n "${BEELINK_GATE_LOAD_WAIT:-}" ]; then
  seconds_of "$BEELINK_GATE_LOAD_WAIT" >/dev/null || die "invalid BEELINK_GATE_LOAD_WAIT: $BEELINK_GATE_LOAD_WAIT"
fi
[[ "$sha" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || die "SHA must be a full commit ID"
launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
case "$target" in
  beelink1|100.98.195.7) target=$(place_named beelink1) ;;
  beelink2|100.127.22.51) target=$(place_named beelink2) ;;
  auto) target=$(choose_beelink) || exit $? ;;
  *) die "unknown beelink: $target" ;;
esac
update_window_of "$target" || exit 2
encoded=()
for arg in "$target" "$repo_url" "$sha" "$install_mode" "$window_day" "$window_hour" "$@"; do
  encoded+=("$(encode "$arg")")
done
heartbeat=1 on_beelink "$target" --remote "${encoded[@]}"
