    git -C "$checkout" checkout --force -B "$gate_branch" "$sha" || exit $?
    git -C "$checkout" branch --set-upstream-to="origin/$gate_branch" "$gate_branch" >/dev/null || exit $?
    git -C "$checkout" config push.default current || exit $?
