fi
cancel_launcher_job() {
  # Repeats do nothing: GNU timeout signals the child and then its process group,
  # and --retry forwards a stop the group also received, so a second TERM would
  # otherwise end the launcher before it schedules the cancellation. A no-op trap,
  # unlike an ignored signal, leaves an inline --cancel-job stoppable.
  trap : HUP INT TERM
  frontend_tainted=1
  [ -z "${gate_id:-}" ] || schedule_cancellation "$gate_id"
  exit 143
}
run_cancelable() {
  if [ "$cancel_on_term" = 1 ]; then
    "$@" &
    local child=$! rc
    wait "$child"; rc=$?
    return "$rc"
  fi
  "$@"
}
# Sandbox placement (beelink_gate_sandbox.mjs): an auto gate that both Beelinks refuse, or that
# has waited BEELINK_GATE_SANDBOX_AFTER (default 5m), runs the same command on a Tangle sandbox.
sandbox_after=$(seconds_of "${BEELINK_GATE_SANDBOX_AFTER:-5m}") || die "invalid BEELINK_GATE_SANDBOX_AFTER"
sandbox_off=$([ "$requested" = auto ] && [ "${BEELINK_GATE_SANDBOX:-1}" != 0 ] && echo 0 || echo 1)
sandbox_due() { [ "$sandbox_off" = 0 ] && (( SECONDS - launched >= sandbox_after )); }
run_sandbox() {
  # Checkout reservations stay up: when no box can start, the gate keeps its place on the Beelinks.
  local receipt rc host row node_pid
  receipt=$(mktemp) || return "$TEMPFAIL"
  # Creates from this launcher start at least BEELINK_GATE_SANDBOX_SPACING (20 s) apart, so a burst of
  # waiting gates never hits the platform's create path at once.
  local spacing=${BEELINK_GATE_SANDBOX_SPACING:-20} stamp="${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate/sandbox-create" last spacing_fd
  mkdir -p "${stamp%/*}" && exec {spacing_fd}>"$stamp.lock" && flock "$spacing_fd" || return "$TEMPFAIL"
  last=$(cat "$stamp" 2>/dev/null || echo 0)
  (( $(date +%s) - last >= spacing )) || sleep $(( spacing - ($(date +%s) - last) ))
  date +%s > "$stamp"; exec {spacing_fd}>&-
  BEELINK_GATE_SANDBOX_RECEIPT=$receipt BEELINK_GATE_PLACED_WAIT=$((SECONDS - launched)) \
    node "$(dirname "$(readlink -f "$0")")/beelink_gate_sandbox.mjs" run "$repo_url" "$sha" "$install_mode" \
    "${gate_class:-$([ "$install_mode" = light ] && echo light || echo normal)}" "${gate_branch:-}" -- "$@" &
  node_pid=$!
  # A stop reaches the runner, which deletes its box; bash would otherwise hold the trap until node returns.
  trap 'kill -TERM "$node_pid" 2>/dev/null; wait "$node_pid"; exit 143' HUP INT TERM
  wait "$node_pid"; rc=$?
  trap - HUP INT TERM
  if [ -s "$receipt" ]; then
    # The receipt of record is a commit status on the gated SHA (context beelink-gate), which --receipt and
    # gh-drew read from any host; the Beelink copy only feeds --report and is best effort.
    python3 - "$receipt" <<'PY' | xargs -0 -r "$(command -v gh-drew || command -v gh)" api -X POST >/dev/null || echo "beelink-gate: sandbox receipt status not posted: $(cat "$receipt")" >&2
import json, re, sys
r = json.load(open(sys.argv[1]))
m = re.fullmatch(r"github\.com/([^/]+/[^/]+)", r["repo"])
if m:
    desc = f"exit={r['exit']} mode={r['mode']} class={r['class']} gate={r['gate_id']}"
    sys.stdout.write("\0".join([f"repos/{m[1]}/statuses/{r['sha']}", "-f", "context=beelink-gate",
                                 "-f", f"state={'success' if r['exit'] == 0 else 'failure'}", "-f", f"description={desc}"]))
PY
    row=$(encode "$(cat "$receipt")")
    for host in beelink1 beelink2; do
      heartbeat=0 on_beelink "$host" --sandbox-receipt "$row" && { row=""; break; }
    done
    [ -z "$row" ] || echo "beelink-gate: sandbox receipt not stored on a beelink: $(cat "$receipt")" >&2
  fi
  rm -f "$receipt"
  return "$rc"
}
launched=$SECONDS placements=0
