# The beelink this launcher runs on, if any.
self_beelink() {
  [ -x "$REG_EXE" ] || return 0
  case "${BEELINK_GATE_SELF:-$(hostname)}" in
    beelink1|DESKTOP-18IR33V) echo beelink1 ;;
    beelink2) echo beelink2 ;;
  esac
}
SELF=$(self_beelink)
# Each beelink's newest install reserve for the gated commit's checkout shape;
# a gate on one host falls back to the other's.
declare -A matched_reserve=() matched_warm_reserve=()

# Connection timeouts and SSH keepalives do not bound a hung WSL command.
# Only short control calls use this deadline; submitted gates keep their hold.
TRANSPORT_TIMEOUT_SECONDS=30
TRANSPORT_KILL_GRACE_SECONDS=2
bounded_transport() {
  local label=$1 timer rc; shift
  timer=$(command -v timeout || command -v gtimeout) || {
    echo "beelink-gate: cannot bound $label: GNU timeout is unavailable" >&2
    return "$TEMPFAIL"
  }
  "$timer" --kill-after="${TRANSPORT_KILL_GRACE_SECONDS}s" "${TRANSPORT_TIMEOUT_SECONDS}s" "$@"; rc=$?
  case "$rc" in
    124|137)
      echo "beelink-gate: $label unconfirmed (exit $rc; transport deadline $TRANSPORT_TIMEOUT_SECONDS seconds)" >&2
      return "$TEMPFAIL"
      ;;
  esac
  return "$rc"
}

# Runs this script with arguments on a beelink: locally on itself, else in WSL
# over SSH. stdin carries the script (SSH) and then stays open as the heartbeat.

# The policy rarely changes, so the last good read is kept per host. WSL interop
# (reg.exe) fails under load, and SSH can time out; a read up to seven days old
# still keeps gates out of the update window.
read_policy() {
  local target=$1 key='HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' policy="" cache
  cache="$STATE_DIR/policy-$target"
  if [ "$target" = "$SELF" ]; then
    policy=$(timeout 20 "$REG_EXE" query "$key" 2>/dev/null) || policy=""
  fi
  if ! grep -q ScheduledInstallDay <<<"$policy"; then
    policy=$(bounded_transport "$target Windows Update policy" ssh "${SSH_OPTIONS[@]}" "${BEELINK_IPS[$target]}" reg query "$key" 2>/dev/null) || policy=""
  fi
  if grep -q ScheduledInstallDay <<<"$policy"; then
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$policy" > "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" 2>/dev/null
    printf '%s\n' "$policy"
    return 0
  fi
  if [ -f "$cache" ] && [ -n "$(find "$cache" -mmin -10080 2>/dev/null)" ]; then
    echo "beelink-gate: using the cached Windows Update policy for $target" >&2
    cat "$cache"
    return 0
  fi
  return 1
}

# Sets window_day and window_hour from the beelink's Windows Update policy.
update_window_of() {
  local target=$1 policy day_hex hour_hex
  policy=$(read_policy "$target") || { echo "beelink-gate: cannot read Windows Update schedule from $target; refusing to start" >&2; return 2; }
  policy=$(printf '%s' "$policy" | tr -d '\r')
  day_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallDay" && $2 == "REG_DWORD" {print $3}')
  hour_hex=$(printf '%s\n' "$policy" | awk '$1 == "ScheduledInstallTime" && $2 == "REG_DWORD" {print $3}')
  [[ "$day_hex" =~ ^0x[0-9a-fA-F]{1,8}$ && "$hour_hex" =~ ^0x[0-9a-fA-F]{1,8}$ ]] \
    || { echo "beelink-gate: invalid Windows Update schedule from $target; refusing to start" >&2; return 2; }
  window_day=$((16#${day_hex#0x}))
  window_hour=$((16#${hour_hex#0x}))
  (( window_day <= 7 && window_hour <= 23 )) \
    || { echo "beelink-gate: invalid Windows Update day/hour from $target; refusing to start" >&2; return 2; }
}

encode() { printf '%s' "$1" | base64 | tr -d '\n'; }

# One probe line for a beelink, or nothing when it cannot be read.
probe_of() {
  local target=$1 attempt line
  # A busy beelink's sshd drops some new connections (MaxStartups) while
  # hundreds of lane sessions are open; one dropped probe made auto treat the
  # host as unreachable for a whole placement round (ADC #10352, 2026-10-12
  # 00:01Z, beelink2 at load 70 answering SSH in under a second).
  for attempt in 1 2 3; do
    if update_window_of "$target" 2>/dev/null; then
      line=$(heartbeat=0 on_beelink "$target" --probe "$(encode "$target")" "$(encode "$repo_url")" "$(encode "$window_day")" "$(encode "$window_hour")" "$(encode "$([ "${gate_class:-}" = dev ] && echo dev || echo "$install_mode")")" "$(encode "$install_mode")" 2>/dev/null \
        | grep '^beelink-gate-probe ' | tail -1)
      [ -z "$line" ] || { echo "$line"; return 0; }
    fi
    (( attempt == 3 )) || sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"
  done
  return 1
}
field() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<<"$2"; }
overloaded() { local load limit; load=$(field load "$1") limit=$(field limit "$1"); [ -n "$load" ] && [ -n "$limit" ] && over_limit "$load" "$limit"; }

# A named beelink over its load limit hands the gate to the other one when that
# one can start it under its own limit; otherwise the gate stays and waits there.
place_named() {
  local named=$1 other line other_line
  if [ "${pin_host:-0}" = 1 ]; then echo "$named"; return 0; fi
  other=$([ "$named" = beelink1 ] && echo beelink2 || echo beelink1)
  line=$(probe_of "$named") || line=""
  if [ -z "$line" ] || ! overloaded "$line"; then echo "$named"; return 0; fi
  other_line=$(probe_of "$other") || other_line=""
  if [ -n "$other_line" ] && [ "$(field state "$other_line")" != refused ] && ! overloaded "$other_line"; then
    echo "beelink-gate: $named load $(field load "$line") is over its limit of $(field limit "$line"); running on $other (load $(field load "$other_line"), limit $(field limit "$other_line"))" >&2
    echo "$other"; return 0
  fi
  echo "$named"
}

# Probes both beelinks and prints the one to use; waits while both are busy.
choose_beelink() {
  local target line state cache load slots best="" best_rank=9 best_load rank waited=0 reported=-60 light_busy next
  local -A seen=()
  local auto_started=$SECONDS
  while :; do
    check_checkout_reservations
    best="" best_rank=9 best_load="" light_busy=""
    for target in beelink1 beelink2; do
      [ -z "${checkout_reservation_lost[$target]:-}" ] || { seen[$target]="unreachable"; continue; }
      line=$(probe_of "$target") || line=""
      [ -n "$line" ] || { seen[$target]="unreachable"; continue; }
      seen[$target]=${line#beelink-gate-probe }
      state=$(sed -n 's/.* state=\([a-z]*\).*/\1/p' <<<"$line"); cache=$(sed -n 's/.* cache=\([a-z]*\).*/\1/p' <<<"$line")
      load=$(sed -n 's/.* load=\([0-9.]*\).*/\1/p' <<<"$line")
      slots=$(sed -n 's/.* slots=\([0-9]*\).*/\1/p' <<<"$line")
      if [ "$state" = busy ] && ! overloaded "$line"; then light_busy=$target; fi
      # A free repo lock with no free host slot still queues, behind any gate.
      case "$state:$cache:$([ "${slots:-1}" -gt 0 ] && echo slot || echo full)" in
        free:warm:slot) rank=0 ;; free:cold:slot) rank=1 ;; free:*:full) rank=2 ;; *) continue ;;
      esac
      # Any host that can admit beats an overloaded one. If both would wait,
      # a warm cache cannot admit sooner than a cold cache: prefer the host
      # closer to its pressure limit while keeping a free slot ahead of a full pool.
      if overloaded "$line"; then
        case "$rank" in 0|1) rank=3 ;; *) rank=5 ;; esac
      fi
      if (( rank < best_rank )) || { (( rank == best_rank )) && awk -v a="${load:-0}" -v b="${best_load:-1e9}" 'BEGIN{exit !(a < b)}'; }; then
        best=$target best_rank=$rank best_load=$load
      fi
    done
    # A repo lock frees in minutes; load over the limit can last the whole
    # load wait. Keep probing rather than queue on an overloaded host while
    # the other one is under its limit and only busy with this repo.
    if (( best_rank >= 3 )) && [ -n "$light_busy" ]; then best=""; fi
    if [ -n "$best" ]; then
      check_checkout_reservations
      [ -z "${checkout_reservation_lost[$best]:-}" ] || continue
      echo "beelink-gate: auto chose $best after ${waited}s (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      echo "$best"; return 0
    fi
    if [ "${seen[beelink1]:-}" = unreachable ] && [ "${seen[beelink2]:-}" = unreachable ]; then
      tempfail "$(utc_in_minutes 5)" "no beelink is reachable from $(hostname)"
    fi
    if [[ "${seen[beelink1]:-}" != *state=busy* && "${seen[beelink2]:-}" != *state=busy* ]]; then
      echo "beelink-gate: no beelink can start this gate (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      # The earliest time either refusing host names.
      next=$(printf '%s\n' "$(field next "${seen[beelink1]:-}")" "$(field next "${seen[beelink2]:-}")" | grep -E '^[0-9]{4}-' | sort | head -1)
      tempfail "${next:-$(utc_in_minutes 5)}" "no beelink can start this gate"
    fi
    if (( waited - reported >= 60 )); then
      echo "beelink-gate: no beelink is both free for this repo and under its load limit after ${waited}s; waiting (beelink1: ${seen[beelink1]:-?}; beelink2: ${seen[beelink2]:-?})" >&2
      reported=$waited
    fi
    sleep "${BEELINK_GATE_AUTO_POLL_SECONDS:-$([ "${BEELINK_GATE_URGENT:-0}" = 1 ] && echo 2 || echo 20)}"; waited=$((SECONDS - auto_started))
  done
}

# Auto gates need a place on both hosts before they probe. Without a durable
# normal ticket, a gate spending minutes between probes can lose every freed
# checkout to a newly arrived gate. Urgent gates use their priority marker.
reserve_checkout() {
  local beelink repo_url gate_class host owner repo cache_root suffix="" marker rc priority=urgent epoch="" token=""
  beelink=$(decode "$1") repo_url=$(decode "$2") gate_class=$(decode "$3")
  if [ "$#" = 6 ]; then
    priority=$(decode "$4") epoch=$(decode "$5") token=$(decode "$6")
    [ "$priority" = normal ] && [[ "$epoch" =~ ^[0-9]+$ && "$token" =~ ^[0-9a-f]{32}$ ]] || die "invalid normal checkout reservation"
  fi
  parse_repo_url "$repo_url"
  cache_root="${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}"
  [ "$gate_class" = dev ] && suffix=@dev
  [ "$gate_class" = light ] && suffix=@light
  if [ "$priority" = normal ]; then
    marker="$cache_root/.locks/queue-$host-$owner-$repo$suffix.$epoch.$$"
  else
    marker="$cache_root/.locks/urgent-$host-$owner-$repo$suffix.$$"
  fi
  mkdir -p "$cache_root/.locks" || die "cannot create checkout reservation"
  ticket_body "$token" > "$marker" || die "cannot create checkout reservation"
  trap 'rm -f "$marker"; exit 143' HUP INT TERM
  echo "beelink-gate-$priority-reserved $beelink"
  # The launcher keeps stdin open. EOF removes the reservation even if its
  # session dies; a timeout merely means that no heartbeat bytes arrived.
  while :; do
    IFS= read -r -t 5 _; rc=$?
    (( rc == 0 || rc > 128 )) || break
  done
  rm -f "$marker"
  trap - HUP INT TERM
}

checkout_reservation_pids=() checkout_reservation_files=() checkout_reservation_hosts=() checkout_reservation_dir="" checkout_monitor_pid=""
declare -A checkout_reservation_lost=()
stop_checkout_reservations() {
  local pid file
  [ -z "$checkout_monitor_pid" ] || kill -TERM "$checkout_monitor_pid" 2>/dev/null || true
  for file in "${checkout_reservation_files[@]}"; do : > "$file.stop"; done
  for pid in "${checkout_reservation_pids[@]}"; do wait "$pid" 2>/dev/null || true; done
  [ -z "$checkout_reservation_dir" ] || rm -rf "$checkout_reservation_dir"
}

watch_checkout_admission() {
  local log=$1 file
  while :; do
    if grep -q '^beelink-gate: lock, host slot .* admitted on ' "$log" 2>/dev/null; then
      for file in "${checkout_reservation_files[@]}"; do : > "$file.stop"; done
      return 0
    fi
    sleep 0.2
  done
}
start_checkout_reservations() {
  local priority=${1:-urgent} host file pid tries
  local -a args=()
  checkout_reservation_dir=$(mktemp -d) || die "cannot allocate checkout reservation state"
  trap stop_checkout_reservations EXIT
  trap 'exit 143' HUP INT TERM
  for host in beelink1 beelink2; do
    file="$checkout_reservation_dir/$host"
    args=("$(encode "$host")" "$(encode "$repo_url")" "$(encode "$([ "$gate_class" = dev ] && echo dev || echo "$install_mode")")")
    if [ "$priority" = normal ]; then
      args+=("$(encode normal)" "$(encode "$reservation_epoch")" "$(encode "$reservation_token")")
    fi
    BEELINK_GATE_HEARTBEAT_STOP="$file.stop" heartbeat=1 on_beelink "$host" --urgent-reserve "${args[@]}" >"$file" 2>"$file.err" &
    checkout_reservation_pids+=("$!")
    checkout_reservation_files+=("$file")
    checkout_reservation_hosts+=("$host")
  done
  # One host that cannot reserve (unreachable, or its reservation died) must not
  # stop auto: a named gate still runs on the other one, so auto keeps the hosts
  # that reserved and places only on them. On 2026-10-17/18 a single sick
  # Beelink made every auto gate exit 75 while named gates ran.
  local i reserved=()
  for i in "${!checkout_reservation_files[@]}"; do
    file=${checkout_reservation_files[$i]} host=${checkout_reservation_hosts[$i]}
    for ((tries = 0; tries < 300; tries++)); do
      grep -q "^beelink-gate-$priority-reserved " "$file" 2>/dev/null && break
      kill -0 "${checkout_reservation_pids[$i]}" 2>/dev/null || break
      sleep 0.1
    done
    if grep -q "^beelink-gate-$priority-reserved " "$file" 2>/dev/null; then
      reserved+=("$host")
    else
      cat "$file.err" >&2
      : > "$file.stop"
      kill -TERM "${checkout_reservation_pids[$i]}" 2>/dev/null || true
      checkout_reservation_lost[$host]=1
      echo "beelink-gate: $host did not reserve a checkout place; auto places only on the other beelink" >&2
    fi
  done
  (( ${#reserved[@]} > 0 )) || tempfail "$(utc_in_minutes 5)" "cannot reserve checkout priority on either beelink"
  local where="on both beelinks"
  (( ${#reserved[@]} == 2 )) || where="on ${reserved[*]} only"
  if [ "$priority" = urgent ]; then
    echo "beelink-gate: urgent priority reserved $where" >&2
  else
    echo "beelink-gate: normal FIFO place reserved $where" >&2
  fi
}

# Marks a host whose reservation ended as lost; exits 75 only when none is left.
check_checkout_reservations() {
  [ -n "${checkout_reservation_dir:-}" ] || return 0
  local i host live=0
  for i in "${!checkout_reservation_pids[@]}"; do
    host=${checkout_reservation_hosts[$i]}
    [ -z "${checkout_reservation_lost[$host]:-}" ] || continue
    if kill -0 "${checkout_reservation_pids[$i]}" 2>/dev/null; then
      live=1
    else
      checkout_reservation_lost[$host]=1
      echo "beelink-gate: $host checkout reservation ended; auto places only on the other beelink" >&2
    fi
  done
  (( live )) || tempfail "$(utc_in_minutes 5)" "checkout reservation disconnected before admission"
}

if [ "${1:-}" = --urgent-reserve ]; then
  { [ "$#" = 4 ] || [ "$#" = 7 ]; } || die "invalid checkout reservation"
  reserve_checkout "${@:2}"
  exit 0
fi

# --receipt <repo-url> <sha>: every receipt both beelinks hold for that repo and
# SHA, one JSON line each with its gate_id and the host it came from ("from").
# gh-drew reads this before it merges a release-path PR, so a merge rests on the
# gate's own receipt, never on a wrapper's exit code: on 2026-10-18 a lane script
# recorded exit=0 for gate beelink2-b1b7743870eff2dc7da8260d77e65fcd, whose
# receipt says exit=1, and discovery-lab#2009 merged on it. Exit 0 with rows,
# 1 with none, 75 when a beelink cannot be read and the others hold no row (a partial read is never "none").
# Rows from the beelinks that answered still print with exit 0: a passing receipt is enough, and on
# 2026-10-18 beelink2 offline for hours made every discovery-lab merge refuse despite beelink1 receipts.
if [ "${1:-}" = --receipt ]; then
  [ "$#" = 3 ] && [[ "$3" =~ ^[0-9a-f]{40}$ ]] || die "usage: beelink-gate --receipt <repo-url> <sha (40 hex)>"
  key=$(python3 -c 'import re,sys; u=sys.argv[1]; m=re.match(r"^(?:git@([^:]+):|ssh://git@([^/]+)/|https?://([^/]+)/)(.+?)(?:\.git)?/?$", u); print(f"{m.group(1) or m.group(2) or m.group(3)}/{m.group(4)}" if m else "")' "$2")
  [ -n "$key" ] || die "--receipt: cannot read a host/owner/repo from $2"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  host_rows=$(mktemp) found=$(mktemp) unread=""
  for host in beelink1 beelink2; do
    if heartbeat=0 on_beelink "$host" --receipts 720 > "$host_rows" 2>/dev/null \
      || { sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"; heartbeat=0 on_beelink "$host" --receipts 720 > "$host_rows" 2>/dev/null; }; then
      python3 - "$host_rows" "$host" "$key" "$3" >> "$found" <<'PY'
import json, sys
path, host, key, sha = sys.argv[1:]
for line in open(path, errors="replace"):
    try:
        row = json.loads(line)
    except ValueError:
        continue
    if row.get("repo") == key and row.get("sha") == sha:
        print(json.dumps({"from": host, **row}))
PY
    else
      echo "beelink-gate: --receipt could not read $host's receipts" >&2
      unread="$unread $host"
    fi
  done
  cat "$found"
  if [ -s "$found" ]; then rc=0; elif [ -n "$unread" ]; then rc=$TEMPFAIL; else rc=1; fi
  # Name what was read, so a refusal is not mistaken for the down host's fault: on 2026-10-18
  # agent-runtime#1832 refused with only "could not read beelink2" while beelink1 held no receipt either.
  # Only with a host unread: gh-drew reads any stderr here as "a beelink was not read".
  if [ ! -s "$found" ] && [ -n "$unread" ]; then
    read_hosts=$(for host in beelink1 beelink2; do [[ " $unread " == *" $host "* ]] || printf '%s ' "$host"; done)
    echo "beelink-gate: --receipt found no receipt for $3 on ${read_hosts:-no reachable beelink}(unknown:$unread)" >&2
  fi
  rm -f "$host_rows" "$found"
  exit "$rc"
fi

# --report [hours]: gate runs per merged PR by repo, from both beelinks' receipts
# and GitHub's merged-PR counts, with each repo's modes, exit classes and
# exact-input repeats (same SHA, mode and command), to tell rework from re-runs.
if [ "${1:-}" = --report ]; then
  shift
  hours=24 report_format="" report_since=""
  if [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then hours=$1; shift; fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) report_format=--json; shift ;;
      --since) [ "$#" -ge 2 ] || die "--since needs a UTC timestamp"; report_since=$2; shift 2 ;;
      *) die "usage: beelink-gate --report [hours] [--json] [--since timestamp]" ;;
    esac
  done
  report_dir=$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")
  cpu_source=$(encode "$(cat "$report_dir/beelink_gate_cpu.py")") || die "cannot load CPU sampler"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  receipts_file=$(mktemp) host_rows=$(mktemp) missing=""
  for host in beelink1 beelink2; do
    # One retry, then a loud partial: on 2026-10-14 one dropped B1 read silently
    # turned a 352-run window into a B2-only 115 runs at 1.0 runs per merged PR.
    if heartbeat=0 on_beelink "$host" --receipts "$hours" "$cpu_source" > "$host_rows" 2>/dev/null \
      || { sleep "${BEELINK_GATE_PROBE_RETRY_SECONDS:-2}"; heartbeat=0 on_beelink "$host" --receipts "$hours" "$cpu_source" > "$host_rows" 2>/dev/null; }; then
      sed "s/^{/{\"from\": \"$host\", /" "$host_rows" >> "$receipts_file"
    else
      echo "beelink-gate: --report could not read $host's receipts" >&2
      missing+="${missing:+,}$host"
    fi
  done
  rm -f "$host_rows"
  merged_lookup=$(command -v gh-drew || command -v gh || true)
  report_module=$report_dir/beelink_gate_report.py
  python3 "$report_module" "$receipts_file" "$hours" "$merged_lookup" "$missing" "$report_format" "$report_since"
  status=$?
  rm -f "$receipts_file"
  exit "$status"
fi

if [ "${1:-}" = --attach ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "usage: beelink-gate --attach <gate-id>"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  heartbeat=0 on_beelink "$target" --job-attach "$2"
  rc=$?
  if [ "$rc" = 255 ]; then
    # SSH also exits 255 on transport loss. A completed command may itself
    # have returned 255; ask the job's exit file before calling it a loss.
    result=$(heartbeat=0 on_beelink "$target" --job-result "$2" 2>/dev/null) || result=""
    [ "$result" = 255 ] || tempfail "$(utc_in_minutes 5)" "attach connection lost for $2; run beelink-gate --attach $2 again"
  fi
  exit "$rc"
fi
if [ "${1:-}" = --cancel-job ]; then
  [ "$#" = 2 ] && [[ "$2" =~ ^beelink[12]-[0-9a-f]{32}$ ]] || die "invalid cancellation id"
  launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
  target=${2%%-*}
  # A manager's cgroup can vanish immediately after scheduling this unit.
  # Limit the existing retry loop to five elapsed minutes. Never
  # start a call or sleep unless its full transport bound still fits.
  cancel_deadline=$((SECONDS + 300))
  cancel_call_bound=$((TRANSPORT_TIMEOUT_SECONDS + TRANSPORT_KILL_GRACE_SECONDS))
  for ((attempt=0; attempt<60 && SECONDS + cancel_call_bound <= cancel_deadline; attempt++)); do
    heartbeat=0 on_beelink "$target" --job-cancel "$2"
    cancel_status=$?
    case "$cancel_status" in
      0) exit 0 ;;
      130|143)
        echo "beelink-gate: cancellation unconfirmed for $2; cancellation transport interrupted, remote state unknown" >&2
        exit "$cancel_status"
        ;;
    esac
    (( SECONDS + 5 + cancel_call_bound <= cancel_deadline )) || break
    sleep 5
  done
  tempfail "$(utc_in_minutes 5)" "cancellation unconfirmed for $2; remote gate may still be running under its existing hold; retry beelink-gate --cancel-job $2"
fi

# --summary: a red gate's test counts and failing tests, printed last so a
# caller's tail still shows the cause. It reads the node test runner's spec
# reporter ("ℹ tests 3" counts, the "✖ failing tests:" section), TAP
# ("# tests 3" counts, each "not ok" line with its indented diagnostics) and
# vitest ("Test Files  1 failed | 2 passed (3)" counts, each "FAIL  file > test"
# line with its error's first line).
summarize_output() {  # <exit code> <output file>...
  python3 - "$@" <<'PY' >&2
import re, sys
code, paths = sys.argv[1], sys.argv[2:]
ansi = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
keys = "tests|suites|pass|fail|cancelled|skipped|todo|duration_ms"
count = re.compile(rf"^(?:ℹ|#) ({keys}) (\S+)$")
not_ok = re.compile(r"^(\s*)not ok\b")
vitest_count = re.compile(r"^\s*(Test Files|Tests)\s{2,}((?:\d+ [a-z]+(?: \| )?)+) \((\d+)\)$")
vitest_fail = re.compile(r"^\s*FAIL\s{1,2}\S")
groups, blocks = [], []
def close(block, kind):
    # A suite's own "not ok" only says that a subtest failed; the subtest's block has the cause.
    if kind == "tap" and any("failureType: 'subtestsFailed'" in l for l in block):
        return
    while block and not block[-1].strip():
        block.pop()
    blocks.append(block)
for path in paths:
    group, block, kind, depth = {}, None, None, 0
    try:
        lines = open(path, encoding="utf-8", errors="replace")
    except OSError:
        continue
    with lines:
        for raw in lines:
            line = ansi.sub("", raw.rstrip("\r\n"))
            if block is not None and kind == "vitest":
                # A vitest failure ends at its "⎯" rule or the next FAIL; keep the error's first line.
                if not (line.startswith("⎯") or vitest_fail.match(line)):
                    if line.strip() and len(block) < 2:
                        block.append(line)
                    continue
                close(block, kind)
                block = None
            if block is not None:
                indent = len(line) - len(line.lstrip())
                if not line.strip() or (kind == "spec" and (indent or line.startswith(("test at ", "✖ ")))) \
                        or (kind == "tap" and indent > depth):
                    block.append(line)
                    continue
                close(block, kind)
                block = None
            match = count.match(line)
            if match:
                group[match[1]] = match[2]
                continue
            if (match := vitest_count.match(line)):
                prefix = "files_" if match[1] == "Test Files" else ""
                group["files" if prefix else "tests"] = match[3]
                for n, state in re.findall(r"(\d+) ([a-z]+)", match[2]):
                    group[prefix + state] = n
                continue
            if group:
                groups.append(group)
                group = {}
            if line == "✖ failing tests:":
                block, kind = [line], "spec"
            elif vitest_fail.match(line):
                block, kind = [line.strip()], "vitest"
            elif (match := not_ok.match(line)):
                block, kind, depth = [line], "tap", len(match[1])
    if block is not None:
        close(block, kind)
    if group:
        groups.append(group)
print(f"beelink-gate: summary of the failed command (exit {code})")
shown = [l for b in blocks for l in b]
limit = 200
for l in shown[:limit]:
    print(l)
if len(shown) > limit:
    print(f"beelink-gate: summary omitted {len(shown) - limit} more failing-test lines; the full output is above")
for g in groups:
    print("beelink-gate: summary " + " ".join(f"{k}={v}" for k, v in g.items()))
if not blocks and not groups:
    print("beelink-gate: summary found no test counts or failing tests in the command output")
PY
}

# --merge PR: after a green gate, `gh-drew pr merge PR -R owner/repo --squash
# --match-head-commit SHA`, so the merge lands exactly the commit the gate ran.
# gh-drew owns the merge preconditions (merge-on-green's hold, unanswered review
# threads, a running Codex review), so they are not repeated here. Lanes had
# each written a wait-for-gate-then-merge script (graph-canary flow.sh and
# merge-1818.sh, 2026-10-17). A red or TEMPFAIL gate never merges; a merge
# gh-drew refuses exits MERGE_REFUSED with its reason.
MERGE_REFUSED=78
merge_pr="" merge_repo="" merge_sha=""
github_repo() {  # <repo-url>: prints owner/name of a GitHub URL, or fails
  local r=$1
  case "$r" in
    git@github.com:*) r=${r#git@github.com:} ;;
    ssh://git@github.com/*) r=${r#ssh://git@github.com/} ;;
    https://github.com/*) r=${r#https://github.com/} ;;
    *) return 1 ;;
  esac
  r=${r%/}; r=${r%.git}
  [[ "$r" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  printf '%s\n' "$r"
}
merge_gated() {  # <gate stderr log>
  local id out sha
  id=$(grep -ao 'gate_id=[A-Za-z0-9-]*' "$1" | tail -n 1)
  id=${id#gate_id=}
  # gh-drew requires this gate's own receipt for a release-path repo (its gated_repos).
  if out=$(BEELINK_GATE_ID="$id" gh-drew pr merge "$merge_pr" -R "$merge_repo" --squash --match-head-commit "$merge_sha" 2>&1); then
    sha=$(gh-drew pr view "$merge_pr" -R "$merge_repo" --json mergeCommit --jq '.mergeCommit.oid // ""' 2>/dev/null)
    echo "beelink-gate: merged #$merge_pr ${sha:-unknown} gate_id=${id:-unknown}" >&2
    return 0
  fi
  echo "beelink-gate: merge of #$merge_pr refused: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 300)" >&2
  return "$MERGE_REFUSED"
}

# --retry MINUTES and --summary run this launcher again as a child with the rest
# of the request and keep each attempt's output. --retry submits again at the
# next_allowed of each attempt's TEMPFAIL line until MINUTES pass. A TEMPFAIL
# that names a gate still running ("run beelink-gate --attach <id>") is
# re-attached after 10 s instead, so a lost connection never starts a duplicate
# gate, and a re-attached auto gate that gave its host back (76) is submitted
# again at once, as the launcher itself does. A 75 without a TEMPFAIL line (a
# canceled gate or the command's own 75) ends the retries.
utc_at() { python3 -c 'import datetime as d, sys; print(d.datetime.fromtimestamp(int(sys.argv[1]), d.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))' "$1"; }
epoch_of_utc() { python3 -c 'import datetime as d, sys; print(int(d.datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=d.timezone.utc).timestamp()))' "$1" 2>/dev/null; }
schedule_cancellation() {  # <gate id>
  echo "beelink-gate: manager stopped; scheduling cancellation of gate_id=$1" >&2
  # Without systemd-run (the Mac has neither it nor /usr/bin/bash) cancel inline.
  systemd-run --user --collect --unit="beelink-gate-cancel-$1" /usr/bin/bash "$0" --cancel-job "$1" >&2 \
    || "$BASH" "$0" --cancel-job "$1" >&2
}
wrap_child="" wrap_sleep="" wrap_stop=""
wrap_signal() {  # <exit code>
  # A repeat changes nothing: GNU timeout signals the launcher and then its process group.
  [ -z "$wrap_stop" ] || return 0
  wrap_stop=$1
  # A background child starts with SIGINT ignored, so every stop reaches it as TERM.
  # With --cancel-on-term a launcher child cancels its own gate, and wrap_stopped
  # cancels a gate the wrapper re-attached to; without it the gate runs on for --attach.
  [ -z "$wrap_child" ] || kill -TERM "$wrap_child" 2>/dev/null || true
  [ -z "$wrap_sleep" ] || kill -TERM "$wrap_sleep" 2>/dev/null || true
}
wrap_stopped() {  # <exit code> <gate id this wrapper attaches to, or empty>
  [ "$cancel_on_term" != 1 ] || [ -z "$2" ] || schedule_cancellation "$2"
  exit "$1"
}
run_wrapped() {  # <retry minutes, or empty> <summary 0|1> <launcher arguments>...
  local minutes=$1 summary=$2 deadline=0 attempt=0 rc line next wait_s reattach="" got tee_out tee_err i
  shift 2
  local dir
  dir=$(mktemp -d) || die "cannot allocate the gate transcript"
  # shellcheck disable=SC2064 # expand the directory now; it is local to this function.
  trap "rm -rf '$dir'" EXIT
  trap 'wrap_signal 143' TERM
  trap 'wrap_signal 129' HUP
  trap 'wrap_signal 130' INT
  [ -z "$minutes" ] || deadline=$(( $(date +%s) + minutes * 60 ))
  while :; do
    [ -z "$wrap_stop" ] || wrap_stopped "$wrap_stop" "$reattach"
    attempt=$((attempt + 1))
    rm -f "$dir/out" "$dir/err"
    mkfifo "$dir/out" "$dir/err" || die "cannot create the gate transcript pipes"
    # The copies ignore stop signals, so a TERM sent to the whole process group
    # cannot cut off the child's own cancellation output; they end at its EOF.
    (trap '' HUP INT TERM; exec tee "$dir/out.log" < "$dir/out") & tee_out=$!
    (trap '' HUP INT TERM; exec tee "$dir/err.log" < "$dir/err" >&2) & tee_err=$!
    if [ -n "$reattach" ]; then
      "$BASH" "$0" --attach "$reattach" > "$dir/out" 2> "$dir/err" & wrap_child=$!
    else
      "$BASH" "$0" "$@" > "$dir/out" 2> "$dir/err" & wrap_child=$!
    fi
    # A stop that came before the child's pid was known is forwarded here.
    [ -z "$wrap_stop" ] || kill -TERM "$wrap_child" 2>/dev/null || true
    wait "$wrap_child"; rc=$?
    # A forwarded stop interrupts wait; keep waiting while the child handles it.
    while [ -n "$wrap_stop" ] && kill -0 "$wrap_child" 2>/dev/null; do wait "$wrap_child"; rc=$?; done
    wrap_child=""
    # A process the child left behind may still hold the pipes; stop copying after 5s.
    for ((i = 0; i < 50; i++)); do
      kill -0 "$tee_out" 2>/dev/null || kill -0 "$tee_err" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL "$tee_out" "$tee_err" 2>/dev/null || true
    wait "$tee_out" "$tee_err" 2>/dev/null || true
    [ -z "$wrap_stop" ] || wrap_stopped "$rc" "$reattach"
    [ -n "$minutes" ] || break
    line=""
    if [ "$rc" = "$NOT_ADMITTED" ] && [ -n "$reattach" ]; then
      reattach="" wait_s=0 got="exit $NOT_ADMITTED (the gate gave its host back)"
    elif [ "$rc" = "$TEMPFAIL" ]; then
      line=$(grep -a '^beelink-gate: TEMPFAIL next_allowed=' "$dir/err.log" | tail -n 1)
      if [ -z "$line" ]; then
        tempfail "$(utc_in_minutes 5)" "--retry $minutes: attempt $attempt exited 75 without a TEMPFAIL line (a canceled gate or the command's own 75); not retrying it"
      fi
      reattach="" got=TEMPFAIL
      if [[ "$line" =~ beelink-gate\ --attach\ (beelink[12]-[0-9a-f]{32}) ]]; then
        # The gate runs on: reconnect soon, whatever the line's next_allowed says.
        reattach=${BASH_REMATCH[1]} wait_s=10
      else
        next=${line#beelink-gate: TEMPFAIL next_allowed=}
        if next=$(epoch_of_utc "${next%% *}"); then
          wait_s=$(( next - $(date +%s) ))
          (( wait_s >= 30 )) || wait_s=30
        else
          wait_s=300
        fi
      fi
    else
      break
    fi
    # The test suite's hook to shorten every wait; callers never set it.
    [ -z "${BEELINK_GATE_RETRY_SECONDS:-}" ] || wait_s=$BEELINK_GATE_RETRY_SECONDS
    if (( $(date +%s) + wait_s > deadline )); then
      echo "beelink-gate: --retry $minutes: the next attempt could not start before the retry window ends at $(utc_at "$deadline"); stopping after $attempt attempts" >&2
      [ -n "$line" ] || tempfail "$(utc_in_minutes 0)" "the last gate gave its host back; submit it again"
      echo "$line" >&2
      exit "$TEMPFAIL"
    fi
    echo "beelink-gate: --retry $minutes: attempt $attempt got $got; attempt $((attempt + 1)) ${reattach:+re-attaches to $reattach and }starts at $(utc_at $(( $(date +%s) + wait_s ))) (window ends $(utc_at "$deadline"))" >&2
    sleep "$wait_s" & wrap_sleep=$!
    [ -z "$wrap_stop" ] || kill -TERM "$wrap_sleep" 2>/dev/null || true
    wait "$wrap_sleep"
    wrap_sleep=""
  done
  if [ "$summary" = 1 ] && [ "$rc" != 0 ] && [ "$rc" != "$TEMPFAIL" ]; then
    summarize_output "$rc" "$dir/out.log" "$dir/err.log"
  fi
  if [ -n "$merge_pr" ] && [ "$rc" = 0 ]; then
    merge_gated "$dir/err.log" || rc=$?
  fi
  exit "$rc"
}

install_mode=install gate_branch="" gate_class="" pin_host=0 cancel_on_term=0 retry_minutes="" summary=0
launch_options=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --retry) [[ "${2:-}" =~ ^[1-9][0-9]{0,3}$ ]] && (( 10#$2 <= 1440 )) || die "--retry needs whole minutes from 1 to 1440"
      retry_minutes=$((10#$2)); shift 2; continue ;;
    --summary) summary=1; shift; continue ;;
    --merge) [[ "${2:-}" =~ ^[1-9][0-9]{0,8}$ ]] || die "--merge needs a pull request number"
      merge_pr=$2; shift 2; continue ;;
    --urgent|--pin-host|--cancel-on-term|--no-install|--light|--dev|--ship) launch_options+=("$1") ;;
    --branch) launch_options+=("$1" "${2:-}") ;;
  esac
  case "$1" in
    --urgent) export BEELINK_GATE_URGENT=1; shift ;;
    --pin-host) pin_host=1; shift ;;
    --cancel-on-term) cancel_on_term=1; shift ;;
    --no-install) [ "$install_mode" = light ] || install_mode=no-install; shift ;;
    --light) [ "$install_mode" != ship ] || die "--light cannot be combined with --ship"; install_mode=light; shift ;;
    --dev) gate_class=dev; shift ;;
    --ship) [ "$install_mode" != light ] || die "--light cannot be combined with --ship"; install_mode=ship; shift ;;
    --branch) [ "$#" -ge 2 ] || die "--branch needs a branch name"
      valid_branch_name "$2" || die "invalid --branch: $2"
      gate_branch=$2; shift 2 ;;
    *) break ;;
  esac
done
usage="usage: beelink-gate [--no-install|--light|--dev] [--urgent] [--pin-host] [--cancel-on-term] [--branch <name>] [--retry <minutes>] [--summary] [--merge <pr>] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
       beelink-gate --ship [--retry <minutes>] [--summary] <beelink1|beelink2|auto> <repo-url> <sha>"
if [ "$gate_class" = dev ]; then
  case "$install_mode" in ship|light) die "--dev cannot be combined with --$install_mode" ;; esac
fi
if [ -n "${BEELINK_GATE_RETRY_SECONDS:-}" ] && [[ ! "$BEELINK_GATE_RETRY_SECONDS" =~ ^[1-9][0-9]{0,4}$ ]]; then
  die "invalid BEELINK_GATE_RETRY_SECONDS: $BEELINK_GATE_RETRY_SECONDS"
fi
if [ -n "$merge_pr" ]; then
  [ "$gate_class" != dev ] || die "--merge cannot be combined with --dev: a dev gate is not the merge gate; gate the final head without --dev"
  [ "$install_mode" != ship ] || die "--merge cannot be combined with --ship"
  { [ "$#" -ge 5 ] && [ "$4" = -- ]; } || die "$usage"
  merge_repo=$(github_repo "$2") || die "--merge needs a GitHub repo URL, not $2"
  merge_sha=$3
fi
if [ -n "$retry_minutes" ] || [ "$summary" = 1 ] || [ -n "$merge_pr" ]; then
  run_wrapped "$retry_minutes" "$summary" ${launch_options[@]+"${launch_options[@]}"} "$@"
fi
if [ "$install_mode" = ship ]; then
  [ "$#" -eq 3 ] || die "$usage"
  set -- "$1" "$2" "$3" -- bash scripts/ship.sh verify
fi
if [ "$#" -lt 5 ] || [ "$4" != -- ]; then
  die "$usage"
fi
target=$1 repo_url=$2 sha=$3
if [ "$pin_host" = 1 ] && [ "$target" = auto ]; then die "--pin-host requires a named beelink"; fi
shift 4
# agent-container stopped merging on a local signoff on 2026-10-14 (agent-dev-container
# #10892): its PRs merge on green CI and develop runs the full suite after merge. Sessions
# that loaded the old rule kept holding Beelink slots the CI runners on the same hosts need.
if [[ "$repo_url" =~ tangle-network/agent-(dev-)?container(\.git)?$ ]] && [ "$gate_class" != dev ] \
  && [[ " $* " =~ [[:space:]/](signoff(\.sh)?|revision-receipt\.mjs)[[:space:]] ]]; then
  die "agent-container no longer merges on a local signoff. Push and stop: merge-on-green merges the PR once Fast Checks, Build and Type Check pass, and develop runs the full suite after merge (agent-dev-container docs/processes/shipping.md). For an iterative run of affected tests use --dev."
fi
if [ -n "${BEELINK_GATE_MAX_CONCURRENT:-}" ]; then
  [[ "$BEELINK_GATE_MAX_CONCURRENT" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_MAX_CONCURRENT"
fi
if [ -n "${BEELINK_GATE_MAX_CPU_PRESSURE:-}" ]; then
  max_cpu_pressure >/dev/null
fi
if [ -n "${BEELINK_GATE_STARVE_AFTER:-}" ]; then
  seconds_of "$BEELINK_GATE_STARVE_AFTER" >/dev/null || die "invalid BEELINK_GATE_STARVE_AFTER: $BEELINK_GATE_STARVE_AFTER"
fi
if [ -n "${BEELINK_GATE_LOAD_WAIT:-}" ]; then
  seconds_of "$BEELINK_GATE_LOAD_WAIT" >/dev/null || die "invalid BEELINK_GATE_LOAD_WAIT: $BEELINK_GATE_LOAD_WAIT"
fi
[[ "$sha" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || die "SHA must be a full commit ID"
[[ -z "${BEELINK_GATE_PR:-}" || "${BEELINK_GATE_PR:-}" =~ ^[1-9][0-9]*$ ]] || die "invalid BEELINK_GATE_PR"
if [ -z "${BEELINK_GATE_LANE:-}" ]; then
  BEELINK_GATE_LANE=${FLEET_LANE:-}
  if [ -z "$BEELINK_GATE_LANE" ] && [[ "${FLEET_STATUS_FILE:-}" =~ /([^/]+)--([^/]+)\.md$ ]]; then
    BEELINK_GATE_LANE="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
  fi
fi
[[ "$BEELINK_GATE_LANE" =~ ^[A-Za-z0-9._:-]{0,128}$ ]] || die "invalid gate lane"
export BEELINK_GATE_LANE
unset BEELINK_GATE_RESERVATION_TOKEN
launcher_name=$(hostname | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
# The gated commit's checkout shape, read before any beelink fetches it, so each
# host's reserve comes from a receipt of the same shape (last_install_reserve_bytes).
commit_sparse_spec() {  # <repo-url> <sha>; prints nothing when it cannot tell
  local host owner repo gh raw err
  parse_repo_url "$1" 2>/dev/null || return 0
  if [ "$host" = github.com ]; then
    gh=$(command -v gh-drew || command -v gh) || return 0
    err=$(mktemp) || return 0
    if raw=$("$gh" api "repos/$owner/$repo/contents/.beelink-gate/sparse-checkout?ref=$2" --jq .content 2>"$err"); then
      printf '%s' "$raw" | tr -d '\n' | base64 --decode | sparse_spec_of
    elif grep -q 'HTTP 404' "$err"; then
      echo full
    fi
    rm -f "$err"
  elif [ "$host" = local ] && git -C "${1#file://}" cat-file -e "$2^{commit}" 2>/dev/null; then
    git -C "${1#file://}" cat-file blob "$2:.beelink-gate/sparse-checkout" 2>/dev/null | sparse_spec_of
  fi
}
BEELINK_GATE_SPARSE_SPEC=""
case "$install_mode" in
  install|ship)
    BEELINK_GATE_SPARSE_SPEC=$(commit_sparse_spec "$repo_url" "$sha")
    if [ -n "$BEELINK_GATE_SPARSE_SPEC" ]; then
      for reserve_host in beelink1 beelink2; do
        reserve_lines=$(heartbeat=0 on_beelink "$reserve_host" --reserve-match "$(encode "$reserve_host")" "$(encode "$repo_url")" "$(encode "$BEELINK_GATE_SPARSE_SPEC")")
        reserve_status=$?
        case "$reserve_status" in
          0) ;;
          130|143) exit "$reserve_status" ;;
          *)
            echo "beelink-gate: optional install reserve hint unavailable on $reserve_host (read exit $reserve_status); target admission still reads its own receipts and enforces its disk floor" >&2
            continue
            ;;
        esac
        matched_reserve[$reserve_host]=$(sed -n 's/^beelink-gate-reserve cold \([0-9]*\)$/\1/p' <<<"$reserve_lines" | tail -1)
        matched_warm_reserve[$reserve_host]=$(sed -n 's/^beelink-gate-reserve warm \([0-9]*\)$/\1/p' <<<"$reserve_lines" | tail -1)
      done
    fi
    ;;
esac
export BEELINK_GATE_SPARSE_SPEC
requested=$target admit_wait_launch="" placed_wait_launch=0
# An --urgent gate stays on the first host auto places it on: giving the host
# back drops its urgent marker and with it its place ahead of every normal gate.
# On 2026-10-12 an urgent fix for a red ADC develop (#10345) was re-placed for
# 1413 s while normal gates re-took the checkout each time it let go.
if [ "$requested" = auto ] && [ "${BEELINK_GATE_URGENT:-0}" != 1 ]; then
  admit_wait_launch=$(seconds_of "${BEELINK_GATE_REPLACE_WAIT:-60s}") || die "invalid BEELINK_GATE_REPLACE_WAIT: ${BEELINK_GATE_REPLACE_WAIT:-}"
fi
starve_after_launch=$(seconds_of "${BEELINK_GATE_STARVE_AFTER:-10m}") || die "invalid BEELINK_GATE_STARVE_AFTER: ${BEELINK_GATE_STARVE_AFTER:-}"
if [ "$requested" = auto ]; then
  if [ "${BEELINK_GATE_URGENT:-0}" = 1 ]; then
    start_checkout_reservations
  else
    reservation_epoch=$(date +%s)
    reservation_token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    export BEELINK_GATE_RESERVATION_TOKEN=$reservation_token
    start_checkout_reservations normal
  fi
fi
cancel_launcher_job() {
  # Repeats do nothing: GNU timeout signals the child and then its process group,
  # and --retry forwards a stop the group also received, so a second TERM would
  # otherwise end the launcher before it schedules the cancellation. A no-op trap,
  # unlike an ignored signal, leaves an inline --cancel-job stoppable.
  trap : HUP INT TERM
  [ -z "${gate_id:-}" ] || schedule_cancellation "$gate_id"
  exit 143
}
run_cancelable() {
  if [ "$cancel_on_term" = 1 ]; then
    "$@" &
    local child=$! rc
    wait "$child"; rc=$?
    return "$rc"
  fi
  "$@"
}
launched=$SECONDS placements=0
while :; do
  case "$requested" in
    beelink1|100.98.195.7) target=$(place_named beelink1) ;;
    beelink2|100.127.22.51) target=$(place_named beelink2) ;;
    auto) target=$(choose_beelink) || exit $? ;;
    *) die "unknown beelink: $requested" ;;
  esac
  update_window_of "$target" || tempfail "$(utc_in_minutes 5)" "cannot read the Windows Update schedule of $target"
  encoded=()
  for arg in "$target" "$repo_url" "$sha" "$install_mode" "$window_day" "$window_hour" "$@"; do
    encoded+=("$(encode "$arg")")
  done
  placed_wait_launch=$((SECONDS - launched))
  # A gate past the starvation backstop keeps its checkout queue place on this host.
  # --dev has no starvation backstop and continues moving between hosts.
  if [ -n "$admit_wait_launch" ] && [ "${gate_class:-}" != dev ] && (( placed_wait_launch >= starve_after_launch )); then
    admit_wait_launch=""
    echo "beelink-gate: waited ${placed_wait_launch}s across placements; staying on $target in its place in line" >&2
  fi
  gate_id="$target-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [ "$cancel_on_term" != 1 ] || trap cancel_launcher_job HUP INT TERM
  echo "beelink-gate: gate_id=$gate_id; reconnect with beelink-gate --attach $gate_id" >&2
  run_cancelable stage_job "$target" "$gate_id" || tempfail "$(utc_in_minutes 5)" "staging unconfirmed for $gate_id on $target; submission not attempted, remote staging may be partial"
  submit_bytes="$(printf '%s ' "${encoded[@]}" | wc -c | tr -d ' ') bytes of encoded arguments"
  submit_err=$(mktemp) || die "cannot create a temporary file"
  BEELINK_GATE_ID="$gate_id" heartbeat=0 run_cancelable on_beelink "$target" --job-submit "$gate_id" "${encoded[@]}" 2>"$submit_err"
  rc=$?
  cat "$submit_err" >&2
  if [ "$rc" = 255 ] && grep -q "exec request failed" "$submit_err"; then
    rm -f "$submit_err"
    die "$target refused the SSH exec request for $gate_id ($submit_bytes); no gate was submitted, and retrying the same command fails the same way"
  fi
  rm -f "$submit_err"
  [ "$rc" != 255 ] || tempfail "$(utc_in_minutes 5)" "submit connection lost for $gate_id ($submit_bytes); run beelink-gate --attach $gate_id before retrying"
  [ "$rc" = 0 ] || exit "$rc"
  # Keep reservations until the submitted gate itself has joined the checkout
  # queue. Its own urgent marker then survives a lost launcher or SSH session.
  if [ -n "$checkout_reservation_dir" ]; then
    admission_log="$checkout_reservation_dir/admission.log"
    : > "$admission_log"
    watch_checkout_admission "$admission_log" & checkout_monitor_pid=$!
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id" 2> >(tee "$admission_log" >&2)
    rc=$?
    kill -TERM "$checkout_monitor_pid" 2>/dev/null || true
    wait "$checkout_monitor_pid" 2>/dev/null || true
    checkout_monitor_pid=""
  else
    heartbeat=0 run_cancelable on_beelink "$target" --job-attach "$gate_id"
    rc=$?
  fi
  if [ "$rc" = 255 ]; then
    result=$(heartbeat=0 on_beelink "$target" --job-result "$gate_id" 2>/dev/null) || result=""
    [ "$result" = 255 ] || tempfail "$(utc_in_minutes 5)" "attach connection lost for $gate_id; run beelink-gate --attach $gate_id again"
  fi
  # Only an auto placement may move; a named host keeps waiting there, as it always has.
  [ "$rc" = "$NOT_ADMITTED" ] && [ "$requested" = auto ] || exit "$rc"
  placements=$((placements + 1))
  echo "beelink-gate: placement $placements on $target gave the host back after waiting; probing both again" >&2
done
