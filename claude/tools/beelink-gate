#!/usr/bin/env bash
# Associative arrays below require Bash 4+. macOS's system Bash 3.2 otherwise
# fails during initialization before validating the request, which can look like
# a successful gate to callers that do not enable errexit. Re-exec an installed
# compatible Bash so callers using the normal CLI keep working without a new install.
bash_major=0
if [ -n "${BASH_VERSION:-}" ]; then bash_major=${BASH_VERSION%%.*}; fi
case "$bash_major" in ''|*[!0-9]*) bash_major=0 ;; esac
if [ "$bash_major" -lt 4 ]; then
  compatible_bash=
  path_bash=$(command -v bash 2>/dev/null || true)
  for bash_candidate in "$path_bash" /opt/homebrew/bin/bash /usr/local/bin/bash /opt/local/bin/bash; do
    [ -n "$bash_candidate" ] && [ -x "$bash_candidate" ] || continue
    if "$bash_candidate" -c "test \"\${BASH_VERSINFO[0]}\" -ge 4" >/dev/null 2>&1; then
      compatible_bash=$bash_candidate
      break
    fi
  done
  if [ -n "$compatible_bash" ]; then
    exec "$compatible_bash" "$0" "$@"
  fi
  echo "beelink-gate: requires Bash 4 or newer; no compatible Bash was found on PATH or in standard macOS locations" >&2
  exit 2
fi
# shellcheck disable=SC2317 # receipt, finish and signal handlers run through traps.
# Gate a pushed revision in a locked Beelink cache; see README.md for the full contract.
# Usage: beelink-gate [--no-install|--light|--dev] [--branch NAME] [--merge PR]
#                    [--urgent] [--pin-host] <beelink1|beelink2|auto> <repo-url> <sha> -- <command> [args...]
#        beelink-gate --ship <beelink1|beelink2|auto> <repo-url> <sha>
#        beelink-gate --attach <gate-id>
#        beelink-gate --receipt <repo-url> <sha>
#        beelink-gate --report [hours] [--json] [--since timestamp]
# --cancel-on-term cancels an exact submitted gate; --retry MINUTES retries TEMPFAIL.
# --light is dependency/browser free and capped at120 command core-seconds and10minutes.
# --dev has separate checkout/slots at low priority; gate the final head without it.
# --ship runs the release owner's scripts/ship.sh verify with the repository's Node.
# Each gate keeps its checkout locked through install and command under one hold budget.
# Quota-aware admission needs a verified priority group; other hosts retain PSI/load fallback.
# Host update windows, disk floors, checkout locks and slots always apply.
# Exit: the command's status,2 for invalid requests/cache,75 for a temporary inability to prove.
set -uo pipefail
die() { echo "beelink-gate: $*" >&2; exit 2; }
TEMPFAIL=75

# Resolve installed symlinks here; staging replaces this block with the helper
# and source helper so submitted gates depend only on their immutable source file.
# BEELINK_GATE_INSTALLER_START
gate_source_root=$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}") || exit $?
gate_installer_source="$gate_source_root/beelink-gate-lib/install.sh"
gate_staging_source="$gate_source_root/beelink-gate-lib/source.sh"
gate_disk_source="$gate_source_root/beelink_gate_disk.py"
beelink_gate_disk_source=$(cat "$gate_disk_source") || exit $?
# shellcheck source=beelink-gate-lib/install.sh
. "$gate_installer_source" || exit $?
# shellcheck source=beelink-gate-lib/source.sh
. "$gate_staging_source" || exit $?
# BEELINK_GATE_INSTALLER_END

tempfail_line() { echo "beelink-gate: TEMPFAIL next_allowed=$1 $2" >&2; }
tempfail() { tempfail_line "$1" "$2"; exit "$TEMPFAIL"; }
utc_in_minutes() {
  python3 -c 'import datetime as d, sys; print((d.datetime.now(d.timezone.utc) + d.timedelta(minutes=int(sys.argv[1]))).strftime("%Y-%m-%dT%H:%M:%SZ"))' "$1"
}

decode() { printf '%s' "$1" | base64 --decode; }

floor_gib() {
  local host="$1" base path line override="" found=0
  case "$host" in
    beelink1) base=100 ;;
    beelink2) base=150 ;;
    *) die "unknown remote beelink: $host" ;;
  esac
  path=$(limits_file)
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ ! -f "$path" || ! -r "$path" ]]; then
      echo "beelink-gate: invalid disk_floor_gib limits file: $path" >&2
      return 1
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in
        disk_floor_gib=*)
          if (( found )); then
            echo "beelink-gate: invalid disk_floor_gib: duplicate limit" >&2
            return 1
          fi
          override=${line#disk_floor_gib=}
          found=1
          ;;
      esac
    done < "$path"
  fi
  if (( found )); then
    if [[ ! "$override" =~ ^[0-9]{1,4}$ ]] || (( 10#$override > 1024 )); then
      echo "beelink-gate: invalid disk_floor_gib: $override (must be a whole number up to 1024; below $base holds $base)" >&2
      return 1
    fi
    # A number under the host minimum cannot lower the floor, so it holds the
    # minimum instead of refusing every gate: an override of 150, valid only on
    # beelink1, took all of beelink2's gates out on 2026-10-15.
    if (( 10#$override < base )); then
      echo "beelink-gate: disk_floor_gib=$((10#$override)) is below $host's $base GiB minimum; using $base" >&2
      echo "$base"
      return 0
    fi
    echo "$((10#$override))"
  else
    echo "$base"
  fi
}

free_bytes() {
  local available
  available=$(df -B1 --output=avail "$HOME" | tail -n 1 | tr -d ' ') || die "cannot read free disk space"
  [[ "$available" =~ ^[0-9]+$ ]] || die "invalid free disk reading: $available"
  echo "$available"
}

check_floor() {
  local host="$1" reserve="${2:-0}" floor_gib available floor_bytes
  floor_gib=$(floor_gib "$host") || return 3
  available=$(free_bytes)
  last_floor_available=$available
  floor_bytes=$((floor_gib * 1024 * 1024 * 1024))
  if (( available < floor_bytes )); then
    printf 'beelink-gate: REFUSED %s has %s bytes free, below its %s GiB disk floor; use the other beelink or ask the host owner to recover capacity\n' \
      "$host" "$available" "$floor_gib" >&2
    return 3
  fi
  if (( reserve > 0 && available < floor_bytes + reserve )); then
    printf 'beelink-gate: REFUSED %s has %s bytes free, below its %s GiB disk floor plus %s bytes last-seen install reserve; use the other beelink or ask the host owner to recover capacity\n' \
      "$host" "$available" "$floor_gib" "$reserve" >&2
    return 3
  fi
}

# Windows owns the update policy; WSL owns the local clock and time-zone rules.
# Check again after waiting for the repo lock, before any checkout is touched.
# A gate admitted before the window keeps running, including its install.
check_update_window() {
  python3 - "$@" <<'PY'
from datetime import datetime, time, timedelta, timezone
import os
from pathlib import Path
import sys
from zoneinfo import ZoneInfo

host, raw_day, raw_hour = sys.argv[1:4]
try:
    day, hour = int(raw_day), int(raw_hour)
    if not 0 <= day <= 7 or not 0 <= hour <= 23:
        raise ValueError("day or hour out of range")
    if len(sys.argv) > 4:
        zone = ZoneInfo(sys.argv[4])
    elif os.environ.get("TZ"):
        zone = ZoneInfo(os.environ["TZ"])
    else:
        with Path("/etc/localtime").open("rb") as zonefile:
            zone = ZoneInfo.from_file(zonefile)
    now = (datetime.fromisoformat(sys.argv[5].replace("Z", "+00:00"))
           if len(sys.argv) > 5 else datetime.now(timezone.utc))
    if now.tzinfo is None:
        raise ValueError("probe time requires a UTC offset")
    now = now.astimezone(timezone.utc)
except (OSError, ValueError, IndexError) as exc:
    print(f"beelink-gate: cannot evaluate Windows Update window: {exc}", file=sys.stderr)
    sys.exit(2)

local_day = now.astimezone(zone).date()
for offset in range(-7, 8):
    candidate = local_day + timedelta(days=offset)
    # Registry day 0 is daily; 1=Sunday through 7=Saturday.
    if day and candidate.isoweekday() % 7 + 1 != day:
        continue
    scheduled_local = datetime.combine(candidate, time(hour), zone)
    scheduled = scheduled_local.astimezone(timezone.utc)
    start = scheduled - timedelta(minutes=60)
    end = scheduled + timedelta(minutes=30)
    if start <= now < end:
        next_local = end.astimezone(zone)
        print(
            f"beelink-gate: REFUSED {host} Windows Update is scheduled "
            f"{scheduled.astimezone(zone):%A %Y-%m-%d %H:%M %Z}; "
            f"new gates are blocked from {start.astimezone(zone):%Y-%m-%d %H:%M %Z} "
            f"until {next_local:%Y-%m-%d %H:%M %Z}; "
            f"next allowed {next_local:%Y-%m-%d %H:%M %Z} "
            f"({end:%Y-%m-%d %H:%M} UTC)",
            file=sys.stderr,
        )
        print(f"{end:%Y-%m-%dT%H:%M:%SZ}")
        sys.exit(3)
PY
}

# Starts only outside the update window; inside it, a TEMPFAIL until it ends.
admit_window() {
  local next rc
  next=$(check_update_window "$@"); rc=$?
  case "$rc" in
    0) ;;
    3) tempfail "$next" "$1 is in its Windows Update window" ;;
    *) exit "$rc" ;;
  esac
}

# A .beelink-gate/sparse-checkout file's patterns, without comments, blank
# lines or trailing spaces (stdin to stdout).
sparse_normalize() { sed -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d'; }

# The checkout shape an install reserve was measured on: full, or sha256 of
# the normalized patterns of the .beelink-gate/sparse-checkout read on stdin.
sparse_spec_of() {
  local want
  want=$(sparse_normalize)
  if [ -z "$want" ]; then
    echo full
  else
    printf '%s\n' "$want" | python3 -c 'import hashlib, sys; print("sha256:" + hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'
  fi
}

# A repo keeps tracked paths its gated commands never read out of its gate
# checkouts by committing .beelink-gate/sparse-checkout: `git sparse-checkout
# --no-cone` patterns, one per line, # for comments. Discovery Lab's excludes
# historical /pursuits/: on 2026-10-14 its full gate checkout held 11 GB on
# beelink1, and its 22-28 GB measured install reserve kept Lab gates off both
# beelinks. A commit without the file, or with no patterns in it, gets a full
# checkout. This keeps <checkout> at the patterns committed at <rev>, the
# commit it is about to check out (an idle checkout passes HEAD); the caller
# holds the checkout's repo lock. Setting patterns removes the excluded
# tracked files now, and later checkouts never write them. The cache prune
# passes --shrink-only: it never restores a full tree, which would write
# gigabytes in the step that frees disk (on 2026-10-15 an idle Lab checkout at
# a commit older than its file was rewritten with 4.7 GB of pursuits/). Sets
# sparse_source to repo or empty, and says on stderr when it changed the
# checkout.
sparse_apply() {  # <checkout> <rev> [--shrink-only]
  local want enabled
  want=$(git -C "$1" cat-file blob "$2:.beelink-gate/sparse-checkout" 2>/dev/null | sparse_normalize)
  enabled=$(git -C "$1" config --bool core.sparseCheckout)
  sparse_source=${want:+repo}
  if [ -z "$want" ]; then
    [ "$enabled" = true ] && [ "${3:-}" != --shrink-only ] || return 0
    echo "beelink-gate: $1 has no sparse patterns at $2; restoring its full tree" >&2
    git -C "$1" sparse-checkout disable
  elif [ "$enabled" != true ] || [ "$want" != "$(cat "$1/.git/info/sparse-checkout" 2>/dev/null)" ]; then
    echo "beelink-gate: applying repo sparse patterns to $1: $(printf '%s' "$want" | tr '\n' ' ')" >&2
    printf '%s\n' "$want" | git -C "$1" sparse-checkout set --no-cone --stdin
  fi
}

# Cache directories are owned by this command. A global lock serializes size
# decisions; per-repo locks keep active gates out of the eviction set.
prune_cache() {
  BEELINK_GATE_TIMING_FILE="${timing_file:-}" BEELINK_GATE_TIMING_PHASE="${timing_phase:-precheck}" \
    python3 - "$1" "$2" "$3" "${4:-0}" "$(declare -f sparse_normalize sparse_apply)" <<'PY'
import contextlib
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid

root, current, cap, required_reclaim = Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
sparse_code = sys.argv[5]
locks = root / ".locks"
size_scans = 0

@contextlib.contextmanager
def writer_intent():
    # Advertise only the brief namespace change, never scans or recursive work.
    writer_fd = os.open(locks / ".capacity.writer.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    intent = locks / ".capacity.writer.intent"
    try:
        fcntl.flock(writer_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # The writer lock, not a PID or clock lease, proves an intent is live.
        # A process death releases it, so the next writer can clear the marker.
        intent.unlink(missing_ok=True)
        marker_fd = os.open(intent, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        os.close(marker_fd)
        try:
            yield
        finally:
            intent.unlink(missing_ok=True)
    finally:
        os.close(writer_fd)

def size(path):
    global size_scans
    size_scans += 1
    result = subprocess.run(
        ["du", "-s", "-B1", "--", str(path)],
        text=True, capture_output=True, env={**os.environ, "LC_ALL": "C"},
    )
    warnings = result.stderr.splitlines()
    # Other repo gates can remove node_modules entries during this scan. GNU du
    # still prints a total; only that expected race may use its partial result.
    if result.returncode and not (
        result.returncode == 1 and warnings and all(
            line.startswith("du: cannot access ") and line.endswith(": No such file or directory")
            for line in warnings
        )
    ):
        raise OSError(f"du {path}: {result.stderr.strip() or f'exit {result.returncode}'}")
    fields = result.stdout.split()
    if not fields:
        raise OSError(f"du {path}: no size result")
    return int(fields[0])

def free_bytes(path):
    stat = os.statvfs(path)
    return stat.f_bavail * stat.f_frsize

def remove(path):
    # Detached paths stay counted in the cache until removal finishes. A slow
    # removal cannot block admission; the next prune retries a timed-out path.
    result = subprocess.run(["timeout", "-s", "KILL", "2s", "rm", "-rf", "--", str(path)], stdin=subprocess.DEVNULL)
    if result.returncode:
        raise OSError(f"bounded cache removal {path}: exit {result.returncode}")

try:
    for pending in locks.glob(".evicted-*"):
        if pending.is_dir() and not pending.is_symlink():
            remove(pending)
    with (locks / ".capacity.lock").open("a+") as global_lock:
        lock_wait_start = time.monotonic_ns()
        # Sizing and sparse work share capacity with new checkout claims.
        fcntl.flock(global_lock, fcntl.LOCK_SH)
        lock_acquired = time.monotonic_ns()
        candidates = []
        for host in root.iterdir():
            if host.name == ".locks" or host.is_symlink() or not host.is_dir():
                continue
            for owner in host.iterdir():
                if owner.is_symlink() or not owner.is_dir():
                    continue
                for repo in owner.iterdir():
                    git_dir = repo / ".git"
                    if repo.is_symlink() or not repo.is_dir() or git_dir.is_symlink() or not git_dir.is_dir():
                        continue
                    used = git_dir / "beelink-gate-used"
                    stamp = used if used.is_file() and not used.is_symlink() else git_dir / "FETCH_HEAD"
                    if not stamp.exists() or stamp.is_symlink():
                        stamp = git_dir
                    candidates.append((stamp.stat().st_mtime_ns, repo, host.name, owner.name))
        # Size after sparse maintenance, once. A second identical tree walk
        # without a mutation costs CPU/IO but proves no stronger capacity bound.
        initial_total = None
        initial_free = free_bytes(root)
        target_free = initial_free + required_reclaim
        # An idle checkout first shrinks to the sparse patterns its HEAD commits: those
        # are paths no gated command reads, and the checkout stays warm for the
        # next gate. LRU eviction then weighs what remains.
        sparsified = False
        for stamp_ns, repo, host, owner in candidates:
            fd = os.open(locks / f"{host}-{owner}-{repo.name}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                if repo != current:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        continue
                result = subprocess.run(
                    ["bash", "-c", sparse_code + '\nsparse_apply "$@"', "beelink-gate", str(repo), "HEAD", "--shrink-only"],
                    text=True, capture_output=True, stdin=subprocess.DEVNULL,
                )
                # sparse_apply writes to stderr only when it changes the checkout.
                sys.stderr.write(result.stderr)
                if result.returncode:
                    print(f"beelink-gate: sparse patterns not applied to idle cache {repo} (exit {result.returncode})", file=sys.stderr)
                elif result.stderr:
                    sparsified = True
                    print(f"beelink-gate: sparse patterns applied to idle cache {repo}", file=sys.stderr)
            finally:
                os.close(fd)
        total = size(root)
        fcntl.flock(global_lock, fcntl.LOCK_UN)
        evictions = 0
        for stamp_ns, repo, host, owner in sorted(candidates):
            if total <= cap and (not required_reclaim or free_bytes(root) >= target_free):
                break
            lock_path = locks / f"{host}-{owner}-{repo.name}.lock"
            fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                if repo != current:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        continue
                # Only detach the chosen checkout under writer intent. Neither
                # du nor recursive removal runs here. Refuse lock contention
                # immediately, so simultaneous pruners cannot form a convoy.
                with writer_intent():
                    fcntl.flock(global_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    try:
                        git_dir = repo / ".git"
                        if repo.is_symlink() or git_dir.is_symlink() or not git_dir.is_dir():
                            continue
                        used = git_dir / "beelink-gate-used"
                        if used.is_file() and used.stat().st_mtime_ns > stamp_ns:
                            continue  # Used since the shared snapshot; no longer LRU.
                        removed = locks / f".evicted-{uuid.uuid4().hex}"
                        repo.rename(removed)
                    finally:
                        fcntl.flock(global_lock, fcntl.LOCK_UN)
                remove(removed)
                evictions += 1
                print(f"beelink-gate: evicted LRU cache {repo}", file=sys.stderr)
            finally:
                os.close(fd)
            fcntl.flock(global_lock, fcntl.LOCK_SH)
            total = size(root)
            fcntl.flock(global_lock, fcntl.LOCK_UN)
        fcntl.flock(global_lock, fcntl.LOCK_SH)
        final_free = free_bytes(root)
        reclaimed = max(0, final_free - initial_free)
        if evictions or sparsified or required_reclaim or total > cap:
            print(
                f"beelink-gate: cache prune: cache_before={initial_total} cache_after={total} "
                f"free_before={initial_free} free_after={final_free}",
                file=sys.stderr,
            )
        if total > cap:
            print(f"beelink-gate: cache cap exceeded: {total} > {cap} bytes; active checkouts cannot be evicted", file=sys.stderr)
            sys.exit(3)
        if reclaimed < required_reclaim:
            print(f"beelink-gate: cache reclaimed {reclaimed} of {required_reclaim} needed bytes; active checkouts or other disk users need the host owner", file=sys.stderr)
            sys.exit(3)
except (OSError, ValueError) as exc:
    print(f"beelink-gate: cache prune failed: {exc}", file=sys.stderr)
    sys.exit(3)
finally:
    timing_file = os.environ.get("BEELINK_GATE_TIMING_FILE")
    if timing_file and "lock_acquired" in locals():
        try:
            with open(timing_file, "a", encoding="utf-8") as timing:
                timing.write(
                    f"{os.environ.get('BEELINK_GATE_TIMING_PHASE', 'precheck')} "
                    f"{(lock_acquired - lock_wait_start) // 1_000_000} "
                    f"{(time.monotonic_ns() - lock_acquired) // 1_000_000}\n"
                )
                timing.write(f"cache_scans {os.environ.get('BEELINK_GATE_TIMING_PHASE', 'precheck')} {size_scans}\n")
        except OSError:
            pass  # Measurement must not change the gate result.
PY
}

# A writer holds the fd lock for its brief intent and rename. If it dies,
# flock releases that lock; a claimant can then remove its abandoned marker.
capacity_writer_active() {
  # The lock is authoritative across marker creation/removal. Inspecting the
  # path first races a brief writer's unlink and can reject a valid claim.
  if flock -n -x "$writer_fd"; then
    if [ -e "$intent_file" ] || [ -L "$intent_file" ]; then
      [ ! -L "$intent_file" ] && [ -f "$intent_file" ] || die "capacity writer intent is not a regular file"
      rm -f -- "$intent_file" || die "cannot clear stale capacity writer intent"
    fi
    flock -u "$writer_fd"
    return 1
  fi
  return 0
}

wait_for_capacity_writer() {
  local now_ms elapsed_ms
  now_ms=$(date +%s%3N)
  (( intent_started_ms )) || intent_started_ms=$now_ms
  elapsed_ms=$((now_ms - intent_started_ms))
  if (( elapsed_ms >= intent_wait_limit * 1000 )); then
    if (( placed_auto )); then
      not_admitted "capacity writer intent exceeded ${intent_wait_limit}s"
    fi
    tempfail "$(utc_in_minutes 5)" "capacity writer intent exceeded ${intent_wait_limit}s on $beelink"
  fi
  if (( SECONDS - last_report >= 60 )); then
    echo "beelink-gate: waiting $((elapsed_ms / 1000))s for capacity writer on $beelink" >&2
    last_report=$SECONDS
  fi
  admission_expired && not_admitted "capacity writer in progress"
  sleep 1 & wait $!
}

# Use only this command's locked, disposable checkouts to restore a host's disk
# floor with 10 GiB headroom. A missing cache has nothing safe to evict.
# A host short only of the repo's last measured install reserve gets the same
# pass with nothing to reclaim: it applies sparse patterns to idle checkouts
# and evicts only for the cache cap, so their bytes count before admission.
recover_floor_from_cache() {
  local host="$1" root="$2" cap="$3" current="$4" reserve="${5:-0}" available wanted floor
  [ -d "$root/.locks" ] || return 0
  available=$(free_bytes)
  floor=$(floor_gib "$host") || return 3
  floor=$(( floor * 1024 * 1024 * 1024 ))
  wanted=$(( floor + 10 * 1024 * 1024 * 1024 ))
  if (( available < wanted )); then
    echo "beelink-gate: disk reserve needs $((wanted - available)) bytes; pruning owned idle cache" >&2
    prune_cache "$root" "$current" "$cap" "$((wanted - available))" || true
  elif (( available < floor + reserve )); then
    echo "beelink-gate: install reserve needs $((floor + reserve - available)) bytes; applying sparse patterns to owned idle cache" >&2
    prune_cache "$root" "$current" "$cap" 0 || true
  fi
}

# Bytes of checkouts no gate holds, measured in one du so hardlinks shared
# between checkouts count once: the most an eviction pass could free.
idle_cache_bytes() {
  local root="$1" dir rel lock fd
  local -a idle=()
  for dir in "$root"/*/*/*/; do
    dir=${dir%/}
    [ ! -L "$dir" ] && [ -d "$dir/.git" ] || continue
    rel=${dir#"$root"/}; lock="$root/.locks/${rel//\//-}.lock"
    if [ -e "$lock" ]; then
      exec {fd}<"$lock" || continue
      if ! flock -n -s "$fd"; then exec {fd}<&-; continue; fi
      exec {fd}<&-
    fi
    idle+=("$dir")
  done
  (( ${#idle[@]} )) || { echo 0; return; }
  du -s -c -B1 -- "${idle[@]}" 2>/dev/null | tail -n 1 | cut -f1
}

# Lanes may point CARGO_TARGET_DIR at ~/.cache/<repo>-build, outside the capped
# cache. Sweep entries of those cargo target dirs (CACHEDIR.TAG) untouched for
# 24 h. Each sweep holds every gate lock for <repo> and cargo's own profile
# locks, so no gate or cargo build is using the files it removes; a removed
# artifact only costs a rebuild. Failure is reported but never fails a gate.
prune_build_dirs() {
  python3 - "$@" <<'PY'
import fcntl
import os
from pathlib import Path
import shutil
import sys
import time

build_root, locks, current_lock = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
max_age = int(sys.argv[4])
cutoff = time.time() - max_age
TAG = "Signature: 8a477f597d28d172789f06886806bc55"
ARTIFACT_DIRS = ("deps", "build", ".fingerprint", "incremental", "examples")
CARGO_LOCKS = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")

def try_lock(path, held):
    try:
        fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    except FileNotFoundError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return False
    held.append(fd)
    return True

def release(held):
    while held:
        os.close(held.pop())

def newest(path):
    # relatime refreshes atime on a read at most daily; cargo's locks, not
    # this age, are what keep an active build's inputs safe.
    st = path.lstat()
    latest = max(st.st_atime, st.st_mtime)
    if path.is_dir() and not path.is_symlink():
        for parent, dirs, files in os.walk(path):
            for name in dirs + files:
                st = os.lstat(os.path.join(parent, name))
                latest = max(latest, st.st_atime, st.st_mtime)
    return latest

def reclaimable(path):
    if not path.is_dir() or path.is_symlink():
        st = path.lstat()
        return st.st_blocks * 512 if st.st_nlink == 1 else 0
    total = 0
    for parent, _, files in os.walk(path):
        for name in files:
            st = os.lstat(os.path.join(parent, name))
            if st.st_nlink == 1:
                total += st.st_blocks * 512
    return total

def profiles(target):
    # <target>/<profile> and <target>/<triple>/<profile>
    for child in target.iterdir():
        if child.is_symlink() or not child.is_dir():
            continue
        if (child / ".fingerprint").is_dir():
            yield child
            continue
        for grandchild in child.iterdir():
            if not grandchild.is_symlink() and (grandchild / ".fingerprint").is_dir():
                yield grandchild

try:
    with (locks / ".build-prune.lock").open("a+") as sweep_lock:
        try:
            fcntl.flock(sweep_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(0)
