  [[ "$pid" =~ ^[1-9][0-9]*$ && "$birth" =~ ^[1-9][0-9]*$ ]] || return 1
  read -r state actual < <(awk '{print $3, $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
