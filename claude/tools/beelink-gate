# Gates for different repos run in parallel; cap them per host with flock slots
# so a burst of lanes cannot drive the load past the cores. The slot is taken
# after the repo lock, so gates queued behind one repo hold no slot.
acquire_slot() {
  local slots_dir="$1" max="$2" pool="${3:-slot}" i announced="" marker
  marker="$slots_dir/urgent-$pool"
  if [ "${urgent:-0}" = 1 ]; then ticket_body > "$marker.$$"; urgent_markers+=("$marker.$$"); fi
  while :; do
    if [ "${urgent:-0}" = 1 ] || ! urgent_ahead "$marker"; then
      for ((i = 0; i < max; i++)); do
        exec {slot_fd}>"$slots_dir/$pool-$i.lock" || die "cannot open host slot"
        if flock -n -x "$slot_fd"; then rm -f "$marker.$$"; return 0; fi
        exec {slot_fd}>&-
      done
    fi
    if [ -z "$announced" ]; then
      echo "beelink-gate: waiting for a host gate slot ($max running$([ "$pool" = slot ] || echo " $pool"))" >&2
      announced=1
    fi
    # The backstop covers slots too: with pressure admission, a full slot pool is
    # now the usual wait (4/4 on both beelinks at 22:15Z with gate pressure 5-16%).
    if starving; then
      exec {slot_fd}>"$slots_dir/$pool-overflow.lock" || die "cannot open host slot"
      starved=1
      echo "beelink-gate: $( [ "${urgent:-0}" = 1 ] && echo URGENT || echo STARVED ): running past the $max-slot cap on $beelink after $(( ${placed_wait:-0} + SECONDS - ${load_wait_started:-$SECONDS} ))s; SHIP_MAX_WORKERS is halved" >&2
      rm -f "$marker.$$"
      return 0
    fi
    admission_expired && not_admitted "no free host slot"
    if [ "${urgent:-0}" = 1 ]; then sleep 0.5; else sleep "${BEELINK_GATE_SLOT_POLL_SECONDS:-2}"; fi
  done
}

# Legacy fallback measures the pressure the gate's cgroup feels; without
# cgroup PSI it uses host PSI, then load average when PSI is unavailable.
pressure_file() {
  local f top
  if [ -n "${BEELINK_GATE_CPU_PRESSURE:-}" ]; then f=$BEELINK_GATE_CPU_PRESSURE
  else
    top=$(sed -n 's|^0::/\([^/]*\).*|\1|p' /proc/self/cgroup 2>/dev/null)
    f=/proc/pressure/cpu
    [ -z "$top" ] || [ ! -r "/sys/fs/cgroup/$top/cpu.pressure" ] || f=/sys/fs/cgroup/$top/cpu.pressure
    # Where the host provides the gate cgroup (host/install.sh --gate-priority-only),
    # the gate runs there after admission, so its pressure is the one that counts.
    [ ! -r "$(gate_cgroup)/cpu.pressure" ] || f=$(gate_cgroup)/cpu.pressure
  fi
  [ -r "$f" ] && echo "$f"
}
loadavg_now() { cut -d' ' -f1 "${BEELINK_GATE_LOADAVG:-/proc/loadavg}"; }
# The maintained host role owns gate quota and priority; this code only reads them.
gate_cgroup() {
  if [ "${dev:-0}" = 1 ]; then echo "${BEELINK_GATE_DEV_CGROUP:-/sys/fs/cgroup/beelink-gate-dev}"
  else echo "${BEELINK_GATE_CGROUP:-/sys/fs/cgroup/beelink-gate}"; fi
}
join_gate_cgroup() {
  local cg; cg=$(gate_cgroup)
  if grep -qxF "0::/${cg#/sys/fs/cgroup/}" /proc/self/cgroup 2>/dev/null; then
    gate_cgroup_joined=${cg##*/}; return 0
  fi
  [ -w "$cg/cgroup.procs" ] || [ -e "$cg/cgroup.procs" ] || return 0
  # Moving a process between top-level cgroups needs root; without sudo the gate
  # keeps running unprioritized rather than failing.
  if sudo -n /bin/sh -c 'echo "$1" > "$2/cgroup.procs"' sh "$$" "$cg" 2>/dev/null; then
    gate_cgroup_joined=${cg##*/}
  fi
}

# One capacity reader for admission, placement, worker sizing and reporting.
# Group full stalls all gate work; group some needs only one stalled gate task.
# Host some also includes lower-priority work waiting outside the gate group.
quota_capacity() {
  [ "${dev:-0}" = 0 ] || return 1
  python3 - "$(gate_cgroup)" "${cache_root:-${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}}/.locks" "${slot_fd:-}" "$(max_cpu_pressure)" "${1:-0}" <<'PY'
import fcntl, json, math, os, pathlib, sys, time
group, locks, held, pressure_limit = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), bool(sys.argv[3]), float(sys.argv[4])
root = pathlib.Path('/sys/fs/cgroup')
try:
    group = group.resolve(strict=True)
    joined = pathlib.Path('/proc/self/cgroup').read_text().strip() == '0::/' + str(group.relative_to(root))
    if sys.argv[5] == '1' and not joined:
        raise ValueError('membership unverified')
    weight = int((group / 'cpu.weight').read_text())
    # The policy is valid only for a maintained priority group, never the
    # caller's ordinary user cgroup or the lower-priority --dev group.
    others = [int((p / 'cpu.weight').read_text()) for p in root.iterdir()
              if p.is_dir() and p != group and (p / 'cpu.weight').is_file()]
    if group.parent != root or weight <= max(others, default=weight):
        raise ValueError('priority unverified')
    cpus, finite = float(len(os.sched_getaffinity(0))), False
    for path in (group, *group.parents):
        if path == root.parent:
            break
        raw = (path / 'cpu.max').read_text().split()
        if raw[0] != 'max':
            cpus, finite = min(cpus, int(raw[0]) / int(raw[1])), True
        spec = (path / 'cpuset.cpus.effective').read_text().strip()
        if spec:
            allowed = sum(int(part.split('-')[-1]) - int(part.split('-')[0]) + 1 for part in spec.split(','))
            cpus = min(cpus, allowed)
        if path == root:
            break
    if not finite or cpus <= 0:
        raise ValueError('quota unverified')
    running = 0
    for pattern in ('slot-*.lock', 'light-slot-*.lock'):
        for lock in locks.glob(pattern):
            with lock.open('rb') as fd:
                try:
                    fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except BlockingIOError:
                    running += 1
    workers = max(1, math.floor(cpus / max(1, running + (not held))))
    runnable, read, expired = 0, 0, time.monotonic() + 1
    for membership in group.rglob('cgroup.threads'):
        for tid in membership.read_text().split():
            if time.monotonic() > expired:
                raise ValueError('thread scan budget')
            try:
                stat = pathlib.Path('/proc', tid, 'stat').read_text()
            except FileNotFoundError:
                continue  # A completed task contributes no runnable work.
            runnable += tid != str(os.getpid()) and stat[stat.rindex(')') + 2:].split()[0] == 'R'
            read += 1
    workers = max(1, min(workers, math.floor(cpus - runnable)))
    lines = dict((line.split()[0], line.split()[1:]) for line in (group / 'cpu.pressure').read_text().splitlines())
    full = float(dict(field.split('=') for field in lines['full'])['avg10'])
    if not math.isfinite(full):
        raise ValueError('pressure unreadable')
    print(json.dumps({'mode': 'quota', 'observed_at': time.time(), 'cgroup': str(group), 'weight': weight,
                     'effective_cpus': cpus, 'runnable_threads': runnable, 'threads_read': read, 'workers': workers,
                     'verified_join': joined,
                     'projected_runnable': runnable + workers, 'full_avg10': full, 'full_limit': pressure_limit,
                     'held': runnable + workers > cpus or full > pressure_limit}, separators=(',', ':')))
except (OSError, ValueError, KeyError, IndexError):
    sys.exit(1)  # Missing evidence uses the complete legacy admission path.
PY
}
capacity_fields() {
  python3 -c 'import json,sys; x=json.loads(sys.argv[1]); print(x["projected_runnable"], x["effective_cpus"], int(x["held"]), x["workers"], x["full_avg10"], x["full_limit"])' "$1"
}
load_now() {
  local f value
  if f=$(pressure_file); then
    value=$(sed -n 's/^some avg10=\([0-9.]*\).*/\1/p' "$f")
    # An unreadable pressure line counts as full contention, so gates hold.
    echo "${value:-100}"
  else
    loadavg_now
  fi
}
metric_name() { if pressure_file >/dev/null; then echo "CPU pressure"; else echo load; fi; }
# CPU this shell's reaped children used, in clock ticks (cutime + cstime of /proc/$$/stat).
# A step's command is reaped through timeout, so the difference around a step is its CPU.
children_cpu_ticks() {
  local stat
  stat=$(cat "/proc/$$/stat" 2>/dev/null) || { echo 0; return; }
  stat=${stat##*) }
  # shellcheck disable=SC2086 # split the stat fields
  set -- $stat
  echo $(( ${14} + ${15} ))
}

# Admission ends early for a placement that may move: the remote gate gives the host back (exit 76, which
# only the launcher sees) and the launcher places the gate again. Nothing is checked out before admission.
NOT_ADMITTED=76
cancel_if_requested() {
  [ -z "${gate_id:-}" ] || [ ! -f "$STATE_DIR/jobs/.canceled/$gate_id" ] || {
    echo "beelink-gate: canceled gate_id=$gate_id before command" >&2
    exit 75
  }
}
admission_expired() {
  cancel_if_requested
  [ -n "${admit_by:-}" ] && (( SECONDS >= admit_by ))
}
not_admitted() {
  [ -z "${lock:-}" ] || rm -f "$lock.holder"
  rm -f "${urgent_markers[@]}" 2>/dev/null
  echo "beelink-gate: not admitted on $beelink within ${admit_wait}s ($1); placing the gate again" >&2
  exit "$NOT_ADMITTED"
}
# A host auto chose can fall below its disk floor between the probe and the
# gate's own check: on 2026-10-12 docker images filled beelink2 by 14 GiB in
# 40 min, and a gate placed there exited TEMPFAIL while beelink1 had room. An
# auto placement gives such a host back, and the launcher's next probe sees it
# refused and picks the other host, or exits TEMPFAIL when both refuse.
give_back_host() {
  rm -f "${urgent_markers[@]}" 2>/dev/null
  echo "beelink-gate: $beelink gave the gate back before admission ($1); placing the gate again" >&2
  exit "$NOT_ADMITTED"
}
# A waiting gate leaves a ticket named <prefix>.<enqueued epoch>.<pid>. A free
# checkout goes to the oldest live ticket, not to whichever gate polls first: on
# 2026-10-12 an ADC gate waited 2,290 s on beelink1 while later gates took each
# checkout as it freed. The epoch is the gate's first enqueue, carried across
# re-placements through BEELINK_GATE_PLACED_WAIT, so moving hosts keeps its place.
# A ticket or marker names its gate's pid, and kill -0 alone also answers for
# a later process that reused that pid after the gate was killed or the host
# rebooted; such a stale ticket would hold a checkout until that process exits.
# Its owner is live only if the process started no later than the file was written.
proc_start() {  # <pid>: its start time in clock ticks since boot, which no clock step moves
  local line fields
  line=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  read -ra fields <<< "${line##*) }"
  [[ "${fields[19]:-}" =~ ^[0-9]+$ ]] && printf '%s' "${fields[19]}"
}
ticket_body() {  # [token]: a ticket or marker naming its token and this gate's start tick
  printf '%s\nstart=%s\n' "${1:-}" "$(proc_start $$)"
}
waiter_alive() {  # <ticket or marker file> <pid>
  kill -0 "$2" 2>/dev/null || return 1
  local fields btime written recorded started
  recorded=$(sed -n 's/^start=\([0-9][0-9]*\)$/\1/p' "$1" 2>/dev/null)
  started=$(proc_start "$2") || return 0
  # A ticket that names its owner's start tick is alive only while that same process runs: a reused pid starts
  # at another tick. Realtime is not compared, because btime is realtime minus uptime and beelink1's moved
  # +723 s in its first 17 h on 2026-10-18; with the old 1 s slack a step dropped a live reservation's ticket
  # and a newer gate went first (beelink-gate tests 136 and 3397).
  [ -z "$recorded" ] || { [ "$recorded" = "$started" ]; return; }
  # Tickets from older gates name no tick. A reused pid needs a pid_max wrap (about 5 h on beelink1 at
  # 238 pids/s), so 60 s of slack still catches reuse and absorbs small steps.
  btime=$(awk '$1 == "btime" { print $2 }' /proc/stat 2>/dev/null)
  written=$(stat -c %Y "$1" 2>/dev/null) || return 1
  [[ "$btime" =~ ^[0-9]+$ ]] || return 0
  (( btime + started / $(getconf CLK_TCK) <= written + 60 ))
}
older_tickets_ahead() {  # <ticket prefix> <my epoch>: how many live, older tickets from other gates
  # A gate's place is the oldest (epoch, pid) among its tickets: an auto gate holds a
  # reservation ticket and its own, under one token. Every gate compares those same
  # pairs, so two gates can never each count the other as ahead.
  local t rest since pid token key me_since=$2 me_pid=$$ n=0
  local -A key_since=() key_pid=()
  for t in "$1".*.*; do
    [ -e "$t" ] || continue
    rest=${t#"$1".}; since=${rest%%.*}; pid=${rest#*.}
    [[ "$since" =~ ^[0-9]+$ && "$pid" =~ ^[0-9]+$ ]] || continue
    token=$(head -n 1 "$t" 2>/dev/null) || token=""
    [[ "$token" =~ ^[0-9a-f]{32}$ ]] || token=""
    if [ "$pid" = "$$" ] || { [ -n "$token" ] && [ "$token" = "${reservation_token:-}" ]; }; then
      if (( since < me_since || (since == me_since && pid < me_pid) )); then me_since=$since me_pid=$pid; fi
      continue
    fi
    if ! waiter_alive "$t" "$pid"; then rm -f "$t"; continue; fi
    key=${token:-$pid}
    if [ -z "${key_since[$key]:-}" ] || (( since < key_since[$key] || (since == key_since[$key] && pid < key_pid[$key]) )); then
      key_since[$key]=$since key_pid[$key]=$pid
    fi
  done
  for key in "${!key_since[@]}"; do
    if (( key_since[$key] < me_since || (key_since[$key] == me_since && key_pid[$key] < me_pid) )); then n=$((n + 1)); fi
  done
  echo "$n"
}
# An urgent gate leaves a marker while it waits; every other gate waiting for the same thing steps aside.
urgent_ahead() {  # <marker prefix>: a live urgent waiter other than this gate
  local m pid
  for m in "$1".*; do
    [ -e "$m" ] || continue
    pid=${m##*.}
    [ "$pid" != "$$" ] || continue
    if waiter_alive "$m" "$pid"; then return 0; fi
    rm -f "$m"  # left by a gate that died
  done
  return 1
}

# Legacy PSI limits are read live from the host owner; light gets twice the normal ceiling.
limits_file() { echo "${BEELINK_GATE_LIMITS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/beelink-gate/limits}"; }
host_max_cpu_pressure() {
  local v
  v=$(sed -n 's/^max_cpu_pressure=\([0-9]\{1,3\}\)[[:space:]]*$/\1/p' "$(limits_file)" 2>/dev/null | tail -1)
  [[ "$v" =~ ^[0-9]+$ ]] && (( v <= 100 )) && echo "$v"
}
max_cpu_pressure() {
  local max=${BEELINK_GATE_MAX_CPU_PRESSURE:-$(host_max_cpu_pressure || echo 20)}
  [[ "$max" =~ ^[0-9]+$ ]] && (( max <= 100 )) || die "BEELINK_GATE_MAX_CPU_PRESSURE must be 0-100: $max"
  if [ "${light:-0}" = 1 ]; then echo $(( max * 2 > 100 ? 100 : max * 2 )); else echo "$max"; fi
}
load_limit() {
  if pressure_file >/dev/null; then max_cpu_pressure
  elif [ "${light:-0}" = 1 ]; then echo $(( $(nproc) * 5 / 2 ))
  else echo $(( $(nproc) * 3 / 2 )); fi
}
limit_basis() {
  if pressure_file >/dev/null; then echo "% some avg10 in $(pressure_file)"
  elif [ "${light:-0}" = 1 ]; then echo "2.5x $(nproc) cores"
  else echo "1.5x $(nproc) cores"; fi
}
# gawk reserves the name `load`; any awk failure counts as over the limit, so a
# broken comparison holds gates instead of admitting them.
over_limit() {
  awk -v cur="$1" -v cap="$2" 'BEGIN { exit !(cur + 0 > cap + 0) }'
  [ "$?" -ne 1 ]
}

gate_worker_budget() {
  local capacity workers _projected _cpus _held _full _limit
  if capacity=$(quota_capacity 1); then
    read -r _projected _cpus _held workers _full _limit < <(capacity_fields "$capacity")
    echo "$workers"; return 0
  fi
  local locks=$1 running=0 f fd
  for f in "$locks"/slot-*.lock "$locks"/light-slot-*.lock "$locks"/dev-slot-*.lock; do
    [ -e "$f" ] || continue
    exec {fd}<"$f" || continue
    flock -n -s "$fd" || running=$((running + 1))
    exec {fd}<&-
  done
  (( running >= 1 )) || running=1
  local each=$(( $(nproc) / running ))
  (( each >= 2 )) || each=2
  echo "$each"
}

# Legacy host guard: retain it whenever maintained priority/quota capacity
# cannot be proved. Its threshold remains owned by the host limits file.
host_pressure_now() {
  sed -n 's/^some avg10=[0-9.]* avg60=\([0-9.]*\).*/\1/p' "${BEELINK_GATE_HOST_PRESSURE:-/proc/pressure/cpu}" 2>/dev/null
}
host_pressure_ceiling() {
  local v=${BEELINK_GATE_HOST_PRESSURE_CEILING:-}
  [ -n "$v" ] || v=$(sed -n 's/^host_pressure_ceiling=\([0-9]\{1,3\}\)[[:space:]]*$/\1/p' "$(limits_file)" 2>/dev/null | tail -1)
  [[ "$v" =~ ^[0-9]+$ ]] && (( v <= 100 )) || v=40
  echo "$v"
}

starving() {
  [ "${dev:-0}" = 0 ] || return 1  # a dev run waits; only merge gates get the backstop
  [ "${urgent:-0}" = 0 ] || return 0
  local after
  after=$(seconds_of "${BEELINK_GATE_STARVE_AFTER:-10m}") || die "invalid BEELINK_GATE_STARVE_AFTER: ${BEELINK_GATE_STARVE_AFTER:-}"
  (( ${placed_wait:-0} + SECONDS - ${load_wait_started:-$SECONDS} >= after ))
}

wait_for_load() {
  : "${load_wait_started:=$SECONDS}"
  local beelink=$1 budget limit load since=$load_wait_started reported=-60 host ceiling held why capacity workers full full_limit quota_mode
  budget=$(seconds_of "${BEELINK_GATE_LOAD_WAIT:-30m}") || die "invalid BEELINK_GATE_LOAD_WAIT: ${BEELINK_GATE_LOAD_WAIT:-}"
  join_gate_cgroup
  while :; do
    host=$(host_pressure_now) ceiling=$(host_pressure_ceiling) held=0 capacity="" quota_mode=0
    if [ "${gate_cgroup_joined:-}" = "$(basename "$(gate_cgroup)")" ] && capacity=$(quota_capacity 1); then
      quota_mode=1
      read -r load limit held workers full full_limit < <(capacity_fields "$capacity")
      why="quota runnable $load (including $workers prospective workers) / $limit CPUs, group full avg10 $full / $full_limit"
      (( held )) || break
    else
      limit=$(load_limit) load=$(load_now)
      [ -n "$host" ] && over_limit "$host" "$ceiling" && held=1
      (( held )) || over_limit "$load" "$limit" || break
      if (( held )); then why="host CPU pressure (some avg60) $host over its ceiling of $ceiling"
      else why="$(metric_name) $load over its limit of $limit ($(limit_basis))"; fi
    fi
    # Quota/full capacity is a hard bound, including urgent/starved gates.
    if (( ! quota_mode && ! held )) && starving; then
      starved=1
      echo "beelink-gate: STARVED: admitting on $beelink after $(( ${placed_wait:-0} + SECONDS - since ))s: $why; SHIP_MAX_WORKERS is halved" >&2
      break
    fi
    if (( SECONDS - since >= budget )); then
      echo "beelink-gate: REFUSED $beelink $why for $((SECONDS - since))s; use the other beelink or retry later" >&2
      return 3
    fi
    if (( SECONDS - reported >= 60 )); then
      echo "beelink-gate: waiting $((SECONDS - since))s of ${budget}s: $beelink $why" >&2
      reported=$SECONDS
    fi
    admission_expired && not_admitted "$why"
    sleep "${BEELINK_GATE_LOAD_POLL_SECONDS:-15}" & wait $!
  done
  start_load=$(loadavg_now) start_host_pressure=${host:-} start_pressure=$(load_now)
  [ -n "$capacity" ] || capacity='{"mode":"legacy"}'
  export BEELINK_GATE_ADMISSION_SAMPLE="$capacity"
  echo "beelink-gate: admission $BEELINK_GATE_ADMISSION_SAMPLE" >&2
  export BEELINK_GATE_ADMITTED=1
}

declare -A BEELINK_IPS=([beelink1]=100.98.195.7 [beelink2]=100.127.22.51)
SSH_OPTIONS=(-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=10)
REG_EXE=${BEELINK_GATE_REG:-/mnt/c/Windows/System32/reg.exe}
STATE_DIR="${BEELINK_GATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/beelink-gate}"

# Durations such as 45m, 90s, 2h or plain seconds.
seconds_of() {
  local value=$1
  case "$value" in
    *h) value=$(( ${value%h} * 3600 )) ;;
    *m) value=$(( ${value%m} * 60 )) ;;
    *s) value=${value%s} ;;
  esac
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
  echo "$value"
}

# Sets host, owner and repo from a Git URL; they are cache path components.
parse_repo_url() {
  local url=$1 key
  if [[ "$url" =~ ^git@([A-Za-z0-9.-]+):([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[1]}"; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  elif [[ "$url" =~ ^(https|ssh)://(git@)?([A-Za-z0-9.-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host="${BASH_REMATCH[3]}"; owner="${BASH_REMATCH[4]}"; repo="${BASH_REMATCH[5]}"
  elif [[ "$url" =~ ^file:///([A-Za-z0-9_./-]+)/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?$ ]]; then
    host=local; owner="${BASH_REMATCH[2]}"; repo="${BASH_REMATCH[3]}"
  else
    die "expected a Git URL ending in owner/repo[.git]"
  fi
  repo="${repo%.git}"
  for key in "$host" "$owner" "$repo"; do
    if [ "$key" = . ] || [ "$key" = .. ] || [[ "$key" = -* ]]; then die "unsafe repository path"; fi
  done
}

# The fixed 10 GiB pre-install headroom is the safe fallback for a repo with
# no receipt yet. Later receipts include that headroom plus bytes consumed
# between admission and the install check (fetch, checkout and install), the
# checkout shape they measured (sparse_spec: full or a pattern digest) and its
# temperature (checkout_temperature: warm when the checkout already had that
# shape, cold when the gate cloned it, reshaped otherwise). A reserve measured
# on another shape says nothing about this one: on 2026-10-15 beelink2's newest
# Lab receipt was a 28.2 GB full clone, which refused every sparse Lab gate, so
# none could write a sparse receipt. A cold clone's cost says little about a
# warm checkout: beelink2's 15.58 GB cold sparse clone then refused its own warm
# checkout at 226 GB free.
# With the gated commit's shape known (<spec>), a cold gate uses this host's
# newest cold receipt of that shape, else the other beelink's (<peer-cold>),
# else the headroom. A warm gate uses this host's newest warm receipt of that
# shape, else the other beelink's (<peer-warm>), else the cold value. With the
# shape unknown, use this host's newest receipt, as before. Receipts from before
# temperatures count as cold. A malformed receipt never counts, and an older one
# never overrides a newer one. match-only prints this host's newest cold and
# warm values for the shape, for the other beelink.
last_install_reserve_bytes() {  # <beelink> <host/owner/repo> <mode> [<spec> <peer-cold> <peer-warm> <warm|cold> [match-only]]
  local beelink="$1" repo_key="$2" mode="$3"
  case "$mode" in install|ship|dev) ;; *) echo 0; return ;; esac
  python3 - "$STATE_DIR/receipts.jsonl" "$beelink" "$repo_key" "${4:-}" "${5:-}" "${6:-}" "${7:-cold}" "${8:-}" <<'PY'
import json
import mmap
import os
import re
import sys

path, host, repo, spec, peer_cold, peer_warm, temperature, match_only = sys.argv[1:]
fallback = 10 * 1024 ** 3
SPEC = re.compile(r"full|sha256:[0-9a-f]{64}")
spec = spec if SPEC.fullmatch(spec) else ""
warm = temperature == "warm"

def measured(value):
    return type(value) is int and fallback <= value <= 1024 ** 4

def peer(value):
    return int(value) if value.isdigit() and measured(int(value)) else None

def shape(row):
    # Receipts from before sparse_spec: one with sparse patterns measured
    # unknown patterns; every other one measured a full checkout.
    if "sparse_spec" not in row:
        return None if row.get("sparse") else "full"
    value = row["sparse_spec"]
    return value if isinstance(value, str) and SPEC.fullmatch(value) else None

def heat(row):
    # Receipts from before temperatures count as cold, the costlier case.
    if "checkout_temperature" not in row:
        return "cold"
    value = row["checkout_temperature"]
    return value if value in ("warm", "cold", "reshaped") else None

def answer(value, source):
    print(f"beelink-gate: install reserve {value} bytes from {source}", file=sys.stderr)
    print(value)
    sys.exit(0)

newest = {}
try:
    with open(path, "rb") as receipts:
        if os.fstat(receipts.fileno()).st_size:
            with mmap.mmap(receipts.fileno(), 0, access=mmap.ACCESS_READ) as data:
                pos = len(data)
                for _ in range(10000):
                    if pos == 0 or len(newest) == 2:
                        break
                    if data[pos - 1:pos] == b"\n":
                        pos -= 1
                    start = data.rfind(b"\n", 0, pos) + 1
                    line, pos = data[start:pos], start
                    try:
                        row = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(row, dict) or row.get("host") != host or row.get("repo") != repo:
                        continue
                    value = row.get("install_reserve_bytes")
                    if not measured(value):
                        continue
                    if not spec and not match_only:
                        answer(value, f"{host}'s newest receipt (checkout shape unknown)")
                    if shape(row) == spec and heat(row) in ("warm", "cold"):
                        newest.setdefault(heat(row), value)
except FileNotFoundError:
    pass
if match_only:
    for kind in ("cold", "warm"):
        if kind in newest:
            print(f"{kind} {newest[kind]}")
    sys.exit(0)
if warm and "warm" in newest:
    answer(newest["warm"], f"{host}'s newest warm receipt for checkout shape {spec}")
if warm and peer(peer_warm):
    answer(peer(peer_warm), f"the other beelink's newest warm receipt for checkout shape {spec}")
note = "; a warm checkout pays it until a beelink has a warm receipt of its shape" if warm else ""
if "cold" in newest:
    answer(newest["cold"], f"{host}'s newest cold receipt for checkout shape {spec}{note}")
if peer(peer_cold):
    answer(peer(peer_cold), f"the other beelink's newest cold receipt for checkout shape {spec}{note}")
answer(fallback, f"the 10 GiB headroom (no receipt for checkout shape {spec}){note}")
PY
}

# The bytes a gate owns on disk: its checkout and the package stores its install
# writes, in one du, so a node_modules file hardlinked into the store counts once.
# On beelink1 at load 12-16 the Lab checkout and the 15 GiB pnpm store (486,018
# files) took 1.1-2.7 s. Prints nothing when du fails, warns about anything but a
# file that vanished mid-scan, or runs past <seconds> (the caller passes 60 s or the
# gate's remaining hold, whichever is less, so a scan never holds the lock past it).
gate_disk() { python3 -c "$beelink_gate_disk_source" "$@"; }
gate_bytes() {  # <seconds> <checkout> <store>...
  local limit=$1
  shift
  (( limit > 0 )) || return 1
  gate_disk scan "${disk_dir:-}" "${disk_snapshot_phase:-before}" "$limit" "$@"
}

# The shape a cached checkout has now: full, or the digest of its applied
# patterns. Fails when there is no checkout.
checkout_shape() {  # <checkout>
  [ -d "$1/.git" ] || return 1
  if [ "$(git -C "$1" config --bool core.sparseCheckout)" = true ]; then
    sparse_spec_of < "$1/.git/info/sparse-checkout"
  else
    echo full
  fi
}

# Before a gate holds a checkout lock it cannot know which copy it gets, so the
# probe and the first admission check assume warm when any copy of the repo has
# the gated commit's shape. Only the check after the lock is binding.
any_copy_warm() {  # <repo cache dir> <spec>
  local copy
  [ -n "$2" ] || return 1
  for copy in "$1" "$1"@*; do
    [ "$(checkout_shape "$copy" 2>/dev/null)" != "$2" ] || return 0
  done
  return 1
}

# The cache is keyed by host/owner/repo, so any spelling of that repo (https or
# SSH, with or without .git) owns it; a different repo in that path is refused.
# The checkout keeps the origin it was created with: that transport has already
# fetched on this host, while the caller's spelling may need credentials the
# beelink does not have (an https URL without a token prompts and hangs).
adopt_origin() {
  local checkout=$1 url=$2 origin origin_key
  # The recorded URL, not `remote get-url`, which applies url.*.insteadOf rewrites.
  origin=$(git -C "$checkout" config --get remote.origin.url) || return $?
  origin_key=$(parse_repo_url "$origin" 2>/dev/null && printf '%s/%s/%s' "$host" "$owner" "$repo")
  [ "$origin_key" = "$host/$owner/$repo" ] || die "cache origin mismatch at $checkout: $origin is not $url"
  # A GitHub cache fetches over SSH, the transport the beelinks hold a key for;
  # an https origin left by an earlier gate is moved to it.
  if [ "$origin" != "$(fetch_url "$url")" ] && [ "$host" = github.com ]; then
    git -C "$checkout" remote set-url origin "$(fetch_url "$url")" || return $?
  fi
}

# The URL a cache fetches from. The beelinks have an SSH key for GitHub and no
# https credentials, so https://github.com/<owner>/<repo> is fetched as
# git@github.com:<owner>/<repo>.git: on 2026-10-12 a cold tangle-tools cache
# cloned from the https spelling failed with "could not read Username".
fetch_url() {
  if [ "$host" = github.com ]; then echo "git@github.com:$owner/$repo.git"; else echo "$1"; fi
}

# A branch name the gate may check out: Git's own rules, plus no leading dash.
valid_branch_name() {
  [[ "$1" =~ ^[A-Za-z0-9._/-]{1,200}$ && "$1" != -* ]] && git check-ref-format --branch "$1" >/dev/null 2>&1
}

# Native addons under node_modules/.pnpm that the gate's Node cannot load, one
# "<name>\t<package dir>\t<reason>" line each: an addon under build/ made for
# another NODE_MODULE_VERSION (process.versions.modules), or a package with a
# binding.gyp and no .node file that the repo allows to build. The build policy
# comes from the repo (pnpm-workspace.yaml, package.json "pnpm") and from
# node_modules/.modules.yaml: allowBuilds, onlyBuiltDependencies,
# neverBuiltDependencies, ignoredBuiltDependencies and ignoredBuilds. A package
# the repo keeps from building is never reported, and N-API addons load under
# any Node.
stale_native_addons() {
  [ -n "$gate_abi" ] || { echo "beelink-gate: cannot read the NODE_MODULE_VERSION of node $gate_node to check native addons" >&2; return 1; }
  python3 - "$gate_abi" "${gate_node_bin:-node}" <<'PY'
import json, os, re, subprocess, sys, tempfile
abi, node = sys.argv[1], sys.argv[2]
root = "node_modules/.pnpm"
allowed, denied = set(), set()

def bare(name):
    name = str(name).strip().strip("'\"")
    return re.sub(r"@[^@/]*$", "", name) if name.rfind("@") > 0 else name

def policy(config):
    if not isinstance(config, dict):
        return
    for name, value in (config.get("allowBuilds") or {}).items():
        (allowed if value is True or str(value).lower() == "true" else denied).add(bare(name))
    allowed.update(bare(n) for n in config.get("onlyBuiltDependencies") or [])
    for key in ("neverBuiltDependencies", "ignoredBuiltDependencies", "ignoredBuilds"):
        denied.update(bare(n) for n in config.get(key) or [])

def read_yaml(path):
    """The top-level lists and flat mappings of a pnpm YAML file; enough for its build policy."""
    try:
        text = open(path).read()
    except OSError:
        return {}
    try:
        return json.loads(text)
    except ValueError:
        pass
    config, section = {}, None
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if re.match(r"^\S", line):
            section = line.split(":", 1)[0].strip()
            config.setdefault(section, None)
        elif section and line.strip().startswith("- "):
            config[section] = (config[section] if isinstance(config[section], list) else []) + [line.strip()[2:]]
        elif section and ":" in line:
            key, _, value = line.strip().rpartition(":")
            if not isinstance(config[section], dict):
                config[section] = {}
            config[section][key.strip().strip("'\"")] = value.strip()
    return config

policy(read_yaml("node_modules/.modules.yaml"))
policy(read_yaml("pnpm-workspace.yaml"))
try:
    policy(json.load(open("package.json")).get("pnpm") or {})
except (OSError, ValueError, AttributeError):
    pass
allowed -= denied

def addons(top, depth=0):
    try:
        entries = list(os.scandir(top))
    except OSError:
        return
    for entry in entries:
        if entry.is_symlink() or entry.name == "node_modules":
            continue
        if entry.is_dir() and depth < 4:
            yield from addons(entry.path, depth + 1)
        elif entry.name.endswith(".node") and entry.is_file():
            yield entry.path

def entrypoint_loads_native(path):
    # Prebuilt addons may live in optional dependency packages. Let this Node
    # validate a declared same-family platform binary reachable from this
    # entrypoint, excluding incidental native dependencies and preloads.
    probe = r"""
const fs = require('node:fs'), path = require('node:path');
const root = process.argv[1], manifest = require(path.join(root, 'package.json'));
const family = manifest.name.split('/').pop() + '-';
const libc = process.platform === 'linux' && (process.report.getReport().header.glibcVersionRuntime ? 'glibc' : 'musl');
function owner(file) {
  for (let dir = path.dirname(fs.realpathSync(file));; dir = path.dirname(dir)) {
    const metadata = path.join(dir, 'package.json');
    if (fs.existsSync(metadata)) return { root: dir, manifest: JSON.parse(fs.readFileSync(metadata, 'utf8')) };
    if (dir === path.dirname(dir)) return null;
  }
}
const providers = new Set();
for (const name of Object.keys(manifest.optionalDependencies || {})) {
  if (!name.split('/').pop().startsWith(family)) continue;
  try {
    const candidate = owner(require.resolve(name, { paths: [root] })), meta = candidate.manifest;
    if (meta.name === name && meta.os?.includes(process.platform) && meta.cpu?.includes(process.arch)
        && (!libc || meta.libc?.includes(libc))) providers.add(candidate.root);
  } catch {}
}
const entry = require.resolve(root);
require(entry);
const seen = new Set(), native = [];
function visit(mod) {
  if (!mod || seen.has(mod.id)) return;
  seen.add(mod.id);
  if (mod.filename.endsWith('.node') && providers.has(owner(mod.filename)?.root)) native.push(mod.filename);
  for (const child of mod.children) visit(child);
}
visit(require.cache[entry]);
console.log(JSON.stringify(native));
"""
    try:
        # A helper may inherit stdout after Node exits; a file avoids waiting
        # forever for a descendant to close a captured pipe after timeout.
        with tempfile.TemporaryFile(mode="w+") as output:
            result = subprocess.run([node, "-e", probe, os.path.abspath(path)],
                                    stdin=subprocess.DEVNULL, stdout=output,
                                    stderr=subprocess.DEVNULL, text=True, timeout=10)
            output.seek(0)
            loaded = json.load(output) if result.returncode == 0 else []
        return isinstance(loaded, list) and bool(loaded)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False

for store_entry in sorted(os.listdir(root)) if os.path.isdir(root) else []:
    base = os.path.join(root, store_entry, "node_modules")
    try:
        names = os.listdir(base)
    except OSError:
        continue
    for name in names:
        candidates = [os.path.join(name, s) for s in os.listdir(os.path.join(base, name))] if name.startswith("@") and os.path.isdir(os.path.join(base, name)) else [name]
        for pkg in candidates:
            path = os.path.join(base, pkg)
            if os.path.islink(path) or not os.path.isfile(os.path.join(path, "binding.gyp")) or pkg in denied:
                continue
            found = list(addons(path))
            if not found:
                if pkg in allowed and not entrypoint_loads_native(path):
                    print(f"{pkg}\t{path}\tmissing addon")
                continue
            for addon in found:
                if os.sep + "build" + os.sep not in addon[len(path):] + os.sep:
                    continue
                with open(addon, "rb") as fh:
                    built = re.search(rb"node_register_module_v(\d+)", fh.read())
                if built and built.group(1).decode() != abi:
                    print(f"{pkg}\t{path}\tabi {built.group(1).decode()}->{abi}")
                    break
PY
}

# Rebuild the stale native addons for the gate's Node before the command runs.
# Each one's build directory is unlinked first: pnpm links build output from its
# store, and a rebuild in place overwrites the store's shared copy for every
# checkout and Node that links it. The result goes on the receipt.
rebuild_native_addons() {
  local stale names=() dirs=() reasons=() name dir reason after scan_rc
  stale=$(BEELINK_GATE_RUN=$run_token stale_native_addons); scan_rc=$?
  reap_leftovers
  (( scan_rc == 0 )) || return "$scan_rc"
  [ -n "$stale" ] || return 0
  while IFS=$'\t' read -r name dir reason; do
    names+=("$name"); dirs+=("$dir"); reasons+=("$name $reason")
  done <<< "$stale"
  echo "beelink-gate: rebuilding native addons for node $gate_node: ${reasons[*]}" >&2
  for dir in "${dirs[@]}"; do rm -rf -- "$dir/build" || return $?; done
  step pnpm rebuild --store-dir "$HOME/.local/share/pnpm/store" "${names[@]}" || return $?
  after=$(BEELINK_GATE_RUN=$run_token stale_native_addons); scan_rc=$?
  reap_leftovers
  (( scan_rc == 0 )) || return "$scan_rc"
  if [ -n "$after" ]; then
    native_rebuild="failed: ${reasons[*]}"
    echo "beelink-gate: NATIVE ADDONS STILL STALE after pnpm rebuild, so node $gate_node cannot load them: ${after//$'\t'/ }" >&2
    return 1
  fi
  native_rebuild="${reasons[*]}"
}

# One line describing the holder of a lock, from the metadata its gate wrote.
holder_line() {
  local info="$1.holder" pid started sha launcher
  [ -f "$info" ] && [ ! -L "$info" ] || { echo "holder unknown (no metadata; an older gate version)"; return; }
  pid=$(sed -n 's/^pid=//p' "$info"); started=$(sed -n 's/^started=//p' "$info")
  sha=$(sed -n 's/^sha=//p' "$info"); launcher=$(sed -n 's/^launcher=//p' "$info")
  local state=dead
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && state=alive
  echo "holder pid=$pid ($state) sha=${sha:0:12} launcher=${launcher:-unknown} held=$(( $(date +%s) - ${started:-0} ))s"
}

# A gate whose main process is gone can leave children that inherited the lock
# descriptor (gates before this version passed it to the command). Kill only
# processes that hold this lock file open, are in the dead holder's session and
# are not themselves gates. A live holder is never touched.
reclaim_dead_holder() {
  local lock=$1 info="$1.holder" pid sid p fd target self_sid candidates=()
  [ -f "$info" ] && [ ! -L "$info" ] || return 0
  pid=$(sed -n 's/^pid=//p' "$info"); sid=$(sed -n 's/^sid=//p' "$info")
  [[ "$pid" =~ ^[0-9]+$ && "$sid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null && return 0
  self_sid=$(ps -o sid= -p $$ | tr -d ' ')
  [ "$sid" != "$self_sid" ] || return 0
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    [ "$p" != $$ ] || continue
    [ "$(ps -o sid= -p "$p" 2>/dev/null | tr -d ' ')" = "$sid" ] || continue
    for fd in /proc/"$p"/fd/*; do
      target=$(readlink "$fd" 2>/dev/null) || continue
      if [ "$target" = "$lock" ]; then
        case "$(tr '\0' ' ' < /proc/"$p"/cmdline 2>/dev/null)" in *--remote*|*beelink-gate*) ;; *) candidates+=("$p") ;; esac
        break
      fi
    done
  done
  [ "${#candidates[@]}" -gt 0 ] || return 0
  for p in "${candidates[@]}"; do
    echo "beelink-gate: reclaiming lock from dead gate $pid: killing leftover pid $p ($(tr '\0' ' ' < /proc/"$p"/cmdline 2>/dev/null | cut -c1-120))" >&2
    kill -TERM "$p" 2>/dev/null
  done
  sleep 5
  for p in "${candidates[@]}"; do kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null; done
  return 0
}

# Prints one line for `auto`: state=free|busy|refused, cache=warm|cold, load.
remote_probe() {
  if [ "$#" -lt 4 ] || [ "$#" -gt 6 ]; then die "invalid probe request"; fi
  local beelink repo_url window_day window_hour host owner repo cache_root lock fd state=free cache=cold reason="" next="" err probe_mode=install reserve_mode reserve
  beelink=$(decode "$1") repo_url=$(decode "$2") window_day=$(decode "$3") window_hour=$(decode "$4") || die "invalid probe encoding"
  [ "$#" -ge 5 ] && probe_mode=$(decode "$5")
  reserve_mode=$probe_mode
  [ "$#" -eq 6 ] && reserve_mode=$(decode "$6")
  light=0 dev=0; [ "$probe_mode" = light ] && light=1
  [ "$probe_mode" = dev ] && dev=1
  parse_repo_url "$repo_url"
  cache_root="${BEELINK_GATE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/beelink-gate}"
  local probe_heat=cold
  ! any_copy_warm "$cache_root/$host/$owner/$repo" "${BEELINK_GATE_SPARSE_SPEC:-}" || probe_heat=warm
  reserve=$(last_install_reserve_bytes "$beelink" "$host/$owner/$repo" "$reserve_mode" "${BEELINK_GATE_SPARSE_SPEC:-}" \
    "${BEELINK_GATE_PEER_RESERVE:-}" "${BEELINK_GATE_PEER_WARM_RESERVE:-}" "$probe_heat" 2>/dev/null) \
    || { state=refused; reason="cannot read install reserve receipts"; next=$(utc_in_minutes 5); }
  # A host short of its floor plus reserve gets the recovery a gate admitted there
  # would run, before auto passes it by: on 2026-10-17 beelink2 sat 3 GB short for
  # hours with idle cache it never pruned, because only an admitted gate prunes.
  # A recovery that leaves the host short is not repeated for 15 minutes, the
  # refusal's own retry time, so polling launchers do not rescan the cache.
  # Recovery runs only when the idle cache can close the gap: a shortfall it cannot
  # cover would evict every idle checkout, leave the caches cold and still refuse.
  local recovered=0 before shortfall floor_bytes stamp="$cache_root/.locks/.probe-recovery-short"
  if [ "$state" != refused ] && ! reason=$(check_floor "$beelink" "$reserve" 2>&1); then
    state=refused next=$(utc_in_minutes 15)
    if [ -d "$cache_root/.locks" ] && [ -z "$(find "$stamp" -mmin -15 2>/dev/null)" ] \
      && floor_bytes=$(( $(floor_gib "$beelink") * 1024 * 1024 * 1024 )); then
      before=$(free_bytes)
      shortfall=$(( floor_bytes + reserve - before ))
      if (( shortfall <= $(idle_cache_bytes "$cache_root") )); then
        mkdir -p "$STATE_DIR" 2>/dev/null
        { echo "$(date -u +%FT%TZ) probe $beelink short $shortfall bytes; recovering idle cache"
          recover_floor_from_cache "$beelink" "$cache_root" "${BEELINK_GATE_CACHE_MAX_BYTES:-42949672960}" \
            "$cache_root/.locks/no-current-checkout" "$reserve" 2>&1
        } >> "$STATE_DIR/capacity.log" 2>/dev/null
        recovered=$(( $(free_bytes) - before )); (( recovered > 0 )) || recovered=0
      fi
      if reason=$(check_floor "$beelink" "$reserve" 2>&1); then
        state=free next=""; rm -f "$stamp"
      else
        touch "$stamp"
      fi
    fi
  fi
  if [ "$state" != refused ]; then
    err=$(mktemp)
    next=$(check_update_window "$beelink" "$window_day" "$window_hour" 2>"$err") || { state=refused; reason=$(cat "$err"); }
    rm -f "$err"
    if [ "$state" != refused ]; then next=""; elif [ -z "$next" ]; then next=$(utc_in_minutes 5); fi
  fi
  # A repo has BEELINK_GATE_REPO_CHECKOUTS checkouts per host; one free is enough.
  # A light gate has its own, <repo>@light.
  local copies=${BEELINK_GATE_REPO_CHECKOUTS:-2} k suffix free_copy=""
  [[ "$copies" =~ ^[1-9][0-9]*$ ]] || copies=2
  [ "$light" = 1 ] && copies=1
  [ "$dev" = 1 ] && copies=1
  if [ "$state" = free ]; then
    state=busy
    for ((k = 0; k < copies; k++)); do
      suffix=$([ "$k" = 0 ] || echo "@$k"); [ "$light" = 1 ] && suffix=@light; [ "$dev" = 1 ] && suffix=@dev
      lock="$cache_root/.locks/$host-$owner-$repo$suffix.lock"
      if [ ! -e "$lock" ]; then state=free free_copy=$suffix; break; fi
      exec {fd}<"$lock" || die "cannot open lock"
      if flock -n -s "$fd"; then state=free free_copy=$suffix; exec {fd}<&-; break; fi
      exec {fd}<&-
      reason=$(holder_line "$lock")
    done
    [ "$state" = busy ] || reason=""
  fi
  [ -d "$cache_root/$host/$owner/$repo$free_copy/.git" ] && cache=warm
  local max_slots=${BEELINK_GATE_MAX_CONCURRENT:-6} pool=slot free_slots=0 i slot
  [ "$light" = 1 ] && { max_slots=${BEELINK_GATE_LIGHT_SLOTS:-2}; pool="light-slot"; }
  [ "$dev" = 1 ] && { max_slots=${BEELINK_GATE_DEV_SLOTS:-2}; pool="dev-slot"; }
  for ((i = 0; i < max_slots; i++)); do
    slot="$cache_root/.locks/$pool-$i.lock"
    if [ ! -e "$slot" ]; then free_slots=$((free_slots + 1)); continue; fi
    exec {fd}<"$slot" || continue
    flock -n -s "$fd" && free_slots=$((free_slots + 1))
    exec {fd}<&-
  done
  local probe_load probe_limit host_cpu capacity mode=legacy held workers full full_limit
  host_cpu=$(host_pressure_now)
  if capacity=$(quota_capacity); then
    mode=quota-tentative
    read -r probe_load probe_limit held workers full full_limit < <(capacity_fields "$capacity")
    if over_limit "$full" "$full_limit"; then probe_load=$full probe_limit=$full_limit; fi
  else
    capacity=null probe_load=$(load_now) probe_limit=$(load_limit)
    if [ -n "$host_cpu" ] && over_limit "$host_cpu" "$(host_pressure_ceiling)"; then
      probe_load=$host_cpu probe_limit=$(host_pressure_ceiling)
    fi
  fi
  printf 'beelink-gate-probe host=%s state=%s cache=%s slots=%s load=%s limit=%s host_cpu=%s next=%s recovered=%s admission=%s capacity=%s reason=%s\n' \
    "$beelink" "$state" "$cache" "$free_slots" "$probe_load" "$probe_limit" "${host_cpu:--}" "${next:--}" "$recovered" "$mode" "$capacity" "$(printf '%s' "$reason" | tr '\n' ' ' | cut -c1-240)"

}

# After a green --ship run, sign what ran and on which tree with this beelink's
# own key, and publish it at refs/ship-proofs/<tree> so the repo's deploy can
# skip repeating the same checks (gtm-agent scripts/ship-proof.mjs). Only repos
# that pin signers in scripts/ship-proof-signers get a proof. The key never
# reaches a command, and a failure here never changes the gate's result.
publish_proof() {
  # Each starts empty: a `local` without a value is unset, and the result check
  # below reads status after any of the API calls may have failed first.
  local key="$HOME/.config/beelink-gate/ship-proof-key" gh="$HOME/bin/gh-drew" tmp="" tree="" empty="" commit="" status="" version=""
  [ -f scripts/ship-proof-signers ] || return 0
  [ "$host" = github.com ] || { echo "beelink-gate: no proof published: $host is not GitHub" >&2; return 0; }
  [ -f "$key" ] || { echo "beelink-gate: no proof published: $beelink has no ship-proof key" >&2; return 0; }
  [ -x "$gh" ] || gh=$(command -v gh-drew) || { echo "beelink-gate: no proof published: gh-drew unavailable on $beelink" >&2; return 0; }
  tree=$(git rev-parse 'HEAD^{tree}') || return 0
  version=$(declare -f remote_gate publish_proof prepare_gate_dependencies prepare_yarn_launcher install_yarn_dependencies resolve_gate_node repo_pnpm_version install_step rebuild_native_addons stale_native_addons | sha256sum | cut -d' ' -f1)
  tmp=$(mktemp -d) || return 0
  printf 'ship-proof v1\nrepo=%s\ntree=%s\ncommit=%s\ncommand=%s\ngate=%s\nhost=%s\nat=%s\nexit=0\n' \
    "$host/$owner/$repo" "$tree" "$(git rev-parse HEAD)" "${command[*]}" "$version" "$beelink" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp/receipt"
  if ! ssh-keygen -Y sign -q -f "$key" -n ship-proof "$tmp/receipt" </dev/null >/dev/null 2>&1; then
    echo "beelink-gate: no proof published: signing failed" >&2; rm -rf "$tmp"; return 0
  fi
  cat "$tmp/receipt" "$tmp/receipt.sig" > "$tmp/message"
  empty=$("$gh" api -X POST "repos/$owner/$repo/git/trees" --input - --jq .sha <<<'{"tree":[]}' 2>/dev/null) &&
    commit=$("$gh" api -X POST "repos/$owner/$repo/git/commits" -F "message=@$tmp/message" -f "tree=$empty" --jq .sha 2>/dev/null) &&
    status=$("$gh" api -X POST "repos/$owner/$repo/git/refs" -f "ref=refs/ship-proofs/$tree" -f "sha=$commit" --jq .ref 2>&1)
  case "$?:$status" in
    0:refs/ship-proofs/*) echo "beelink-gate: published ship proof for tree $tree at refs/ship-proofs/$tree" >&2 ;;
    *already\ exists*) echo "beelink-gate: a ship proof for tree $tree already exists" >&2 ;;
    *) echo "beelink-gate: no proof published: GitHub refused ($(printf '%s' "${status:-no response}" | tr '\n' ' ' | cut -c1-160))" >&2 ;;
  esac
  rm -rf "$tmp"
  return 0
}

# After a green --ship verify, run the repo's pre-merge chat canary when it
# offers one (`scripts/ship.sh preview <base>`) and names the vault files its
# credentials come from (scripts/ship-preview.vault, one file per line under
# ~/company/devops/secrets). The credentials reach that step only. Exit: 0 when
# the preview passed or the change needs none, 0 when it was refused (ship
# verify stands alone; the reason is printed), 75 when a release preempted it,
# 1 when it failed. The preview's receipt goes into this gate's receipt row.
run_preview() {
  local vault="$HOME/company/devops/secrets" line receipt_file rc
  local -a files=()
  grep -q '^  preview) ' scripts/ship.sh 2>/dev/null && [ -f scripts/ship-preview.vault ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}; line=${line//[[:space:]]/}
    [ -n "$line" ] || continue
    [[ "$line" =~ ^[A-Za-z0-9._-]+\.env$ ]] || { echo "beelink-gate: preview not run: '$line' is not a vault file name" >&2; return 1; }
    [ -f "$vault/$line" ] || { echo "beelink-gate: preview not run: $vault/$line is missing on $beelink" >&2; return 1; }
    files+=(-f "$vault/$line")
  done < scripts/ship-preview.vault
  [ -n "$default_branch" ] || { echo "beelink-gate: preview not run: the remote default branch is unknown" >&2; return 1; }
  receipt_file=$(mktemp) || return 1
  echo "beelink-gate: running the pre-merge preview against origin/$default_branch" >&2
  step npx -y @dotenvx/dotenvx run "${files[@]}" --quiet -- \
    env SHIP_PREVIEW_RECEIPT="$receipt_file" SHIP_PREVIEW_PR="$gate_pr" bash scripts/ship.sh preview "origin/$default_branch"
  rc=$?
  preview_result=$(tail -n 1 "$receipt_file" 2>/dev/null)
  rm -f "$receipt_file"
  case "$rc" in
    0|2) return 0 ;;
    3) tempfail_line "$(utc_in_minutes 5)" "the preview was preempted or inconclusive; ship verify passed"; return "$TEMPFAIL" ;;
    *) return 1 ;;
  esac
}

# Keep install timing on failure too; no inference from the surrounding precheck.
install_step() {
  local begin=$SECONDS status
  step "$@"; status=$?
  export BEELINK_GATE_INSTALL_S=$(( ${BEELINK_GATE_INSTALL_S:-0} + SECONDS - begin ))
  return "$status"
}

  receipt() {
    local status="$1" ran=$((SECONDS - started))
    local preview_verdict
    preview_verdict=$(printf '%s' "$preview_result" | python3 -c 'import json,sys; t=sys.stdin.read().strip(); print(json.loads(t).get("verdict","?") if t else "none")' 2>/dev/null || echo "?")
    printf 'beelink-gate receipt: sha=%s install=%s command=%s exit=%s duration=%ss waited=%ss host=%s timed_out=%s watchdog=%s load=%s preview=%s class=%s cpu_s=%s node=%s rebuild=%s cpu_pressure=%s starved=%s cgroup=%s cache=%s sparse=%s checkout=%s workers=%s reaped=%s bundle=%s host_cpu=%s%s\n' \
      "$sha" "$install_mode" "${display% }" "$status" "$ran" "$waited" "$beelink" "$timed_out" "$watchdog" "${start_load:-?}" "$preview_verdict" \
      "$( [ "${light:-0}" = 1 ] && echo light || { [ "${dev:-0}" = 1 ] && echo dev || echo normal; } )" "${cpu_s:-?}" "${gate_node:-?}" "${native_rebuild:-none}" "${start_pressure:-?}" "$starved" "${gate_cgroup_joined:-none}" "${cache_note:-ok}" "${sparse_source:-none}" "${checkout_temperature:-none}" "${gate_workers:-?}" "$reaped" "${bundle_note:-none}" "${start_host_pressure:-?}" "${gate_id:+ gate_id=$gate_id}" >&2
    mkdir -p "$STATE_DIR" 2>/dev/null && python3 - "$STATE_DIR/receipts.jsonl" "$beelink" "$host/$owner/$repo" "$sha" "$install_mode" \
      "${display% }" "$status" "$waited" "$ran" "$timed_out" "$watchdog" "$launcher" "${start_load:-}" "${preview_result:-}" "${cpu_s:-}" "${gate_node:-}" "${native_rebuild:-}" "${start_pressure:-}" "$starved" "${gate_cgroup_joined:-}" "${cache_note:-}" "$( [ "${light:-0}" = 1 ] && echo light || { [ "${dev:-0}" = 1 ] && echo dev || echo normal; } )" "$reaped" "$bundle_note" "${start_host_pressure:-}" "$gate_id" "$base_sha" "$gate_pr" "$gate_lane" "$observed_install_reserve_bytes" "$timing_file" "$fetch_s" "$pre_command_s" "$command_s" "$cleanup_s" "$capacity_claim_wait_ms" "$sparse_source" "$sparse_spec" "$checkout_temperature" "$reserve_gate_bytes" "$reserve_host_drop" "$reserve_basis" "$reserve_du_ms" <<'PY' || true
import fcntl, json, mmap, os, sys, time
from pathlib import Path
path, beelink, repo, sha, mode, command, status, waited, ran, timed_out, watchdog, launcher, load, preview, cpu, node, rebuild, pressure, starved, cgroup, cache_note, gate_class, reaped, bundle, host_cpu, gate_id, base_sha, pr_number, lane, install_reserve, timing_file, fetch_s, pre_command_s, command_s, cleanup_s, capacity_claim_wait_ms, sparse, sparse_spec, checkout_temperature, reserve_gate_bytes, reserve_host_drop, reserve_basis, reserve_du_ms = sys.argv[1:]
row = {"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "host": beelink, "repo": repo, "sha": sha,
       "mode": mode, "command": command, "exit": int(status), "waited_s": int(waited), "ran_s": int(ran),
       "timed_out": timed_out == "1", "watchdog": watchdog == "1", "launcher": launcher,
       "start_load": float(load) if load else None,
       "start_cpu_pressure": float(pressure) if pressure else None,
       "starved": starved == "1", "cgroup": cgroup or None, "cache_unpruned": cache_note == "unpruned",
       "class": gate_class, "cpu_s": float(cpu) if cpu else None,
       "node": node or None, "rebuild": rebuild or None, "reaped": int(reaped), "bundle": bundle or None,
       "start_host_cpu_pressure": float(host_cpu) if host_cpu else None, "gate_id": gate_id or None,
       "base_sha": base_sha or None, "pr_number": int(pr_number) if pr_number else None,
       "lane": lane or None, "sparse": sparse or None, "sparse_spec": sparse_spec or None, "checkout_temperature": checkout_temperature or None, "reason_scope": "host_last_10000_receipts"}
try:
    row["admission"] = json.loads(os.environ.get("BEELINK_GATE_ADMISSION_SAMPLE", "null"))
except ValueError:
    row["admission"] = None
try:
    disk = json.loads(os.environ.get("BEELINK_GATE_DISK_OBSERVATION") or "null")
    row["disk_observation"] = disk if isinstance(disk, dict) else None
except ValueError:
    row["disk_observation"] = None
if int(install_reserve):
    row["install_reserve_bytes"] = int(install_reserve)
    # The gate's own bytes against the host's free-space drop over the same window.
    row["reserve_basis"] = reserve_basis or None
    for key, value in (("reserve_gate_bytes", reserve_gate_bytes), ("reserve_host_free_drop", reserve_host_drop), ("reserve_du_ms", reserve_du_ms)):
        row[key] = int(value) if value.lstrip("-").isdigit() else None
if preview:
    try:
        row["preview"] = json.loads(preview)
    except ValueError:
        row["preview"] = {"unreadable": True}
install_s = os.environ.get("BEELINK_GATE_INSTALL_S")
spans = {}
timing = {"fetch_s": int(fetch_s) if fetch_s else None,
          "install_s": int(install_s) if install_s else None,
          "typecheck_s": None, "tests_s": None,
          "pre_command_s": int(pre_command_s) if pre_command_s else None,
          "command_s": int(command_s) if command_s else None,
          "cleanup_s": int(cleanup_s) if cleanup_s else None,
          "capacity_claim_wait_ms": int(capacity_claim_wait_ms),
          "cache_lock_wait_ms": None,
          "cache_size_scans": None,
          "cache_prune_work_ms": None}
# pre_command_s includes fetch and precheck prune; cleanup_s includes cleanup
# prune. These nested spans must not be added to ran_s as separate phases.
if timing_file:
    try:
        with open(timing_file, encoding="utf-8") as phases:
            timing["cache_lock_wait_ms"] = {"precheck": 0, "cleanup": 0}
            timing["cache_size_scans"] = {"precheck": 0, "cleanup": 0}
            timing["cache_prune_work_ms"] = {"precheck": 0, "cleanup": 0}
            for line in phases:
                fields = line.split()
                phase = fields[0] if fields else ""
                if phase in ("precheck", "cleanup"):
                    _, wait, work = fields
                    timing["cache_lock_wait_ms"][phase] += int(wait)
                    timing["cache_prune_work_ms"][phase] += int(work)
                elif phase == "cache_scans" and len(fields) == 3 and fields[1] in ("precheck", "cleanup"):
                    timing["cache_size_scans"][fields[1]] += int(fields[2])
                elif phase in ("typecheck", "tests") and len(fields) == 3:
                    # Caller-owned monotonic spans; union overlaps rather than double-counting parallel checks.
                    begin, end = map(float, fields[1:])
                    if 0 <= begin <= end < float("inf"):
                        spans.setdefault(phase, []).append((begin, end))
    except (OSError, ValueError):
        pass  # A missing measurement must not change the gate result.
for phase, intervals in spans.items():
    elapsed = 0
    right = 0
    for begin, end in sorted(intervals):
        elapsed += max(0, end - max(begin, right))
        right = max(right, end)
    timing[phase + "_s"] = round(elapsed, 3)
try:
    timing["turbo_cache"] = json.loads(os.environ.get("BEELINK_GATE_TURBO_OBSERVATIONS") or "null")
except ValueError:
    timing["turbo_cache"] = None
row["timing"] = timing
with open(path, "a+") as out:
    fcntl.flock(out, fcntl.LOCK_EX)
    prior_head = prior_exact = None
    if os.fstat(out.fileno()).st_size:
