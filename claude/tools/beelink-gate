      if capacity_writer_active; then
        flock -u "$capacity_fd"
        wait_for_capacity_writer
        continue
      fi
      break
    done
    capacity_claim_wait_ms=$((capacity_claim_wait_ms + $(date +%s%3N) - claim_started_ms))
