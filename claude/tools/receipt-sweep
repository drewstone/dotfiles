#!/usr/bin/env bash
# Land agent-container PRs through the revision receipt, one at a time.
#
# Usage:
#   receipt-sweep [--repo owner/name] [--deadline 4h] [--state-dir DIR] <pr>...
#   receipt-sweep --detach [same options] <pr>...
#
# Per PR: read the head, gate it with beelink-gate running
# `node scripts/ci/revision-receipt.mjs merge <N>`, wait out exit 75 until the
# gate's next_allowed (plus 20s, clamped to 30s..20m) until --deadline, rerun
# once when the receipt step failed after a full signoff passed, and move on
# from any other failure. Each PR appends exactly one line to
# <state-dir>/<N>.result and prints it. --detach re-runs this tool under
# `setsid nohup bash -lc`, so PATH has gh-drew and beelink-gate.
#
# Test and tuning knobs: RECEIPT_SWEEP_SLEEP (sleep command),
# RECEIPT_SWEEP_BASE (default branch, develop), RECEIPT_SWEEP_DETACH_WAIT (20),
# RECEIPT_SWEEP_MERGE_POLL (poll seconds after the gate, 300).
# shellcheck disable=SC2016 # GraphQL variables are not shell expansions.
set -uo pipefail
die() { echo "receipt-sweep: $*" >&2; exit 2; }
log() { echo "receipt-sweep: $*" >&2; }

REPO=tangle-network/agent-container
DEADLINE=4h
STATE_DIR="${HOME}/.local/state/receipt-sweep"
DETACH=0
SLEEP="${RECEIPT_SWEEP_SLEEP:-sleep}"
BASE="${RECEIPT_SWEEP_BASE:-develop}"
PRS=()

now_epoch() { python3 -c 'import time; print(int(time.time()))'; }
utc_stamp() { python3 -c 'import datetime as d; print(d.datetime.now(d.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))'; }
parse_duration() {
  python3 -c '
import re, sys
m = re.fullmatch(r"(\d+)([smhd]?)", sys.argv[1])
if not m: sys.exit(1)
print(int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)])' "$1"
}
# Seconds to sleep for a next_allowed UTC stamp: until it plus 20s, within 30s..20m.
wait_seconds() {
  python3 -c '
import datetime as d, sys, time
w = 0
try:
    t = d.datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=d.timezone.utc)
    w = int(t.timestamp() - time.time()) + 20
except ValueError:
    pass
print(max(30, min(1200, w)))' "${1:-}"
}
strip_ansi() { LC_ALL=C sed $'s/\033\\[[0-9;]*m//g'; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; REPO="$2"; shift 2 ;;
    --deadline) [ $# -ge 2 ] || die "--deadline needs a value"; DEADLINE="$2"; shift 2 ;;
    --state-dir) [ $# -ge 2 ] || die "--state-dir needs a value"; STATE_DIR="$2"; shift 2 ;;
    --detach) DETACH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; PRS+=("$@"); break ;;
    -*) die "unknown option $1" ;;
    *) PRS+=("$1"); shift ;;
  esac
done
[ "${#PRS[@]}" -gt 0 ] || die "no PR numbers given (see --help)"
for n in "${PRS[@]}"; do [[ "$n" =~ ^[0-9]+$ ]] || die "not a PR number: $n"; done
[[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "bad --repo: $REPO"
DEADLINE_S="$(parse_duration "$DEADLINE")" || die "bad --deadline: $DEADLINE (use 90s, 30m, 4h)"
mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"

detach() {
  local self stamp pidfile logfile pid wait_s n
  self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  pidfile="$STATE_DIR/run-$stamp.pid"
  logfile="$STATE_DIR/run-$stamp.log"
  local args=(--repo "$REPO" --deadline "$DEADLINE" --state-dir "$STATE_DIR" "${PRS[@]}")
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup bash -lc 'exec "$@"' receipt-sweep "$self" "${args[@]}" </dev/null >"$logfile" 2>&1 &
  else
    nohup python3 -c 'import os, sys; os.setsid(); os.execvp("bash", ["bash", "-lc", "exec \"$@\"", "receipt-sweep"] + sys.argv[1:])' "$self" "${args[@]}" </dev/null >"$logfile" 2>&1 &
  fi
  pid=$!
  echo "$pid" > "$pidfile"
  wait_s="${RECEIPT_SWEEP_DETACH_WAIT:-20}"
  "$SLEEP" "$wait_s"
  if grep -q "command not found" "$logfile" 2>/dev/null; then
    echo "receipt-sweep: detached run failed to start (exit 127, command not found); log $logfile" >&2
    tail -5 "$logfile" >&2
    exit 127
  fi
  if kill -0 "$pid" 2>/dev/null; then
    echo "receipt-sweep: running pid $pid (pidfile $pidfile); stop it with: kill \$(cat $pidfile)"
  else
    echo "receipt-sweep: pid $pid already finished; read the log"
  fi
  echo "log: $logfile"
  for n in "${PRS[@]}"; do echo "result: $STATE_DIR/$n.result"; done
  exit 0
}
[ "$DETACH" = 1 ] && detach

for tool in gh-drew beelink-gate python3; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool not on PATH (use --detach, which starts a login shell)"
done

START="$(now_epoch)"
DEADLINE_AT=$((START + DEADLINE_S))
REPO_URL="git@github.com:${REPO}.git"
OWNER="${REPO%%/*}"
NAME="${REPO##*/}"

# Prints: author<TAB>isDraft<TAB>state<TAB>branch<TAB>head<TAB>mergeCommit
read_pr() {
  gh-drew api graphql \
    -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){author{login} isDraft state headRefName headRefOid mergeCommit{oid}}}}' \
    -f o="$OWNER" -f r="$NAME" -F n="$1" \
    --jq '.data.repository.pullRequest | [(.author.login // ""), (.isDraft|tostring), .state, .headRefName, .headRefOid, (.mergeCommit.oid // "")] | @tsv' 2>/dev/null
}

# Does the base branch's recent history hold this PR's merge?
on_base() {
  local n="$1" merge="$2" out
  out="$(gh-drew api graphql \
    -f query='query($o:String!,$r:String!,$b:String!){repository(owner:$o,name:$r){ref(qualifiedName:$b){target{...on Commit{history(first:100){nodes{oid messageHeadline}}}}}}}' \
    -f o="$OWNER" -f r="$NAME" -f b="refs/heads/$BASE" \
    --jq '.data.repository.ref.target.history.nodes[] | .oid + " " + .messageHeadline' 2>/dev/null)" || return 1
  if [ -n "$merge" ] && printf '%s\n' "$out" | grep -q "^$merge "; then return 0; fi
  # Develop's merge headlines: "Merge pull request #N from", "chore: merge locally
  # signed PR #N" (revision-receipt) and "chore: merge checked version PR N".
  printf '%s\n' "$out" | grep -Eq "\(#$n\)|[Pp]ull request #$n( |$)|PR #?$n( |$)"
}

write_result() { # pr head attempts exit state merge receipt
  local line
  line="$(utc_stamp) pr=$1 head=${2:--} attempts=$3 exit=$4 state=${5:--} merge=${6:--} receipt=${7:--}"
  printf '%s\n' "$line" >> "$STATE_DIR/$1.result"
  printf '%s\n' "$line"
}

last_receipt_line() {
  grep -E "revision-receipt:|beelink-gate receipt|TEMPFAIL|REFUSED" "$1" | grep -v "GitHub calls" | tail -1 | cut -c1-260
}

sweep_pr() {
  local n="$1" info author draft state branch head merge attempts=0 rc=0 reran=0
  local out receipt next wait_s remaining
  info="$(read_pr "$n")"
  IFS=$'\t' read -r author draft state branch head merge <<<"$info"
  if [ -z "$info" ]; then write_result "$n" - 0 - unknown - "skip: PR unreadable"; return; fi
  if [ "$author" != drewstone ] || [ "$state" != OPEN ] || [ "$draft" != false ]; then
    write_result "$n" "$head" 0 - "$state" "$merge" "skip: author=$author state=$state draft=$draft"; return
  fi
  out="$(mktemp "${TMPDIR:-/tmp}/receipt-sweep.XXXXXX")" || die "mktemp failed"
  while :; do
    # A develop merge or a late-visible push moves the head; use the current one.
    info="$(read_pr "$n")"
    if [ -n "$info" ]; then
      IFS=$'\t' read -r author draft state branch head merge <<<"$info"
      if [ "$state" != OPEN ] || [ "$draft" != false ]; then rc=0; receipt=""; break; fi
    fi
    attempts=$((attempts + 1))
    log "#$n attempt $attempts $branch @ ${head:0:8}"
    FLEET_LANE="${FLEET_LANE:-op-company:receipt-sweep}" timeout 2700 beelink-gate --branch "$branch" auto "$REPO_URL" "$head" -- node scripts/ci/revision-receipt.mjs merge "$n" 2>&1 | strip_ansi > "$out"
    rc=${PIPESTATUS[0]}
    cat "$out" >&2
    receipt="$(last_receipt_line "$out")"
    [ "$rc" -eq 0 ] && break
    if [ "$rc" -eq 75 ]; then
      next="$(grep -o 'next_allowed=[0-9T:-]*Z' "$out" | tail -1 | cut -d= -f2)"
      wait_s="$(wait_seconds "$next")"
      remaining=$((DEADLINE_AT - $(now_epoch)))
      if [ "$wait_s" -ge "$remaining" ]; then log "#$n deadline: next try is $wait_s s away, $remaining s left"; break; fi
      log "#$n TEMPFAIL; next_allowed=${next:-unknown}, sleeping ${wait_s}s"
      "$SLEEP" "$wait_s"
      continue
    fi
    if [ "$reran" -eq 0 ] && grep -q "receipt step failed after the full signoff passed" "$out"; then
      reran=1; log "#$n receipt step failed after a passing signoff; rerunning once"; continue
    fi
    break
  done
  rm -f "$out"
  # The merge can land before GitHub marks the PR merged; poll up to 5 minutes.
  local polled=0 poll_max="${RECEIPT_SWEEP_MERGE_POLL:-300}"
  while :; do
    info="$(read_pr "$n")"
    IFS=$'\t' read -r author draft state branch head merge <<<"$info"
    [ "$state" = MERGED ] && break
    [ "$rc" -eq 0 ] || break
    on_base "$n" "$merge" || break
    [ "$polled" -ge "$poll_max" ] && break
    "$SLEEP" 15; polled=$((polled + 15))
  done
  write_result "$n" "$head" "$attempts" "$rc" "$state" "$merge" "${receipt:-}"
}

log "start repo=$REPO prs=${PRS[*]} deadline=$DEADLINE state=$STATE_DIR"
for n in "${PRS[@]}"; do sweep_pr "$n"; done
log "done"
