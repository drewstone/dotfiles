def slot_repositories():
    """Read release-slot ownership from the same inventory that installs the timers."""
    path = Path(__file__).resolve().parents[2] / 'host/agents/merge-on-green.repos'
    repos, invalid = set(), set()
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        instance, *options = line.split()
        if options not in ([], ['slot']):
            invalid.add(instance.split(':')[0])
            print(f'merge-on-green: invalid inventory policy for {instance}; that repository is held: {options}', file=sys.stderr)
            continue
        if options:
            repos.add(instance.split(':')[0])
    return repos, invalid


