#!/usr/bin/env python3
"""Merge every green pull request into a repo's base branch (agent-container and develop by default).

usage: merge-on-green [--repo owner/name] [--base BRANCH] [--state-dir DIR] [--dry-run]
       merge-on-green pause --minutes N --reason TEXT    (N at most 120)
       merge-on-green resume
       merge-on-green status
       merge-on-green hold < answer.json   (one PR's GraphQL answer; exit 1 and the reason if held)

One tick reads every open PR into the base (--base, default develop) in one GraphQL call
and merges each PR that is ready:
  - not a draft, not conflicting, not a release branch;
  - Fast Checks, Build and Type Check succeeded on the current head (any other red check is
    advisory: it is named in the merge line, and develop's full fan fixes it forward);
    MERGE_ON_GREEN_REQUIRED="" (empty) drops the CI gate entirely: merge first, gate before deploy;
    MERGE_ON_GREEN_REQUIRED="*" requires every check on the head to pass (success, neutral or
    skipped), and a head with no checks at all merges only on a passed beelink-gate receipt for
    that head, which gh-drew checks (GH_DREW_REQUIRE_RECEIPT); the product repos outside
    agent-container run this way from merge-on-green@.timer;
  - no unresolved review thread opens with P0 or P1;
  - no hold label and no hold phrase in the body (a phrase that waits only for the gate is not a hold);
  - its head is at least 2 minutes old (a push may still be landing).
A PR that conflicts gets the base merged in by git, which honors .gitattributes merge
drivers (docs/invariants.md is merge=union) that GitHub's own merge ignores; a conflict git
cannot resolve gets one comment per head for its owner.
Merges pin the exact head they judged (--match-head-commit), use a merge commit
when the repo allows one (else squash, else rebase), and run as drewstone
through gh-drew, so base CI and release automation fire exactly as they do for any merge. Develop then runs the full test fan; red is fixed
forward (docs/processes/shipping.md in agent-container).

A pause holds every merge except PRs labelled release-critical, so a release gets
a clean CI window; version PRs stay with release automation, paused or not. It comes from
<state-dir>/pause.json, written by `pause` and removed by `resume`, or from the
repo variable MERGE_ON_GREEN_PAUSED="<until UTC ISO> [reason]", read once per
pass. Each ends on its own at its until; a variable also ends 120 minutes after
it was last set. While paused the pass runs and logs one line per skipped PR.

Each decision is appended to <state-dir>/decisions.jsonl and the open queue is
written to <state-dir>/status.md. Run it from a timer; it holds a lock.
"""
import argparse
import datetime as dt
import fcntl
import getpass
import json
import os
import re
import socket
import subprocess
import sys
import importlib.util
from pathlib import Path

_spec = importlib.util.spec_from_file_location('mog_github', Path(__file__).resolve().with_name('merge-on-green-github.py'))
_github = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_github)
CLIENT = None
REVIEW_FRAGMENT = Path(__file__).resolve().with_name('gh-drew-review.sh').read_text().split("<<'GRAPHQL'", 1)[1].split('\n', 1)[1].split('\nGRAPHQL', 1)[0]

REQUIRED = [c.strip() for c in os.environ.get("MERGE_ON_GREEN_REQUIRED", "Fast Checks,Build,Type Check").split(",") if c.strip()]
# "*": every check on the head is the gate. On 2026-10-21 about 60 PRs across the product repos waited for
# a hand merge because this tool served agent-container alone; most of those repos run no PR CI.
ALL_CHECKS = REQUIRED == ["*"]
PASSED = {"SUCCESS", "NEUTRAL", "SKIPPED"} if ALL_CHECKS else {"SUCCESS"}
# A no-CI head whose receipt gh-drew refused is asked again after this long, not every tick:
# each ask reads both beelinks' receipts over SSH.
RECEIPT_RETRY_S = 600
BASE = "develop"
RELEASE_PREFIXES = ("release/", "changeset-release/", "sync/main-", "queue/")
HOLD = re.compile(r"(?i)\b(do not merge|don'?t merge|merge only (after|when)|hold until)\b")
# A sentence that waits only for the gate this tool already requires is not a hold. #11327
# (2026-10-17) said "merge only after Fast Checks, Build and Type Check finish green on this head",
# sat green 3.5 h, and was merged by hand; the same hand pass merged #11312 past a real pre-deploy hold.
GATE_ONLY = re.compile(r"(?i)merge only (after|when)\s+(?:(?:the|hosted|required|gate|fast checks|checks?|build|type check|and|,)\s*)+"
                       r"(?:finish(?:es)?|pass(?:es)?|are|is|turn|go)?\s*green")
# "hold until" holds only as an instruction: it opens its sentence or list item, after at most "please" or "this PR".
# discovery-lab #2010 (2026-10-18) described behavior ("Both hold until a later start writes the journal")
# and was refused as held.
HOLD_UNTIL_LEAD = re.compile(r"(?i)(?:please|this|pr)?(?:\s+(?:please|this|pr))*")
# A cancelled run says nothing about the tree and nothing re-runs it, so it is not red;
# #11004 sat green for 2 h on 2026-10-15 behind a cancelled "regressions" run.
# The gate checks still have to read SUCCESS (REQUIRED below).
RED = {"FAILURE", "ERROR", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"}
# Statuses only the retired local-signoff path posted; a stale red one is not a gate.
RETIRED = {"signoff/local"}
MIN_HEAD_AGE_S = int(os.environ.get("MERGE_ON_GREEN_MIN_AGE_S", "120"))
# gh-drew waits for a Codex review running on the head before it merges; a tick does not wait,
# so such a PR is refused now and tried again on the next tick.
os.environ.setdefault("GH_DREW_REVIEW_WAIT", "0")
# A pause ends on its own: version PR #11196 needed one clean CI window on 2026-10-15, and the
# only pause then was stopping the timer by hand behind a separate dead-man restart.
PAUSE_MAX_MIN = 120
PAUSE_VAR = "MERGE_ON_GREEN_PAUSED"
ALLOW_LABEL = "release-critical"
ALLOWLIST = f"PRs labelled {ALLOW_LABEL} (version PRs stay with release.yml)"

QUERY = """query($owner:String!,$name:String!,$base:String!,$ref:String!){rateLimit{cost remaining resetAt}
repository(owner:$owner,name:$name){mergeCommitAllowed squashMergeAllowed
ref(qualifiedName:$ref){target{oid}}
pullRequests(states:OPEN,baseRefName:$base,first:100,orderBy:{field:CREATED_AT,direction:ASC}){nodes{
number isDraft mergeable isCrossRepository headRefName headRefOid updatedAt body labels(first:20){nodes{name}}
commits(last:1){nodes{commit{committedDate checkSuites(first:20){nodes{createdAt}} statusCheckRollup{contexts(first:100){nodes{__typename
...on CheckRun{name conclusion status completedAt} ...on StatusContext{context state}}}}}}}
reviews(last:1){nodes{updatedAt}}
comments(first:100){nodes{id updatedAt}}
reviewThreads(first:100){nodes{id isResolved isOutdated
comments(first:1){totalCount nodes{id updatedAt}}}}}}}}"""


def gh(*args, input=None, via="gh-drew", env=None):
    if CLIENT:
        return CLIENT.run(*args, input=input, via=via, env=env)
    return subprocess.run([via, *args], input=input, capture_output=True, text=True)


def allowlisted(pr):
    return ALLOW_LABEL in {l["name"] for l in pr["labels"]["nodes"]}


def utc(s):
    t = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def active_pause(a, now):
    """The pause in force now, from pause.json or the repo variable, or None; the later one wins."""
    pauses = []
    try:
        with open(os.path.join(a.state_dir, "pause.json")) as f:
            p = json.load(f)
        pauses.append((utc(p["until"]), p.get("reason", ""), f"{p.get('who') or 'unknown'} via pause.json"))
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    r = gh("api", f"repos/{a.repo}/actions/variables/{PAUSE_VAR}")
    try:
        v = json.loads(r.stdout)
        until, _, why = v["value"].strip().partition(" ")
        # A forgotten variable cannot hold merges past the same 120 minutes a `pause` may ask for.
        end = min(utc(until), utc(v["updated_at"]) + dt.timedelta(minutes=PAUSE_MAX_MIN))
        pauses.append((end, why.strip(), f"repo variable {PAUSE_VAR}"))
    except (ValueError, KeyError, TypeError, AttributeError):
        pass
    live = [p for p in pauses if p[0] > now]
    if not live:
        return None
    until, reason, by = max(live)
    return {"until": until.strftime("%Y-%m-%dT%H:%M:%SZ"), "reason": reason or "no reason given", "by": by}


def pause_line(p):
    if not p:
        return f"merge-on-green: not paused. A pause merges only: {ALLOWLIST}."
    return (f"merge-on-green: paused until {p['until']} ({p['reason']}), set by {p['by']}.\n"
            f"While paused it merges only: {ALLOWLIST}.")


def control(a):
    """The pause, resume and status commands; none of them takes the pass lock."""
    path = os.path.join(a.state_dir, "pause.json")
    if a.command == "pause":
        if a.minutes is None or not 1 <= a.minutes <= PAUSE_MAX_MIN or not (a.reason or "").strip():
            print(f"merge-on-green: pause needs --minutes 1..{PAUSE_MAX_MIN} and --reason; a longer hold is a new pause "
                  f"when this one ends (got --minutes {a.minutes})", file=sys.stderr)
            return 2
        until = dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=a.minutes)
        lane = os.environ.get("FLEET_LANE")
        rec = {"until": until.strftime("%Y-%m-%dT%H:%M:%SZ"), "reason": a.reason.strip(),
               "who": f"{getpass.getuser()}@{socket.gethostname()}" + (f" ({lane})" if lane else "")}
        with open(path + ".tmp", "w") as f:
            json.dump(rec, f)
        os.replace(path + ".tmp", path)
    elif a.command == "resume":
        if os.path.exists(path):
            os.remove(path)
        # The variable is the other pause source; resume ends both.
        gh("api", "--method", "DELETE", f"repos/{a.repo}/actions/variables/{PAUSE_VAR}")
    print(pause_line(active_pause(a, dt.datetime.now(dt.timezone.utc))))
    return 0


def hold_reason(pr):
    """Why the PR's author holds it (the hold label, or a hold phrase asking for more than the gate), or None.

    gh-drew asks the same question before a hand merge (`merge-on-green hold`).
    """
    labels = {l["name"] for l in ((pr.get("labels") or {}).get("nodes") or [])}
    if "hold" in labels:
        return "hold label"
    # A release cut held by its release owner: on 2026-10-19 a lane hand-merged
    # cut #11993 over hold-promotion and superseded eu1's fleet roll a minute in.
    if "hold-promotion" in labels:
        return "hold-promotion label (the release owner holds this cut)"
    body = pr.get("body") or ""
    for m in HOLD.finditer(body):
        if m.group(1).lower() == "hold until":
            lead = re.split(r"[.!?;:]\s", body[body.rfind("\n", 0, m.start()) + 1:m.start()])[-1]
            if not HOLD_UNTIL_LEAD.fullmatch(lead.strip(" \t-*>#").strip()):
                continue
        if not GATE_ONLY.match(body, m.start()):
            line = body[body.rfind("\n", 0, m.start()) + 1:].split("\n", 1)[0].strip()
            return "hold phrase in body: " + line[:160]
    return None


def hold_command():
    """`merge-on-green hold`: read one PR's GraphQL answer on stdin; print why it is held and exit 1, or exit 0."""
    try:
        repo = json.load(sys.stdin)["data"]["repository"]
        pr = repo.get("pullRequest") or ((repo.get("pullRequests") or {}).get("nodes") or [None])[0]
    except (ValueError, KeyError, TypeError, AttributeError, IndexError) as e:
        print(f"merge-on-green: hold: unreadable PR answer: {e}", file=sys.stderr)
        return 2
    if not pr:
        print("merge-on-green: hold: the answer names no pull request", file=sys.stderr)
        return 2
    why = hold_reason(pr)
    if why:
        print(why)
        return 1
    return 0


def decide(pr, now):
    """Return (action, reason) for one PR node: merge, conflict, or wait."""
    if pr["isDraft"]:
        return "wait", "draft"
    if pr["headRefName"].startswith(RELEASE_PREFIXES):
        return "wait", "release branch"
    held = hold_reason(pr)
    if held:
        return "wait", held
    if any(not t["isResolved"] and re.search(r"\bP[01]\b", (t["comments"]["nodes"] or [{"body": ""}])[0]["body"])
           for t in pr["reviewThreads"]["nodes"]):
        return "wait", "unresolved P0/P1 thread"
    if pr["mergeable"] == "CONFLICTING":
        # GitHub runs no pull_request CI on a conflicting head, so nothing else can change.
        return "conflict", f"conflicts with {BASE}"
    commit = pr["commits"]["nodes"][0]["commit"]
    # Judge each check by its latest run: a failure that was re-run green is green.
    runs = {}
    for c in (commit.get("statusCheckRollup") or {}).get("contexts", {}).get("nodes", []):
        if c["__typename"] == "CheckRun":
            runs.setdefault(c["name"], []).append((c.get("completedAt") or "~", c["conclusion"] or c["status"]))
        elif c["context"] not in RETIRED:
            runs.setdefault(c["context"], []).append(("~", c["state"]))
    checks = {n: [max(rs, key=lambda r: r[0])[1]] for n, rs in runs.items()}
    gate = sorted(checks) if ALL_CHECKS else REQUIRED
    if ALL_CHECKS and not gate:
        # No CI on this head: gh-drew merges it only on a passed beelink-gate receipt (tick sets the flag).
        return "merge", "no CI checks; merging on its beelink-gate receipt"
    # Only the gate blocks. A red check outside it held #11718 (4 lines, gate green) for 9 h on
    # 2026-10-19 on "Sandbox composer browser contract"; the gate is Fast Checks, Build and
    # Type Check (AGENTS.md), and develop's full fan fixes any other red forward.
    failed = sorted(n for n in gate if any(s in RED for s in checks.get(n, [])))
    if failed:
        return "wait", "red: " + ", ".join(failed[:3])
    missing = [n for n in gate if not checks.get(n) or any(s not in PASSED for s in checks[n])]
    if missing:
        return "wait", "waiting on " + ", ".join(missing)
    age = (now - dt.datetime.fromisoformat(commit["committedDate"].replace("Z", "+00:00"))).total_seconds()
    if age < MIN_HEAD_AGE_S:
        return "wait", f"head {int(age)}s old"
    advisory = sorted(n for n, states in checks.items() if n not in gate and any(s in RED for s in states))
    return "merge", "green" + (" (advisory red: " + ", ".join(advisory[:3]) + ")" if advisory else "")


def merge_base_with_attributes(a, pr):
    """Merge the base into a same-repo PR branch the way local git does, honoring .gitattributes.

    Returns (pushed merge sha or None, reason). Runs in a blob-less bare mirror, so no
    worktree or install; the push is a fast-forward of the judged head, so a branch that
    moved since is refused rather than overwritten.
    """
    mirror = os.path.join(a.state_dir, "mirror.git")
    git = lambda *args: subprocess.run(["git", "-C", mirror, *args], capture_output=True, text=True)
    if not os.path.isdir(mirror):
        c = subprocess.run(["git", "clone", "--quiet", "--bare", "--filter=blob:none", a.git_url, mirror],
                           capture_output=True, text=True)
        if c.returncode != 0:
            return None, "mirror clone failed: " + c.stderr.strip()[:120]
    branch, head = pr["headRefName"], pr["headRefOid"]
    f = git("fetch", "--quiet", "origin", f"+refs/heads/{a.base}:refs/heads/{a.base}", f"+refs/heads/{branch}:refs/pr-head")
    if f.returncode != 0:
        return None, "fetch failed: " + f.stderr.strip()[:120]
    if git("rev-parse", "refs/pr-head").stdout.strip() != head:
        return None, "head moved"
    base = git("rev-parse", f"refs/heads/{a.base}").stdout.strip()
    # The branch is "ours", as in `git merge <base>` run on it.
    m = git(f"--attr-source={base}", "merge-tree", "--write-tree", head, base)
    if m.returncode != 0:
        return None, "real conflict"
    tree = m.stdout.split("\n", 1)[0].strip()
    c = git("commit-tree", tree, "-p", head, "-p", base, "-m", f"Merge {a.base} into {branch}\n\n"
            "merge-on-green: GitHub's merge ignores .gitattributes merge drivers; git's merge is clean.")
    if c.returncode != 0:
        return None, "commit failed: " + c.stderr.strip()[:120]
    sha = c.stdout.strip()
    p = git("push", "--quiet", "origin", f"{sha}:refs/heads/{branch}")
    if p.returncode != 0:
        return None, "push refused: " + p.stderr.strip()[:120]
    return sha, f"merged {a.base} in (git attributes)"


def head_to_green_s(pr):
    """Seconds from CI receiving the head (its first check suite) to the last required check passing.

    Falls back to the commit time when GitHub reports no suite; a head committed long before it
    was pushed would otherwise count its idle hours as gate time.
    """
    commit = pr["commits"]["nodes"][0]["commit"]
    runs = [c for c in (commit.get("statusCheckRollup") or {}).get("contexts", {}).get("nodes", []) if c["__typename"] == "CheckRun"]
    gate = {c["name"] for c in runs} if ALL_CHECKS else set(REQUIRED)
    done = [c.get("completedAt") for c in runs if c["name"] in gate and c.get("completedAt")]
    # No gate (MERGE_ON_GREEN_REQUIRED empty: CI is not the merge gate, or a head with no checks) means no gate time.
    if not gate or len(done) < len(gate):
        return None
    parse = lambda t: dt.datetime.fromisoformat(t.replace("Z", "+00:00"))
    suites = [parse(x["createdAt"]) for x in ((commit.get("checkSuites") or {}).get("nodes") or []) if x.get("createdAt")]
    start = max(parse(commit["committedDate"]), min(suites)) if suites else parse(commit["committedDate"])
    return int((max(map(parse, done)) - start).total_seconds())


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default="tangle-network/agent-container")
    ap.add_argument("--base", default="develop", help="the branch PRs merge into (default develop)")
    ap.add_argument("--state-dir", default=os.path.expanduser("~/.local/state/merge-on-green"))
    ap.add_argument("--git-url", help="clone URL for the merge mirror (default: the repo over SSH)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("command", nargs="?", choices=["pause", "resume", "status", "hold"], help="omit to run one pass")
    ap.add_argument("--minutes", type=int, help=f"pause: how long, at most {PAUSE_MAX_MIN}")
    ap.add_argument("--reason", help="pause: why, shown in every skipped line")
    a = ap.parse_args()
    global BASE
    BASE = a.base
    if a.command == "hold":
        return hold_command()
    owner, name = a.repo.split("/", 1)
    a.git_url = a.git_url or f"git@github.com:{a.repo}.git"
    os.makedirs(a.state_dir, exist_ok=True)
    if a.command:
        return control(a)
    lock = open(os.path.join(a.state_dir, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    global CLIENT
    CLIENT = _github.GitHub(a.state_dir, a.repo)
    deferred = None
    success = False
    try:
        CLIENT.ready()
        result = tick(a, owner, name)
        success = result == 0
        return result
    except _github.RateLimited as e:
        deferred = str(e)
        print(f"merge-on-green: deferred #{CLIENT.pr or CLIENT.backoff.get('pr') or 'queue'}: {e}")
        Path(a.state_dir, 'status.md').write_text(f"# merge-on-green\n\nDeferred: {e}; retry next eligible tick.\n")
        return 0
    except (RuntimeError, ValueError, KeyError) as e:
        print(f"merge-on-green: read failed: {e}", file=sys.stderr)
        return 1
    finally:
        CLIENT.finish(a.dry_run, deferred, success)


def tick(a, owner, name):
    # This read is a GraphQL query every 2 minutes; on
    # drewstone it starved the merges and every lane's gh-drew, so tangletools' gh-read pays for it.
    r = gh("api", "graphql", "-f", f"query={QUERY}", "-f", f"owner={owner}", "-f", f"name={name}",
           "-f", f"base={a.base}", "-f", f"ref=refs/heads/{a.base}", via="gh-read")
    if r.returncode != 0:
        print(f"merge-on-green: read failed: {r.stderr.strip()[:200]}", file=sys.stderr)
        return 1
    answer = json.loads(r.stdout)
    if answer.get('errors'):
        raise RuntimeError(str(answer['errors']))
    repo = answer["data"]["repository"]
    prs = repo["pullRequests"]["nodes"]
    base_tip = ((repo.get("ref") or {}).get("target") or {}).get("oid", "")
    method = "--merge" if repo.get("mergeCommitAllowed", True) else "--squash" if repo.get("squashMergeAllowed") else "--rebase"
    now = dt.datetime.now(dt.timezone.utc)
    stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    pause = active_pause(a, now)
    noted_path = os.path.join(a.state_dir, "conflict-noted.json")
    noted = json.load(open(noted_path)) if os.path.exists(noted_path) else {}
    for k, v in list(noted.items()):  # notes written before 2026-10-15 hold a bare head: its owner was told
        if k.isdigit() and "@" not in v:
            noted.setdefault(f"told:{k}", v)
    status, records = [], CLIENT.decisions
    # Resume the deferred PR first when the backoff has elapsed.
    retry_pr = CLIENT.backoff.get('pr')
    prs.sort(key=lambda p: p['number'] != retry_pr)

    for pr in prs:
        n, head = pr["number"], pr["headRefOid"]
        CLIENT.pr = n
        if pause and not allowlisted(pr):
            outcome = f"paused until {pause['until']} ({pause['reason']}): skipped #{n}"
            records.append({"at": stamp, "pr": n, "head": head, "action": "paused", "outcome": outcome})
            status.append(f"- #{n} {pr['headRefName']}: {outcome}")
            continue
        answer = None
        if not (pr['isDraft'] or pr['headRefName'].startswith(RELEASE_PREFIXES) or hold_reason(pr)):
            answer = CLIENT.reviews(pr, REVIEW_FRAGMENT)
            pr['reviewThreads'] = answer['data']['repository']['pullRequest']['reviewThreads']
        action, reason = decide(pr, now)
        handled = f"{head}@{base_tip}"
        if action != "wait" and noted.get(str(n)) == handled:
            # This head's conflict was handled against this base; retry when either moves.
            action, reason = "wait", f"conflicts with {a.base}; owner told"
        receipt = action == "merge" and reason.startswith("no CI checks")
        asked = noted.get(f"receipt:{n}") or {}
        if receipt and asked.get("head") == head and now.timestamp() - asked.get("at", 0) < RECEIPT_RETRY_S:
            action, reason = "wait", "no CI checks and no passed beelink-gate receipt on this head yet: " + asked.get("why", "")[:120]
        outcome = reason
        if action == "merge" and not a.dry_run:
            m = gh("pr", "merge", str(n), "-R", a.repo, method, "--match-head-commit", head,
                   env={'MOG_REVIEW_SNAPSHOT': CLIENT.snapshot(pr, answer), **({'GH_DREW_REQUIRE_RECEIPT': '1'} if receipt else {})})
            outcome = "merged" if m.returncode == 0 else "merge refused: " + (m.stderr.strip() or m.stdout.strip())[:160]
            if receipt and m.returncode != 0:
                noted[f"receipt:{n}"] = {"head": head, "at": now.timestamp(), "why": outcome}
                _github.save(noted_path, noted)
            if re.search(r"(?i)conflict|cannot be cleanly created", outcome):
                # GitHub's mergeable flag lags a merge that just landed; the refusal is the fresh answer.
                action = "conflict"
        if action == "conflict" and not a.dry_run:
            sha, why = (None, "fork") if pr.get("isCrossRepository") else merge_base_with_attributes(a, pr)
            if sha:
                outcome = f"{why}: {sha[:10]}"
            else:
                if noted.get(f"told:{n}") != head:  # one comment per head, however often the base moves
                    gh("pr", "comment", str(n), "-R", a.repo, "--body",
                       f"This conflicts with {a.base}, so its gate cannot run. Merge {a.base} into the branch and it merges itself once green.")
                    noted[f"told:{n}"] = head
                outcome = f"{outcome}; owner told ({why})"
            noted[str(n)] = handled
            _github.save(noted_path, noted)
        rec = {"at": stamp, "pr": n, "head": head, "action": action, "outcome": outcome}
        if outcome == "merged":
            rec["head_to_green_s"] = head_to_green_s(pr)
        records.append(rec)
        # Retain already completed actions if a later PR is rate limited.
        if rec['action'] not in ('wait', 'paused') or rec['outcome'] == 'merged':
            with open(os.path.join(a.state_dir, 'decisions.jsonl'), 'a') as f:
                f.write(json.dumps(rec) + '\n')
        if outcome != "merged":
            status.append(f"- #{n} {pr['headRefName']}: {outcome}")

    Path(a.state_dir, 'decisions.jsonl').touch(exist_ok=True)
    json.dump(noted, open(noted_path, "w"))
    gates = []
    with open(os.path.join(a.state_dir, "decisions.jsonl")) as f:
        for line in f:
            g = json.loads(line).get("head_to_green_s")
            if isinstance(g, int):
                gates.append(g)
    gates = sorted(gates[-20:])
    gate_line = (f"Gate, head to green, last {len(gates)} merges: p50 {gates[len(gates) // 2] // 60} min, "
                 f"max {gates[-1] // 60} min.\n\n") if gates else ""
    with open(os.path.join(a.state_dir, "status.md"), "w") as f:
        f.write(f"# merge-on-green {stamp}\n\n" + (pause_line(pause) + "\n\n" if pause else "") + gate_line
                + ("\n".join(status) or "Nothing waiting.") + "\n")
    for rec in records:
        if rec["action"] == "paused":
            print(f"{stamp} {rec['outcome']}")
        elif rec["action"] != "wait":
            print(f"{stamp} #{rec['pr']} {rec['outcome']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
