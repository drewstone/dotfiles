#!/usr/bin/env bash
# hostlab: a throwaway Ubuntu 24.04 VM for root-level experiments.
# Storage, mount, namespace and freeze experiments run only inside the VM.
# The VM has root over ssh, lvm2, dm-thin, xfs, btrfs, a 16G blank scratch disk
# at /dev/vdb, the calling directory shared at /work, and the same softdog
# watchdog policy as the host. Each run boots a fresh copy-on-write overlay of
# one prepared base image and deletes it on exit.
#
#   hostlab build                 prepare the base image once (~5 min, network)
#   hostlab run [opts] -- CMD...  boot, run CMD in /work as root, tear down
#   hostlab shell [opts]          boot and open an interactive root shell
#   hostlab ssh ID [-- CMD...]    reach a kept VM
#   hostlab status                list kept VMs with owner and expiry
#   hostlab extend ID DURATION    move a kept VM's expiry to DURATION from now
#   hostlab reap                  stop expired or orphaned VMs, archive their run dirs
#   hostlab clean                 stop and delete every kept VM
#   hostlab clean --cache         retire idle base/download/key files; keep receipts
# Options for run/shell: --keep (leave the VM running, print its ID),
#   --ttl 2h (a kept VM's lifetime; 90s, 45m, 2h, 1d), --owner NAME,
#   --mem 4G, --cpus 4, --scratch 16G, --work DIR (default: cwd),
#   --read-only-input NAME=FILE (repeatable raw disk at
#     /dev/disk/by-id/virtio-hostlab-NAME; NAME is 1-12 lowercase letters,
#     digits or hyphens; caller-owned, never copied or removed by retirement)
# Env: HOSTLAB_HOME (default ~/.cache/hostlab),
#   HOSTLAB_ARCHIVE (default /mnt/traces/archive/hostlab), HOSTLAB_OWNER,
#   HOSTLAB_SMALL_ARCHIVE (a directory or host:directory; see archive_run)
# The reaper archives expired/orphaned runs; cache retirement refuses every run.
set -euo pipefail

HOSTLAB_SOURCE="$(readlink -f -- "$0")"
BOOT_DIAGNOSTICS="$(dirname "$HOSTLAB_SOURCE")/hostlab_boot_diagnostics.py"
DIAGNOSTIC_SECONDS=5
CACHE="${HOSTLAB_HOME:-$HOME/.cache/hostlab}"
CLOUD_IMG="$CACHE/noble-server-cloudimg-amd64.img"
CLOUD_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
BASE_IMG="$CACHE/base.qcow2"
KEY="$CACHE/id_ed25519"
RUNS="$CACHE/runs"
MEM="${HOSTLAB_MEM:-4G}"
CPUS="${HOSTLAB_CPUS:-4}"
SCRATCH="${HOSTLAB_SCRATCH:-16G}"
DISK="${HOSTLAB_DISK:-20G}"
ARCHIVE="${HOSTLAB_ARCHIVE:-/mnt/traces/archive/hostlab}"
# The archive lives on the external drive. When that drive is missing, the
# path is a plain directory on the root disk, and archiving there would move
# VM disks onto root.
ARCHIVE_MOUNT="${HOSTLAB_ARCHIVE_MOUNT:-/mnt/traces}"
MIN_FREE_GB=100
ARCHIVE_KEEP_DAYS=14
TTL=2h
OWNER="${HOSTLAB_OWNER:-}"
KEEP=0
WORK="$PWD"
INPUT_NAMES=()
INPUT_FILES=()

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

die() { printf 'hostlab: %s\n' "$*" >&2; exit 1; }

to_seconds() {
  # to_seconds 90s|45m|2h|1d|120 -> seconds
  [[ "$1" =~ ^([0-9]+)([smhd]?)$ ]] || die "bad duration $1 (use 90s, 45m, 2h or 1d)"
  local n="${BASH_REMATCH[1]}"
  case "${BASH_REMATCH[2]}" in
    s|'') echo "$n" ;; m) echo $((n * 60)) ;; h) echo $((n * 3600)) ;; d) echo $((n * 86400)) ;;
  esac
}

# The kernel start time of PID, or nothing when it has exited. Paired with the
# PID it identifies the caller even after the PID is reused.
proc_start() {
  [ -r "/proc/$1/stat" ] || return 0
  sed -E 's/^.*\) //' "/proc/$1/stat" 2>/dev/null | awk '{ print $20 }'
}

caller_alive() {
  local pid start
  read -r pid start < "$1/caller" 2>/dev/null || return 1
  [ -n "$start" ] && [ "$(proc_start "$pid")" = "$start" ]
}

check_free() {
  mkdir -p "$RUNS"
  local avail need=$(( MIN_FREE_GB + $(numfmt --from=iec "$SCRATCH") / 1073741824 ))  # the scratch grows to its full size inside the VM
  avail="$(df -P -BG "$RUNS" | awk 'NR == 2 { sub(/G$/, "", $4); print $4 }')"
  [ "${avail:-0}" -ge "$need" ] ||
    die "only ${avail:-0}G free on the disk holding $RUNS; a VM with --scratch $SCRATCH needs ${need}G (hostlab status; hostlab reap)"
}

reap_log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$CACHE/reap.log"; }

need() {
  local b kvm_gid account_groups active_groups
  for b in qemu-system-x86_64 qemu-img cloud-localds ssh ssh-keygen python3 timeout; do command -v "$b" >/dev/null 2>&1 || die "missing $b (sudo apt-get install -y qemu-system-x86 qemu-utils cloud-image-utils openssh-client)"; done
  if [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
    kvm_gid=$(getent group kvm 2>/dev/null | cut -d: -f3) || kvm_gid=""
    if [[ "$kvm_gid" =~ ^[0-9]+$ ]] && [ "$(stat -c %g /dev/kvm 2>/dev/null)" = "$kvm_gid" ]; then
      account_groups=$(id -G "$(id -un)" 2>/dev/null || true) active_groups=$(id -G)
      if [[ " $account_groups " == *" $kvm_gid "* && " $active_groups " != *" $kvm_gid "* ]]; then
        die "/dev/kvm is inaccessible: the account belongs to kvm, but this process does not. A lingering systemd user manager can keep old groups; run this hostlab call through sg kvm -c 'hostlab ...'"
      fi
    fi
    die "/dev/kvm is not accessible (add yourself to the kvm group)"
  fi
  mkdir -p "$CACHE" "$RUNS"
  [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C hostlab -f "$KEY"
}

cache_lock() {
  mkdir -p "$CACHE"
  [ ! -L "$CACHE/cache.lock" ] && { [ ! -e "$CACHE/cache.lock" ] || { [ -f "$CACHE/cache.lock" ] && [ -O "$CACHE/cache.lock" ] && [ "$(stat -c %h "$CACHE/cache.lock")" = 1 ]; }; } || die "unsafe cache.lock"
  exec 8>"$CACHE/cache.lock"
  flock -n "$1" 8 || die "cache is in use: $CACHE"
}

# -F /dev/null: the user's ssh config (a ProxyCommand or LocalCommand for
# Host *) must not run on the host when a command goes to the VM.
ssh_opts() {
  printf '%s\n' -F /dev/null -i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=3 -o IdentitiesOnly=yes -o BatchMode=yes \
    -o ConnectionAttempts=1 -o ServerAliveInterval=5 -o ServerAliveCountMax=2
}

free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()'
}

# The watchdog policy inside the VM mirrors dotfiles/host: a root-write probe
# that blocks on a frozen root, and a softdog that resets the VM when the
# daemon stops the keepalive.
watchdog_files() {
  cat <<'YAML'
write_files:
  - path: /etc/watchdog.d/root-write
    permissions: "0755"
    content: |
      #!/bin/sh
      case "${1:-}" in
        test)
          d=/var/lib/watchdog-probe
          mkdir -p "$d" || exit 1
          printf '%s\n' "$(date +%s)" > "$d/root-write" || exit 1
          sync -f "$d/root-write" || exit 1
          exit 0 ;;
        repair) exit 1 ;;
        *) exit 0 ;;
      esac
  - path: /etc/watchdog.conf
    content: |
      watchdog-device = /dev/watchdog0
      watchdog-timeout = 60
      interval = 10
      realtime = yes
      priority = 1
      test-directory = /etc/watchdog.d
      test-timeout = 60
      repair-timeout = 10
      retry-timeout = 60
  - path: /etc/modules-load.d/softdog.conf
    content: "softdog\n"
  - path: /etc/modprobe.d/softdog.conf
    content: "options softdog soft_margin=60\n"
  - path: /etc/default/watchdog
    content: |
      run_watchdog=1
      run_wd_keepalive=1
      watchdog_module="softdog"
      watchdog_options=""
YAML
}

qmp_socket_path() {
  # qmp_socket_path DIR -> prints a socket path in a new 0700 dir, or fails.
  local base="${XDG_RUNTIME_DIR:-}" hash qdir
  [ -n "$base" ] && [ -d "$base" ] && [ -w "$base" ] || base=/tmp
  hash="$(printf '%s' "$1" | sha256sum | cut -c1-12)"
  qdir="$(mktemp -d "$base/hostlab-qmp-$hash.XXXXXX" 2>/dev/null)" ||
    { [ "$base" != /tmp ] && qdir="$(mktemp -d "/tmp/hostlab-qmp-$hash.XXXXXX" 2>/dev/null)"; } || return 1
  chmod 700 "$qdir" || { rmdir "$qdir"; return 1; }
  if (( ${#qdir} + 10 >= 108 )); then rmdir "$qdir"; return 1; fi
  printf '%s\n' "$qdir/qmp.sock"
}

qmp_socket_remove() {
  # Removes only the private dir qmp_socket_path made for this run.
  local sock qdir
  sock="$(cat "$1/qmp.path" 2>/dev/null)" || return 0
  case "$sock" in /*/hostlab-qmp-*/qmp.sock) ;; *) return 0 ;; esac
  qdir="${sock%/qmp.sock}"
  [ -d "$qdir" ] && [ ! -L "$qdir" ] && [ -O "$qdir" ] || return 0
  rm -f "$sock"; rmdir "$qdir" 2>/dev/null || true
}

qemu_start() {
  # qemu_start DIR PORT WORKDIR
  local dir="$1" port="$2" workdir="$3" i input_id LC_ALL=C
  sha256sum "$HOSTLAB_SOURCE" "$BOOT_DIAGNOSTICS" \
    "$(dirname "$HOSTLAB_SOURCE")/beelink_gate_cpu.py" | awk '{print $1}' > "$dir/source-sha256"
  local -a input=() qmp=(); local sock
  # QMP lives in a short private dir, because a Unix socket path must stay under
  # 108 bytes and real run dirs exceed that (113 bytes for tangle-devops #585).
  # Diagnostics never block a boot: without a socket, QEMU starts without QMP.
  if sock="$(qmp_socket_path "$dir")"; then qmp=(-qmp "unix:${sock//,/,,},server=on,wait=off"); else sock=unavailable; fi
  (umask 077; printf '%s\n' "$sock" > "$dir/qmp.path"); chmod 600 "$dir/qmp.path"
  for i in "${!INPUT_NAMES[@]}"; do
    input_id="hostlab-${INPUT_NAMES[$i]}"
    # QEMU's option parser escapes a literal comma as a doubled comma.
    input+=(-drive "if=none,id=$input_id,format=raw,file=${INPUT_FILES[$i]//,/,,},readonly=on"
      -device "virtio-blk-pci,drive=$input_id,serial=$input_id")
  done
  # The host's /nix/store at the guest's /nix/store, read-only in QEMU itself (a guest write fails EROFS): packets copied
  # a 21.8 GB closure into every VM, ~134 GB for the pre-cut journey (operator 10-27). The base image has no /nix.
  [ ! -d /nix/store ] || input+=(-virtfs "local,path=/nix/store,mount_tag=nixstore,security_model=none,readonly=on,id=nixstore")
  # Explicit devices preserve root/scratch/seed/input order. Mixing implicit
  # if=virtio drives with explicit inputs lets QEMU realize the inputs first.
  # Prefer the OS disk in firmware instead of an unindexed raw input disk.
  (umask 077; qemu-system-x86_64 \
    -enable-kvm -cpu host -m "$MEM" -smp "$CPUS" \
    -display none -serial "file:$dir/console.log" -monitor none \
    "${qmp[@]}" \
    -drive "if=none,id=hostlab-internal-root,format=qcow2,file=${dir//,/,,}/disk.qcow2" \
    -device virtio-blk-pci,drive=hostlab-internal-root,bootindex=1 \
    -drive "if=none,id=hostlab-internal-scratch,format=qcow2,file=${dir//,/,,}/scratch.qcow2" \
    -device virtio-blk-pci,drive=hostlab-internal-scratch \
    -drive "if=none,id=hostlab-internal-seed,format=raw,file=${dir//,/,,}/seed.img,readonly=on" \
    -device virtio-blk-pci,drive=hostlab-internal-seed \
    "${input[@]}" \
    -netdev user,id=n0,hostfwd=tcp:127.0.0.1:"$port"-:22 -device virtio-net-pci,netdev=n0 \
    -virtfs local,path="$workdir",mount_tag=work,security_model=none,id=work \
    -pidfile "$dir/qemu.pid" -daemonize)
  [ "$sock" = unavailable ] || chmod 600 "$sock" 2>/dev/null || true
  local pid start
  pid="$(cat "$dir/qemu.pid")"; start="$(proc_start "$pid")"
  printf '%s %s\n' "$pid" "$start" > "$dir/qemu.identity"
}

wait_ssh() {
  # Count SSH time as well as sleeps; a connected but stalled peer is bounded too.
  local port="$1" budget="$2" error_file="$3" command="$4"
  local deadline=$((SECONDS + budget)) remaining attempt rc attempt_number=0
  local attempt_file="${error_file}.attempt"
  : > "$error_file"
  while (( SECONDS < deadline )); do
    remaining=$((deadline - SECONDS)); attempt="$remaining"
    (( attempt <= 5 )) || attempt=5
    if timeout --signal=KILL "${attempt}s" \
      ssh -n -v $(ssh_opts) -p "$port" root@127.0.0.1 "$command" 2>&1 | tail -c 2048 > "$attempt_file"; then
      rc=0
    else
      rc=${PIPESTATUS[0]}
      (( rc != 0 )) || rc=1
    fi
    attempt_number=$((attempt_number + 1))
    printf '\nhostlab: SSH attempt=%s elapsed=%ss exit=%s (deadline %ss)\n' \
      "$attempt_number" "$((SECONDS - deadline + budget))" "$rc" "$attempt" >> "$error_file"
    cat "$attempt_file" >> "$error_file"
    if (( rc == 0 )); then
      rm -f "$attempt_file"
      printf '\n'
      return 0
    fi
    printf '.'
    remaining=$((deadline - SECONDS))
    (( remaining > 0 )) || break
    (( remaining <= 2 )) || remaining=2
    sleep "$remaining"
  done
  rm -f "$attempt_file"
  printf '\n'
  return 1
}

vm_boot_diagnostics() {
  local dir="$1" stage="$2" dest="$CACHE/diagnostics/$(basename "$1")"
  (umask 077; mkdir -p "$dest"; chmod 700 "$dest")
  timeout --foreground --signal=KILL "$((DIAGNOSTIC_SECONDS + 1))s" \
    python3 "$BOOT_DIAGNOSTICS" "$dir" "$dest" "$stage" "$HOSTLAB_SOURCE" "$DIAGNOSTIC_SECONDS" ||
    echo 'hostlab: boot-state observation incomplete; existing readiness result retained' >&2
  echo "hostlab: boot diagnostics retained at $dest" >&2
  cat "$dest/ssh-display.txt" "$dest/console-display.txt" >&2
}

vm_stop() {
  local dir="$1" pid
  [ ! -f "$dir/port" ] || timeout 8 ssh $(ssh_opts) -p "$(cat "$dir/port")" root@127.0.0.1 'poweroff' >/dev/null 2>&1 || true
  if [ -f "$dir/qemu.pid" ]; then
    pid="$(cat "$dir/qemu.pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      local t=0
      while kill -0 "$pid" 2>/dev/null && [ "$t" -lt 10 ]; do sleep 1; t=$((t + 1)); done
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  qmp_socket_remove "$dir"
}

cmd_build() {
  cache_lock -x
  need
  if [ ! -f "$CLOUD_IMG" ]; then
    echo "hostlab: downloading $CLOUD_URL"
    curl -fL --progress-bar -o "$CLOUD_IMG.part" "$CLOUD_URL"
    mv "$CLOUD_IMG.part" "$CLOUD_IMG"
  fi
  local dir="$CACHE/build"
  qmp_socket_remove "$dir"; rm -rf "$dir"; mkdir -m 700 "$dir"
  qemu-img create -q -f qcow2 -F qcow2 -b "$CLOUD_IMG" "$dir/disk.qcow2"
  qemu-img resize -q "$dir/disk.qcow2" "$DISK"
  qemu-img create -q -f qcow2 "$dir/scratch.qcow2" 1G
  {
    echo "#cloud-config"
    echo "hostname: hostlab-base"
    echo "disable_root: false"
    echo "ssh_pwauth: false"
    echo "users:"
    echo "  - name: root"
    echo "    ssh_authorized_keys:"
    echo "      - $(cat "$KEY.pub")"
    echo "package_update: true"
    echo "packages: [lvm2, thin-provisioning-tools, xfsprogs, e2fsprogs, btrfs-progs, watchdog, kmod, util-linux]"
    watchdog_files
    echo "runcmd:"
    echo "  - apt-get install -y linux-modules-extra-\$(uname -r)"
    echo "  - systemctl enable watchdog"
    echo "  - mkdir -p /work"
    echo "  - touch /etc/hostlab-base-ready"
    echo "power_state: {mode: poweroff, timeout: 30, condition: true}"
  } > "$dir/user-data"
  printf 'instance-id: hostlab-base\nlocal-hostname: hostlab-base\n' > "$dir/meta-data"
  cloud-localds "$dir/seed.img" "$dir/user-data" "$dir/meta-data"
  local port; port="$(free_port)"; echo "$port" > "$dir/port"
  echo "hostlab: provisioning the base image (cloud-init, apt); console in $dir/console.log"
  qemu_start "$dir" "$port" "$dir"
  local pid t=0; pid="$(cat "$dir/qemu.pid")"
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$t" -ge 900 ]; then vm_stop "$dir"; die "base build did not finish in 15 min; see $dir/console.log"; fi
    [ $((t % 20)) -eq 0 ] && printf 'hostlab: %3ds  %s\n' "$t" "$(grep -aoE 'cloud-init\[[0-9]+\]: .*' "$dir/console.log" 2>/dev/null | tail -1 | cut -c1-100)"
    sleep 5; t=$((t + 5))
  done
  grep -aq 'hostlab-base-ready\|finished at' "$dir/console.log" || grep -a 'cloud-init' "$dir/console.log" | tail -5 >&2
  mv "$dir/disk.qcow2" "$BASE_IMG"
  date -u +%FT%TZ > "$BASE_IMG.built"
  qmp_socket_remove "$dir"; rm -rf "$dir"
  echo "hostlab: base image ready at $BASE_IMG"
}

# Under a GTR gate a VM whose disks fit the gate's lease is tagged with it, so gtr_used_bytes counts it (10-27).
gate_lease_fits() {
  [ -n "${BEELINK_GATE_LEASE_DIR:-}" ] && [ -f "$BASE_IMG" ] || return 0  # no base image: vm_boot refuses below
  local want; want=$(( $(qemu-img info --output=json "$BASE_IMG" | python3 -c 'import json,sys; print(json.load(sys.stdin)["virtual-size"])') + $(numfmt --from=iec "$SCRATCH") ))
  (( want <= ${BEELINK_GATE_LEASE_BYTES:-0} )) || GATE_VM_BYTES=$want
}
# Disks over the gate's lease take op-company:beelink-gate-gtr-hostlab (tangle-tools hosts/drew-GTR-Pro.json: at most 65 GB,
# only while free stays over the 295 GB floor; operator 10-27). A unit holds it while qemu runs; a refusal stops the boot.
gate_vm_lease() {  # <run dir> <id>
  systemd-run --user --unit="hostlab-lease-$2" --collect --quiet ${STORAGE_LIFECYCLE_CONFIG:+-E STORAGE_LIFECYCLE_CONFIG} "$(command -v storage-lifecycle || echo "$HOME/.local/bin/storage-lifecycle")" run-lane --lane op-company:beelink-gate-gtr-hostlab --path "$1" --bytes "$GATE_VM_BYTES" -- \
    bash -c 'touch "$0/leased"; for _ in $(seq 120); do [ -s "$0/qemu.pid" ] && break; sleep 5; done; while kill -0 "$(cat "$0/qemu.pid" 2>/dev/null)" 2>/dev/null; do sleep 30; done' "$1"
  while [ ! -e "$1/leased" ] && [ "$(systemctl --user show -p ActiveState --value "hostlab-lease-$2")" != inactive ]; do sleep 1; done
  [ -e "$1/leased" ] || { rm -rf "$1"; die "no VM reservation for $GATE_VM_BYTES bytes in op-company:beelink-gate-gtr-hostlab: $(journalctl --user -u "hostlab-lease-$2" -o cat | grep -m1 -o '"reason": "[^"]*"' || echo 'see its journal')"; }
}

vm_boot() {
  # vm_boot -> prints RUN DIR; boots an overlay of the base with WORK at /work
  gate_lease_fits
  check_free
  need
  [ -f "$BASE_IMG" ] || die "no base image; run: hostlab build"
  [ -d "$WORK" ] || die "work dir $WORK does not exist"
  local id dir port i
  id="$(date +%Y%m%d-%H%M%S)-$RANDOM"
  dir="$RUNS/$id"; mkdir -m 700 "$dir"; [ -z "${GATE_VM_BYTES:-}" ] || gate_vm_lease "$dir" "$id"
  # Recorded before qemu starts, so the reaper never sees an unowned run.
  # Command substitution keeps $$ as the hostlab process: the caller.
  printf '%s\n' "$OWNER" > "$dir/owner"; echo "$KEEP" > "$dir/keep"; [ -z "${BEELINK_GATE_LEASE_DIR:-}" ] || [ -n "${GATE_VM_BYTES:-}" ] || echo "$BEELINK_GATE_LEASE_DIR" > "$dir/gate"
  echo "$$ $(proc_start $$)" > "$dir/caller"
  for i in "${!INPUT_NAMES[@]}"; do printf '%s\t%s\n' "${INPUT_NAMES[$i]}" "${INPUT_FILES[$i]}" >> "$dir/read-only-inputs"; done
  if [ "$KEEP" = 1 ]; then echo $(( $(date +%s) + $(to_seconds "$TTL") )) > "$dir/expires"; else echo none > "$dir/expires"; fi
  qemu-img create -q -f qcow2 -F qcow2 -b "$BASE_IMG" "$dir/disk.qcow2"
  qemu-img create -q -f qcow2 "$dir/scratch.qcow2" "$SCRATCH"
  {
    echo "#cloud-config"
    echo "hostname: hostlab-${id##*-}"
    echo "mounts:"
    echo "  - [work, /work, 9p, 'trans=virtio,version=9p2000.L,msize=512000,_netdev', '0', '0']"
    echo "  - [nixstore, /nix/store, 9p, 'trans=virtio,version=9p2000.L,msize=512000,ro,nofail,_netdev', '0', '0']"
    echo "mount_default_fields: [None, None, 'auto', 'defaults,nofail', '0', '2']"
    echo "runcmd:"
    echo "  - mountpoint -q /work || mount -t 9p -o trans=virtio,version=9p2000.L,msize=512000 work /work"
    echo "  - mkdir -p /nix/store && { mountpoint -q /nix/store || mount -t 9p -o trans=virtio,version=9p2000.L,msize=512000,ro nixstore /nix/store || true; }"
  } > "$dir/user-data"
  printf 'instance-id: hostlab-%s\nlocal-hostname: hostlab-%s\n' "$id" "${id##*-}" > "$dir/meta-data"
  cloud-localds "$dir/seed.img" "$dir/user-data" "$dir/meta-data" 2>/dev/null
  port="$(free_port)"; echo "$port" > "$dir/port"; echo "$WORK" > "$dir/work"
  qemu_start "$dir" "$port" "$WORK"
  printf 'hostlab: booting %s (ssh port %s, /work = %s) ' "$id" "$port" "$WORK" >&2
  if ! wait_ssh "$port" 120 "$dir/readiness-ssh.stderr" true >&2; then
    vm_boot_diagnostics "$dir" readiness || true
    vm_stop "$dir" || true
    rm -rf "$dir"; die "VM SSH did not become ready in 120 s"
  fi
  # /work is mounted by cloud-init; its readiness shares the bounded SSH path.
  if ! wait_ssh "$port" 30 "$dir/mount-ssh.stderr" 'mountpoint -q /work' >&2; then
    vm_boot_diagnostics "$dir" mount || true
    vm_stop "$dir" || true
    rm -rf "$dir"; die "/work did not mount in 30 s"
  fi
  # Preserve positive QMP/identity evidence too; observation never gates readiness.
  vm_boot_diagnostics "$dir" ready >/dev/null 2>&1 || true
  echo "$dir"
}

parse_opts() {
  local input_name input_file prior i
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) KEEP=1; shift ;;
      --ttl) TTL="$2"; shift 2 ;;
      --owner) OWNER="$2"; shift 2 ;;
      --mem) MEM="$2"; shift 2 ;;
      --cpus) CPUS="$2"; shift 2 ;;
      --scratch) SCRATCH="$2"; shift 2 ;;
      --work) WORK="$(cd "$2" && pwd)"; shift 2 ;;
      --read-only-input)
        [ $# -ge 2 ] && [[ "$2" = *=* ]] || die "--read-only-input needs NAME=FILE"
        input_name="${2%%=*}"; input_file="${2#*=}"
        [[ "$input_name" =~ ^[a-z][a-z0-9-]{0,11}$ ]] && [ -n "$input_file" ] || die "invalid read-only input name or file"
        for prior in "${INPUT_NAMES[@]}"; do [ "$prior" != "$input_name" ] || die "duplicate read-only input name: $input_name"; done
        INPUT_NAMES+=("$input_name"); INPUT_FILES+=("$input_file"); shift 2 ;;
      --) shift; break ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option $1" ;;
      *) break ;;
    esac
  done
  REST=("$@")
  to_seconds "$TTL" >/dev/null
  for i in "${!INPUT_NAMES[@]}"; do
    INPUT_FILES[i]=$(python3 - "${INPUT_FILES[$i]}" "$RUNS" "$CACHE/build" "$ARCHIVE" "${HOSTLAB_SMALL_ARCHIVE:-}" <<'PY'
import os,pathlib,stat,sys
source=pathlib.Path(sys.argv[1])
if not stat.S_ISREG(source.lstat().st_mode):
    raise SystemExit('hostlab: read-only input must be a regular file, not a symlink or device')
source=source.resolve(strict=True)
managed=sys.argv[2:5]
if sys.argv[5] and ':' not in sys.argv[5]: managed.append(sys.argv[5])
if any(source.is_relative_to(pathlib.Path(p).resolve()) for p in managed):
    raise SystemExit('hostlab: read-only input must be outside managed VM and archive directories')
size=source.stat().st_size
if not os.access(source,os.R_OK) or size<=0 or size%512 or any(ord(c)<32 for c in str(source)):
    raise SystemExit('hostlab: read-only input must be readable, nonempty and sector-aligned')
print(source)
PY
    ) || die "invalid read-only input"
  done
  [ -n "$OWNER" ] || OWNER="$(id -un) pid $PPID: $(ps -o args= -p "$PPID" 2>/dev/null | cut -c1-100)"
}

# A run that is not kept stops its VM when interrupted. A SIGKILL skips this;
# the reaper then finds the caller gone.
stop_on_signal() {
  [ "$KEEP" = 1 ] && return 0
  trap 'vm_stop "$dir"; rm -rf "$dir"; exit 130' INT TERM HUP
}

cmd_run() {
  local mode=$1; shift
  parse_opts "$@"
  [ "$mode" = shell ] || [ "${#REST[@]}" -gt 0 ] || die "run needs a command after --"
  cache_lock -s
  local dir port rc=0
  dir="$(vm_boot)"; port="$(cat "$dir/port")"
  stop_on_signal
  if [ "$mode" = shell ]; then ssh -t $(ssh_opts) -p "$port" root@127.0.0.1 'cd /work && exec bash -l' || rc=$?
  else ssh $(ssh_opts) -p "$port" root@127.0.0.1 "cd /work && ${REST[*]}" || rc=$?; fi
  if [ "$KEEP" = 1 ]; then
    echo "hostlab: kept $(basename "$dir") until $(date -d "@$(cat "$dir/expires")" +%FT%T%z) (hostlab ssh $(basename "$dir") -- CMD; hostlab extend $(basename "$dir") 2h)" >&2
  else
    vm_stop "$dir"; rm -rf "$dir"
  fi
  exit "$rc"
}

cmd_ssh() {
  local id="${1:-}"; [ -n "$id" ] || die "ssh needs a VM ID (hostlab status)"
  shift; [ "${1:-}" = "--" ] && shift
  local dir="$RUNS/$id"; [ -f "$dir/port" ] || die "no VM $id"
  [ $# -eq 0 ] || exec ssh $(ssh_opts) -p "$(cat "$dir/port")" root@127.0.0.1 "cd /work && $*"
  exec ssh -t $(ssh_opts) -p "$(cat "$dir/port")" root@127.0.0.1 'cd /work && exec bash -l'
}

cmd_status() {
  local d pid state exp left now
  now="$(date +%s)"
  for d in "$RUNS"/*/; do
    [ -d "$d" ] || continue
    pid="$(cat "$d/qemu.pid" 2>/dev/null || echo -)"
    state=dead; [ "$pid" != - ] && kill -0 "$pid" 2>/dev/null && state=running
    exp="$(cat "$d/expires" 2>/dev/null || echo unset)"
    case "$exp" in ''|*[!0-9]*) left="$exp" ;; *) left="$(( (exp - now) / 60 ))m" ;; esac
    printf '%s  %s  expires_in=%s  owner=%s  port=%s  work=%s\n' "$(basename "$d")" "$state" "$left" \
      "$(cat "$d/owner" 2>/dev/null || echo unrecorded)" "$(cat "$d/port" 2>/dev/null)" "$(cat "$d/work" 2>/dev/null)"
  done
  [ -f "$BASE_IMG" ] && echo "base: $BASE_IMG (built $(cat "$BASE_IMG.built" 2>/dev/null))" || echo "base: not built (hostlab build)"
}

cmd_clean() {
  cache_lock -s
  need
  local d
  for d in "$RUNS"/*/; do
    [ -d "$d" ] || continue
    vm_stop "$d"; rm -rf "$d"
    echo "hostlab: removed $(basename "$d")"
  done
}

cmd_clean_cache() {
  [ -d "$CACHE" ] && [ ! -L "$CACHE" ] && [ -O "$CACHE" ] && [ "$CACHE" = "$(realpath -m -- "$CACHE")" ] && (( (8#$(stat -c %a "$CACHE") & 022) == 0 )) || die "cache must be an owned, non-writable-by-others canonical directory"
  cache_lock -x
  local p rc entries bytes=0; local -a payload=()
  for p in "$CACHE"/* "$CACHE"/.[!.]* "$CACHE"/..?*; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    case "${p##*/}" in
      base.qcow2|base.qcow2.built|noble-server-cloudimg-amd64.img|noble-server-cloudimg-amd64.img.part|id_ed25519|id_ed25519.pub)
        [ ! -L "$p" ] && [ -f "$p" ] && [ -O "$p" ] && [ "$(stat -c %h "$p")" = 1 ] || die "unsafe cache payload: $p"
        payload+=("$p"); bytes=$((bytes + $(stat -c %b "$p") * 512)) ;;
      runs)
        [ ! -L "$p" ] && [ -d "$p" ] && entries=$(find "$p" -mindepth 1 -maxdepth 1 -print -quit) && [ -z "$entries" ] || die "cache has runs or cannot be inspected; retire them first" ;;
      diagnostics|reap.log|reap.lock|cache.lock) [ ! -L "$p" ] && [ -O "$p" ] || die "unsafe cache receipt: $p" ;;
      *) die "unrecognized cache entry; retained: $p" ;;
    esac
  done
  if [ "${#payload[@]}" -gt 0 ]; then
    command -v fuser >/dev/null || die "cache retirement needs fuser"
    rc=0; fuser -s "${payload[@]}" || rc=$?
    [ "$rc" = 1 ] || die "cache payload is open or its use could not be checked"
    rm -- "${payload[@]}"
  fi
  printf 'hostlab: retired cache payload files=%s allocated_bytes=%s; receipts retained\n' "${#payload[@]}" "$bytes"
}
cmd_extend() {
  local id="${1:-}" dur="${2:-}"
  [ -n "$id" ] && [ -n "$dur" ] || die "usage: hostlab extend ID DURATION"
  local dir="$RUNS/$id"
  [ -d "$dir" ] || die "no VM $id"
  to_seconds "$dur" >/dev/null
  echo $(( $(date +%s) + $(to_seconds "$dur") )) > "$dir/expires"
  echo 1 > "$dir/keep"
  echo "hostlab: $id expires at $(date -d "@$(cat "$dir/expires")" +%FT%T%z)"
}

# Archive logs/artifacts, never VM disks; remove the run only after verification.
archive_small() {
  local d="$1" reason="$2" dest="$3" id host_part dir_part want got list
  id="$(basename "$d")"
  list="$(cd "$RUNS" && find "$id" -type f ! -name '*.qcow2' ! -name '*.img' -size -100M | sort)"
  want=$(printf '%s\n' "$list" | grep -c . || true)
  case "$dest" in
    *:*)
      host_part="${dest%%:*}"; dir_part="${dest#*:}"
      printf '%s\n' "$list" | tar -C "$RUNS" -czf - -T - \
        | ssh -o BatchMode=yes -o ConnectTimeout=15 "$host_part" "mkdir -p '$dir_part' && tar -C '$dir_part' -xzf -" || return 1
      got=$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$host_part" "find '$dir_part/$id' -type f | wc -l") || return 1 ;;
    *)
      mkdir -p "$dest" || return 1
      printf '%s\n' "$list" | tar -C "$RUNS" -czf - -T - | tar -C "$dest" -xzf - || return 1
      got=$(find "$dest/$id" -type f | wc -l) ;;
  esac
  [ "${got:-0}" -eq "$want" ] || { reap_log "$id $reason: small-file archive at $dest holds $got of $want files; kept in place"; return 1; }
  rm -rf "$d"
  reap_log "$id $reason: stopped, $want small files archived to $dest/$id, VM disks deleted (owner: $(cat "$dest/$id/owner" 2>/dev/null || echo see-archive))"
}

archive_run() {
  local d="$1" reason="$2" id
  id="$(basename "$d")"
  echo "$reason at $(date -u +%FT%TZ)" > "$d/reaped"
  case "$ARCHIVE/" in
    "$ARCHIVE_MOUNT"/*)
      if ! mountpoint -q "$ARCHIVE_MOUNT"; then
        # A host without the drive archives to HOSTLAB_SMALL_ARCHIVE, by host and date.
        if [ -n "${HOSTLAB_SMALL_ARCHIVE:-}" ] &&
          archive_small "$d" "$reason" "${HOSTLAB_SMALL_ARCHIVE%/}/$(hostname -s)-$(date -u +%Y%m%d)"; then return 0; fi
        reap_log "$id $reason: stopped and kept in place, because $ARCHIVE_MOUNT is not mounted (owner: $(cat "$d/owner" 2>/dev/null))"
        return 0
      fi ;;
  esac
  if mkdir -p "$ARCHIVE" 2>/dev/null && [ -w "$ARCHIVE" ]; then
    archive_small "$d" "$reason" "$ARCHIVE" ||
      reap_log "$id $reason: stopped and kept in place, because its archive to $ARCHIVE failed (owner: $(cat "$d/owner" 2>/dev/null))"
  else
    reap_log "$id $reason: stopped and deleted, because $ARCHIVE is not writable (owner: $(cat "$d/owner" 2>/dev/null))"
    rm -rf "$d"
  fi
}

cmd_reap() {
  cache_lock -s
  mkdir -p "$CACHE" "$RUNS"
  exec 9> "$CACHE/reap.lock"
  flock -n 9 || { echo "hostlab reap: another reap holds $CACHE/reap.lock"; return 0; }
  local now d id pid alive exp keep reason
  now="$(date +%s)"
  for d in "$RUNS"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"; id="$(basename "$d")"
    pid="$(cat "$d/qemu.pid" 2>/dev/null || true)"
    alive=0; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && alive=1
    if [ ! -f "$d/caller" ]; then
      # A run from before owners were recorded: give it the default lifetime
      # from now instead of stopping it under whoever is using it.
      echo $(( now + $(to_seconds "$TTL") )) > "$d/expires"
      echo "unrecorded (started before hostlab recorded owners)" > "$d/owner"
      echo 1 > "$d/keep"; echo "0 unknown" > "$d/caller"
      reap_log "$id has no recorded owner: expires in $TTL (hostlab extend $id DURATION)"
      continue
    fi
    exp="$(cat "$d/expires" 2>/dev/null || echo none)"
    keep="$(cat "$d/keep" 2>/dev/null || echo 1)"
    reason=
    if [ "$exp" != none ] && [ "$now" -ge "$exp" ]; then
      reason=expired
    elif [ "$keep" != 1 ] && ! caller_alive "$d"; then
      reason="caller exited"
    elif [ "$alive" = 0 ] && { ! caller_alive "$d" || [ $(( now - $(stat -c %Y "$d") )) -gt 600 ]; }; then
      # qemu writes its pid a moment after the run dir appears; only a gone
      # caller or a 10-minute-old dir makes a missing qemu final.
      reason="qemu not running"
    fi
    [ -n "$reason" ] || continue
    vm_stop "$d"
    archive_run "$d" "$reason"
  done
  if [ -d "$ARCHIVE" ]; then
    find "$ARCHIVE" -mindepth 2 -maxdepth 2 -name reaped -mtime +"$ARCHIVE_KEEP_DAYS" -printf '%h\n' 2>/dev/null |
      while read -r old; do rm -rf "$old"; reap_log "pruned $(basename "$old") from the archive after $ARCHIVE_KEEP_DAYS days"; done
  fi
}

# Validate arguments before any side effects, including --help.
no_args() {
  local cmd=$1; shift
  case "${1:-}" in
    '') ;;
    -h|--help) usage; exit 0 ;;
    *) die "hostlab $cmd takes no arguments (got: $*)" ;;
  esac
}

case "${1:-}" in
  build) shift; no_args build "$@"; cmd_build ;;
  run|shell) mode=$1; shift; cmd_run "$mode" "$@" ;;
  ssh) shift; cmd_ssh "$@" ;;
  status) shift; no_args status "$@"; cmd_status ;;
  extend) shift; cmd_extend "$@" ;;
  reap) shift; no_args reap "$@"; cmd_reap ;;
  clean) shift; if [ "$#" = 1 ] && [ "$1" = --cache ]; then cmd_clean_cache; else no_args clean "$@"; cmd_clean; fi ;;
  -h|--help|help|"") usage; exit 0 ;;
  *) die "unknown command $1 (hostlab --help)" ;;
esac
