#!/usr/bin/env bash
# Push a branch and PROVE it landed.
#
# Measured on 2026-08-13 with 4 agents sharing one box and one GitHub remote:
#   - concurrent pushes make GitHub drop the SSH connection during ref
#     advertisement ("Connection to github.com closed by remote host"), and the
#     drop appears at line 6 of a 28-line log — before the gate even finishes
#   - the pre-push gate then PASSES and git exits 0 with nothing on the remote
#   - so `git push` succeeding proves nothing; only ls-remote does
#   - and because the gate is fused into the push, every transport retry re-pays
#     the whole gate (measured 375-622s)
#
# This serialises the transport across every agent on the box (one flock), then
# verifies the remote SHA equals the local SHA. It never passes --no-verify: the
# gate still runs, it just stops being paid for a network failure.
#
# usage: adc-push <worktree> [attempts]
set -uo pipefail

WT="${1:?usage: adc-push <worktree> [attempts]}"
ATTEMPTS="${2:-4}"
LOCK="${ADC_PUSH_LOCK:-/tmp/adc-push.lock}"
export TURBO_CACHE_DIR="${TURBO_CACHE_DIR:-$HOME/.cache/turbo/adc}"

BRANCH="$(git -C "$WT" rev-parse --abbrev-ref HEAD)"
[ "$BRANCH" != "HEAD" ] || { echo "adc-push: $WT is detached" >&2; exit 2; }

# Bind the commit NOW, not when the lock is acquired. The lock serialises every
# agent on the box, so a queued push can wait minutes; worktrees are shared, and
# on 2026-08-14 a push that waited 16 minutes acquired the lock after another
# agent had checked out their own branch in the same tree, and pushed THEIR
# HEAD. Pushing an explicit sha cannot drift no matter how long it queues.
COMMIT="$(git -C "$WT" rev-parse HEAD)"

# A repo-local user.email silently shadows the correct global one, and the
# author identity only becomes visible after the fact: GitHub appends
# `Co-authored-by: <that address>` to every squash merge. On 2026-08-13 a stale
# `drew@webb.tools` override put a personal address on 28 of the last 30
# develop commits before anyone noticed. Refuse the push rather than sign work
# with an account that is not the one merging it.
AUTHOR_EMAIL="$(git -C "$WT" config user.email 2>/dev/null || true)"
case "${ADC_ALLOWED_EMAILS:-drewstone329@gmail.com hello@tangle.tools}" in
  *"$AUTHOR_EMAIL"*) ;;
  *)
    echo "adc-push: refusing — commit identity is '${AUTHOR_EMAIL:-<unset>}'." >&2
    echo "  allowed: ${ADC_ALLOWED_EMAILS:-drewstone329@gmail.com hello@tangle.tools}" >&2
    echo "  fix: git -C '$WT' config --unset user.email   (falls back to the global identity)" >&2
    exit 2
    ;;
esac

log() { echo "[adc-push $(date +%H:%M:%S)] $*"; }
local_sha()  { printf "%s" "$COMMIT"; }
remote_sha() { git -C "$WT" ls-remote --heads origin "$BRANCH" 2>/dev/null | cut -f1; }

for attempt in $(seq 1 "$ATTEMPTS"); do
  if [ "$(remote_sha)" = "$(local_sha)" ]; then
    log "already landed: $BRANCH @ $(local_sha | cut -c1-9)"
    exit 0
  fi

  log "attempt $attempt/$ATTEMPTS: waiting for the machine-wide push lock"
  # The gate runs inside the lock too. That is deliberate: two gates in parallel
  # on one box starve each other's timeouts (a 13s test tripped its budget and
  # reported a false failure), so serialising both is what makes each attempt
  # deterministic.
  #
  # HTTPS first. GitHub caps concurrent SSH connections per host, and 8 agent
  # sessions on one box exhaust it: measured 2026-08-13, one branch failed 3 SSH
  # pushes — reporting success on two of them — then landed over HTTPS on the
  # first try, as did every branch after it. SSH stays the fallback for a box
  # with no token.
  if [ -n "${DREW_GH_TOKEN:-}" ]; then
    # The token is passed by NAME, never by value. Interpolating it into the
    # URL puts the secret in argv, where `ps -eo args` shows it to every local
    # user for the length of the push — and this box runs many agents as one
    # user. Git runs the helper with `sh -c`, so `$DREW_GH_TOKEN` expands
    # inside that shell from the inherited environment; the process table holds
    # only the literal variable name.
    flock "$LOCK" env TURBO_CACHE_DIR="$TURBO_CACHE_DIR" DREW_GH_TOKEN="$DREW_GH_TOKEN" \
      git -C "$WT" \
        -c 'credential.helper=!f() { printf "username=x-access-token\npassword=%s\n" "$DREW_GH_TOKEN"; }; f' \
        push \
        "https://github.com/${ADC_REMOTE_SLUG:-tangle-network/agent-dev-container}.git" \
        "$COMMIT:refs/heads/$BRANCH" 2>&1 \
      | grep -vE "x-access-token|dependabot" | tail -5 | sed -E 's/\x1b\[[0-9;]*m//g'
  else
    flock "$LOCK" env TURBO_CACHE_DIR="$TURBO_CACHE_DIR" \
      git -C "$WT" push origin "$COMMIT:refs/heads/$BRANCH" 2>&1 | tail -5 | sed -E 's/\x1b\[[0-9;]*m//g'
  fi

  if [ "$(remote_sha)" = "$(local_sha)" ]; then
    log "LANDED $BRANCH @ $(local_sha | cut -c1-9)"
    exit 0
  fi
  log "attempt $attempt did not land (ls-remote is the proof); backing off"
  sleep $((attempt * 30))
done

log "FAILED to land $BRANCH after $ATTEMPTS attempts"
exit 1
