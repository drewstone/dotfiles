#!/usr/bin/env bash
set -euo pipefail

# Every `gh` this script runs (identity check, quota probe, the call itself)
# must be the real binary. Without the marker, the gh shim (claude/tools/gh)
# re-entered gh-drew, so each call was verified and logged twice, and each
# guarded read logged a phantom `api rate_limit` (found 2026-10-09).
export GH_DREW_SHIM=1

expected_login="${GH_DREW_EXPECTED_LOGIN:-drewstone}"
secrets_file="${GH_DREW_SECRETS_FILE:-$HOME/company/devops/secrets/agent-state.env}"
keys_file="${GH_DREW_KEYS_FILE:-$HOME/company/devops/secrets/.env.keys}"

# Decrypting the vault starts a Node process per call. Thirteen agent sessions
# calling gh-drew kept 3-6 decrypts running at once (2026-09-27, several cores).
# A decrypted value is cached for GH_DREW_SECRET_TTL seconds (default 900) in a
# per-user private temp directory (0700, files 0600), and is discarded early when
# the vault file changes. The vault's own key file lives in the same home, so the
# cache does not widen who can read the token.
secret_ttl="${GH_DREW_SECRET_TTL:-900}"
secret_cache_dir="${TMPDIR:-/tmp}/gh-drew-secrets-$(id -u)"

cached_secret() {
  local key="$1" f="$secret_cache_dir/$1" now mtime
  [[ "$secret_ttl" -gt 0 && -f "$f" && -O "$f" ]] || return 1
  now=$(date +%s)
  if ! mtime=$(stat -c %Y "$f" 2>/dev/null); then
    mtime=$(stat -f %m "$f" 2>/dev/null) || return 1
  fi
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
  (( now - mtime < secret_ttl )) || return 1
  [[ "$f" -nt "$secrets_file" ]] || return 1
  cat "$f"
}

store_secret() {
  local key="$1" value="$2" tmp
  [[ "$secret_ttl" -gt 0 && -n "$value" ]] || return 0
  ( umask 077; mkdir -p "$secret_cache_dir" ) 2>/dev/null || return 0
  chmod 700 "$secret_cache_dir" 2>/dev/null || return 0
  [[ -O "$secret_cache_dir" ]] || return 0
  tmp=$(umask 077; mktemp "$secret_cache_dir/.$key.XXXXXX") || return 0
  printf '%s' "$value" > "$tmp" && mv -f "$tmp" "$secret_cache_dir/$key"
}

read_secret() {
  local key="$1" value
  if value=$(cached_secret "$key"); then printf '%s' "$value"; return 0; fi
  value=$(read_secret_uncached "$key")
  store_secret "$key" "$value"
  printf '%s' "$value"
}

read_secret_uncached() {
  local key="$1"

  if command -v dotenvx >/dev/null 2>&1 && [[ -f "$secrets_file" ]]; then
    if [[ -f "$keys_file" ]]; then
      dotenvx get "$key" -fk "$keys_file" -f "$secrets_file" --overload 2>/dev/null || true
    else
      dotenvx get "$key" -f "$secrets_file" --overload 2>/dev/null || true
    fi
  fi
}

# Identity verification used to spend a `gh api user` REST call on EVERY
# gh-drew invocation — and the loops below try up to three candidate keys, so a
# single command could cost 2-4 calls before doing any work. With several agents
# sharing one token (one 5,000/hr core bucket) that alone can exhaust the quota
# and lock out merges. Cache the verdict per token fingerprint; the token's
# identity does not change between calls.
# The check asks GraphQL (`viewer { login }`), whose quota is separate from the
# core REST quota: on 2026-10-09 the core quota reached 0 at 20:10Z, the 6h
# verdict expired at 20:20Z, `GET /user` then failed, and every gh-drew call on
# the host, writes and `/rate_limit` included, refused until the 20:21Z reset.
verify_cache_dir="${GH_DREW_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/gh-drew}"
verify_ttl="${GH_DREW_VERIFY_TTL:-21600}" # 6h

token_fingerprint() {
  # macOS may lack sha256sum; an empty fingerprint once made the cache path the
  # directory itself, and `chmod 600` then locked the directory.
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | cut -c1-16
  else
    printf '%s' "$1" | shasum -a 256 | cut -c1-16
  fi
}

try_token() {
  local token="$1"

  [[ -n "$token" ]] || return 1

  local fp cache now stamp
  fp="$(token_fingerprint "$token")" || return 1
  [[ "$fp" =~ ^[0-9a-f]{16}$ ]] || return 1
  cache="$verify_cache_dir/$fp"
  now="$(date +%s)"

  if [[ -r "$cache" ]]; then
    stamp="$(head -1 "$cache" 2>/dev/null || true)"
    if [[ "$stamp" =~ ^[0-9]+$ ]] && (( now - stamp < verify_ttl )); then
      local cached
      cached="$(tail -1 "$cache" 2>/dev/null || true)"
      # A cache written before this check could hold an API error body; ignore it.
      if [[ "$cached" =~ ^[A-Za-z0-9-]+$ ]]; then
        printf '%s' "$cached"
        return 0
      fi
      rm -f "$cache" 2>/dev/null || true
    fi
  fi

  local login
  login="$(GH_TOKEN="$token" gh api graphql -f query='{viewer{login}}' --jq .data.viewer.login 2>/dev/null || true)"
  # On a 403 (rate limit) gh prints the JSON error body to stdout; only a real
  # GitHub login may be cached or returned, or one outage locks every caller out
  # for the whole cache TTL.
  if [[ ! "$login" =~ ^[A-Za-z0-9-]+$ ]]; then
    return 1
  fi
  if [[ -n "$login" ]]; then
    mkdir -p "$verify_cache_dir" 2>/dev/null || true
    # The private cache directory must be searchable before writing a verdict.
    chmod 700 "$verify_cache_dir" 2>/dev/null || true
    if printf '%s\n%s\n' "$now" "$login" > "$cache" 2>/dev/null; then
      chmod 600 "$cache" 2>/dev/null || true
    fi
  fi
  printf '%s' "$login"
}

# Every call leaves one line in an hourly log, so the fleet can name who spends the shared quota
# (tangle-tools fleet/INVARIANTS.md, "GitHub core quota"). A line is: epoch, outcome (called or
# refused), caller, session, working directory and the command's shape, tab-separated. It never
# holds the token or a flag's value (a body, a field, a header): only subcommands, the API path,
# numbers and repository names. On Linux the line costs no fork: /proc and builtins give the caller.
log_dir="${GH_DREW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-drew}"

# Launchers that sit between an agent and gh-drew; the caller is the first ancestor that is not one.
passthrough='@env@timeout@nice@nohup@xargs@flock@stdbuf@setsid@ionice@time@sudo@rtk@'

# Sets argv to the first words of a process's command line.
read_argv() {
  local args
  argv=()
  if [[ -r "/proc/$1/cmdline" ]]; then
    local a0='' a1='' a2='' a3='' a4=''
    { IFS= read -r -d '' a0 && IFS= read -r -d '' a1 && IFS= read -r -d '' a2 &&
      IFS= read -r -d '' a3 && IFS= read -r -d '' a4; } < "/proc/$1/cmdline" || true
    argv=("$a0" "$a1" "$a2" "$a3" "$a4")
  else
    args="$(ps -o args= -p "$1" 2>/dev/null || true)"
    read -r -a argv <<< "$args" || true
  fi
  return 0
}

# Sets script to the script an interpreter or shell runs (python3 .../fleet/fleet is "fleet"), or to
# nothing for inline code (bash -c, python -c) and an interactive shell.
script_of() {
  local arg dir
  script=''
  for arg in "$@"; do
    case "$arg" in
      '') continue ;;
      --*) continue ;;
      -*c*) return 0 ;;
      -*) continue ;;
    esac
    script="${arg##*/}"
    case "$script" in
      cli.js|cli.mjs|cli.cjs|index.js|index.mjs|main.js|main.mjs|main.py|__main__.py|cli.py)
        dir="${arg%/*}"
        if [[ "$dir" != "$arg" ]]; then
          script="${dir##*/}"
        fi
        ;;
    esac
    script="${script%.js}"; script="${script%.mjs}"; script="${script%.cjs}"; script="${script%.py}"
    script="${script%.ts}"; script="${script%.sh}"
    return 0
  done
  return 0
}

# Sets caller from the process tree: /proc on Linux, ps elsewhere.
find_caller() {
  local pid="$PPID" hops=0 comm ppid stat rest script
  local -a argv
  caller='?'
  while (( hops < 8 )); do
    hops=$((hops + 1))
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || (( pid <= 1 )); then
      return 0
    fi
    if [[ -r "/proc/$pid/stat" ]]; then
      IFS= read -r stat < "/proc/$pid/stat" || return 0
      comm="${stat#*\(}"; comm="${comm%\)*}"
      rest="${stat##*\) }"; ppid="${rest#* }"; ppid="${ppid%% *}"
    else
      read -r ppid comm < <(ps -o ppid= -o comm= -p "$pid" 2>/dev/null) || return 0
      comm="${comm##*/}"
    fi
    case "$comm" in
      bash|sh|dash|zsh|fish|python*|node|bun|deno|ruby|perl|uv|npx|tsx)
        read_argv "$pid"
        script_of "${argv[@]:1}"
        if [[ -n "$script" && "$script" != gh-drew ]]; then
          caller="$script"
          return 0
        fi
        case "$comm" in
          bash|sh|dash|zsh|fish) pid="$ppid"; continue ;;
        esac
        ;;
    esac
    if [[ "$passthrough" == *"@$comm@"* ]]; then
      pid="$ppid"
      continue
    fi
    caller="$comm"
    return 0
  done
  return 0
}

# Sets session: the tmux pane (the fleet maps it to a lane), else the systemd service, else the Claude session.
find_session() {
  local cgroup unit
  session=''
  if [[ -n "${TMUX_PANE-}" ]]; then
    session="tmux:$TMUX_PANE"
    return 0
  fi
  if [[ -r "/proc/$$/cgroup" ]] && IFS= read -r cgroup < "/proc/$$/cgroup"; then
    unit="${cgroup##*/}"
    if [[ "$unit" == *.service && "$unit" != user@*.service ]]; then
      session="unit:$unit"
      return 0
    fi
  fi
  if [[ -n "${CLAUDE_CODE_SESSION_ID-}" ]]; then
    session="claude:${CLAUDE_CODE_SESSION_ID:0:8}"
  fi
  return 0
}

# Sets shape: the subcommand and what names the target, never a flag's value.
call_shape() {
  local -a words=()
  local arg skip='' first="${1-}"
  shift || true
  words+=("$first")
  if [[ "$first" == api ]]; then
    for arg in "$@"; do
      if [[ -n "$skip" ]]; then
        if [[ "$skip" == method ]]; then
          words+=("$arg")
        fi
        skip=''
        continue
      fi
      case "$arg" in
        -X|--method) skip=method ;;
        -H|--header|-f|--raw-field|-F|--field|-q|--jq|-t|--template|--input|-p|--preview|--hostname|--cache) skip=value ;;
        -X?*) words+=("${arg#-X}") ;;
        --method=*) words+=("${arg#--method=}") ;;
        -*) ;;
        *)
          # gh api takes one positional argument, the endpoint. A credential in its query is dropped.
          if [[ "$arg" == *\?* && "$arg" =~ (token|key|secret|password)= ]]; then
            arg="${arg%%\?*}"
          fi
          if (( ${#words[@]} < 3 )); then
            words+=("$arg")
          fi
          ;;
      esac
    done
  else
    if [[ -n "${1-}" && "${1-}" != -* ]]; then
      words+=("$1")
      shift
    fi
    case "$first" in
      secret|variable|auth|ssh-key|gpg-key|config|alias|extension) ;;
      *)
        for arg in "$@"; do
          if [[ "$arg" =~ ^[0-9]+$ || "$arg" =~ ^https://github\.com/[A-Za-z0-9_./#-]+$ ||
                "$arg" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
            words+=("$arg")
          fi
          if (( ${#words[@]} >= 5 )); then
            break
          fi
        done
        ;;
    esac
  fi
  printf -v shape '%s ' "${words[@]}"
  shape="${shape% }"
  return 0
}

write_call() {
  local outcome="$1" stamp='' epoch hour file line where caller session shape
  shift
  printf -v stamp '%(%s %Y%m%d%H)T' -1 2>/dev/null || stamp="$(date '+%s %Y%m%d%H')"
  epoch="${stamp% *}"; hour="${stamp#* }"
  find_caller
  find_session
  call_shape "$@"
  where="$PWD"
  if [[ "$where" == "$HOME" || "$where" == "$HOME"/* ]]; then
    where="~${where#"$HOME"}"
  fi
  printf -v line '%s\t%s\t%s\t%s\t%s\t%s' "$epoch" "$outcome" "${caller//[$'\t\n\r']/ }" \
    "${session//[$'\t\n\r']/ }" "${where//[$'\t\n\r']/ }" "${shape//[$'\t\n\r']/ }"
  file="$log_dir/calls-$hour.tsv"
  if [[ ! -e "$file" ]]; then
    [[ -d "$log_dir" ]] || mkdir -p "$log_dir"
    # A new hour: drop the hours the fleet no longer reads, in the background.
    find "$log_dir" -maxdepth 1 -name 'calls-*.tsv' -mmin +1500 -delete </dev/null >/dev/null 2>&1 &
  fi
  # One line under PIPE_BUF, appended: concurrent callers never interleave.
  printf '%s\n' "${line:0:1000}" >> "$file"
}

log_call() {
  if [[ -r "/proc/$$/stat" ]]; then
    write_call "$@" 2>/dev/null || true
  else
    # Without /proc the caller costs ps forks; they run beside gh and hold none of its output.
    ( write_call "$@" ) </dev/null >/dev/null 2>&1 &
  fi
  return 0
}

# Reads must never starve writes. /rate_limit does not count against the core
# quota, so this check is free. Below the floor, refuse read-only commands (the
# polling loops that cause exhaustion) while letting mutations through, so a
# runaway status poll can never block a merge or a deploy dispatch.
core_floor="${GH_DREW_MIN_CORE:-150}"

guard_reads() {
  local token="$1"; shift
  [[ "$core_floor" =~ ^[0-9]+$ ]] && (( core_floor > 0 )) || return 0

  case "${1-}" in
    api)
      # Only GETs are reads; an explicit -X/--method other than GET mutates.
      # /rate_limit is exempt: it costs nothing and is how an operator inspects
      # the very exhaustion this guard reports.
      for a in "$@"; do
        case "$a" in
          -X|--method) return 0 ;;
          rate_limit|/rate_limit) return 0 ;;
        esac
      done
      ;;
    run|pr|issue|release|workflow|repo|cache)
      case "${2-}" in
        list|view|status|checks|diff|download|watch) ;;
        *) return 0 ;;
      esac
      ;;
    *) return 0 ;;
  esac

  local remaining
  remaining="$(GH_TOKEN="$token" gh api rate_limit --jq .resources.core.remaining 2>/dev/null || true)"
  [[ "$remaining" =~ ^[0-9]+$ ]] || return 0
  if (( remaining < core_floor )); then
    log_call refused "$@"
    local reset
    reset="$(GH_TOKEN="$token" gh api rate_limit --jq '.resources.core.reset' 2>/dev/null || true)"
    cat >&2 <<EOF
gh-drew: refusing a read — core quota $remaining left, reserved floor $core_floor.
The remainder is held for writes (merge, PR create, workflow dispatch).
Resets: $( [[ "$reset" =~ ^[0-9]+$ ]] && date -u -d "@$reset" 2>/dev/null || echo unknown )

Watch the live service instead of polling CI (curl the deployed endpoint) — that
costs no quota. Override with GH_DREW_MIN_CORE=0 if this read is load-bearing.
EOF
    exit 3
  fi
}

# A squash merge without an explicit body lets GitHub write the message, and
# GitHub then appends "Co-authored-by:" for every PR commit whose author email
# is not verified on the merging account (agents commit as unverified tangle
# addresses). An explicit --body replaces that message, so a `pr merge
# --squash` that names no body gets one: the PR title and the first prose
# paragraph of its description, with trailer and generator lines removed.
squash_body=()
add_squash_body() {
  local token="$1"; shift
  [[ "${1:-}" == "pr" ]] || return 0
  shift
  local squash=0 selector="" repo=() arg
  # gh accepts the inherited repository flag before the subcommand: gh pr -R o/r merge 12 -s.
  while (( $# )) && [[ "$1" != "merge" ]]; do
    case "$1" in
      -R|--repo) repo=(--repo "${2:-}"); shift 2 || return 0 ;;
      --repo=*) repo=(--repo "${1#--repo=}"); shift ;;
      -R?*) repo=(--repo "${1#-R}"); shift ;;
      *) return 0 ;;
    esac
  done
  (( $# )) || return 0
  shift
  while (( $# )); do
    arg="$1"; shift
    case "$arg" in
      -s|--squash) squash=1 ;;
      -b|--body|-F|--body-file|--body=*|--body-file=*) return 0 ;;
      -R|--repo) repo=(--repo "${1:-}"); shift || true ;;
      --repo=*) repo=(--repo "${arg#--repo=}") ;;
      -t|--subject|-A|--author-email|--match-head-commit) shift || true ;;
      --) [[ -z "$selector" ]] && selector="${1:-}"; break ;;
      -[!-]?*)
        # A cluster of short flags (-sd, -sb msg, -Ro/r): read it letter by letter.
        local i=1 c
        while (( i < ${#arg} )); do
          c="${arg:i:1}"
          case "$c" in
            s) squash=1 ;;
            b|F) return 0 ;;
            R|t|A)
              if (( i + 1 < ${#arg} )); then
                [[ "$c" == R ]] && repo=(--repo "${arg:i+1}")
              else
                [[ "$c" == R ]] && repo=(--repo "${1:-}")
                shift || true
              fi
              break ;;
          esac
          i=$((i + 1))
        done ;;
      -*) ;;
      *) [[ -z "$selector" ]] && selector="$arg" ;;
    esac
  done
  (( squash )) || return 0
  local view=(pr view) title description summary
  [[ -n "$selector" ]] && view+=("$selector")
  view+=(${repo[@]+"${repo[@]}"})
  title="$(GH_TOKEN="$token" gh "${view[@]}" --json title --jq .title)" || {
    echo "gh-drew: cannot read the PR title to write the squash body; pass --body explicitly" >&2
    exit 2
  }
  description="$(GH_TOKEN="$token" gh "${view[@]}" --json body --jq .body)" || description=""
  summary="$(printf '%s\n' "$description" | tr -d '\r' | awk '
    /^[[:space:]]*```/ { fence = !fence; next }
    fence { next }
    /^[[:space:]]*$/ { if (n) exit; next }
    /^[[:space:]]*#/ || /^[[:space:]]*[A-Za-z-]+-[Bb]y:/ || /Generated with \[/ || /^[[:space:]]*<!--/ || /^[[:space:]]*\|/ { if (n) exit; next }
    { sub(/^[[:space:]]+/, ""); sub(/^[-*][[:space:]]+/, ""); printf "%s%s", (n ? " " : ""), $0; n++ }
  ' | cut -c1-600)"
  if [[ -n "$summary" ]]; then
    squash_body=(--body "$title"$'\n\n'"$summary")
  else
    squash_body=(--body "$title")
  fi
}

# The body goes before a `--`, after which gh reads only positionals.
final_args=()
with_squash_body() {
  local a inserted=0
  for a in "$@"; do
    if [[ "$a" == "--" && $inserted -eq 0 ]]; then
      final_args+=(${squash_body[@]+"${squash_body[@]}"})
      inserted=1
    fi
    final_args+=("$a")
  done
  (( inserted )) || final_args+=(${squash_body[@]+"${squash_body[@]}"})
}

# GH_DREW_TOKEN_KEYS names other keys for a wrapper that runs as another login (gh-read).
read -r -a token_keys <<< "${GH_DREW_TOKEN_KEYS:-DREW_GH_TOKEN DREWSTONE_GH_TOKEN GH_TOKEN}"

for key in "${token_keys[@]}"; do
  token="${!key-}"
  login="$(try_token "$token" || true)"

  if [[ "$login" == "$expected_login" ]]; then
    guard_reads "$token" "$@"
    add_squash_body "$token" "$@"
    log_call called "$@"
    with_squash_body "$@"
    exec env GH_TOKEN="$token" gh ${final_args[@]+"${final_args[@]}"}
  fi
done

for key in "${token_keys[@]}"; do
  token="$(read_secret "$key")"
  login="$(try_token "$token" || true)"

  if [[ "$login" == "$expected_login" ]]; then
    guard_reads "$token" "$@"
    add_squash_body "$token" "$@"
    log_call called "$@"
    with_squash_body "$@"
    exec env GH_TOKEN="$token" gh ${final_args[@]+"${final_args[@]}"}
  fi
done

cat >&2 <<EOF
gh-drew: no valid GitHub API token for '$expected_login' found (keys: ${token_keys[*]}).

Required:
- Add DREW_GH_TOKEN to $secrets_file, or export it in the shell.
- The token must authenticate as '$expected_login'.
- It needs repository and pull request write access for the target repos.

Do not fall back to raw 'gh' for PR creation in Drew/Tangle repos; that can
silently use another configured account.
EOF
exit 2
