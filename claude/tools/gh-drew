#!/usr/bin/env bash
# Associative arrays below require Bash 4+. Under macOS's system Bash 3.2, which a PATH
# with /usr/bin first resolves, the receipt-rule table fails with "tangle: unbound
# variable" and the requested call never runs (an armed merge, 2026-10-18). Re-exec an
# installed compatible Bash so callers using the normal CLI keep working without a new install.
bash_major=0
if [ -n "${BASH_VERSION:-}" ]; then bash_major=${BASH_VERSION%%.*}; fi
case "$bash_major" in ''|*[!0-9]*) bash_major=0 ;; esac
if [ "$bash_major" -lt 4 ]; then
  compatible_bash=
  path_bash=$(command -v bash 2>/dev/null || true)
  for bash_candidate in "$path_bash" /opt/homebrew/bin/bash /usr/local/bin/bash /opt/local/bin/bash; do
    [ -n "$bash_candidate" ] && [ -x "$bash_candidate" ] || continue
    if "$bash_candidate" -c "test \"\${BASH_VERSINFO[0]}\" -ge 4" >/dev/null 2>&1; then
      compatible_bash=$bash_candidate
      break
    fi
  done
  if [ -n "$compatible_bash" ]; then
    exec "$compatible_bash" "$0" "$@"
  fi
  echo "gh-drew: requires Bash 4 or newer; no compatible Bash was found on PATH or in standard macOS locations" >&2
  exit 2
fi
set -euo pipefail

# Every `gh` this script runs (identity check, quota probe, the call itself)
# must be the real binary. Without the marker, the gh shim (claude/tools/gh)
# re-entered gh-drew, so each call was verified and logged twice, and each
# guarded read logged a phantom `api rate_limit` (found 2026-10-09).
export GH_DREW_SHIM=1

expected_login="${GH_DREW_EXPECTED_LOGIN:-drewstone}"
secrets_file="${GH_DREW_SECRETS_FILE:-$HOME/company/devops/secrets/agent-state.env}"
keys_file="${GH_DREW_KEYS_FILE:-$HOME/company/devops/secrets/.env.keys}"

# Decrypting the vault starts a Node process per call. Thirteen agent sessions
# calling gh-drew kept 3-6 decrypts running at once (2026-09-27, several cores).
# A decrypted value is cached for GH_DREW_SECRET_TTL seconds (default 900) in a
# per-user private temp directory (0700, files 0600), and is discarded early when
# the vault file changes. The vault's own key file lives in the same home, so the
# cache does not widen who can read the token.
secret_ttl="${GH_DREW_SECRET_TTL:-900}"
secret_cache_dir="${TMPDIR:-/tmp}/gh-drew-secrets-$(id -u)"

cached_secret() {
  local key="$1" f="$secret_cache_dir/$1" now mtime
  [[ "$secret_ttl" -gt 0 && -f "$f" && -O "$f" ]] || return 1
  now=$(date +%s)
  if ! mtime=$(stat -c %Y "$f" 2>/dev/null); then
    mtime=$(stat -f %m "$f" 2>/dev/null) || return 1
  fi
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
  (( now - mtime < secret_ttl )) || return 1
  [[ "$f" -nt "$secrets_file" ]] || return 1
  cat "$f"
}

store_secret() {
  local key="$1" value="$2" tmp
  [[ "$secret_ttl" -gt 0 && -n "$value" ]] || return 0
  ( umask 077; mkdir -p "$secret_cache_dir" ) 2>/dev/null || return 0
  chmod 700 "$secret_cache_dir" 2>/dev/null || return 0
  [[ -O "$secret_cache_dir" ]] || return 0
  tmp=$(umask 077; mktemp "$secret_cache_dir/.$key.XXXXXX") || return 0
  printf '%s' "$value" > "$tmp" && mv -f "$tmp" "$secret_cache_dir/$key"
}

read_secret() {
  local key="$1" value
  if value=$(cached_secret "$key"); then printf '%s' "$value"; return 0; fi
  value=$(read_secret_uncached "$key")
  store_secret "$key" "$value"
  printf '%s' "$value"
}

read_secret_uncached() {
  local key="$1"

  if command -v dotenvx >/dev/null 2>&1 && [[ -f "$secrets_file" ]]; then
    if [[ -f "$keys_file" ]]; then
      dotenvx get "$key" -fk "$keys_file" -f "$secrets_file" --overload 2>/dev/null || true
    else
      dotenvx get "$key" -f "$secrets_file" --overload 2>/dev/null || true
    fi
  fi
}

# Identity verification used to spend a `gh api user` REST call on EVERY
# gh-drew invocation — and the loops below try up to three candidate keys, so a
# single command could cost 2-4 calls before doing any work. With several agents
# sharing one token (one 5,000/hr core bucket) that alone can exhaust the quota
# and lock out merges. Cache the verdict per token fingerprint; the token's
# identity does not change between calls.
# The check asks GraphQL (`viewer { login }`), whose quota is separate from the
# core REST quota: on 2026-10-09 the core quota reached 0 at 20:10Z, the 6h
# verdict expired at 20:20Z, `GET /user` then failed, and every gh-drew call on
# the host, writes and `/rate_limit` included, refused until the 20:21Z reset.
verify_cache_dir="${GH_DREW_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/gh-drew}"
verify_ttl="${GH_DREW_VERIFY_TTL:-21600}" # 6h

token_fingerprint() {
  # macOS may lack sha256sum; an empty fingerprint once made the cache path the
  # directory itself, and `chmod 600` then locked the directory.
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | cut -c1-16
  else
    printf '%s' "$1" | shasum -a 256 | cut -c1-16
  fi
}

try_token() {
  local token="$1"

  [[ -n "$token" ]] || return 1

  local fp cache now stamp
  fp="$(token_fingerprint "$token")" || return 1
  [[ "$fp" =~ ^[0-9a-f]{16}$ ]] || return 1
  cache="$verify_cache_dir/$fp"
  now="$(date +%s)"

  if [[ -r "$cache" ]]; then
    stamp="$(head -1 "$cache" 2>/dev/null || true)"
    if [[ "$stamp" =~ ^[0-9]+$ ]] && (( now - stamp < verify_ttl )); then
      local cached
      cached="$(tail -1 "$cache" 2>/dev/null || true)"
      # A cache written before this check could hold an API error body; ignore it.
      if [[ "$cached" =~ ^[A-Za-z0-9-]+$ ]]; then
        printf '%s' "$cached"
        return 0
      fi
      rm -f "$cache" 2>/dev/null || true
    fi
  fi

  local login
  login="$(GH_TOKEN="$token" gh api graphql -f query='{viewer{login}}' --jq .data.viewer.login 2>/dev/null || true)"
  # On a 403 (rate limit) gh prints the JSON error body to stdout; only a real
  # GitHub login may be cached or returned, or one outage locks every caller out
  # for the whole cache TTL.
  if [[ ! "$login" =~ ^[A-Za-z0-9-]+$ ]]; then
    return 1
  fi
  if [[ -n "$login" ]]; then
    mkdir -p "$verify_cache_dir" 2>/dev/null || true
    # The private cache directory must be searchable before writing a verdict.
    chmod 700 "$verify_cache_dir" 2>/dev/null || true
    if printf '%s\n%s\n' "$now" "$login" > "$cache" 2>/dev/null; then
      chmod 600 "$cache" 2>/dev/null || true
    fi
  fi
  printf '%s' "$login"
}

# Every call leaves one line in an hourly log, so the fleet can name who spends the shared quota
# (tangle-tools fleet/INVARIANTS.md, "GitHub core quota"). A line is: epoch, outcome (called or
# refused), caller, session, working directory and the command's shape, tab-separated. It never
# holds the token or a flag's value (a body, a field, a header): only subcommands, the API path,
# numbers and repository names. On Linux the line costs no fork: /proc and builtins give the caller.
log_dir="${GH_DREW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-drew}"

# Launchers that sit between an agent and gh-drew; the caller is the first ancestor that is not one.
passthrough='@env@timeout@nice@nohup@xargs@flock@stdbuf@setsid@ionice@time@sudo@rtk@'

# Sets argv to the first words of a process's command line.
read_argv() {
  local args
  argv=()
  if [[ -r "/proc/$1/cmdline" ]]; then
    local a0='' a1='' a2='' a3='' a4=''
    { IFS= read -r -d '' a0 && IFS= read -r -d '' a1 && IFS= read -r -d '' a2 &&
      IFS= read -r -d '' a3 && IFS= read -r -d '' a4; } < "/proc/$1/cmdline" || true
    argv=("$a0" "$a1" "$a2" "$a3" "$a4")
  else
    args="$(ps -o args= -p "$1" 2>/dev/null || true)"
    read -r -a argv <<< "$args" || true
  fi
  return 0
}

# Sets script to the script an interpreter or shell runs (python3 .../fleet/fleet is "fleet"), or to
# nothing for inline code (bash -c, python -c) and an interactive shell.
script_of() {
  local arg dir
  script=''
  for arg in "$@"; do
    case "$arg" in
      '') continue ;;
      --*) continue ;;
      -*c*) return 0 ;;
      -*) continue ;;
    esac
    script="${arg##*/}"
    case "$script" in
      cli.js|cli.mjs|cli.cjs|index.js|index.mjs|main.js|main.mjs|main.py|__main__.py|cli.py)
        dir="${arg%/*}"
        if [[ "$dir" != "$arg" ]]; then
          script="${dir##*/}"
        fi
        ;;
    esac
    script="${script%.js}"; script="${script%.mjs}"; script="${script%.cjs}"; script="${script%.py}"
    script="${script%.ts}"; script="${script%.sh}"
    return 0
  done
  return 0
}

# Sets caller from the process tree: /proc on Linux, ps elsewhere.
find_caller() {
  local pid="$PPID" hops=0 comm ppid stat rest script
  local -a argv
  caller='?'
  while (( hops < 8 )); do
    hops=$((hops + 1))
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || (( pid <= 1 )); then
      return 0
    fi
    if [[ -r "/proc/$pid/stat" ]]; then
      IFS= read -r stat < "/proc/$pid/stat" || return 0
      comm="${stat#*\(}"; comm="${comm%\)*}"
      rest="${stat##*\) }"; ppid="${rest#* }"; ppid="${ppid%% *}"
    else
      read -r ppid comm < <(ps -o ppid= -o comm= -p "$pid" 2>/dev/null) || return 0
      comm="${comm##*/}"
    fi
    case "$comm" in
      # Node 24 names its main thread, and so the process, MainThread.
      bash|sh|dash|zsh|fish|python*|node|MainThread|bun|deno|ruby|perl|uv|npx|tsx)
        read_argv "$pid"
        script_of "${argv[@]:1}"
        if [[ -n "$script" && "$script" != gh-drew ]]; then
          caller="$script"
          return 0
        fi
        case "$comm" in
          bash|sh|dash|zsh|fish) pid="$ppid"; continue ;;
        esac
        ;;
    esac
    if [[ "$passthrough" == *"@$comm@"* ]]; then
      pid="$ppid"
      continue
    fi
    caller="$comm"
    return 0
  done
  return 0
}

# Sets session: the tmux pane (the fleet maps it to a lane), else the systemd service, else the Claude session.
find_session() {
  local cgroup unit
  session=''
  if [[ -n "${TMUX_PANE-}" ]]; then
    session="tmux:$TMUX_PANE"
    return 0
  fi
  if [[ -r "/proc/$$/cgroup" ]] && IFS= read -r cgroup < "/proc/$$/cgroup"; then
    unit="${cgroup##*/}"
    if [[ "$unit" == *.service && "$unit" != user@*.service ]]; then
      session="unit:$unit"
      return 0
    fi
  fi
  if [[ -n "${CLAUDE_CODE_SESSION_ID-}" ]]; then
    session="claude:${CLAUDE_CODE_SESSION_ID:0:8}"
  fi
  return 0
}

# Sets shape: the subcommand and what names the target, never a flag's value.
call_shape() {
  local -a words=()
  local arg skip='' first="${1-}"
  shift || true
  words+=("$first")
  if [[ "$first" == api ]]; then
    for arg in "$@"; do
      if [[ -n "$skip" ]]; then
        if [[ "$skip" == method ]]; then
          words+=("$arg")
        fi
        skip=''
        continue
      fi
      case "$arg" in
        -X|--method) skip=method ;;
        -H|--header|-f|--raw-field|-F|--field|-q|--jq|-t|--template|--input|-p|--preview|--hostname|--cache) skip=value ;;
        -X?*) words+=("${arg#-X}") ;;
        --method=*) words+=("${arg#--method=}") ;;
        -*) ;;
        *)
          # gh api takes one positional argument, the endpoint. A credential in its query is dropped.
          if [[ "$arg" == *\?* && "$arg" =~ (token|key|secret|password)= ]]; then
            arg="${arg%%\?*}"
          fi
          if (( ${#words[@]} < 3 )); then
            words+=("$arg")
          fi
          ;;
      esac
    done
  else
    if [[ -n "${1-}" && "${1-}" != -* ]]; then
      words+=("$1")
      shift
    fi
    case "$first" in
      secret|variable|auth|ssh-key|gpg-key|config|alias|extension) ;;
      *)
        for arg in "$@"; do
          if [[ "$arg" =~ ^[0-9]+$ || "$arg" =~ ^https://github\.com/[A-Za-z0-9_./#-]+$ ||
                "$arg" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
            words+=("$arg")
          fi
          if (( ${#words[@]} >= 5 )); then
            break
          fi
        done
        ;;
    esac
  fi
  printf -v shape '%s ' "${words[@]}"
  shape="${shape% }"
  return 0
}

# Sets caller, session, shape and where once per call; the cap and the log both read them.
identified=''
identify() {
  [[ -z "$identified" ]] || return 0
  find_caller
  find_session
  call_shape "$@"
  where="$PWD"
  if [[ "$where" == "$HOME" || "$where" == "$HOME"/* ]]; then
    where="~${where#"$HOME"}"
  fi
  identified=1
}

write_call() {
  local outcome="$1" stamp='' epoch hour file line
  shift
  printf -v stamp '%(%s %Y%m%d%H)T' -1 2>/dev/null || stamp="$(date '+%s %Y%m%d%H')"
  epoch="${stamp% *}"; hour="${stamp#* }"
  identify "$@"
  printf -v line '%s\t%s\t%s\t%s\t%s\t%s' "$epoch" "$outcome" "${caller//[$'\t\n\r']/ }" \
    "${session//[$'\t\n\r']/ }" "${where//[$'\t\n\r']/ }" "${shape//[$'\t\n\r']/ }"
  file="$log_dir/calls-$hour.tsv"
  if [[ ! -e "$file" ]]; then
    [[ -d "$log_dir" ]] || mkdir -p "$log_dir"
    # A new hour: drop the hours the fleet no longer reads, in the background.
    find "$log_dir" -maxdepth 1 -name 'calls-*.tsv' -mmin +1500 -delete </dev/null >/dev/null 2>&1 &
  fi
  # One line under PIPE_BUF, appended: concurrent callers never interleave.
  printf '%s\n' "${line:0:1000}" >> "$file"
}

log_call() {
  if [[ -r "/proc/$$/stat" ]]; then
    write_call "$@" 2>/dev/null || true
  else
    # Without /proc the caller costs ps forks; they run beside gh and hold none of its output.
    ( write_call "$@" ) </dev/null >/dev/null 2>&1 &
  fi
  return 0
}

# Reads must never starve writes. /rate_limit does not count against the core
# quota, so this check is free. Below the floor, refuse read-only commands (the
# polling loops that cause exhaustion) while letting mutations through, so a
# runaway status poll can never block a merge or a deploy dispatch.
core_floor="${GH_DREW_MIN_CORE:-150}"

guard_reads() {
  local token="$1"; shift
  [[ "$core_floor" =~ ^[0-9]+$ ]] && (( core_floor > 0 )) || return 0

  case "${1-}" in
    api)
      # Only GETs are reads; an explicit -X/--method other than GET mutates.
      # /rate_limit is exempt: it costs nothing and is how an operator inspects
      # the very exhaustion this guard reports.
      for a in "$@"; do
        case "$a" in
          -X|--method) return 0 ;;
          rate_limit|/rate_limit) return 0 ;;
        esac
      done
      ;;
    run|pr|issue|release|workflow|repo|cache)
      case "${2-}" in
        list|view|status|checks|diff|download|watch) ;;
        *) return 0 ;;
      esac
      ;;
    *) return 0 ;;
  esac

  local remaining
  remaining="$(GH_TOKEN="$token" gh api rate_limit --jq .resources.core.remaining 2>/dev/null || true)"
  [[ "$remaining" =~ ^[0-9]+$ ]] || return 0
  if (( remaining < core_floor )); then
    log_call refused "$@"
    local reset
    reset="$(GH_TOKEN="$token" gh api rate_limit --jq '.resources.core.reset' 2>/dev/null || true)"
    cat >&2 <<EOF
gh-drew: refusing a read — core quota $remaining left, reserved floor $core_floor.
The remainder is held for writes (merge, PR create, workflow dispatch).
Resets: $( [[ "$reset" =~ ^[0-9]+$ ]] && date -u -d "@$reset" 2>/dev/null || echo unknown )

Watch the live service instead of polling CI (curl the deployed endpoint) — that
costs no quota. Override with GH_DREW_MIN_CORE=0 if this read is load-bearing.
EOF
    exit 3
  fi
}

# One caller may not drain the quota every agent shares. Each quota breach from 2026-10-09 to 10-11 was
# one script reading in a loop (per-run jobs, per-PR pulls: 530 to 7,857 core reads an hour from one
# caller), while the busiest legitimate caller peaked at 270 in ten minutes and 630 in an hour.
# A caller (the same caller and session, or directory without one, as the fleet's quota item counts)
# gets GH_DREW_CALLER_10M core reads in any ten minutes and GH_DREW_CALLER_1H in any hour, counted
# from this host's own log, so concurrent callers need no lock. Writes and free reads (GraphQL,
# search, /rate_limit) never count and are never refused. 0 turns a limit off.
cap_10m="${GH_DREW_CALLER_10M:-300}"
cap_1h="${GH_DREW_CALLER_1H:-600}"

hour_of() {
  printf -v hour '%(%Y%m%d%H)T' "$1" 2>/dev/null ||
    hour="$(date -d "@$1" +%Y%m%d%H 2>/dev/null || date -r "$1" +%Y%m%d%H)"
}

# Whether a logged shape draws on the core quota as a read; the fleet's draws_core, less writes.
core_read_awk='
function core_read(s,  w, n, i, p, m) {
  n = split(s, w, " ")
  if (w[1] == "api") {
    for (i = 2; i <= 3 && i <= n; i++) {
      m = toupper(w[i])
      if (m ~ /^(GET|HEAD|POST|PUT|PATCH|DELETE)$/) { if (m != "GET" && m != "HEAD") return 0; continue }
      if (p == "") p = w[i]
    }
    sub(/^\//, "", p)
    return p != "" && p !~ /^(rate_limit|graphql)([?]|$)/ && p !~ /^search\//
  }
  if (w[1] ~ /^(run|workflow|release|cache)$/) return w[2] ~ /^(list|view|status|checks|diff|download|watch)$/
  return w[1] == "pr" && w[2] == "diff"
}'

cap_reads() {
  local now hour key n10=0 n60=0 a
  local -a files=()
  [[ "$cap_10m" =~ ^[0-9]+$ && "$cap_1h" =~ ^[0-9]+$ ]] && (( cap_10m + cap_1h > 0 )) || return 0
  case "${1-}" in
    api)
      # gh api sends a POST when it is given fields or a body and no method.
      for a in "$@"; do
        case "$a" in -f|-F|--field|--raw-field|--input|-f?*|-F?*|--field=*|--raw-field=*|--input=*) return 0 ;; esac
      done
      ;;
    run|workflow|release|cache|pr) ;;
    *) return 0 ;;
  esac
  identify "$@"
  awk -v shape="$shape" "$core_read_awk"' BEGIN { exit !core_read(shape) }' </dev/null 2>/dev/null || return 0
  printf -v now '%(%s)T' -1 2>/dev/null || now="$(date +%s)"
  hour_of $((now - 3600)); [[ -f "$log_dir/calls-$hour.tsv" ]] && files+=("$log_dir/calls-$hour.tsv")
  hour_of "$now"; [[ -f "$log_dir/calls-$hour.tsv" ]] && files+=("$log_dir/calls-$hour.tsv")
  (( ${#files[@]} )) || return 0
  key="${session:-$where}"
  read -r n10 n60 < <(awk -F '\t' -v caller="$caller" -v key="$key" -v now="$now" "$core_read_awk"'
    $2 == "called" && $3 == caller && ($4 != "" ? $4 : $5) == key && $1 > now - 3600 && core_read($6) {
      n60++; if ($1 > now - 600) n10++
    }
    END { print n10 + 0, n60 + 0 }' "${files[@]}" 2>/dev/null) || return 0
  if (( (cap_10m > 0 && n10 >= cap_10m) || (cap_1h > 0 && n60 >= cap_1h) )); then
    log_call refused "$@"
    cat >&2 <<EOF
gh-drew: refusing a read — $caller ($key) made $n10 core reads in the last 10 minutes
(cap $cap_10m) and $n60 in the last hour (cap $cap_1h). Every agent shares one 5,000/h quota.
Stop the loop and batch the reads: one GraphQL query for many pulls or runs, git fetch and
local git for refs and ancestry, the newest run per workflow instead of every run's jobs.
Reads come back as this caller's older reads leave the window.
EOF
    exit 3
  fi
}

# Reads a `pr merge` command line into merge_selector, merge_repo (--repo o/r, or nothing),
# merge_squash, merge_body and merge_disable_auto; returns 1 for any other command.
parse_pr_merge() {
  [[ "${1:-}" == "pr" ]] || return 1
  shift
  merge_selector="" merge_repo=() merge_squash=0 merge_body=0 merge_disable_auto=0
  local arg
  # gh accepts the inherited repository flag before the subcommand: gh pr -R o/r merge 12 -s.
  while (( $# )) && [[ "$1" != "merge" ]]; do
    case "$1" in
      -R|--repo) merge_repo=(--repo "${2:-}"); shift 2 || return 1 ;;
      --repo=*) merge_repo=(--repo "${1#--repo=}"); shift ;;
      -R?*) merge_repo=(--repo "${1#-R}"); shift ;;
      *) return 1 ;;
    esac
  done
  (( $# )) || return 1
  shift
  while (( $# )); do
    arg="$1"; shift
    case "$arg" in
      -s|--squash) merge_squash=1 ;;
      --disable-auto) merge_disable_auto=1 ;;
      -b|--body|-F|--body-file) merge_body=1; shift || true ;;
      --body=*|--body-file=*) merge_body=1 ;;
      -R|--repo) merge_repo=(--repo "${1:-}"); shift || true ;;
      --repo=*) merge_repo=(--repo "${arg#--repo=}") ;;
      -t|--subject|-A|--author-email|--match-head-commit) shift || true ;;
      --) [[ -z "$merge_selector" ]] && merge_selector="${1:-}"; break ;;
      -[!-]?*)
        # A cluster of short flags (-sd, -sb msg, -Ro/r): read it letter by letter.
        local i=1 c
        while (( i < ${#arg} )); do
          c="${arg:i:1}"
          case "$c" in
            s) merge_squash=1 ;;
            b|F|R|t|A)
              [[ "$c" == b || "$c" == F ]] && merge_body=1
              if (( i + 1 < ${#arg} )); then
                [[ "$c" == R ]] && merge_repo=(--repo "${arg:i+1}")
              else
                [[ "$c" == R ]] && merge_repo=(--repo "${1:-}")
                shift || true
              fi
              break ;;
          esac
          i=$((i + 1))
        done ;;
      -*) ;;
      *) [[ -z "$merge_selector" ]] && merge_selector="$arg" ;;
    esac
  done
  return 0
}

# Codex reviews arrive minutes after a PR opens, and agents merged without reading them: on
# 2026-10-15, dotfiles#465 merged 22 s after it opened while its review ran, and the review's two
# P2 findings landed 6 minutes after the merge. Of the 42 completed Codex reviews on dotfiles from
# 2026-10-11 to 10-15, 20 finished after their PR merged.
# Before a merge (or --auto), one GraphQL query reads the PR's head, review threads and comments:
# - a review thread a Codex reviewer started, unresolved and with no reply from a non-bot account,
#   refuses the merge and names the finding;
# - a Codex Review Summary showing a review running on the head waits up to GH_DREW_REVIEW_WAIT
#   seconds, re-reading once a minute, then refuses (exit 75: merge again once it finishes);
# - a PR that opened or turned ready under 30 s ago with no Codex comment yet waits for the rest of
#   those 30 s: Codex posts its summary 12 s (median) to 16 s (90th percentile) after either, and 9
#   of 44 dotfiles reviews from 10-11 to 10-15 started after a merge made 3 to 12 s after it;
# - no Codex comment, a usage-limit comment, a failed review, or a completed review with every
#   finding answered carries on.
# The default wait is 600 s: those 42 reviews took 232 s at the median and 603 s at the 90th
# percentile from start to finish, and a merge comes at least one gate after the review starts.
# GH_DREW_REVIEW_OVERRIDE=<reason> merges without the check; the reason is logged. A host-wide override is the
# file ~/.config/gh-drew/review-override (GH_DREW_REVIEW_OVERRIDE_FILE): while it exists and is not empty, its
# first line is the reason for every merge on the host. Drew, 2026-10-17, with the Codex seats full: "keep
# merging no more codex review ... time to just merge and yolo". Deleting the file restores the check. Reads that fail
# refuse. GraphQL draws on no core quota, so cap_reads and guard_reads never count these reads.
# The same read asks merge-on-green, which owns the rule, whether the PR's author holds it (the hold
# label, or a hold phrase such as "merge only after the pre-deploy check below"). A held PR is refused,
# override or not: on 2026-10-17 a lane hand-merged #11312, which merge-on-green had skipped for six hours,
# before the pre-deploy check its body names was shown. GH_DREW_PRECONDITIONS_SHOWN=<evidence> merges a
# held PR once every precondition is shown true; the evidence is logged.
review_wait="${GH_DREW_REVIEW_WAIT:-600}"
merge_on_green="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/merge-on-green"
read -r -d '' review_query <<'GRAPHQL' || true
fragment pr on PullRequest {
  url headRefOid createdAt body labels(first: 20) { nodes { name } }
  timelineItems(itemTypes: [READY_FOR_REVIEW_EVENT], last: 1) { nodes { ... on ReadyForReviewEvent { createdAt } } }
  reviewThreads(first: 100) { nodes { isResolved isOutdated path line originalLine
    comments(first: 50) { nodes { author { __typename login } body url } } } }
  comments(first: 100) { nodes { author { login } body } }
}
GRAPHQL
# Prints "pr <url> <head>", "held <reason>" when merge-on-green says the author holds the PR,
# then "finding <path:line> <title> <url>" for each unanswered Codex thread, "running <review> <commit>" for each Codex review running on the head, and
# "pending <seconds left> <seconds since>" while a just-opened or just-ready PR has no Codex comment.
read -r -d '' review_reader <<'PY' || true
import json, re, subprocess, sys
from datetime import datetime, timezone
text = sys.stdin.read()
answer = json.loads(text)
if answer.get("errors"):
    sys.exit("GitHub answered: " + "; ".join(e.get("message", "?") for e in answer["errors"])[:300])
repo = (answer.get("data") or {}).get("repository")
if not repo:
    sys.exit("GitHub returned no repository")
pr = repo.get("pullRequest")
if pr is None and repo.get("pullRequests") is not None:
    found = repo["pullRequests"]["nodes"]
    if len(found) != 1:
        sys.exit(f"{len(found)} open pull requests have this head branch; name the PR number")
    pr = found[0]
if not pr:
    sys.exit("GitHub returned no such pull request")
head = pr["headRefOid"]
codex = lambda actor: "codex" in ((actor or {}).get("login") or "").lower()
clean = lambda s: re.sub(r"\s+", " ", s).strip()
print("pr", pr["url"], head, sep="\t")
held = subprocess.run([sys.executable, sys.argv[1], "hold"], input=text, capture_output=True, text=True)
if held.returncode == 1:
    print("held", clean(held.stdout), sep="\t")
elif held.returncode != 0:
    sys.exit("cannot ask merge-on-green whether the PR is held: " + clean(held.stderr or held.stdout)[:200])
for thread in pr["reviewThreads"]["nodes"]:
    said = thread["comments"]["nodes"]
    if thread["isResolved"] or not said or not codex(said[0]["author"]):
        continue
    if any(c["author"] and c["author"]["__typename"] != "Bot" for c in said[1:]):
        continue
    line = thread["line"] or thread["originalLine"]
    where = thread["path"] + (f":{line}" if line else "") + (" (outdated)" if thread["isOutdated"] else "")
    title = next((l for l in said[0]["body"].splitlines() if l.strip()), "")
    title = re.sub(r"!\[([^\]]*?)(?: Badge)?\]\([^)]*\)", r"\1", title)
    title = clean(re.sub(r"<[^>]+>|\*\*|__", "", title))[:160]
    print("finding", where, title, said[0]["url"], sep="\t")
running = set()
for comment in pr["comments"]["nodes"]:
    body = comment["body"] or ""
    if not codex(comment["author"]) or "codex-pull-request-review-summary" not in body:
        continue
    # The summary carries this state while a review runs or after it fails, and drops it once
    # the review completes (dotfiles#464 and #465, 2026-10-15).
    state = re.search(r"codex-review-state:v1 (\{.*?\}) -->", body)
    try:
        for review, s in (json.loads(state.group(1)) if state else {}).items():
            if s and s.get("status") in ("running", "queued", "pending", "in_progress") and s.get("commit_sha") == head:
                running.add((review.replace("_", " "), head[:7]))
    except (ValueError, AttributeError):
        pass
for review, commit in sorted(running):
    print("running", review, commit, sep="\t")
moments = [pr.get("createdAt")] + [n.get("createdAt") for n in ((pr.get("timelineItems") or {}).get("nodes") or []) if n]
moments = [datetime.fromisoformat(m.replace("Z", "+00:00")) for m in moments if m]
if moments and not running and not any(codex(c["author"]) for c in pr["comments"]["nodes"]):
    since = max(0, int((datetime.now(timezone.utc) - max(moments)).total_seconds()))
    if since < 30:
        print("pending", 30 - since, since, sep="\t")
PY

# Reads the PR that parse_pr_merge named; prints review_reader's lines.
review_state() {
  local token="$1" sel="$merge_selector" repo="${merge_repo[1]:-}" rest json
  local -a vars=()
  if [[ "$sel" =~ ^https?://[^/]+/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    vars=(-f "owner=${BASH_REMATCH[1]}" -f "name=${BASH_REMATCH[2]}")
    sel="${BASH_REMATCH[3]}"
  elif [[ -n "$repo" ]]; then
    # -R takes [HOST/]OWNER/REPO or a URL.
    repo="${repo#*://}"; repo="${repo%.git}"; repo="${repo%/}"; rest="${repo%/*}"
    vars=(-f "owner=${rest##*/}" -f "name=${repo##*/}")
  else
    # gh fills these from the current repository (or GH_REPO), as `gh pr merge` does.
    vars=(-F "owner={owner}" -F "name={repo}")
  fi
  sel="${sel#\#}"
  if [[ "$sel" =~ ^[0-9]+$ ]]; then
    vars+=(-F "number=$sel" -f "query=query(\$owner: String!, \$name: String!, \$number: Int!) {
  repository(owner: \$owner, name: \$name) { pullRequest(number: \$number) { ...pr } } }
$review_query")
  else
    if [[ -n "$sel" ]]; then vars+=(-f "branch=${sel#*:}"); else vars+=(-F "branch={branch}"); fi
    vars+=(-f "query=query(\$owner: String!, \$name: String!, \$branch: String!) {
  repository(owner: \$owner, name: \$name) { pullRequests(headRefName: \$branch, states: OPEN, first: 2) { nodes { ...pr } } } }
$review_query")
  fi
  json="$(GH_TOKEN="$token" gh api graphql "${vars[@]}")" || return 1
  printf '%s' "$json" | python3 -I -c "$review_reader" "$merge_on_green"
}

review_guard() {
  local token="$1"; shift
  parse_pr_merge "$@" || return 0
  (( ! merge_disable_auto )) || return 0
  local override="${GH_DREW_REVIEW_OVERRIDE:-}" override_file="${GH_DREW_REVIEW_OVERRIDE_FILE:-$HOME/.config/gh-drew/review-override}"
  if [[ -z "$override" && -s "$override_file" ]]; then
    IFS= read -r override < "$override_file" || true
    override="${override:-host override file $override_file}"
  fi
  local shown="${GH_DREW_PRECONDITIONS_SHOWN:-}"
  shown="${shown//[$'\t\n\r']/ }"
  if [[ ! "$review_wait" =~ ^[0-9]+$ ]]; then
    echo "gh-drew: GH_DREW_REVIEW_WAIT must be whole seconds, got '$review_wait'" >&2
    exit 2
  fi
  local start=$SECONDS out err kind a b c url head elapsed why told="" pending since nap held logged_shown=0
  local -a findings running
  err="$(mktemp)"
  while :; do
    findings=() running=() url="" head="" pending="" since="" held=""
    if ! out="$(review_state "$token" 2>"$err")"; then
      log_call refused "$@"
      echo "gh-drew: refusing to merge: cannot read the PR's reviews: $(tr '\n' ' ' <"$err" | cut -c1-300)" >&2
      echo "Merge again once GitHub answers, or override with GH_DREW_REVIEW_OVERRIDE=<reason>." >&2
      rm -f "$err"
      exit 1
    fi
    while IFS=$'\t' read -r kind a b c; do
      case "$kind" in
        pr) url="$a" head="$b" ;;
        finding) findings+=("  $a  $b"$'\n'"    $c") ;;
        running) running+=("$a of ${b}") ;;
        pending) pending="$a" since="$b" ;;
        held) held="$a" ;;
      esac
    done <<<"$out"
    reviewed_url="$url" reviewed_head="$head"
    if [[ -n "$held" && -z "$shown" ]]; then
      log_call refused "$@"
      echo "gh-drew: refusing to merge $url: its author holds it ($held)." >&2
      echo "Show every precondition its body names is true, then merge with GH_DREW_PRECONDITIONS_SHOWN=<evidence>." >&2
      rm -f "$err"
      exit 1
    fi
    if [[ -n "$held" ]] && (( ! logged_shown )); then
      log_call "preconditions-shown: ${shown:0:200}" "$@"
      echo "gh-drew: merging a held PR ($held); preconditions shown: $shown" >&2
      logged_shown=1
    fi
    if [[ -n "$override" ]]; then
      local reason="${override//[$'\t\n\r']/ }"
      log_call "review-override: ${reason:0:200}" "$@"
      echo "gh-drew: merging without the Codex review check: $reason" >&2
      rm -f "$err"
      return 0
    fi
    if (( ${#findings[@]} )); then
      log_call refused "$@"
      {
        echo "gh-drew: refusing to merge $url: ${#findings[@]} Codex review finding(s) have no answer:"
        printf '%s\n' "${findings[@]}"
        echo "For each, fix it and reply on the thread with the commit, reply with the evidence that it"
        echo "does not apply, or resolve the thread. Then merge again."
        echo "Override: GH_DREW_REVIEW_OVERRIDE=<reason>"
      } >&2
      rm -f "$err"
      exit 1
    fi
    nap=60
    if (( ${#running[@]} )); then
      why="Codex ${running[*]} is running"
    elif [[ -n "$pending" ]]; then
      why="no Codex comment yet, ${since}s after the PR opened or turned ready"
      nap="$pending"
    else
      break
    fi
    elapsed=$((SECONDS - start))
    if (( elapsed >= review_wait )); then
      log_call refused "$@"
      echo "gh-drew: refusing to merge $url: $why (waited ${elapsed}s, GH_DREW_REVIEW_WAIT=$review_wait)." >&2
      echo "Merge again once Codex answers, or override with GH_DREW_REVIEW_OVERRIDE=<reason>." >&2
      rm -f "$err"
      exit 75
    fi
    (( review_wait - elapsed > nap )) || nap=$((review_wait - elapsed))
    if [[ "$why" != "$told" ]]; then
      echo "gh-drew: waiting up to $(( ${#running[@]} ? review_wait : nap ))s to merge $url: $why." >&2
      told="$why"
    fi
    sleep "$nap"
  done
  rm -f "$err"
}

# Release-path repos merge only on the gate's own receipt. On 2026-10-18 01:39Z discovery-lab#2009 merged
# through a lane script that recorded exit=0 for gate beelink2-b1b7743870eff2dc7da8260d77e65fcd, whose receipt
# says exit=1 (the script's own quoting failed); earlier agent-runtime#1818 merged on a subset gate that never
# ran its src/ tests and turned the Runtime release red. So a `pr merge`, or an `api -X PUT
# repos/<o>/<r>/pulls/<n>/merge`, of a repo below needs: the merge pinned to the PR's head
# (--match-head-commit <head>, or -f sha=<head>), and a beelink-gate receipt for that head (read from the
# beelinks by `beelink-gate --receipt`) with exit 0, mode install and class normal. Any command counts: Drew's
# merge model (AGENTS.md, 2026-10-18) is a fast gate on the integration tests a change touches, then merge, with the
# full suite after merge; the Lab's full `pnpm test` failed a different unrelated test on 3 of 4 gates that night
# (shared /tmp fixtures, OOM timing under load), blocking merges without catching a bug. Under `beelink-gate --merge`, BEELINK_GATE_ID names the gate and that receipt must be the one.
# The review override does not reach this check, and nothing overrides it.
reviewed_url="" reviewed_head=""
declare -A gated_repos=([tangle-network/discovery-lab]="*" [tangle-network/agent-runtime]="*")
beelink_gate="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/beelink-gate"

# Reads `beelink-gate --receipt` rows on stdin; prints "pass" or "fail", then one line per receipt with
# what keeps it from counting. argv: the accepted commands joined by "|" ("*" accepts any), and the required gate id or "".
read -r -d '' receipt_reader <<'PY' || true
import json, sys
commands, gate_id = sys.argv[1].split("|"), sys.argv[2]
rows, passed = [], False
for line in sys.stdin:
    try:
        r = json.loads(line)
    except ValueError:
        continue
    g = r.get
    why = []
    if g("exit") != 0:
        why.append("exit %s" % g("exit"))
    if g("mode") != "install":
        why.append("mode %s" % g("mode"))
    if g("class") != "normal":
        why.append("class %s" % g("class"))
    if "*" not in commands and g("command") not in commands:
        why.append("not the full test command")
    if gate_id and g("gate_id") != gate_id:
        why.append("not gate %s" % gate_id)
    passed = passed or not why
    rows.append("  %s %s exit=%s mode=%s class=%s command=%s  <- %s" % (g("gate_id"), g("at"), g("exit"), g("mode"), g("class"),
                str(g("command"))[:120], ", ".join(why) or "passes"))
print("pass" if passed else "fail")
print("\n".join(rows))
PY

receipt_refuse() {  # <exit code> <message lines>...
  local rc="$1"; shift
  log_call refused "${receipt_args[@]}"
  printf '%s\n' "$@" >&2
  exit "$rc"
}

receipt_guard() {
  local token="$1"; shift
  local -a receipt_args=("$@")
  local owner="" name="" number="" head="" pinned="" how="" a b prev="" method="" path="" out rows rc i
  if [[ "${1-}" == pr ]]; then
    parse_pr_merge "$@" || return 0
    (( ! merge_disable_auto )) || return 0
    for a in "$@"; do
      if [[ "$prev" == --match-head-commit ]]; then pinned="$a"; fi
      if [[ "$a" == --match-head-commit=* ]]; then pinned="${a#*=}"; fi
      prev="$a"
    done
    how="--match-head-commit <head>"
    # review_guard, which runs first, has read the PR's URL and head; a second read would cost every merge a call.
    path="$reviewed_url" head="$reviewed_head"
    [[ "$path" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]] || return 0
    owner="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}" number="${BASH_REMATCH[3]}"
  elif [[ "${1-}" == api ]]; then
    shift
    prev=""
    for a in "$@"; do
      case "$prev" in
        -X|--method) method="${a^^}" ;;
        -f|-F|--field|--raw-field) if [[ "$a" == sha=* ]]; then pinned="${a#sha=}"; fi ;;
      esac
      case "$a" in
        -X?*) method="${a#-X}"; method="${method^^}" ;;
        --method=*) method="${a#--method=}"; method="${method^^}" ;;
        -fsha=*|-Fsha=*) pinned="${a#-?sha=}" ;;
        --field=sha=*|--raw-field=sha=*) pinned="${a#*=sha=}" ;;
        -*) ;;
        *) if [[ "${a#/}" =~ ^repos/[^/]+/[^/]+/pulls/[0-9]+/merge/?$ ]]; then path="${a#/}"; fi ;;
      esac
      prev="$a"
    done
    [[ "$method" == PUT && "$path" =~ ^repos/([^/]+)/([^/]+)/pulls/([0-9]+)/merge/?$ ]] || return 0
    owner="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}" number="${BASH_REMATCH[3]}"
    [[ -n "${gated_repos[$owner/$name]:-}" ]] || return 0
    how="-f sha=<head>"
    head="$(GH_TOKEN="$token" gh api "repos/$owner/$name/pulls/$number" --jq .head.sha 2>&1)" \
      || receipt_refuse 1 "gh-drew: refusing to merge $owner/$name#$number: cannot read its head: ${head:0:300}"
  else
    return 0
  fi
  local commands="${gated_repos[$owner/$name]:-}"
  [[ -n "$commands" ]] || return 0
  local pr="https://github.com/$owner/$name/pull/$number"
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] || receipt_refuse 1 "gh-drew: refusing to merge $pr: cannot read its head commit (got '${head:0:80}')."
  [[ "$pinned" == "$head" ]] || receipt_refuse 1 \
    "gh-drew: refusing to merge $pr: a release-path merge is pinned to the head its gate ran on;" \
    "name it with $how (head is $head${pinned:+, the call names $pinned})."
  local err; err="$(mktemp)"
  rc=0
  rows="$("$beelink_gate" --receipt "https://github.com/$owner/$name" "$head" 2>"$err")" || rc=$?
  if (( rc != 0 && rc != 1 )); then
    local why; why="$(tr '\n' ' ' <"$err" | cut -c1-300)"; rm -f "$err"
    receipt_refuse 75 "gh-drew: refusing to merge $pr: cannot read the beelinks' gate receipts for $head (exit $rc): $why"
  fi
  out="$(printf '%s\n' "$rows" | python3 -I -c "$receipt_reader" "$commands" "${BEELINK_GATE_ID:-}")"
  if [[ "${out%%$'\n'*}" != pass ]]; then
    local found="${out#*$'\n'}"; [[ "$out" == *$'\n'* ]] || found=""
    # One passing receipt is enough; a beelink left unread may hold it, so no pass with a host unread is not "none".
    # Under --merge only the named gate's receipt counts, so once that row is read an unread host cannot change
    # the verdict: on 2026-10-18 discovery-lab#2078 refused with "could not read beelink2's receipts" first,
    # and the lane waited for beelink2 while its beelink1 receipt said mode no-install.
    if [[ -s "$err" ]] && ! { [[ -n "${BEELINK_GATE_ID:-}" ]] && grep -qF "  $BEELINK_GATE_ID " <<<"$found"; }; then
      local why; why="$(tr '\n' ' ' <"$err" | cut -c1-300)"; rm -f "$err"
      receipt_refuse 75 "gh-drew: refusing to merge $pr: no receipt read so far passes on $head, and $why" "Receipts read: ${found:-none}"
    fi
    rm -f "$err"
    receipt_refuse 1 \
      "gh-drew: refusing to merge $pr: no beelink-gate receipt shows a gate passed on head $head in mode install, class normal${BEELINK_GATE_ID:+, as gate $BEELINK_GATE_ID}." \
      "Receipts for this head: ${found:+$'\n'}${found:-none}" \
      "Gate the head on the integration tests it touches: beelink-gate --merge $number auto https://github.com/$owner/$name.git $head -- <tests>"
  fi
  rm -f "$err"
  log_call "gate-receipt: $head" "$@"
}

# A squash merge without an explicit body lets GitHub write the message, and
# GitHub then appends "Co-authored-by:" for every PR commit whose author email
# is not verified on the merging account (agents commit as unverified tangle
# addresses). An explicit --body replaces that message, so a `pr merge
# --squash` that names no body gets one: the PR title and the first prose
# paragraph of its description, with trailer and generator lines removed.
squash_body=()
add_squash_body() {
  local token="$1"; shift
  parse_pr_merge "$@" || return 0
  (( merge_squash && ! merge_body )) || return 0
  local view=(pr view) title description summary
  [[ -n "$merge_selector" ]] && view+=("$merge_selector")
  view+=(${merge_repo[@]+"${merge_repo[@]}"})
  title="$(GH_TOKEN="$token" gh "${view[@]}" --json title --jq .title)" || {
    echo "gh-drew: cannot read the PR title to write the squash body; pass --body explicitly" >&2
    exit 2
  }
  description="$(GH_TOKEN="$token" gh "${view[@]}" --json body --jq .body)" || description=""
  summary="$(printf '%s\n' "$description" | tr -d '\r' | awk '
    /^[[:space:]]*```/ { fence = !fence; next }
    fence { next }
    /^[[:space:]]*$/ { if (n) exit; next }
    /^[[:space:]]*#/ || /^[[:space:]]*[A-Za-z-]+-[Bb]y:/ || /Generated with \[/ || /^[[:space:]]*<!--/ || /^[[:space:]]*\|/ { if (n) exit; next }
    { sub(/^[[:space:]]+/, ""); sub(/^[-*][[:space:]]+/, ""); printf "%s%s", (n ? " " : ""), $0; n++ }
  ' | cut -c1-600)"
  local message="$title"
  [[ -n "$summary" ]] && message+=$'\n\n'"$summary"
  squash_body=(--body "$(with_lane_line "$message")")
}

# Lane provenance: a PR body or squash message gh-drew writes ends with the run that made it, so a
# merge can be traced to its lane (hills merges-lane-attributed reads "Run ID:" / "Session:" lines;
# on 2026-10-12 0 of 656 merged PRs carried one). This names a run, not an author: no trailers.
lane_line() {
  if [[ -n "${TANGLE_RUN_ID:-}" ]]; then
    printf 'Run ID: %s' "$TANGLE_RUN_ID"
  elif [[ -n "${TANGLE_CLAUDE_SESSION:-}" ]]; then
    printf 'Session: %s' "$TANGLE_CLAUDE_SESSION"
  fi
}

# The same line shape the hills collector matches (hills/collectors.py LANE_MARK).
has_lane_mark() {
  grep -qiE '^[[:space:]]*[*_`]*[[:space:]]*(lane|fleet lane|run[ -]?id|session)[[:space:]]*[*_`]*[[:space:]]*:[[:space:]]*[^[:space:]]' <<<"$1"
}

with_lane_line() {
  local body="$1" line
  line="$(lane_line)"
  if [[ -z "$line" ]] || has_lane_mark "$body"; then
    printf '%s' "$body"
    return
  fi
  while [[ "$body" == *$'\n' ]]; do body="${body%$'\n'}"; done
  if [[ -n "$body" ]]; then printf '%s\n\n%s\n' "$body" "$line"; else printf '%s\n' "$line"; fi
}

# Rewrite the body of `pr create` / `pr edit` to carry the lane line. A --body-file is read (stdin
# for "-") and passed as --body so no temp file outlives the exec. A `pr create --fill` with no
# body has no text until gh writes it, so fill_patch asks main to add the line after creation.
lane_args=()
fill_patch=0
# Read a body file (stdin for "-") into lane_text, keeping its trailing newlines; fail when it can't be read.
lane_text=""
read_body_file() {
  local raw
  if [[ "$1" == "-" ]]; then raw="$(cat && printf x)" || return 1; else raw="$(cat -- "$1" && printf x)" || return 1; fi
  lane_text="${raw%x}"
}
add_lane_line() {
  lane_args=("$@")
  [[ -n "$(lane_line)" ]] || return 0
  local -a a=("$@") out=()
  local i=0 n=$#
  # gh accepts its inherited repo flag before `pr` as well as after it.
  while (( i < n )); do
    case "${a[i]}" in
      -R|--repo) (( i + 1 < n )) || return 0; out+=("${a[i]}" "${a[i+1]}"); i=$((i + 2)) ;;
      --repo=*|-R?*) out+=("${a[i]}"); i=$((i + 1)) ;;
      *) break ;;
    esac
  done
  [[ "${a[i]:-}" == pr ]] || return 0
  out+=(pr); i=$((i + 1))
  while (( i < n )); do
    case "${a[i]}" in
      -R|--repo) out+=("${a[i]}" "${a[i+1]:-}"); i=$((i + 2)) ;;
      --repo=*|-R?*) out+=("${a[i]}"); i=$((i + 1)) ;;
      *) break ;;
    esac
  done
  (( i < n )) || return 0
  local sub="${a[i]}" saw_body=0 saw_fill=0 tok k c rest
  [[ "$sub" == "create" || "$sub" == "edit" ]] || return 0
  out+=("$sub"); i=$((i + 1))
  while (( i < n )); do
    tok="${a[i]}"
    case "$tok" in
      --) out+=("${a[@]:i}"); i=$n; break ;;
      -b|--body)
        (( i + 1 < n )) || return 0
        out+=("$tok" "$(with_lane_line "${a[i+1]}")"); saw_body=1; i=$((i + 2)) ;;
      --body=*)
        out+=("--body=$(with_lane_line "${tok#--body=}")"); saw_body=1; i=$((i + 1)) ;;
      -F|--body-file)
        (( i + 1 < n )) || return 0
        read_body_file "${a[i+1]}" || return 0
        out+=(--body "$(with_lane_line "$lane_text")"); saw_body=1; i=$((i + 2)) ;;
      --body-file=*)
        read_body_file "${tok#--body-file=}" || return 0
        out+=(--body "$(with_lane_line "$lane_text")"); saw_body=1; i=$((i + 1)) ;;
      --fill|--fill-first|--fill-verbose) saw_fill=1; out+=("$tok"); i=$((i + 1)) ;;
      -[!-]*)
        # Short flags, alone or clustered (-df, -bText, -Ffile, -dFfile): flags without a value are
        # d e f w; any other letter takes the rest of the token, or the next argument, as its value.
        k=1; local prefix="-" handled=0
        while (( k < ${#tok} )); do
          c="${tok:k:1}"
          case "$c" in
            f) saw_fill=1; prefix+="$c"; k=$((k + 1)) ;;
            d|e|w) prefix+="$c"; k=$((k + 1)) ;;
            b|F)
              rest="${tok:k+1}"
              local value consumed=0
              if [[ -n "$rest" ]]; then value="$rest"; else (( i + 1 < n )) || return 0; value="${a[i+1]}"; consumed=1; fi
              if [[ "$c" == F ]]; then read_body_file "$value" || return 0; value="$lane_text"; fi
              [[ "$prefix" != "-" ]] && out+=("$prefix")
              out+=(--body "$(with_lane_line "$value")")
              saw_body=1; handled=1; i=$((i + 1 + consumed)); break ;;
            *) break ;;  # another value-taking flag: the token, and any separate value after it, pass through
          esac
        done
        (( handled )) || { out+=("$tok"); i=$((i + 1)); } ;;
      *) out+=("$tok"); i=$((i + 1)) ;;
    esac
  done
  lane_args=("${out[@]}")
  [[ "$sub" == "create" && $saw_body -eq 0 && $saw_fill -eq 1 ]] && fill_patch=1
  return 0
}

# After `pr create --fill`, append the lane line to the body gh wrote. The create's own output
# and exit status are what the caller sees.
run_create_with_fill_patch() {
  local token="$1"; shift
  local out status url body
  status=0
  out="$(GH_TOKEN="$token" gh "$@")" || status=$?
  [[ -n "$out" ]] && printf '%s\n' "$out"
  (( status == 0 )) || return "$status"
  url="$(grep -oE 'https://github\.com/[^[:space:]]+/pull/[0-9]+' <<<"$out" | tail -n 1)" || url=""
  [[ -n "$url" ]] || return 0
  if [[ -n "$pr_wip_ledger" ]]; then
    mkdir -p "$pr_wip_dir"
    printf '%s\tcreated\t%s\n' "$(date -u +%FT%TZ)" "$url" >>"$pr_wip_ledger"
  fi
  body="$(GH_TOKEN="$token" gh pr view "$url" --json body --jq .body)" || return 0
  has_lane_mark "$body" && return 0
  GH_TOKEN="$token" gh pr edit "$url" --body "$(with_lane_line "$body")" >/dev/null || \
    echo "gh-drew: created $url but could not add its lane line" >&2
  return 0
}

# The body goes before a `--`, after which gh reads only positionals.
final_args=()
with_squash_body() {
  local a inserted=0
  for a in "$@"; do
    if [[ "$a" == "--" && $inserted -eq 0 ]]; then
      final_args+=(${squash_body[@]+"${squash_body[@]}"})
      inserted=1
    fi
    final_args+=("$a")
  done
  (( inserted )) || final_args+=(${squash_body[@]+"${squash_body[@]}"})
}

# One open PR per fleet lane (ops-board #10097). Lanes opened PRs faster than
# signoff could land them (5.7/h in vs 3.25/h merged on 2026-10-12), so a lane
# with an open PR is refused another `pr create`. Fleet stamps a stable key
# from the claimed project, shared by helpers, new runs, and operator handoffs.
# Older sessions retain their run-id key; a shell with no lane id is not limited.
# Each lane's ledger lists the PRs it created; only those are read, read-only.
# gh-read cannot see Drew's personal private repos, so a state it returns empty
# is read once with the drewstone token via a plain `gh pr view` (a read; it
# never re-enters this script). Unreadable by both refuses rather than admits.
pr_wip_dir="${GH_DREW_PR_WIP_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet/pr-wip}"
pr_wip_key="${TANGLE_PR_WIP_KEY:-${TANGLE_ROOT_RUN_ID:-${TANGLE_RUN_ID:-}}}"
pr_wip_ledger=""
pr_wip_args=("$@")
pr_wip_pos=0
pr_wip_is_pr=0
while (( pr_wip_pos < ${#pr_wip_args[@]} )); do
  case "${pr_wip_args[pr_wip_pos]}" in
    -R|--repo) pr_wip_pos=$((pr_wip_pos + 2)) ;;
    --repo=*|-R?*) pr_wip_pos=$((pr_wip_pos + 1)) ;;
    *) break ;;
  esac
done
if [[ "${pr_wip_args[pr_wip_pos]:-}" == pr ]]; then
  pr_wip_is_pr=1
  pr_wip_pos=$((pr_wip_pos + 1))
  while (( pr_wip_pos < ${#pr_wip_args[@]} )); do
    case "${pr_wip_args[pr_wip_pos]}" in
      -R|--repo) pr_wip_pos=$((pr_wip_pos + 2)) ;;
      --repo=*|-R?*) pr_wip_pos=$((pr_wip_pos + 1)) ;;
      *) break ;;
    esac
  done
fi
if (( pr_wip_is_pr )) && [[ "${pr_wip_args[pr_wip_pos]:-}" == create && -n "$pr_wip_key" ]]; then
  if [[ ! "$pr_wip_key" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "gh-drew: invalid fleet PR WIP key" >&2
    exit 2
  fi
  pr_wip_ledger="$pr_wip_dir/$pr_wip_key.tsv"
  mkdir -p "$pr_wip_dir"
  # Keep the check, GitHub create, and ledger write in one local critical
  # section. A crashed creator leaves the lock in place and fails closed.
  pr_wip_lock="$pr_wip_dir/$pr_wip_key.lock"
  pr_wip_locked=0
  for (( pr_wip_wait=0; pr_wip_wait<600; pr_wip_wait++ )); do
    if mkdir "$pr_wip_lock" 2>/dev/null; then
      pr_wip_locked=1
      trap 'rmdir "$pr_wip_lock"' EXIT
      break
    fi
    sleep 0.1
  done
  if (( ! pr_wip_locked )); then
    echo "gh-drew: PR create for lane $pr_wip_key is locked ($pr_wip_lock); inspect the creator before clearing it" >&2
    exit 1
  fi
fi

pr_wip_guard() {
  local token="$1"
  [[ -n "$pr_wip_ledger" && -s "$pr_wip_ledger" ]] || return 0
  if [[ -n "${PR_WIP_OVERRIDE:-}" ]]; then
    printf '%s\toverride\t%s\n' "$(date -u +%FT%TZ)" "$PR_WIP_OVERRIDE" >>"$pr_wip_ledger"
    return 0
  fi
  local _when kind url state
  while IFS=$'\t' read -r _when kind url; do
    [[ "$kind" == created && -n "$url" ]] || continue
    state="$("${GH_DREW_PR_WIP_READER:-gh-read}" pr view "$url" --json state --jq .state 2>/dev/null || true)"
    if [[ -z "$state" ]]; then
      state="$(GH_TOKEN="$token" gh pr view "$url" --json state --jq .state 2>/dev/null || true)"
    fi
    [[ "$state" == MERGED || "$state" == CLOSED ]] && continue
    echo "pr create refused: lane $pr_wip_key already has open PR $url (state: ${state:-unreadable}); land or close it first (ops-board #10097). Override: PR_WIP_OVERRIDE=<reason>" >&2
    exit 1
  done <"$pr_wip_ledger"
}

# `pr create` in a lane runs gh as a child so the new PR's URL joins the ledger.
run_gh() {
  local token="$1" rc out url
  if [[ -z "$pr_wip_ledger" ]]; then
    exec env GH_TOKEN="$token" gh ${final_args[@]+"${final_args[@]}"}
  fi
  out="$(mktemp)"
  env GH_TOKEN="$token" gh ${final_args[@]+"${final_args[@]}"} | tee "$out"
  rc=${PIPESTATUS[0]}
  if (( rc == 0 )); then
    url="$(grep -oE 'https://github\.com/[^/[:space:]]+/[^/[:space:]]+/pull/[0-9]+' "$out" | head -1)" || url=""
    if [[ -n "$url" ]]; then
      mkdir -p "$pr_wip_dir"
      printf '%s\tcreated\t%s\n' "$(date -u +%FT%TZ)" "$url" >>"$pr_wip_ledger"
    fi
  fi
  rm -f "$out"
  exit "$rc"
}

# GH_DREW_TOKEN_KEYS names other keys for a wrapper that runs as another login (gh-read).
read -r -a token_keys <<< "${GH_DREW_TOKEN_KEYS:-DREW_GH_TOKEN DREWSTONE_GH_TOKEN GH_TOKEN}"

for key in "${token_keys[@]}"; do
  token="${!key-}"
  login="$(try_token "$token" || true)"

  if [[ "$login" == "$expected_login" ]]; then
    pr_wip_guard "$token"
    cap_reads "$@"
    guard_reads "$token" "$@"
    review_guard "$token" "$@"
    receipt_guard "$token" "$@"
    add_squash_body "$token" "$@"
    log_call called "$@"
    add_lane_line "$@"
    with_squash_body ${lane_args[@]+"${lane_args[@]}"}
    if (( fill_patch )); then run_create_with_fill_patch "$token" "${final_args[@]}"; exit $?; fi
    run_gh "$token"
  fi
done

for key in "${token_keys[@]}"; do
  token="$(read_secret "$key")"
  login="$(try_token "$token" || true)"

  if [[ "$login" == "$expected_login" ]]; then
    pr_wip_guard "$token"
    cap_reads "$@"
    guard_reads "$token" "$@"
    review_guard "$token" "$@"
    receipt_guard "$token" "$@"
    add_squash_body "$token" "$@"
    log_call called "$@"
    add_lane_line "$@"
    with_squash_body ${lane_args[@]+"${lane_args[@]}"}
    if (( fill_patch )); then run_create_with_fill_patch "$token" "${final_args[@]}"; exit $?; fi
    run_gh "$token"
  fi
done

cat >&2 <<EOF
gh-drew: no valid GitHub API token for '$expected_login' found (keys: ${token_keys[*]}).

Required:
- Add DREW_GH_TOKEN to $secrets_file, or export it in the shell.
- The token must authenticate as '$expected_login'.
- It needs repository and pull request write access for the target repos.

Do not fall back to raw 'gh' for PR creation in Drew/Tangle repos; that can
silently use another configured account.
EOF
exit 2
