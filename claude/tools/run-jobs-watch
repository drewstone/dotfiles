#!/bin/bash
# run-jobs-watch [-v] <run-id> [owner/repo]: watch a GitHub Actions run at the JOB level.
# Exits 1 on the first job that concludes anything but success or skipped, and prints that job's link;
# exits 0 when the run completes, printing its conclusion; exits 2 after 5 failed reads in a row.
# A run-level watch misses a failed job while the run waits on a later one.
# Transient read errors are retried.
# --require-job <name>: only that job decides. Other failed jobs are printed but do not stop the watch;
# exit 0 when the run completes with that job a success, exit 3 otherwise. A run can conclude
# success while shipping nothing.
verbose=0; require=""
while [ $# -gt 0 ]; do case "$1" in -v) verbose=1; shift ;; --require-job) require=${2:?--require-job needs a job name}; shift 2 ;; *) break ;; esac; done
cfg="${DOTFILES_PRIVATE:-$HOME/.local/share/dotfiles-private}/claude/config/run-jobs-watch.env"; [ -r "$cfg" ] && . "$cfg"; GH=${GH_CLI:-gh}
RUN=${1:?usage: run-jobs-watch [-v] [--require-job <name>] <run-id> [owner/repo]}; R=${2:-${RUN_JOBS_WATCH_REPO:-$($GH repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)}}
[ -n "$R" ] || { echo "run-jobs-watch: pass owner/repo or run inside a GitHub checkout"; exit 2; }
seen="" fails=0
while :; do
  if ! out=$($GH api "repos/$R/actions/runs/$RUN/jobs?per_page=100" \
      --jq '.jobs[]|select(.status=="completed")|"\(.id)\t\(.conclusion)\t\(.name)"' 2>/dev/null); then
    fails=$((fails + 1)); (( fails < 5 )) || { echo "run-jobs-watch: 5 failed reads of run $RUN"; exit 2; }
    sleep 60; continue
  fi
  fails=0
  while IFS=$'\t' read -r id conclusion name; do
    [ -n "$id" ] || continue
    case " $seen " in *" $id "*) continue ;; esac
    seen="$seen $id"
    case $conclusion in
      success|skipped) (( verbose )) && echo "$(date -u +%H:%MZ) ok: $name" ;;
      *) echo "$(date -u +%H:%MZ) JOB $conclusion: $name (https://github.com/$R/actions/runs/$RUN/job/$id)"
         # With --require-job only that job decides.
         if [ -z "$require" ]; then exit 1; fi
         # A job in a reusable workflow is named "<caller> / <callee>".
         if [ "$name" = "$require" ] || [ "${name%% / *}" = "$require" ]; then exit 3; fi ;;
    esac
  done <<<"$out"
  state=$($GH api "repos/$R/actions/runs/$RUN" --jq '"\(.status) \(.conclusion)"' 2>/dev/null) || state=""
  if [ "${state%% *}" = completed ]; then
    echo "$(date -u +%H:%MZ) run $RUN completed: ${state#* }"
    if [ -n "$require" ]; then
      rc=$($GH api "repos/$R/actions/runs/$RUN/jobs?per_page=100" --jq "[.jobs[]|select(.name==\"$require\" or (.name|startswith(\"$require / \")))|.conclusion][0] // \"absent\"" 2>/dev/null) || rc=unreadable
      [ "$rc" = success ] || { echo "REQUIRED JOB \"$require\": $rc (the run shipped nothing it requires)"; exit 3; }
      echo "required job \"$require\": success"
    fi
    exit 0
  fi
  sleep 60
done
