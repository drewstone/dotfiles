#!/usr/bin/env python3
"""Append checked rows to a project's climb ledger, and lint the rows already in it.

Usage:
  climb-log append [--ledger PATH] [--project DIR] [--row JSON | --file PATH] [--skip-existing]
                   check rows (an object, an array or JSON lines; stdin by default), append all or none, print their ids
  climb-log check  [--ledger PATH] [--project DIR] [--since DATE] [--json]      lint rows written at or after DATE (default 2026-10-11)
  climb-log hills  [--ledger PATH] [--project DIR] [--strict] [--json]          each hill's instrument and calibration
  climb-log schema                                                              print the measurement contract

The ledger is reports/climb/ledger.jsonl when the project has reports/climb/, else .agent/climb.jsonl
(docs/processes/climb.md#the-ledger). The project is the git toplevel of the working directory unless
--project names one.

On 2026-10-10 five reported numbers were retracted. "Coalescing p50 32,401" chose streams by finish time
and mixed code versions; a failure time was measured from its notice; a disk reclaim was estimated, not
measured. Each reached a report because nothing asked how its sample was chosen. So a row that reports a
number carries a measurement block beside it, in its baseline and its result:

  "baseline": {"value": 5.6, "measurement": {
      "metric": "first visible progress p50", "unit": "s",
      "selection": "every chat turn on b81b whose request started in the window",
      "selectBy": "start", "n": 412, "basis": "measured",
      "window": {"from": "2026-10-10T20:00:00Z", "to": "2026-10-10T22:00:00Z"},
      "codeVersion": "gtm-agent@226b2182", "deployedAt": "2026-10-10T19:41:00Z",
      "instrument": "scripts/climb/first-progress.mjs",
      "calibration": {"verdict": "PASS", "check": "tests/climb/first-progress.test.mjs",
                      "against": "20 turns timed by hand from their traces"}}}

Required of every measured side: metric, unit, selection (the rule that chose the sample, in words),
selectBy (start, finish, notice, event, sample, version or all), n (the sample size), and basis (measured,
computed from measured values, or judged by a scorer). An estimate is a prediction, not a measurement.
  - A time-based selection (start, finish, notice, event) names its window {from, to}.
  - A duration (a time unit) selects by start, or is a fixed sample: choosing by finish time keeps the
    short items and drops the long ones still running, and choosing by notice time measures detection.
  - A per-release metric names one codeVersion and selects by start, event, sample or version (each item
    records the version that served it); a live selection
    (start or event) also names deployedAt, at or before window.from, so the sample cannot reach back
    into the previous release. Per-release: the row compares a code, config, infra, model or prompt
    change; or its layer is product, agents or system; or the block sets "perRelease": true. A product,
    agents or system position over several releases (a 3-day SLO) sets "perRelease": false; a
    comparison across a change cannot.
  - A baseline row (lever "baseline") names the hill's instrument and its calibration: verdict PASS or
    FAIL with the check that compared the instrument with a known answer and that answer (against), or
    UNCALIBRATED with what would calibrate it (next). `climb-log hills` counts the hills calibrated.

A side reports a number when it holds a JSON number or a numeral in its text (dates, times, shas and
#refs are not numerals). Append-only: append never rewrites a line, and takes a lock while it writes.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import pathlib
import re
import secrets
import subprocess
import sys

POLICY_START = "2026-10-11T00:00:00Z"
REQUIRED = ("id", "project", "layer", "hill", "timestamp")
SELECT_BY = ("start", "finish", "notice", "event", "sample", "version", "all")
BASIS = ("measured", "computed", "judged")
TIMED = ("start", "finish", "notice", "event")
RELEASE_LAYERS = ("product", "agents", "system")
RELEASE_CATEGORIES = ("code", "config", "infra", "model", "prompt")
TIME_UNITS = {"ms", "millisecond", "milliseconds", "s", "sec", "secs", "second", "seconds", "min", "mins",
              "minute", "minutes", "h", "hr", "hrs", "hour", "hours", "d", "day", "days"}
VAGUE = {"", "n/a", "na", "none", "unknown", "tbd", "todo", "-", "?", "various", "mixed", "multiple", "several",
         "all", "latest", "current", "main", "master", "head", "prod", "production"}
# A numeral, not part of a word, a date, a time, a sha, a version or a #ref.
NUMERAL = re.compile(r"(?<![\w#@.:-])\d[\d,]*(?:\.\d+)?"
                     r"(?i:(?:ms|s|m|min|h|d|x|k|kb|mb|gb|tb|kib|mib|gib|tib)(?!\w))?(?![\w:-]|\.\d)")
SHA = re.compile(r"(?<![0-9a-fA-F])[0-9a-f]{7,40}(?![0-9a-fA-F])|\b(?:sha256|sha1|sha|rev):[0-9a-f]{3,}\b")
SEMVER = re.compile(r"(?<![\w.])v?\d+\.\d+(?:\.\d+)?(?:[-+][\w.]+)?(?![\w.])")
RANGE = re.compile(r"\.\.|(?<=\w)\s*(?:->|→|–)\s*(?=\w)|\bto\b|\band\b|[,;]|\s/\s")


# ---------------------------------------------------------------------------------------- reading

def parse_time(value):
    """A timezone-aware datetime from an ISO 8601 string (Z accepted), or None."""
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        when = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    return when if when.tzinfo else when.replace(tzinfo=dt.timezone.utc)


def reports_number(value):
    """True when a baseline or result holds a measured number outside its measurement block."""
    if value is None or isinstance(value, bool):
        return False
    if isinstance(value, (int, float)):
        return True
    if isinstance(value, str):
        return bool(NUMERAL.search(value))
    if isinstance(value, dict):
        return any(reports_number(v) for k, v in value.items() if k != "measurement")
    if isinstance(value, list):
        return any(reports_number(v) for v in value)
    return False


def text_value(block, key):
    value = block.get(key)
    return value.strip() if isinstance(value, str) else None


def vague(value):
    return value is None or value.lower() in VAGUE


def single_version(value):
    """None when value names exactly one release, else the reason it does not."""
    if isinstance(value, list):
        return "is a list; a per-release number comes from one release"
    if not isinstance(value, str) or vague(value.strip()):
        return "is missing or vague; name the deployed release, such as gtm-agent@226b2182"
    if RANGE.search(value):
        return f"`{value}` names a range or a set; measure each release on its own"
    if not (SHA.search(value) or SEMVER.search(value)):
        return f"`{value}` has no commit sha or version number"
    return None


# ---------------------------------------------------------------------------------------- checking

def per_release(row, block, comparison):
    if comparison:
        return True
    declared = block.get("perRelease")
    if isinstance(declared, bool):
        return declared
    return row.get("layer") in RELEASE_LAYERS or row.get("category") in RELEASE_CATEGORIES


def check_calibration(where, calibration):
    if not isinstance(calibration, dict):
        return [f"{where}.calibration is missing: a baseline names how its instrument was checked against a known "
                "answer, as {\"verdict\": \"PASS\", \"check\": \"<test or command>\", \"against\": \"<known answer>\"}, "
                "or {\"verdict\": \"UNCALIBRATED\", \"next\": \"<what would calibrate it>\"}"]
    verdict = calibration.get("verdict")
    if verdict in ("PASS", "FAIL"):
        missing = [k for k in ("check", "against") if vague(text_value(calibration, k))]
        if missing:
            return [f"{where}.calibration {verdict} needs {' and '.join(missing)}: the check that compared the "
                    "instrument with a known answer, and that answer"]
        return []
    if verdict == "UNCALIBRATED":
        if vague(text_value(calibration, "next")):
            return [f"{where}.calibration UNCALIBRATED needs next: the check that would calibrate the instrument"]
        return []
    return [f"{where}.calibration.verdict is {json.dumps(verdict)}; use PASS, FAIL or UNCALIBRATED"]


def check_side(row, side, comparison):
    """Problems with one measured side (baseline or result) of a row."""
    value = row.get(side)
    if not isinstance(value, dict):
        return [f"{side} reports a number as bare {type(value).__name__}; make it an object with the value and a "
                "measurement block (climb-log schema)"]
    block = value.get("measurement")
    if not isinstance(block, dict):
        return [f"{side} reports a number without {side}.measurement: name the metric, unit, selection rule, "
                "selectBy and n (climb-log schema)"]
    where = f"{side}.measurement"
    problems = []
    for key in ("metric", "unit", "selection"):
        if vague(text_value(block, key)):
            problems.append(f"{where}.{key} is missing or vague")
    select_by = block.get("selectBy")
    if select_by not in SELECT_BY:
        problems.append(f"{where}.selectBy is {json.dumps(select_by)}; use one of {', '.join(SELECT_BY)}: the event "
                        "whose time chose each item")
    n = block.get("n")
    if isinstance(n, bool) or not isinstance(n, int) or n < 0:
        problems.append(f"{where}.n is {json.dumps(n)}; give the sample size as a whole number")
    basis = block.get("basis")
    if basis in ("estimated", "estimate", "predicted", "assumed"):
        problems.append(f"{where}.basis is {basis}: an estimate belongs in prediction; measure the value before "
                        "recording it (on 2026-10-10 a ~7 GB disk reclaim was reported from an estimate)")
    elif basis not in BASIS:
        problems.append(f"{where}.basis is {json.dumps(basis)}; use measured, computed or judged")

    window = block.get("window")
    start = end = None
    if window is not None or select_by in TIMED:
        start = parse_time((window or {}).get("from")) if isinstance(window, dict) else None
        end = parse_time((window or {}).get("to")) if isinstance(window, dict) else None
        if start is None or end is None:
            problems.append(f"{where}.window needs from and to as ISO 8601 times: a selection by {select_by or 'time'} "
                            "is only as honest as its window")
        elif start >= end:
            problems.append(f"{where}.window.from is not before window.to")

    unit = (text_value(block, "unit") or "").lower()
    if unit in TIME_UNITS and select_by not in ("start", "sample", "version", None):
        problems.append(f"{where}: a duration ({unit}) chosen by selectBy {select_by} is biased; select by start (every item "
                        "that began in the window) or name a fixed sample. On 2026-10-10 \"coalescing p50 32,401\" chose "
                        "streams by finish time and a failure time was measured from its notice")

    if per_release(row, block, comparison):
        reason = single_version(block.get("codeVersion"))
        if reason:
            problems.append(f"{where}.codeVersion {reason}")
        if select_by in ("finish", "notice", "all"):
            problems.append(f"{where}: a per-release number chosen by {select_by} reaches into items the previous release "
                            "served; select by start, event, a fixed sample or each item's recorded version")
        deployed = block.get("deployedAt")
        if select_by in ("start", "event") or deployed is not None:
            when = parse_time(deployed)
            if when is None:
                problems.append(f"{where}.deployedAt is missing: name when {block.get('codeVersion') or 'the release'} "
                                "started serving, so the window cannot include the release before it")
            elif start is not None and start < when:
                problems.append(f"{where}.window.from ({window['from']}) is before deployedAt ({deployed}): the sample "
                                "includes items the previous release served")
    if row.get("lever") == "baseline" and side == "baseline":
        if vague(text_value(block, "instrument")):
            problems.append(f"{where}.instrument is missing: name the script, query or endpoint that measures the hill")
        problems.extend(check_calibration(where, block.get("calibration")))
    return problems


def check_row(row):
    """Every problem with one ledger row, as sentences naming the fix."""
    if not isinstance(row, dict):
        return ["the line is not a JSON object"]
    problems = [f"{key} is missing" for key in REQUIRED if row.get(key) in (None, "")]
    if row.get("timestamp") and parse_time(row["timestamp"]) is None:
        problems.append(f"timestamp {json.dumps(row['timestamp'])} is not ISO 8601")
    measured = [side for side in ("baseline", "result") if reports_number(row.get(side))]
    if row.get("lever") == "baseline" and "baseline" not in measured:
        problems.append("a baseline row reports the hill's current value in baseline")
    comparison = (len(measured) == 2 and row.get("lever") != "baseline"
                  and row.get("category") in RELEASE_CATEGORIES)
    for side in measured:
        problems.extend(check_side(row, side, comparison))
    return problems


# ---------------------------------------------------------------------------------------- ledger

def git_path(start, *args):
    try:
        out = subprocess.run(["git", "-C", str(start), "rev-parse", *args], capture_output=True, text=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return pathlib.Path(out.stdout.strip()) if out.stdout.strip() else None


def project_name(root):
    """The main checkout's name, so a row written from a worktree names the project, not the worktree."""
    common = git_path(root, "--path-format=absolute", "--git-common-dir")
    if common and common.name == ".git":
        return common.parent.name
    return root.name


def ledger_path(args):
    """(ledger path, project root)."""
    if args.ledger:
        path = pathlib.Path(args.ledger).resolve()
        if args.project:
            return path, pathlib.Path(args.project).resolve()
        start = path.parent if path.parent.is_dir() else pathlib.Path.cwd()
        return path, git_path(start, "--show-toplevel") or start
    root = pathlib.Path(args.project).resolve() if args.project else (git_path(pathlib.Path.cwd(), "--show-toplevel")
                                                                       or pathlib.Path.cwd())
    lab = root / "reports" / "climb"
    return (lab / "ledger.jsonl") if lab.is_dir() else (root / ".agent" / "climb.jsonl"), root


def read_rows(path):
    """(line number, row or None, raw text) for each non-empty line."""
    if not path.is_file():
        return []
    out = []
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip():
            continue
        try:
            out.append((number, json.loads(line), line))
        except ValueError:
            out.append((number, None, line))
    return out


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-")[:40] or "row"


def parse_rows(raw):
    """Rows from a JSON object, a JSON array of objects, or JSON lines."""
    text = raw.strip()
    try:
        value = json.loads(text)
        rows = value if isinstance(value, list) else [value]
    except ValueError:
        rows = [json.loads(line) for line in text.splitlines() if line.strip()]
    if not rows or not all(isinstance(r, dict) for r in rows):
        raise ValueError("expected a JSON object, an array of objects, or JSON lines")
    return rows


def cmd_append(args):
    raw = args.row if args.row is not None else (pathlib.Path(args.file).read_text() if args.file else sys.stdin.read())
    try:
        rows = parse_rows(raw)
    except ValueError as exc:
        print(f"climb-log: the row is not JSON ({exc})", file=sys.stderr)
        return 2
    path, root = ledger_path(args)
    now = dt.datetime.now(dt.timezone.utc)
    refused = False
    for row in rows:
        row.setdefault("timestamp", now.strftime("%Y-%m-%dT%H:%M:%SZ"))
        if not row.get("project"):
            row["project"] = project_name(root)
        row.setdefault("id", f"{slug(row.get('hill'))}-{now.strftime('%Y%m%dT%H%M%SZ')}-{secrets.token_hex(3)}")
        problems = check_row(row)
        if problems:
            refused = True
            print(f"climb-log: refused row {row['id']} for {path}:", file=sys.stderr)
            for problem in problems:
                print(f"  - {problem}", file=sys.stderr)
    if refused:
        print("Nothing was written. The contract: climb-log schema; docs/processes/climb.md#the-ledger.", file=sys.stderr)
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.seek(0)
        existing = fh.read()
        ids = set()
        for line in existing.splitlines():
            try:
                ids.add(json.loads(line).get("id"))
            except (ValueError, AttributeError):
                continue
        repeated = [r["id"] for r in rows if r["id"] in ids]
        if repeated and not args.skip_existing:
            print(f"climb-log: {path} already has a row {repeated[0]}; the ledger is append-only, so give the new row "
                  "its own id", file=sys.stderr)
            return 1
        fresh = [r for r in rows if r["id"] not in ids]
        if fresh:
            lead = "\n" if existing and not existing.endswith("\n") else ""
            fh.write(lead + "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in fresh))
            fh.flush()
            os.fsync(fh.fileno())
    for r in fresh:
        print(r["id"])
    if args.skip_existing and repeated:
        print(f"climb-log: skipped {len(repeated)} rows already in {path}", file=sys.stderr)
    return 0


def cmd_check(args):
    path, _ = ledger_path(args)
    since = parse_time(args.since)
    if since is None:
        print(f"climb-log: --since {args.since} is not an ISO 8601 date", file=sys.stderr)
        return 2
    findings, checked, seen = [], 0, {}
    for number, row, _raw in read_rows(path):
        if row is None:
            findings.append({"line": number, "id": None, "problems": ["the line is not JSON"]})
            continue
        when = parse_time(row.get("timestamp")) if isinstance(row, dict) else None
        rid = row.get("id") if isinstance(row, dict) else None
        first = seen.setdefault(rid, number) if rid else number
        if when is not None and when < since:
            continue
        checked += 1
        problems = check_row(row)
        if rid and first != number:
            problems.append(f"id repeats line {first}")
        if problems:
            findings.append({"line": number, "id": rid, "hill": row.get("hill"), "problems": problems})
    if args.json:
        print(json.dumps({"ledger": str(path), "since": args.since, "checked": checked, "failed": len(findings),
                          "rows": findings}, indent=2, ensure_ascii=False))
    else:
        for f in findings:
            print(f"{path}:{f['line']} {f['id'] or '(no id)'}")
            for problem in f["problems"]:
                print(f"  - {problem}")
        print(f"climb-log check: {checked - len(findings)}/{checked} rows since {args.since} pass ({path})")
    return 1 if findings else 0


def cmd_hills(args):
    path, _ = ledger_path(args)
    hills = {}
    for _number, row, _raw in read_rows(path):
        if not isinstance(row, dict) or not row.get("hill"):
            continue
        h = hills.setdefault(row["hill"], {"hill": row["hill"], "layer": row.get("layer"), "rows": 0,
                                            "baseline": None, "instrument": None, "calibration": "no baseline"})
        h["rows"] += 1
        if row.get("lever") != "baseline":
            continue
        when = parse_time(row.get("timestamp"))
        if h["baseline"] and when and parse_time(h["baseline"]["timestamp"]) and when < parse_time(h["baseline"]["timestamp"]):
            continue
        block = (row.get("baseline") or {}).get("measurement") if isinstance(row.get("baseline"), dict) else None
        calibration = (block or {}).get("calibration")
        h["baseline"] = {"id": row.get("id"), "timestamp": row.get("timestamp")}
        h["instrument"] = (block or {}).get("instrument")
        h["calibration"] = calibration.get("verdict") if isinstance(calibration, dict) else "missing"
    table = sorted(hills.values(), key=lambda h: (h["calibration"] != "PASS", h["hill"]))
    calibrated = sum(1 for h in table if h["calibration"] == "PASS")
    if args.json:
        print(json.dumps({"ledger": str(path), "hills": len(table), "calibrated": calibrated, "rows": table},
                         indent=2, ensure_ascii=False))
    else:
        width = min(48, max([len(h["hill"]) for h in table] + [4]))
        print(f"{'hill':<{width}}  {'layer':<9} {'calibration':<13} instrument")
        for h in table:
            name = h["hill"] if len(h["hill"]) <= width else h["hill"][:width - 1] + "…"
            print(f"{name:<{width}}  {str(h['layer'] or '-'):<9} {h['calibration']:<13} {h['instrument'] or '-'}")
        print(f"climb-log hills: {calibrated}/{len(table)} hills have a passing calibration check ({path})")
    return 1 if args.strict and calibrated < len(table) else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="climb-log", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="command", required=True)
    for name in ("append", "check", "hills"):
        p = sub.add_parser(name)
        p.add_argument("--ledger", help="ledger path (default: the project's ledger)")
        p.add_argument("--project", help="project root (default: git toplevel of the working directory)")
        if name == "append":
            source = p.add_mutually_exclusive_group()
            source.add_argument("--row", help="the row as JSON")
            source.add_argument("--file", help="a file holding the row as JSON")
            p.add_argument("--skip-existing", action="store_true", help="skip rows whose id the ledger already has")
        if name == "check":
            p.add_argument("--since", default=POLICY_START, help=f"lint rows at or after this time (default {POLICY_START})")
        if name in ("check", "hills"):
            p.add_argument("--json", action="store_true")
        if name == "hills":
            p.add_argument("--strict", action="store_true", help="exit 1 when a hill lacks a passing calibration")
    sub.add_parser("schema")
    args = ap.parse_args(argv)
    if args.command == "schema":
        print(__doc__.strip())
        return 0
    return {"append": cmd_append, "check": cmd_check, "hills": cmd_hills}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
