#!/usr/bin/env bash
# Fast-forward idle, clean primary checkouts without resetting local work.
# MAIN_CHECKOUT_ROOTS (colon-separated roots, default ~/code) and MAIN_CHECKOUT_FF_EXCLUDE (space-separated repo names) come
# from the environment, else from the private layer's claude/config/main-checkout-ff.env, read when no roots are set.
set -u
usage() { echo 'Usage: main-checkout-ff [--dry-run | --help]'; }
case "$#:${1-}" in
  0:) dry_run=0 ;;
  1:--dry-run) dry_run=1 ;;
  1:--help|1:-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

state="$HOME/.local/state/main-checkout-ff"
log="$state/main-checkout-ff.log"
mkdir -p "$state"
cfg="${DOTFILES_PRIVATE:-$HOME/.local/share/dotfiles-private}/claude/config/main-checkout-ff.env"
[ -n "${MAIN_CHECKOUT_ROOTS-}" ] || [ ! -r "$cfg" ] || . "$cfg"
roots="${MAIN_CHECKOUT_ROOTS:-$HOME/code}"

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=15}"

note() { echo "$(date -u +%FT%TZ) $*" >> "$log"; }
say() { if [ "$dry_run" = 1 ]; then echo "$*"; else note "$*"; fi; }

exclude=" ${MAIN_CHECKOUT_FF_EXCLUDE-} "

# Snapshot process cwd, executable and script; other arguments are data.
busy_paths() {
  if [ -d /proc/self ]; then
    local p d hidden=0
    for p in /proc/[0-9]*; do
      d="$(readlink "$p/cwd" 2>/dev/null)" || { [ -e "$p" ] && hidden=$((hidden + 1)); continue; }
      echo "$d"
      tr '\0' '\n' < "$p/cmdline" 2>/dev/null | head -n 2
    done
    # Other users' processes are unreadable without root; a repo shared with them is not ours to move.
    [ "$hidden" -eq 0 ] || [ "$(id -u)" -ne 0 ]
  else
    command -v lsof >/dev/null 2>&1 || return 1
    local out
    out="$(lsof -a -d cwd -F n 2>/dev/null | sed -n 's/^n//p')"
    [ -n "$out" ] || return 1
    printf '%s\n' "$out"
    ps -axo args= 2>/dev/null | awk '{ print $1; if (NF > 1) print $2 }'
  fi
}

github_ssh_url() {
  git -C "$1" remote get-url origin 2>/dev/null | sed -n 's#^https://github\.com/\(.*\)$#git@github.com:\1#p'
}

busy_cache=""
busy_cached=0

in_use() {
  # Cache process snapshots; "fresh" rechecks before merge. Nested worktrees are independent.
  local busy
  holder="processes not visible"
  if [ "${3:-}" = fresh ] || [ "$busy_cached" = 0 ]; then
    busy_cache="$(busy_paths)" || { busy_cached=0; return 0; }
    [ "${3:-}" = fresh ] || busy_cached=1
  fi
  busy="$busy_cache"
  local nested
  nested="$(git -C "$1" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | awk -v r="$1" 'index($0, r "/") == 1')"
  holder="$(printf '%s\n' "$busy" | NESTED="$nested" awk -v r="$1" -v s="$2" '
    function under(path, root) { return index(path, root) == 1 && (length(path) == length(root) || substr(path, length(root) + 1, 1) == "/") }
    BEGIN { n = split(ENVIRON["NESTED"], nested, "\n") }
    {
      for (i = 1; i <= n; i++) if (nested[i] != "" && under($0, nested[i])) next
      if (under($0, r) || under($0, s)) { print; exit }
    }')"
  [ -n "$holder" ]
}

IFS=: read -r -a root_list <<< "$roots"
for root in "${root_list[@]}"; do
  [ -d "$root" ] || continue
  for repo in "$root"/*/; do
    repo="${repo%/}"; name="${repo##*/}"
    case "$name" in _*|.*) continue ;; esac
    case "$exclude" in *" $name "*) continue ;; esac
    [ -d "$repo/.git" ] || continue
    real="$(cd "$repo" && pwd -P)" || continue
    git -C "$repo" remote get-url origin >/dev/null 2>&1 || continue
    def="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
    if [ -z "$def" ]; then
      git -C "$repo" remote set-head origin --auto >/dev/null 2>&1
      def="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
      ssh_url="$(github_ssh_url "$repo")"
      if [ -z "$def" ] && [ -n "$ssh_url" ]; then
        head="$(git ls-remote --symref "$ssh_url" HEAD 2>/dev/null | sed -n 's#^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$#\1#p')"
        [ -n "$head" ] && git -C "$repo" remote set-head origin "$head" >/dev/null 2>&1 && def="origin/$head"
      fi
    fi
    def="${def#origin/}"
    if [ -z "$def" ]; then
      say "skipped $repo: origin default branch unknown"
      continue
    fi
    [ "$(git -C "$repo" branch --show-current)" = "$def" ] || continue
    if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      say "skipped $repo: tracked changes"
      continue
    fi
    if in_use "$real" "$repo"; then
      say "skipped $repo: in use by $holder"
      continue
    fi
    if ! err="$(git -C "$repo" -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 fetch -q origin "$def" 2>&1)"; then
      # Refresh through SSH if HTTPS failed, preserving the configured remote.
      ssh_url="$(github_ssh_url "$repo")"
      if [ -z "$ssh_url" ] || ! git -C "$repo" fetch -q "$ssh_url" "+$def:refs/remotes/origin/$def" 2>/dev/null; then
        say "fetch-failed $repo: $(printf '%s' "$err" | head -n 1)"
        continue
      fi
    fi
    behind="$(git -C "$repo" rev-list --count "HEAD..origin/$def" 2>/dev/null || echo 0)"
    [ "$behind" -gt 0 ] || continue
    if ! git -C "$repo" merge-base --is-ancestor HEAD "origin/$def" 2>/dev/null; then
      say "diverged $repo (needs its owner)"
      continue
    fi
    # Check only changed paths, with literal pathspecs and fail-closed pipelines.
    if ! ignored="$(set -o pipefail; git -C "$repo" diff --name-only -z HEAD "origin/$def" \
        | GIT_LITERAL_PATHSPECS=1 xargs -0 -r git -C "$repo" ls-files -z -o -i --exclude-standard -- \
        | tr '\0' '\n')"; then
      say "skipped $repo: ignored-file check failed"
      continue
    fi
    clobber="${ignored%%$'\n'*}"
    if [ -n "$clobber" ]; then
      say "skipped $repo: merge would replace ignored file $clobber"
      continue
    fi
    if [ "$dry_run" = 1 ]; then
      echo "would fast-forward $repo ($behind behind origin/$def)"
      continue
    fi
    # The fetch can take minutes; look for a new process again right before moving files.
    if in_use "$real" "$repo" fresh; then
      note "skipped $repo: in use by $holder"
      continue
    fi
    if out="$(git -C "$repo" -c core.hooksPath=/dev/null merge --ff-only -q "origin/$def" 2>&1)"; then
      note "ff $repo -> $(git -C "$repo" rev-parse --short HEAD) ($behind)"
    else
      note "refused $repo: $(printf '%s' "$out" | head -n 1)"
    fi
  done
done
