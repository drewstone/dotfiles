#!/usr/bin/env bash
# Fast-forward main checkouts that are safe to move, so they track origin's default branch.
#
# A checkout moves only when all of these hold:
#   - it is a primary clone (its .git is a directory) with an origin,
#   - it is on origin's default branch and HEAD is an ancestor of it,
#   - it has no tracked changes (untracked files are kept; git refuses an overwrite),
#   - the merge would not replace a locally ignored file such as .env,
#   - no live process has its working directory inside it, read again just before the merge.
# Anything else is left for its owner, as the fleet main-checkouts runbook requires.
# It never stashes, resets or cleans: a stash of untracked run directories once killed live runs.
# When live processes cannot be seen (no lsof on macOS, unreadable /proc entries), it moves nothing.
#
# Roots: MAIN_CHECKOUT_ROOTS (colon-separated), default ~/code:~/company:~/webb.
# Log: ~/.local/state/main-checkout-ff/main-checkout-ff.log
set -u

state="$HOME/.local/state/main-checkout-ff"
log="$state/main-checkout-ff.log"
mkdir -p "$state"
roots="${MAIN_CHECKOUT_ROOTS:-$HOME/code:$HOME/company:$HOME/webb}"
dry_run=0
[ "${1:-}" = "--dry-run" ] && dry_run=1

# A background job must never wait on a prompt: a hung run blocks every later launchd run.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=15}"

note() { echo "$(date -u +%FT%TZ) $*" >> "$log"; }
say() { if [ "$dry_run" = 1 ]; then echo "$*"; else note "$*"; fi; }

# Repositories another lane owns (fleet runbook: discovery-lab-65 owns discovery-lab and discovery).
# Override with MAIN_CHECKOUT_FF_EXCLUDE, a space-separated list of directory names.
exclude=" ${MAIN_CHECKOUT_FF_EXCLUDE-discovery-lab discovery} "

# Prints the paths each process runs from: its working directory, its program (argv[0]) and
# the script it was given (argv[1]), since services run code by absolute path without a cwd
# inside. Later arguments are data a process reads, not code it runs: a backup that names a
# file in every repo must not hold all of them. Fails when processes cannot be seen.
busy_paths() {
  if [ -d /proc/self ]; then
    local p d hidden=0
    for p in /proc/[0-9]*; do
      d="$(readlink "$p/cwd" 2>/dev/null)" || { [ -e "$p" ] && hidden=$((hidden + 1)); continue; }
      echo "$d"
      tr '\0' '\n' < "$p/cmdline" 2>/dev/null | head -n 2
    done
    # Other users' processes are unreadable without root; a repo shared with them is not ours to move.
    [ "$hidden" -eq 0 ] || [ "$(id -u)" -ne 0 ]
  else
    command -v lsof >/dev/null 2>&1 || return 1
    local out
    out="$(lsof -a -d cwd -F n 2>/dev/null | sed -n 's/^n//p')"
    [ -n "$out" ] || return 1
    printf '%s\n' "$out"
    # Program and first argument of every process; argument splitting on spaces is enough for paths.
    ps -axo args= 2>/dev/null | awk '{ print $1; if (NF > 1) print $2 }'
  fi
}

in_use() {
  # True when any process uses the repo or a path below it ($1 real path, $2 path as listed).
  # Linked worktrees kept inside the clone (agent-dev-container keeps them in .worktrees/) are separate
  # checkouts: a merge never touches them, so a lane working in one does not hold the main checkout.
  local busy
  busy="$(busy_paths)" || return 0
  local nested
  nested="$(git -C "$1" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | awk -v r="$1" 'index($0, r "/") == 1')"
  printf '%s\n' "$busy" | NESTED="$nested" awk -v r="$1" -v s="$2" '
    function under(path, root) { return index(path, root) == 1 && (length(path) == length(root) || substr(path, length(root) + 1, 1) == "/") }
    BEGIN { n = split(ENVIRON["NESTED"], nested, "\n") }
    {
      for (i = 1; i <= n; i++) if (nested[i] != "" && under($0, nested[i])) next
      if (under($0, r) || under($0, s)) found = 1
    }
    END { exit !found }'
}

IFS=: read -r -a root_list <<< "$roots"
for root in "${root_list[@]}"; do
  [ -d "$root" ] || continue
  for repo in "$root"/*/; do
    repo="${repo%/}"; name="${repo##*/}"
    case "$name" in _*|.*) continue ;; esac
    case "$exclude" in *" $name "*) continue ;; esac
    [ -d "$repo/.git" ] || continue
    real="$(cd "$repo" && pwd -P)" || continue
    git -C "$repo" remote get-url origin >/dev/null 2>&1 || continue
    def="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
    if [ -z "$def" ]; then
      # Clones made before origin set a default branch lack origin/HEAD; ask the remote once.
      git -C "$repo" remote set-head origin --auto >/dev/null 2>&1
      def="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
    fi
    def="${def#origin/}"
    if [ -z "$def" ]; then
      say "skipped $repo: origin default branch unknown"
      continue
    fi
    [ "$(git -C "$repo" branch --show-current)" = "$def" ] || continue
    if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      say "skipped $repo: tracked changes"
      continue
    fi
    if in_use "$real" "$repo"; then
      say "skipped $repo: in use"
      continue
    fi
    if ! err="$(git -C "$repo" -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 fetch -q origin "$def" 2>&1)"; then
      say "fetch-failed $repo: $(printf '%s' "$err" | head -n 1)"
      continue
    fi
    behind="$(git -C "$repo" rev-list --count "HEAD..origin/$def" 2>/dev/null || echo 0)"
    [ "$behind" -gt 0 ] || continue
    # Local commits on the default branch need their owner; a fast-forward cannot carry them.
    if ! git -C "$repo" merge-base --is-ancestor HEAD "origin/$def" 2>/dev/null; then
      say "diverged $repo (needs its owner)"
      continue
    fi
    # git replaces ignored files silently when origin starts tracking the same path.
    clobber="$(comm -12 <(git -C "$repo" diff --name-only HEAD "origin/$def" | sort) \
                        <(git -C "$repo" ls-files -o -i --exclude-standard | sort) | head -n 1)"
    if [ -n "$clobber" ]; then
      say "skipped $repo: merge would replace ignored file $clobber"
      continue
    fi
    if [ "$dry_run" = 1 ]; then
      echo "would fast-forward $repo ($behind behind origin/$def)"
      continue
    fi
    # The fetch can take minutes; look for a new process again right before moving files.
    if in_use "$real" "$repo"; then
      note "skipped $repo: in use"
      continue
    fi
    if out="$(git -C "$repo" -c core.hooksPath=/dev/null merge --ff-only -q "origin/$def" 2>&1)"; then
      note "ff $repo -> $(git -C "$repo" rev-parse --short HEAD) ($behind)"
    else
      note "refused $repo: $(printf '%s' "$out" | head -n 1)"
    fi
  done
done
