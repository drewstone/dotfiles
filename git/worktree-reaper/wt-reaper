import subprocess
import sys
import time

IS_LINUX = sys.platform.startswith('linux')
IS_MAC = sys.platform == 'darwin'

# Ignored paths that may be discarded with the worktree. Anything else that
# is ignored (.env, scratch notes, local config) makes the worktree a skip.
BUILD_DIRS = {
    'node_modules', 'dist', 'build', 'out', 'target', 'coverage', '.next',
    '.nuxt', '.turbo', '.cache', '.parcel-cache', '.vite', '.svelte-kit',
    '.output', '.vercel', '__pycache__', '.pytest_cache', '.mypy_cache',
    '.ruff_cache', '.tox', '.nox', '.venv', 'venv', '.gradle', '.eslintcache',
    '.wrangler', '.nyc_output', 'storybook-static', '.docusaurus',
    '.expo', '.angular', '.pnpm-store', '.yarn', 'foundry-out', 'cache',
    'artifacts', 'typechain-types', 'test-results', 'playwright-report',
    # Generated sources: route and content types, codegen output (ADC's products/sandbox/api/src/generated).
    'generated', '.react-router', '.astro',
}
BUILD_FILE_RE = re.compile(
    r'(\.pyc|\.pyo|\.tsbuildinfo|\.log|\.o|\.so|\.dylib|\.class|\.DS_Store'
    r'|\.eslintcache|\.coverage)$'
)
IN_PROGRESS = {
    'MERGE_HEAD': 'merge in progress',
    'rebase-merge': 'rebase in progress',
    'rebase-apply': 'rebase or am in progress',
    'BISECT_LOG': 'bisect in progress',
    'BISECT_START': 'bisect in progress',
    'CHERRY_PICK_HEAD': 'cherry-pick in progress',
    'REVERT_HEAD': 'revert in progress',
    'sequencer': 'sequencer in progress',
}


class Skip(Exception):
    """Raised by a check to skip the worktree with a reason."""


def now_iso():
    return time.strftime('%Y-%m-%dT%H:%M:%S%z')


class Log:
    def __init__(self, path):
        self.path = path
        self.fh = None
        if path:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            self._trim()
            self.fh = open(path, 'a', encoding='utf-8')

    def _trim(self, max_bytes=2 * 1024 * 1024, keep_lines=20000):
        try:
            if os.path.getsize(self.path) <= max_bytes:
                return
            with open(self.path, encoding='utf-8', errors='replace') as fh:
                lines = fh.readlines()[-keep_lines:]
            with open(self.path, 'w', encoding='utf-8') as fh:
                fh.writelines(lines)
        except OSError:
            pass

    def write(self, **fields):
        parts = ['ts=' + now_iso()]
        for key, value in fields.items():
            text = str(value)
            if not text or re.search(r'\s|"', text):
                text = json.dumps(text)
            parts.append('%s=%s' % (key, text))
        line = ' '.join(parts)
        print(line, flush=True)
        if self.fh:
            self.fh.write(line + '\n')
            self.fh.flush()


def git(args, cwd, check=True, timeout=300):
    env = dict(os.environ)
    # Never refresh or write the index while inspecting: that would change
    # the index mtime the idle check reads, and race with live sessions.
    env['GIT_OPTIONAL_LOCKS'] = '0'
    env['GIT_TERMINAL_PROMPT'] = '0'
    env.setdefault('GIT_SSH_COMMAND', 'ssh -o BatchMode=yes -o ConnectTimeout=20')
    env['LC_ALL'] = 'C'
    proc = subprocess.run(
        ['git'] + args, cwd=cwd, env=env, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, timeout=timeout,
    )
    out = proc.stdout.decode('utf-8', 'surrogateescape')
    if check and proc.returncode != 0:
        err = proc.stderr.decode('utf-8', 'replace').strip().splitlines()
        raise Skip('git %s failed: %s' % (args[0], (err[-1] if err else 'exit %d' % proc.returncode)))
    return out


def git_ok(args, cwd, timeout=120):
    try:
        git(args, cwd, timeout=timeout)
        return True
    except (Skip, subprocess.TimeoutExpired):
        return False


def real(path):
    return os.path.realpath(path)


def inside(path, root):
    return path == root or path.startswith(root.rstrip('/') + '/')


# ---------------------------------------------------------------- discovery

def find_repos(roots, max_depth):
    """Return the common git dirs of repositories found under the roots."""
    common_dirs = set()
    for root in roots:
        root = real(root)
        if not os.path.isdir(root):
            continue
        stack = [(root, 0)]
        while stack:
            path, depth = stack.pop()
            dotgit = os.path.join(path, '.git')
            if os.path.lexists(dotgit):
                try:
                    common = git(['rev-parse', '--path-format=absolute', '--git-common-dir'], path).strip()
                    common_dirs.add(real(common))
                except (Skip, subprocess.TimeoutExpired, OSError):
                    pass
                continue
            if (os.path.isfile(os.path.join(path, 'HEAD')) and os.path.isdir(os.path.join(path, 'objects'))
                    and os.path.isdir(os.path.join(path, 'refs'))):
                # A bare repository (or a .git dir used as a root) has no .git child.
                try:
                    if git(['--git-dir', path, 'rev-parse', '--is-bare-repository'], '/').strip() == 'true':
                        common_dirs.add(real(path))
                except (Skip, subprocess.TimeoutExpired, OSError):
                    pass
                continue
            if depth >= max_depth:
                continue
            try:
                entries = list(os.scandir(path))
            except OSError:
                continue
            for entry in entries:
                if entry.name in ('node_modules', '.Trash') or not entry.is_dir(follow_symlinks=False):
                    continue
                stack.append((entry.path, depth + 1))
    return sorted(common_dirs)


def list_worktrees(common_dir):
    """Parse `git worktree list --porcelain`. The first entry is the main one."""
    out = git(['--git-dir', common_dir, 'worktree', 'list', '--porcelain'], cwd='/')
    entries, cur = [], {}
    for line in out.split('\n'):
        if not line:
            if cur:
                entries.append(cur)
                cur = {}
            continue
        key, _, value = line.partition(' ')
        cur[key] = value if value else True
    if cur:
        entries.append(cur)
    return entries


# ---------------------------------------------------------------- checks

def check_in_progress(gitdir):
    for name, reason in IN_PROGRESS.items():
        if os.path.lexists(os.path.join(gitdir, name)):
            raise Skip(reason)


def storage_owner(name):
    owner = os.path.expanduser('~/.local/share/tangle-tools')
    if owner not in sys.path:
        sys.path.insert(0, owner)
    return importlib.import_module('storage_lifecycle.' + name)


def newest_git_activity(gitdir, common_dir, branch):
    try:
        return storage_owner('worktree_activity').latest_git_activity(gitdir, common_dir, branch)
    except (ImportError, OSError, ValueError) as exc:
        raise Skip('Git activity owner unavailable or unsafe: %s' % exc) from exc


def _looks_bare(path, entries):
    """A bare repository or a moved .git dir: HEAD plus objects and refs.

    Name presence alone decides, so a symlinked objects/ or refs/ store (which
    Git accepts) still counts; a false positive only keeps a worktree.
    """
    names = {e.name for e in entries}
    return {'HEAD', 'objects', 'refs'} <= names


def mount_points():
    """Every mount point on this host (a bind mount keeps the same st_dev)."""
    points = set()
    if IS_LINUX:
        tables = storage_owner('proc_scan').mountinfo('self')
        if tables is None:
            raise Skip('canonical Linux mount inventory is unavailable')
        for pairs in tables.values():
            points.update(point for _, point in pairs)
    else:
        out = subprocess.run(['/sbin/mount'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             check=True).stdout.decode('utf-8', 'replace')
        for line in out.splitlines():
            match = re.match(r'.+? on (/.*?) \(', line)
            if match:
                points.add(match.group(1))
    return points


def check_no_mounts(rpath):
    inner = sorted(p for p in mount_points() if inside(real(p), rpath))
    if inner:
        raise Skip('mount point inside: %s' % inner[0])


def changed_at(st):
    """When this entry last changed. A hardlinked file's ctime moves whenever any of its links is added or
    removed elsewhere (another worktree's pnpm install), so only its mtime says this tree was touched."""
    if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
        return st.st_mtime
    return max(st.st_mtime, st.st_ctime)


def walk_tree(path, cutoff):
    """Return (newest_time, nested_git_path). Stops early on a recent entry.

    Raises Skip when the walk crosses onto another filesystem.
    """
    newest = 0.0
    stack = [path]
    root_dev = os.lstat(path).st_dev
    while stack:
        cur = stack.pop()
        try:
            st = os.lstat(cur)
            if st.st_dev != root_dev:
                raise Skip('another filesystem is mounted at %s' % cur)
            newest = max(newest, st.st_mtime, st.st_ctime)
            if newest > cutoff:
                return newest, None
            with os.scandir(cur) as it:
                entries = list(it)
        except OSError as exc:
            raise Skip('cannot read %s: %s' % (cur, exc.strerror))
        if cur != path and _looks_bare(cur, entries):
            return newest, cur
        for entry in entries:
            try:
                if entry.name == '.git' and cur != path:
                    return newest, entry.path
                if entry.is_dir(follow_symlinks=False):
                    stack.append(entry.path)
                    continue
                st = entry.stat(follow_symlinks=False)
                newest = max(newest, changed_at(st))
                if newest > cutoff:
                    return newest, None
            except OSError as exc:
                raise Skip('cannot stat %s: %s' % (entry.path, exc.strerror))
    return newest, None


def is_build_output(rel):
    parts = [p for p in rel.rstrip('/').split('/') if p]
    return any(p in BUILD_DIRS for p in parts) or bool(parts and BUILD_FILE_RE.search(parts[-1]))


def only_build_output(full, rel, depth=4, budget=None):
    """An ignored directory holding nothing but build output, such as a package directory left behind
    with only node_modules/, dist/ and .turbo/. Subdirectories are checked the same way, at most
    `depth` levels and 500 entries; anything else, a symlink, or any error keeps the tree."""
    budget = budget if budget is not None else [500]
    if depth < 0 or os.path.islink(full) or not os.path.isdir(full):
        return False
    try:
        entries = os.listdir(full)
    except OSError:
        return False
    if not entries:
        return False
    for name in entries:
        budget[0] -= 1
        if budget[0] < 0:
            return False
        child = rel.rstrip('/') + '/' + name
        if is_build_output(child):
            continue
        if not only_build_output(os.path.join(full, name), child, depth - 1, budget):
            return False
    return True


def check_clean(path):
    out = git(['status', '--porcelain=v1', '-z', '--ignored=traditional',
               '--untracked-files=normal', '--ignore-submodules=none'], path)
    dirty, keep = [], []
    records = out.split('\0')
    i = 0
    while i < len(records):
        rec = records[i]
        i += 1
        if not rec:
            continue
        code, rel = rec[:2], rec[3:]
        if code[0] in 'RC':
            i += 1  # rename/copy carries the source path as the next record
        if rel == '.wt-owner' and code in ('??', '!!'):
            continue  # wt-new's per-machine ownership marker, untracked or excluded, is never work
        if code != '!!':
            dirty.append(rel)
        elif not (is_build_output(rel) or only_build_output(os.path.join(path, rel), rel)):
            keep.append(rel)
    if dirty:
        raise Skip('not clean: %d change(s), first %s' % (len(dirty), dirty[0]))
    if keep:
        raise Skip('ignored non-build files: %s' % ', '.join(keep[:5]))


def check_pushed(path):
    out = git(['rev-list', '--count', 'HEAD', '--not', '--remotes'], path).strip()
    if out != '0':
        raise Skip('%s commit(s) not on any remote ref' % out)


# ---------------------------------------------------------------- processes

def process_table():
    """pid -> ps state letters for every process (works on Linux and macOS)."""
    out = subprocess.run(['ps', '-axo', 'pid=,stat='], stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, check=True).stdout.decode()
    table = {}
    for line in out.splitlines():
        f = line.split()
        if len(f) == 2 and f[0].isdigit():
            table[int(f[0])] = f[1]
    return table


def alive(pid, table):
    """True while pid exists and is not a zombie (a zombie holds no files)."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    state = table.get(pid)
    return state is not None and not state.startswith('Z')


def scan_processes(use_sudo, log):
    """Return every path a live process holds, or raise Skip.

    Any live process the scan cannot inspect makes the whole scan incomplete:
    a root daemon may hold a worktree, and its ancestry proves nothing.
    """
    if IS_LINUX:
        try:
            if use_sudo:
                owner = storage_owner('core')
                return owner.Live.scan(owner.Config.load()).paths
            data = storage_owner('proc_scan').dump()
            if data['unreadable']:
                raise Skip('process scan incomplete: native reader reports unreadable processes')
            return set(data['paths'])
        except (OSError, RuntimeError, ValueError) as error:
            raise Skip('canonical process visibility unavailable: %s' % error) from error
    elif IS_MAC:
        from wt_reaper_mac import scan
        try:
            paths, unreadable, hint = scan(use_sudo, process_table)
        except RuntimeError as error:
            raise Skip(str(error)) from error
    else:
        raise Skip('unsupported platform %s' % sys.platform)
    table = process_table()
    live = [p for p in unreadable if p != os.getpid() and alive(p, table)]
    if live:
        raise Skip('process scan incomplete: %d live process(es) not inspectable, e.g. pid %s%s'
                   % (len(live), ','.join(str(p) for p in live[:5]), hint))
    return paths


# ---------------------------------------------------------------- main loop

def default_branch(common_dir):
    try:
        ref = git(['--git-dir', common_dir, 'symbolic-ref', '-q', 'refs/remotes/origin/HEAD'], '/').strip()
        return ref or None
    except Skip:
        return None


def evaluate(wt, main_path, common_dir, args, cutoff, fetched):
    path = wt['worktree']
    rpath = real(path)
    if wt.get('bare'):
        raise Skip('bare repository entry')
    if 'locked' in wt:
        raise Skip('locked' + (': ' + wt['locked'] if isinstance(wt['locked'], str) else ''))
    if 'prunable' in wt:
        raise Skip('prunable (directory missing); left for git worktree prune')
    if not os.path.isdir(rpath):
        raise Skip('directory missing')
    if not os.path.isfile(os.path.join(rpath, '.git')):
        raise Skip('.git is not a file: not a linked worktree')
    home = real(os.path.expanduser('~'))
    for guard in [home, real(main_path)] + [real(r) for r in args.root]:
        if inside(guard, rpath):
            raise Skip('contains protected path %s' % guard)
    check_kept(rpath, args)
    top = git(['rev-parse', '--path-format=absolute', '--show-toplevel'], rpath).strip()
    if real(top) != rpath:
        raise Skip('toplevel mismatch: %s' % top)
    gitdir = real(git(['rev-parse', '--path-format=absolute', '--git-dir'], rpath).strip())
    wt_common = real(git(['rev-parse', '--path-format=absolute', '--git-common-dir'], rpath).strip())
    if wt_common != common_dir or gitdir == common_dir:
        raise Skip('git dir does not belong to %s' % common_dir)
    check_in_progress(gitdir)
    check_no_mounts(rpath)
    branch = wt.get('branch') if isinstance(wt.get('branch'), str) else None
    newest = newest_git_activity(gitdir, common_dir, branch)
    if newest > cutoff:
        raise Skip('git activity %s ago' % ago(newest))
    newest, nested = walk_tree(rpath, cutoff)
    if nested:
        raise Skip('nested git repository at %s' % nested)
    if newest > cutoff:
        raise Skip('modified %s ago' % ago(newest))
    check_clean(rpath)
    if not fetched:
        raise Skip('fetch failed for this repository')
    check_pushed(rpath)
    return rpath, branch


def check_kept(rpath, args):
    """Paths another owner retires (Discovery run roots go through the Lab) are never this reaper's."""
    for keep in args.keep:
        if inside(rpath, real(os.path.expanduser(keep))):
            raise Skip('under %s, which its owner retires' % keep)


def ago(ts):
    delta = time.time() - ts
    if delta < 0:
        return 'in the future (%ds)' % -delta
    return '%.1fh' % (delta / 3600)


def run(args):
    log = Log(None if args.no_log_file else args.log_file)
    mode = 'dry-run' if args.dry_run else 'live'
    cutoff = time.time() - args.idle_hours * 3600
    counts = {'scanned': 0, 'removed': 0, 'would_remove': 0, 'skipped': 0,
              'errors': 0, 'branches_deleted': 0}
    log.write(event='start', mode=mode, host=socket.gethostname(), roots=','.join(args.root),
              idle_hours=args.idle_hours)
    candidates = []
    seen = []
    for common_dir in find_repos(args.root, args.depth):
        try:
            entries = list_worktrees(common_dir)
        except (Skip, subprocess.TimeoutExpired) as exc:
            counts['errors'] += 1
            log.write(event='repo-error', repo=common_dir, reason=str(exc))
            continue
        if len(entries) < 2:
            continue
        main_path = entries[0].get('worktree', common_dir)
        fetched = True
        try:
            git(['--git-dir', common_dir, 'fetch', '--all', '--prune', '--quiet'], '/', timeout=300)
        except (Skip, subprocess.TimeoutExpired) as exc:
            fetched = False
            log.write(event='fetch-failed', repo=common_dir, reason=str(exc))
        for wt in entries[1:]:
            counts['scanned'] += 1
            seen.append((wt, main_path, common_dir))
            path = wt.get('worktree', '?')
            try:
                rpath, branch = evaluate(wt, main_path, common_dir, args, cutoff, fetched)
                candidates.append((rpath, branch, main_path, common_dir))
            except Skip as exc:
                counts['skipped'] += 1
                log.write(decision='skip', path=path, reason=str(exc))
            except Exception as exc:  # any surprise is a skip, never a removal
                counts['skipped'] += 1
                counts['errors'] += 1
                log.write(decision='skip', path=path, reason='error: %r' % exc)

    held = set()
    if candidates:
        try:
            held = scan_processes(not args.no_sudo, log)
            if IS_MAC:  # lsof may report a path through a symlink such as /tmp -> /private/tmp
                held = {real(p) for p in held} | held
        except Exception as exc:
            for rpath, _, _, _ in candidates:
                counts['skipped'] += 1
                log.write(decision='skip', path=rpath, reason='process scan: %s' % exc)
            candidates = []
            counts['errors'] += 1

    removed = set()
    for rpath, branch, main_path, common_dir in candidates:
        users = sorted(p for p in held if inside(p, rpath))
        if users:
            counts['skipped'] += 1
            log.write(decision='skip', path=rpath, reason='in use by a process: %s' % users[0])
            continue
        if args.dry_run:
            counts['would_remove'] += 1
            log.write(decision='would-remove', path=rpath, branch=branch or '(detached)')
            continue
        # The first pass can be minutes old. Repeat every check, with a fresh
        # process scan, immediately before the destructive step.
        try:
            recheck(rpath, main_path, common_dir, args, log)
        except Exception as exc:
            counts['skipped'] += 1
            log.write(decision='skip', path=rpath, reason='recheck: %s' % exc)
            continue
        try:
            owner = shutil.which('wt-remove') or os.path.expanduser('~/.local/bin/wt-remove')
            result = subprocess.run([owner, rpath], cwd='/', capture_output=True, text=True)
            if result.returncode:
                raise Skip('wt-remove refused (exit %s); source retained' % result.returncode)
            receipt = json.loads(result.stdout.strip().splitlines()[-1])
            if (not isinstance(receipt, dict) or receipt.get('path') != rpath
                    or receipt.get('action') not in ('removed-clean', 'salvaged-removed')
                    or os.path.lexists(rpath)):
                raise Skip('wt-remove did not confirm this exact removal')
        except Exception as exc:
            counts['skipped'] += 1
            counts['errors'] += 1
            log.write(decision='skip', path=rpath, reason='worktree remove refused: %s' % exc)
            continue
        counts['removed'] += 1
        removed.add(rpath)
        log.write(decision='remove', path=rpath, branch=branch or '(detached)', receipt=json.dumps(receipt))

    if not args.no_derived:
        derived = DerivedPass(args, log)
        derived.dependencies(seen, removed)
        derived.journeys()
        counts.update(derived.counts)
    log.write(event='summary', mode=mode, host=socket.gethostname(),
              **counts)
    return 0


# ---------------------------------------------------------------- derived files
# On 2026-10-11 both beelinks fell to their 200 GiB worktree floor and beelink2 toward its 162 GiB gate
# floor, while merged, idle worktrees still held their node_modules and journey runs kept raw recordings
# whose mp4 and scrubbed outputs already existed.

DEPENDENCY_DIRS = ('node_modules',)


def unique_bytes(path):
    """Allocated bytes that deleting path frees: files with one link (pnpm's store keeps the others)."""
    total = 0
    for top, dirs, files in os.walk(path):
        for name in files + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
            try:
                st = os.lstat(os.path.join(top, name))
            except OSError:
                continue
            if st.st_nlink == 1:
                total += st.st_blocks * 512
    return total


# Merged and closed are final; an open or absent pull request is asked again after an hour.
PR_STATE_CACHE = os.path.expanduser('~/.local/state/wt-reaper/pr-state.json')
PR_STATE_RECHECK_S = 3600


def pr_state(slug, name, head):
    """The state of the pull request for this branch at this exact HEAD (MERGED, CLOSED, OPEN) or ''."""
    key = '%s %s %s' % (slug, name, head)
    try:
        with open(PR_STATE_CACHE, encoding='utf-8') as fh:
            cache = json.load(fh)
    except (OSError, ValueError):
        cache = {}
    hit = cache.get(key)
    if hit and (hit['state'] in ('MERGED', 'CLOSED') or time.time() - hit['at'] < PR_STATE_RECHECK_S):
        return hit['state']
    gh = shutil.which('gh-drew') or shutil.which('gh')
    if not gh:
        return ''
    try:
        proc = subprocess.run([gh, 'pr', 'list', '--repo', slug, '--head', name, '--state', 'all',
                               '--json', 'state,headRefOid'], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=60)
        if proc.returncode != 0:
            return ''
        prs = json.loads(proc.stdout or b'[]')
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return ''
    state = next((pr.get('state', '') for pr in prs if pr.get('headRefOid') == head), '')
    cache[key] = {'state': state, 'at': time.time()}
    try:
        os.makedirs(os.path.dirname(PR_STATE_CACHE), exist_ok=True)
        with open(PR_STATE_CACHE + '.tmp', 'w', encoding='utf-8') as fh:
            json.dump(cache, fh)
        os.replace(PR_STATE_CACHE + '.tmp', PR_STATE_CACHE)
    except OSError:
        pass
    return state


def merged_reason(rpath, common_dir, branch):
    """Why this worktree's HEAD is finished work, or None."""
    head = git(['rev-parse', 'HEAD'], rpath).strip()
    default = default_branch(common_dir)
    for ref in [default] if default else ['refs/remotes/origin/main', 'refs/remotes/origin/master']:
        if git_ok(['-C', rpath, 'merge-base', '--is-ancestor', head, ref], '/'):
            return 'HEAD is in %s' % ref[len('refs/remotes/'):]
    # A squash merge leaves HEAD outside the default branch; its pull request says it is done.
    name = branch[len('refs/heads/'):] if branch and branch.startswith('refs/heads/') else None
    if not name:
        return None
    url = git(['config', '--get', 'remote.origin.url'], rpath, check=False).strip()
    match = re.match(r'^(?:git@github\.com:|https://github\.com/|ssh://git@github\.com/)([\w.-]+/[\w.-]+?)(?:\.git)?$', url)
    state = pr_state(match.group(1), name, head) if match else ''
    return 'its pull request at this HEAD is %s' % state.lower() if state in ('MERGED', 'CLOSED') else None


def dependency_dirs(rpath):
    """Every node_modules directory in the tree (not below another, not inside .git) that git ignores."""
    found = []
    for top, dirs, _ in os.walk(rpath):
        keep = []
        for d in dirs:
            full = os.path.join(top, d)
            if d == '.git' or os.path.islink(full):
                continue
            (found if d in DEPENDENCY_DIRS else keep).append(full)
        dirs[:] = [os.path.basename(k) for k in keep]
    ignored = []
    for full in found:
        if git_ok(['-C', rpath, 'check-ignore', '-q', os.path.relpath(full, rpath)], '/'):
            ignored.append(full)
    return ignored




class DerivedPass:
    def __init__(self, args, log):
        self.args, self.log = args, log
        self.counts = {'derived_removed': 0, 'derived_would_remove': 0, 'derived_freed_bytes': 0}
        self.held = None

    def processes(self):
        held = scan_processes(not self.args.no_sudo, self.log)
        return ({real(p) for p in held} | held) if IS_MAC else held

    def done(self, rule, path, freed, reason):
        if self.args.dry_run:
            self.counts['derived_would_remove'] += 1
            self.log.write(decision='would-remove-derived', rule=rule, path=path, bytes=freed, reason=reason)
        else:
            self.counts['derived_removed'] += 1
            self.counts['derived_freed_bytes'] += freed
            self.log.write(decision='remove-derived', rule=rule, path=path, bytes=freed, reason=reason)

    def dependency_check(self, wt, main_path, common_dir, cutoff):
        path = wt['worktree']
        rpath = real(path)
        if wt.get('bare') or 'locked' in wt or 'prunable' in wt:
            raise Skip('bare, locked or prunable')
        if not os.path.isdir(rpath) or not os.path.isfile(os.path.join(rpath, '.git')):
            raise Skip('not a linked worktree')
        home = real(os.path.expanduser('~'))
        for guard in [home, real(main_path)] + [real(r) for r in self.args.root]:
            if inside(guard, rpath):
                raise Skip('contains protected path %s' % guard)
        check_kept(rpath, self.args)
        gitdir = real(git(['rev-parse', '--path-format=absolute', '--git-dir'], rpath).strip())
        check_in_progress(gitdir)
        check_no_mounts(rpath)
        branch = wt.get('branch') if isinstance(wt.get('branch'), str) else None
        newest = newest_git_activity(gitdir, common_dir, branch)
        if newest > cutoff:
            raise Skip('git activity %s ago' % ago(newest))
        if not os.path.isdir(os.path.join(rpath, 'node_modules')):
            raise Skip('no node_modules')
        why = merged_reason(rpath, common_dir, branch)
        if not why:
            raise Skip('HEAD is not in the default branch and no merged or closed pull request has it')
        newest, nested = walk_tree(rpath, cutoff)
        if nested:
            raise Skip('nested git repository at %s' % nested)
        if newest > cutoff:
            raise Skip('modified %s ago' % ago(newest))
        dirs = dependency_dirs(rpath)
        if not dirs:
            raise Skip('no ignored node_modules')
        return rpath, why, dirs

    def dependencies(self, seen, removed):
        cutoff = time.time() - self.args.dependency_idle_hours * 3600
        ready = []
        for wt, main_path, common_dir in seen:
            if real(wt.get('worktree', '')) in removed:
                continue
            try:
                ready.append((wt, main_path, common_dir) + self.dependency_check(wt, main_path, common_dir, cutoff))
            except Skip:
                continue
            except Exception as exc:  # any surprise keeps the files
                self.log.write(decision='keep-derived', rule='node_modules', path=wt.get('worktree', '?'),
                               reason='error: %r' % exc)
        if not ready:
            return
        try:
            held = self.processes()
        except Exception as exc:
            for item in ready:
                self.log.write(decision='keep-derived', rule='node_modules', path=item[3], reason='process scan: %s' % exc)
            return
        for wt, main_path, common_dir, rpath, why, dirs in ready:
            users = sorted(p for p in held if inside(p, rpath))
            if users:
                self.log.write(decision='keep-derived', rule='node_modules', path=rpath,
                               reason='in use by a process: %s' % users[0])
                continue
            if not self.args.dry_run:
                # Repeat the checks and the process scan immediately before deleting.
                try:
                    _, why, dirs = self.dependency_check(wt, main_path, common_dir,
                                                         time.time() - self.args.dependency_idle_hours * 3600)
                    users = sorted(p for p in self.processes() if inside(p, rpath))
                    if users:
                        raise Skip('in use by a process: %s' % users[0])
                except Exception as exc:
                    self.log.write(decision='keep-derived', rule='node_modules', path=rpath, reason='recheck: %s' % exc)
                    continue
            for full in dirs:
                freed = unique_bytes(full)
                if not self.args.dry_run:
                    try:
                        shutil.rmtree(full)
                    except OSError as exc:
                        self.log.write(decision='keep-derived', rule='node_modules', path=full, reason=str(exc))
                        continue
                self.done('node_modules', full, freed, why)

    def journeys(self):
        state = os.path.expanduser(self.args.journey_state)
        raw = os.path.join(state, 'raw')
        outs = [d for pattern in self.args.journey_out for d in glob.glob(os.path.expanduser(pattern)) if os.path.isdir(d)]
        if not os.path.isdir(raw) or not outs:
            return
        stamp = re.compile(r'^(?P<journey>.+)-(?P<start>\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d-\d{3}Z)$')
        held = None
        for run in sorted(os.listdir(raw)):
            match = stamp.match(run)
            if not match:
                continue
            journey, start = match.group('journey'), match.group('start')
            out = None
            for base in outs:
                timings = os.path.join(base, journey, 'timings.json')
                try:
                    with open(timings, encoding='utf-8') as fh:
                        started = json.load(fh).get('startedAt', '')
                except (OSError, ValueError):
                    continue
                if started.replace(':', '-').replace('.', '-') == start:
                    out = os.path.join(base, journey)
            if not out:
                continue
            for label in sorted(os.listdir(os.path.join(raw, run))):
                lab = os.path.join(raw, run, label)
                if not os.path.isdir(lab) or os.path.islink(lab):
                    continue
                video = os.path.join(out, 'video')
                if not glob.glob(os.path.join(glob.escape(video), glob.escape(label) + '-*.mp4')):
                    continue
                trace = os.path.join(lab, 'trace.raw.zip')
                scrubbed = os.path.join(video, label + '-trace.zip')
                if os.path.exists(trace) and not (os.path.isfile(scrubbed) and os.path.getsize(scrubbed) > 0):
                    continue
                files = sorted(glob.glob(os.path.join(glob.escape(lab), '*.webm')))
                files += [trace] if os.path.isfile(trace) else []
                if not files:
                    continue
                if held is None:
                    try:
                        held = self.processes()
                    except Exception as exc:
                        self.log.write(decision='keep-derived', rule='journey-raw', path=raw, reason='process scan: %s' % exc)
                        return
                for f in files:
                    if any(inside(real(f), real(os.path.expanduser(k))) for k in self.args.keep):
                        continue
                    if any(p == real(f) or inside(p, real(f)) for p in held):
                        self.log.write(decision='keep-derived', rule='journey-raw', path=f, reason='open in a process')
                        continue
                    freed = os.lstat(f).st_blocks * 512
                    if not self.args.dry_run:
                        try:
                            os.remove(f)
                        except OSError as exc:
                            self.log.write(decision='keep-derived', rule='journey-raw', path=f, reason=str(exc))
                            continue
                    self.done('journey-raw', f, freed, 'mp4 and scrubbed trace are in %s' % out)



def recheck(rpath, main_path, common_dir, args, log):
    entry = [e for e in list_worktrees(common_dir)[1:] if real(e.get('worktree', '')) == rpath]
    if len(entry) != 1:
        raise Skip('no longer registered')
    # Refetch so a remote branch deleted since the first pass is seen.
    git(['--git-dir', common_dir, 'fetch', '--all', '--prune', '--quiet'], '/', timeout=300)
    # Check-then-remove cannot be atomic, so interleave the checks: a writer
    # that exits during a scan is caught by the following evaluate, and a
    # process that arrives during an evaluate is caught by the following scan.
    # The scan runs last so the remaining window is the gap until the remove.
    for _ in range(2):
        evaluate(entry[0], main_path, common_dir, args, time.time() - args.idle_hours * 3600, True)
        held = scan_processes(not args.no_sudo, log)
        if IS_MAC:
            held = {real(p) for p in held} | held
        users = sorted(p for p in held if inside(p, rpath))
        if users:
            raise Skip('in use by a process: %s' % users[0])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--dry-run', action='store_true', help='decide and log, remove nothing')
    parser.add_argument('--root', action='append', help='scan root (repeatable); default ~/code, ~/company and ~/webb')
    parser.add_argument('--depth', type=int, default=3, help='directory depth searched for repositories')
    # 12 h matches wt-remove's activity guard; at 24 h lane worktree churn on the beelinks
    # (about 90 new trees in 6 h on 2026-10-11) outran the hourly reap and filled the disk.
    parser.add_argument('--idle-hours', type=float, default=12.0)
    parser.add_argument('--log-file', default=os.path.expanduser('~/.local/state/wt-reaper/wt-reaper.log'))
    parser.add_argument('--no-log-file', action='store_true')
    parser.add_argument('--no-sudo', action='store_true', help='never use sudo -n for the process scan')
    parser.add_argument('--no-derived', action='store_true', help='skip the derived-file passes')
    # 2026-10-11: discovery-lab retires its beelink run roots through the Lab (archive, then sha256-checked
    # removal), so nothing under ~/code/_runs is this reaper's, whole trees or derived files.
    parser.add_argument('--keep', action='append', help='path no pass touches (repeatable); default ~/code/_runs, the '
                        'archive drive /mnt/traces and the Discovery deploy roots')
    parser.add_argument('--dependency-idle-hours', type=float, default=6.0,
                        help='idle time before a merged worktree loses its node_modules')
    parser.add_argument('--journey-state', default='~/.local/state/gtm-journeys')
    parser.add_argument('--journey-out', action='append', help='journeys out directory glob (repeatable); '
                        'default ~/code/_wt/*/journeys/out')
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        # Root would see and remove other accounts' worktrees and would
        # create root-owned state in a user's repositories.
        parser.error('run as the owning user, not root')
    if args.root is None:
        args.root = [os.path.expanduser(r) for r in ('~/code', '~/company', '~/webb')]
    if not math.isfinite(args.idle_hours) or args.idle_hours <= 0:
        parser.error('--idle-hours must be a finite positive number')
    if not math.isfinite(args.dependency_idle_hours) or args.dependency_idle_hours <= 0:
        parser.error('--dependency-idle-hours must be a finite positive number')
    if args.journey_out is None:
        args.journey_out = ['~/code/_wt/*/journeys/out']
    if args.keep is None:
        # Discovery's pinned deploy checkouts are pruned by its keeper (discovery-lab runner/keeper.mjs
        # prunePinnedCheckouts). On 2026-10-18 the reaper spent over 2 h in D state reading one 47k-file deploy
        # on the archive drive, hit its timeout and restarted, while Discovery's per-run cost rose from 0.5 s to 5.7 s.
        # The next pass stalled the same way in a hostlab worktree there (/mnt/traces/hostlab-adc-b5/work/adc, one
        # directory block per 10 s at 300 ms r_await): a tree on that drive frees nothing on the disk this reaper
        # guards, and tangle-tools storage_lifecycle owns the drive, so no pass reads any of it.
        args.keep = ['~/code/_runs', '/mnt/traces', '~/.local/share/discovery-lab-deploys']
    return run(args)


if __name__ == '__main__':
    sys.exit(main())
