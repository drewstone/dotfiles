#!/usr/bin/env bash
# Every commit-time ratchet, in one entry point. The global pre-commit runs it, and so does any repo that sets
# its own core.hooksPath: agent-container, agent-runtime and agent-eval call "$(git config --global
# core.hooksPath)/ratchets". A new ratchet added here then reaches every repo without a repo change. Until
# 2026-10-21 those repos called loc-ratchet directly, so doc-ref-ratchet and dup-export-ratchet never ran there,
# and agent-runtime #1965 deleted files that docs still named.
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$dir/loc-ratchet"
"$dir/doc-ref-ratchet"
"$dir/dup-export-ratchet"
if command -v node >/dev/null 2>&1; then node "$dir/fn-ratchet.cjs"; fi
