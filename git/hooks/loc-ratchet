#!/usr/bin/env python3
"""Enforce file sizes at commit and report growth and long lines; `A..B [owner/repo#N]` is the merge check, which enforces them."""
from runpy import run_path
from types import SimpleNamespace
import os
import re
import sys

sys.dont_write_bytecode = True
census = SimpleNamespace(**run_path(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "census", "census")))


def third_party_fork():
    """Only GitHub metadata proving an external parent exempts this repository."""
    try:
        owners = census.FORK_PARENT_OWNERS.strip().lower()
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*)*", owners):
            return False
        origin = census.repository(census.git(".", "remote", "get-url", "origin").decode())
        match = re.fullmatch(r"https://github\.com/([\w.-]+/[\w.-]+)\.git", origin)
        if not match:
            return False
        repo = census.github(f"repos/{match[1]}")
        owner = repo.get("parent", {}).get("owner", {}).get("login", "").strip().lower()
        return repo.get("fork") is True and bool(owner) and owner not in owners.split(",")
    except Exception:
        return False


def main():
    merging = len(sys.argv) > 1
    if merging:  # the merge check: <base>..<head> [<owner>/<repo>#<number>]
        base, head = sys.argv[1].split("..", 1)
        head, merge = census.git(".", "rev-parse", "--verify", f"{head}^{{commit}}").decode().strip(), None
    else:
        base = census.optional_ref(".", "HEAD") or census.git(".", "hash-object", "-t", "tree", os.devnull).decode().strip()
        head = census.git(".", "write-tree").decode().strip()
        merge = census.optional_ref(".", "MERGE_HEAD")
    total, oversized, long, keys = census.production_delta(".", base, head, merge)
    # One total of production code: deletions anywhere offset additions anywhere, a cited restore is not growth, and tests or
    # docs never pay for it. Only a repository's first commit grows from nothing.
    total = round(total - (merging and census.restored(".", base, head, keys))) if census.git(".", "ls-tree", base).strip() else 0
    limit, pr = census.C.GROWTH_LIMIT, " ".join(sys.argv[2:])
    if not merging and total > 0:  # a commit is never refused for growth or line length
        print(f"loc-ratchet: this change adds {total} production lines; a PR whose total passes {limit} needs a growth approval to merge (git/census/README.md).", file=sys.stderr)
    for path, number, length in long:
        print(f"loc-ratchet: {'refusing merge: ' * merging}{path}:{number} adds a {length}-character line; a merge refuses an added production line over\n"
              f"  {census.C.LINE_LIMIT} characters unless one URL or hash is the excess. Line breaks cost nothing.", file=sys.stderr)
    grown, long = merging and total > limit, merging and long
    if (oversized or grown or long) and third_party_fork():
        return 0
    if grown := grown and not (pr and census.approved_growth(".", base, head, total, pr)):
        print(f"loc-ratchet: refusing merge: the PR adds {total} production lines (code tokens over {census.C.TOKENS_PER_LINE}),"
              f" over the {limit} that merge unapproved.\n"
              "  Deleted tests and docs do not pay for it; a restore of deleted code cites the deleting commit in a commit message, `Restores: <sha>`.\n"
              "  Otherwise a reviewer who did not write it judges it new, proportionate and reusing nothing that exists, then comments on the PR,\n"
              f"  under a session or run other than the one the PR's body names:\n"
              f"  Growth approved: {pr or '<owner>/<repo>#<number>'} at {head}: <why>\n  Session: <the reviewer's own>", file=sys.stderr)
    for path, old, new in oversized:
        print(f"loc-ratchet: refusing commit: {path}: {new} lines ({'new file' if old is None else f'was {old}'}).\n"
              f"  A logic file may not exceed {census.C.FILE_LIMIT} lines unless it already did and does not grow.", file=sys.stderr)
    return int(bool(oversized or grown or long))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as why:
        print(f"loc-ratchet: REFUSED: {why}", file=sys.stderr)
        sys.exit(2)
