#!/usr/bin/env python3
"""Enforce file sizes at commit and report growth; `A..B [owner/repo#N]` is the merge check, which enforces growth."""
from runpy import run_path
from types import SimpleNamespace
import os
import re
import sys

sys.dont_write_bytecode = True
census = SimpleNamespace(**run_path(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "census", "census")))
LOCKFILE = re.compile(r"(^|/)(pnpm-lock\.yaml|package-lock\.json|yarn\.lock|bun\.lockb?|Cargo\.lock|uv\.lock|poetry\.lock|go\.sum)$")


def third_party_fork():
    """Only GitHub metadata proving an external parent exempts this repository."""
    try:
        owners = census.FORK_PARENT_OWNERS.strip().lower()
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*)*", owners):
            return False
        origin = census.repository(census.git(".", "remote", "get-url", "origin").decode())
        match = re.fullmatch(r"https://github\.com/([\w.-]+/[\w.-]+)\.git", origin)
        if not match:
            return False
        repo = census.github(f"repos/{match[1]}")
        owner = repo.get("parent", {}).get("owner", {}).get("login", "").strip().lower()
        return repo.get("fork") is True and bool(owner) and owner not in owners.split(",")
    except Exception:
        return False


def net_lines(base, head):
    """Lines the change adds less lines it deletes in every text file but lockfiles: tests, docs and comments count."""
    links = [{p for p, kind in census.tree_entries(".", ref).items() if kind == "commit"} for ref in (base, head)]
    rows = census.git(".", "diff", "--numstat", "-z", "--no-renames", base, head).decode().split("\0")
    return sum(int(a) - int(d) + (path in links[0]) - (path in links[1])
               for a, d, path in (r.split("\t", 2) for r in rows if r.count("\t") >= 2)
               if a.isdigit() and not LOCKFILE.search(path))


def main():
    if len(sys.argv) > 1:  # the merge check: <base>..<head> [<owner>/<repo>#<number>]
        base, head = sys.argv[1].split("..", 1)
        head, merge = census.git(".", "rev-parse", "--verify", f"{head}^{{commit}}").decode().strip(), None
    else:
        base = census.optional_ref(".", "HEAD") or census.git(".", "hash-object", "-t", "tree", os.devnull).decode().strip()
        head = census.git(".", "write-tree").decode().strip()
        merge = census.optional_ref(".", "MERGE_HEAD")
    growth, oversized = census.production_delta(".", base, head, merge)
    # One total: deletions anywhere offset additions anywhere. Only a repository's first commit grows from nothing.
    total = sum(growth.values()) if census.git(".", "ls-tree", base).strip() else 0
    limit, pr = census.C.GROWTH_LIMIT, " ".join(sys.argv[2:])
    if len(sys.argv) == 1 and total > 0:  # a commit is never refused for growth
        print(f"loc-ratchet: this change adds {total} production lines; a PR whose total passes {limit} needs a growth approval to merge (git/census/README.md).", file=sys.stderr)
    grown = len(sys.argv) > 1 and total > limit and (net := net_lines(base, head)) > 0
    if (oversized or grown) and third_party_fork():
        return 0
    if grown := grown and not (pr and census.approved_growth(".", base, head, total, pr)):
        print(f"loc-ratchet: refusing merge: the PR adds {total} production lines ({net} net lines of all text), over the {limit} that merge unapproved.\n"
              "  Delete low-value tests and dead code first. Otherwise a reviewer who did not write it judges it new, proportionate and reusing nothing\n"
              f"  that exists, then comments on the PR:\n  Growth approved: {pr or '<owner>/<repo>#<number>'} at {head}: <why>", file=sys.stderr)
    for path, old, new in oversized:
        print(f"loc-ratchet: refusing commit: {path}: {new} lines ({'new file' if old is None else f'was {old}'}).\n"
              f"  A logic file may not exceed {census.C.FILE_LIMIT} lines unless it already did and does not grow.", file=sys.stderr)
    return int(bool(oversized or grown))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as why:
        print(f"loc-ratchet: REFUSED: {why}", file=sys.stderr)
        sys.exit(2)
