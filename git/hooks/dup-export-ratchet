#!/usr/bin/env python3
"""Refuse a commit that exports a name another file in the repo already exports.

Drew, 2026-10-21, after the god-object splits: "repos and primitives need to be reusable and smart and
simple and succinct", and "no miscommunication or confusion should be allowed". That morning
agent-container exported 659 names from two or more files (logger from 24, JsonValue from 11, shellQuote
from 6), so an agent could not tell which one to use, and every copy drifted on its own.

The rule: a staged TypeScript or JavaScript declaration `export function|class|interface|type|const|let|enum X`
is refused when another non-test file in the staged tree already declares `export ... X`. Import the
existing one, move it into its owner, or give the new one a name that says how it differs.

Moving an export from one file to another in the same commit passes, because the old copy is gone from
the staged tree, and so does editing a declaration in place, even one that is already duplicated. Names that frameworks require in every route or entry file (GET, loader, metadata, main,
default and similar) are not checked. Tests, type declarations and generated or vendored paths are skipped.
The TypeScript AST owner ignores comments, literals, export lists and barrels, and counts every const/let binding.
There is no escape variable; fixture repos set core.hooksPath=/dev/null like every other global hook here.
"""
import os
import collections
import json
import subprocess
import sys

sys.dont_write_bytecode = True  # the installed checkout stays clean
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "census"))
import classify  # noqa: E402  the census owns the classification, so this hook and the census count alike

AST_OWNER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "census", "functions.cjs")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def blobs(specs, *, missing=False):
    """Read the requested Git blobs in one process, including index paths outside a sparse checkout."""
    if not specs:
        return {}
    run = subprocess.run(["git", "cat-file", "--batch"], input="".join(f"{spec}\n" for spec in specs).encode(),
                         capture_output=True)
    if run.returncode:
        raise RuntimeError(run.stderr.decode(errors="replace").strip())
    result, offset = {}, 0
    for spec in specs:
        end = run.stdout.index(b"\n", offset)
        header, offset = run.stdout[offset:end].split(), end + 1
        if header[-1:] == [b"missing"] and missing:
            continue
        if len(header) != 3 or header[1] != b"blob":
            raise RuntimeError(f"cannot read {spec} as a blob")
        size = int(header[2])
        result[spec] = run.stdout[offset:offset + size].decode(errors="replace")
        offset += size + 1
    return result


def declarations(texts):
    if not texts:
        return {}
    run = subprocess.run(["node", AST_OWNER, os.getcwd()], capture_output=True, text=True,
                         input=json.dumps([{"file": path, "text": text} for path, text in texts.items()]))
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or "functions.cjs failed")
    result = json.loads(run.stdout)
    if result["parsed"] != len(texts):
        raise RuntimeError("functions.cjs did not parse every blob")
    found = collections.defaultdict(set)
    for _line, _column, path, name in result["exports"]:
        if name not in classify.CONVENTION:
            found[path].add(name)
    return found


def main():
    if git("rev-parse", "-q", "--verify", "HEAD").returncode != 0:
        return 0
    changed = [p for p in git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").stdout.split("\0")
               if classify.source(p)]
    if not changed:
        return 0
    # Compare declarations, not changed text: literals/comments cannot introduce exports, and an initializer edit
    # leaves the same declaration in place. During a merge either parent's declaration is already established.
    parents = ["HEAD"]
    if git("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0:
        parents.append("MERGE_HEAD")
    texts = blobs([f":{p}" for p in changed])
    texts.update(blobs([f"{ref}:{p}" for ref in parents for p in changed], missing=True))
    found = declarations(texts)
    added = collections.defaultdict(set)
    for path in changed:
        previous = set().union(*(found.get(f"{ref}:{path}", set()) for ref in parents))
        for name in found.get(f":{path}", set()) - previous:
            added[name].add(path)
    if not added:
        return 0
    # The staged tree is authoritative: deleted/moved copies and unstaged edits must not change this decision.
    peers = [p for p in git("ls-files", "--cached", "-z").stdout.split("\0")
             if classify.source(p) and p not in changed]
    # An escaped identifier may contain none of its decoded spelling. Keep all Unicode escapes conservatively;
    # comments/literals can add candidates here, but only the AST can establish a declaration.
    peer_texts = blobs([f":{p}" for p in peers])
    peers_found = declarations({spec: text for spec, text in peer_texts.items()
                               if "\u" in text or any(name in text for name in added)})
    owners = collections.defaultdict(set)
    for spec, names in {**peers_found, **{f":{p}": found.get(f":{p}", set()) for p in changed}}.items():
        for name in names:
            owners[name].add(spec[1:])
    clashes = []
    for name, paths in sorted(added.items()):
        others = sorted(owners[name] - paths)
        if others or len(paths) > 1:
            clashes.append((name, sorted(paths), others or ["another file in this commit"]))
    if not clashes:
        return 0
    sys.stderr.write("dup-export-ratchet: refusing commit: it exports a name another file already exports.\n")
    for name, paths, others in clashes[:30]:
        sys.stderr.write(f"  {name}: new in {', '.join(paths)}; already exported by {', '.join(others[:4])}{' ...' if len(others) > 4 else ''}\n")
    sys.stderr.write(
        "  Import the existing export, move it into its one owner, or rename the new one to say how it differs.\n"
    )
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, ValueError, OSError) as error:
        sys.stderr.write(f"dup-export-ratchet: refused: {error}\n")
        sys.exit(2)
