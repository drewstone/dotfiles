#!/usr/bin/env python3
"""Refuse a commit that exports a name another file in the repo already exports.

Drew, 2026-10-21, after the god-object splits: "repos and primitives need to be reusable and smart and
simple and succinct", and "no miscommunication or confusion should be allowed". That morning
agent-container exported 659 names from two or more files (logger from 24, JsonValue from 11, shellQuote
from 6), so an agent could not tell which one to use, and every copy drifted on its own.

The rule: a staged TypeScript or JavaScript declaration `export function|class|interface|type|const|enum X`
is refused when another non-test file in the staged tree already declares `export ... X`. Import the
existing one, move it into its owner, or give the new one a name that says how it differs.

Moving an export from one file to another in the same commit passes, because the old copy is gone from
the staged tree, and so does editing a declaration in place, even one that is already duplicated. Names that frameworks require in every route or entry file (GET, loader, metadata, main,
default and similar) are not checked. Tests, type declarations and generated or vendored paths are skipped.
There is no escape variable; fixture repos set core.hooksPath=/dev/null like every other global hook here.
"""
import re
import subprocess
import sys

SOURCE = re.compile(r"\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$")
SKIP = re.compile(
    r"(\.d\.[cm]?ts$|\.(test|spec)\.[^/]+$|(^|/)(__tests__|tests?|e2e|fixtures|testdata|generated|vendor|node_modules|dist|build)/)"
)
DECL = re.compile(r"^[+-]export (?:default )?(?:declare )?(?:async )?(?:abstract )?(?:function\*?|class|interface|type|const|let|enum) ([A-Za-z_$][\w$]*)")
CONVENTION = {
    "main", "default", "config", "handler", "runtime", "dynamic", "revalidate", "metadata", "viewport",
    "generateMetadata", "generateStaticParams", "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS",
    "loader", "action", "meta", "links", "headers", "handle", "ErrorBoundary", "HydrateFallback",
    "clientLoader", "clientAction", "shouldRevalidate", "Route", "Props",
}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def main():
    if git("rev-parse", "-q", "--verify", "HEAD").returncode != 0:
        return 0
    added, removed = {}, set()
    path = None
    for line in git("diff", "--cached", "--no-color", "--no-ext-diff", "-U0", "--diff-filter=ACMR").stdout.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
            continue
        if not path or not SOURCE.search(path) or SKIP.search(path):
            continue
        m = DECL.match(line)
        if m and line[0] == "-":
            removed.add((path, m.group(1)))
        elif m and m.group(1) not in CONVENTION:
            added.setdefault(m.group(1), set()).add(path)
    # A declaration this commit only edits in place (it removes and re-adds the same name in the same file)
    # is not new; the ratchet refuses only duplicates the commit creates.
    added = {n: {p for p in ps if (p, n) not in removed} for n, ps in added.items()}
    added = {n: ps for n, ps in added.items() if ps}
    clashes = []
    for name, paths in sorted(added.items()):
        # POSIX ERE (git grep -E) has no \b on every platform, so the name ends at a non-identifier character.
        pattern = rf"^export (default )?(declare )?(async )?(abstract )?(function\*?|class|interface|type|const|let|enum) {re.escape(name)}([^A-Za-z0-9_$]|$)"
        hits = git("grep", "--cached", "-l", "-E", pattern, "--", "*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.mts", "*.cts").stdout.split()
        others = sorted(h for h in hits if h not in paths and not SKIP.search(h))
        if others or len(paths) > 1:
            clashes.append((name, sorted(paths), others or ["another file in this commit"]))
    if not clashes:
        return 0
    sys.stderr.write("dup-export-ratchet: refusing commit: it exports a name another file already exports.\n")
    for name, paths, others in clashes[:30]:
        sys.stderr.write(f"  {name}: new in {', '.join(paths)}; already exported by {', '.join(others[:4])}{' ...' if len(others) > 4 else ''}\n")
    sys.stderr.write(
        "  Import the existing export, move it into its one owner, or rename the new one to say how it differs.\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
