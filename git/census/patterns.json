{
  "about": "The one classification every census instrument and ratchet reads (git/census/README.md). Patterns are regular expressions both Python and JavaScript accept.",
  "logic": "\\.(ts|tsx|js|jsx|mjs|cjs|py|rs|go|sh|bash|sql|rb|java|kt|swift|sol)$",
  "workflow": "(^|/)\\.github/workflows/[^/]+\\.ya?ml$",
  "exempt": "(\\.d\\.ts$|\\.min\\.js$|\\.(test|spec)\\.[^/]+$|_test\\.go$|(^|/)test_[^/]+\\.py$|(^|/)(__tests__|tests?|e2e|fixtures|testdata|generated|vendor|node_modules|dist|build|migrations)/)",
  "test": "(\\.(test|spec)\\.[^/]+$|_test\\.go$|(^|/)test_[^/]+\\.py$|(^|/)(__tests__|tests?|e2e)/)",
  "source": "\\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$",
  "skip": "(\\.d\\.[cm]?ts$|\\.min\\.js$|\\.(test|spec)\\.[^/]+$|(^|/)(__tests__|tests?|e2e|fixtures|testdata|generated|vendor|node_modules|dist|build)/)",
