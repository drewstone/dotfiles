#!/bin/sh
# Installed by ~/dotfiles/host/provision.sh (wifi module).
# mt7925e firmware resets look like a wrong key to NetworkManager. It then marks
# the profile "no-secrets" and stops autoconnecting, and a headless box has no
# secret agent to answer, so the box stays offline until someone reconnects it.
# When the box has no connection, bring Wi-Fi profiles up again, most recently
# used first. An explicit "connection up" clears the autoconnect block.
[ "$(nmcli -t -f RUNNING general 2>/dev/null)" = running ] || exit 0
case "$(nmcli -t -f STATE general 2>/dev/null)" in
  connected* | connecting) exit 0 ;;
esac
nmcli -t -f TIMESTAMP,UUID,TYPE,AUTOCONNECT connection show |
  awk -F: '$3 == "802-11-wireless" && $4 == "yes" { print $1, $2 }' |
  sort -rn |
  while read -r _ uuid; do
    name="$(nmcli -g connection.id connection show uuid "$uuid" 2>/dev/null)"
    logger -t wifi-watchdog "not connected; bringing up $name"
    if nmcli --wait 45 connection up uuid "$uuid" >/dev/null 2>&1; then
      logger -t wifi-watchdog "reconnected $name"
      exit 0
    fi
    logger -t wifi-watchdog "reconnect of $name failed"
  done
