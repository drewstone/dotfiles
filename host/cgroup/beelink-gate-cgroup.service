# Transitional raw groups remain only while retained old gate sources drain.
# New gates stay in systemd-owned beelinkgate.slice units; no PID migration.
[Unit]
Description=Beelink gate resource policy and legacy drain protection

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p /sys/fs/cgroup/beelink-gate /sys/fs/cgroup/beelink-gate-dev
ExecStart=/usr/local/libexec/beelink-memory-policy --apply

[Install]
WantedBy=multi-user.target
