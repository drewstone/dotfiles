#!/usr/bin/env bash
# Resource owner: --apply/--check use installed policy; --read-policy [file]
# prints validated values. Apply never restarts Actions runners.
set -euo pipefail
mode=${1:---apply}
if [[ "$mode" == --read-policy ]]; then
python3 - "${@:2}" <<'PYTHON'
import json, os, stat
import sys
if len(sys.argv) > 2: sys.exit(64)
path = sys.argv[1] if len(sys.argv) == 2 else '/etc/beelink-gate/resource-policy.json'
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
with os.fdopen(fd) as stream:
    info = os.fstat(stream.fileno())
    if not stat.S_ISREG(info.st_mode) or (len(sys.argv) == 1 and info.st_uid != 0) or info.st_mode & 0o022 or info.st_size > 4096:
        raise SystemExit('unsafe gate resource policy')
    row = json.load(stream)
keys = ('cpu_weight', 'io_weight', 'normal_memory_bytes', 'dev_memory_bytes', 'normal_cpu_percent_per_host_cpu', 'normal_cpu_period_us')
if set(row) != set(keys) or any(type(row[key]) is not int or row[key] <= 0 for key in keys):
    raise SystemExit('invalid gate resource policy')
if row['cpu_weight'] > 10000 or row['io_weight'] > 10000 or row['normal_cpu_percent_per_host_cpu'] > 100 or not 1000 <= row['normal_cpu_period_us'] <= 1000000:
    raise SystemExit('invalid gate resource policy range')
print(*(row[key] for key in keys))
PYTHON
exit
fi
[[ "$mode" == --apply || "$mode" == --check ]] || exit 64
[[ $(id -u) == 0 ]] || { echo 'run as root' >&2; exit 77; }
case $(hostname) in DESKTOP-18IR33V|beelink1) index=1;; DESKTOP-10CQNP0|beelink2) index=2;; *)
  # WSL hostnames differ across provisioning; match the existing ADC unit.
  if systemctl cat actions.runner.tangle-network.deploy-beelink1-adc-01.service >/dev/null 2>&1; then index=1
  elif systemctl cat actions.runner.tangle-network.deploy-beelink2-adc-01.service >/dev/null 2>&1; then index=2
  else echo 'no ADC deploy runner on this host' >&2; exit 69; fi;; esac
# The installer reads its checkout explicitly; live apply/check always use the root-owned installed policy.
read -r gate_cpu gate_io normal_memory dev_memory normal_percent normal_period < <("$0" --read-policy)
[[ "$gate_cpu" =~ ^[0-9]+$ && "$normal_memory" =~ ^[0-9]+$ ]] || exit 69
normal_cpu=$(( $(getconf _NPROCESSORS_ONLN) * normal_percent * normal_period / 100 ))
priority_drift=0
# Lower both CPU groups first, even if this kernel lacks the IO controller.
for file in cpu.weight io.weight; do
  for group in beelink-gate beelink-gate-dev; do
    if [[ "$file" == io.weight ]]; then
      path="/sys/fs/cgroup/$group/$file"
      if [[ ! -e "$path" && ! -L "$path" ]]; then
        [[ -r "/sys/fs/cgroup/$group/io.stat" && -r "/sys/fs/cgroup/$group/io.pressure" ]] || {
          echo "cannot establish IO controller support for $group" >&2; exit 69;
        }
        echo "UNSUPPORTED $group io.weight: systemd IOWeight remains configured; device enforcement unproved" >&2
        continue
      fi
      expected="default:$gate_io"
      actual="default:$(awk '$1 == "default" {print $2}' "$path")"
    else expected=$gate_cpu; actual=$(cat "/sys/fs/cgroup/$group/$file"); fi
    if [[ "$actual" != "$expected" ]]; then
      if [[ "$mode" == --check ]]; then echo "DRIFT $group $file"; priority_drift=1
      elif [[ "$file" == io.weight ]]; then echo "default $gate_io" > "/sys/fs/cgroup/$group/$file"
      else echo "$expected" > "/sys/fs/cgroup/$group/$file"; fi
    fi
  done
done
if [[ $(cat /sys/fs/cgroup/beelink-gate/cpu.max) != "$normal_cpu $normal_period" ]]; then
  if [[ "$mode" == --check ]]; then echo 'DRIFT legacy normal CPU ceiling'; priority_drift=1
  else echo "$normal_cpu $normal_period" > /sys/fs/cgroup/beelink-gate/cpu.max; fi
fi
GiB=1073741824
uid=$(id -u ghrunner-adcprod)
# MemoryMin is used-page reclaim protection, not a preallocated reservation or
# immunity from an ancestor OOM. Bound release compilation separately and keep
# the former 32G deploy allowance plus two 12G release allowances in its parent.
properties() {
  printf '%s\n' "beelinkgate.slice CPUWeight $gate_cpu" "beelinkgate.slice IOWeight $gate_io" \
    "beelinkgate-normal.slice CPUWeight $gate_cpu" "beelinkgate-normal.slice IOWeight $gate_io" \
    "beelinkgate-dev.slice CPUWeight $gate_cpu" "beelinkgate-dev.slice IOWeight $gate_io" \
    "beelinkgate-normal.slice MemoryMax $normal_memory" "beelinkgate-dev.slice MemoryMax $dev_memory"
  printf '%s\n' 'deploy.slice MemoryMin 8589934592'  \
    'deploy-runners.slice MemoryMin 8589934592' \
    'deploy-runners.slice MemoryMax 60129542144'
  for n in 01 02; do
    echo "actions.runner.tangle-network.deploy-beelink${index}-adc-${n}.service MemoryMin $((4*GiB))"
    echo "actions.runner.tangle-network.release-beelink${index}-adc-${n}.service MemoryMax $((12*GiB))"
  done
  for unit in user.slice "user-${uid}.slice" "user@${uid}.service"; do
    echo "$unit MemoryMin $((8*GiB))"
  done
}
# A cap below current usage could kill a live job during installation. Refuse
# before changing any memory cap; priority lowering above is safe independently.
for entry in "beelink-gate $normal_memory" "beelink-gate-dev $dev_memory"; do
  read -r group value <<<"$entry"
  current=$(cat "/sys/fs/cgroup/$group/memory.current")
  if (( current > value )); then
    echo "$group exceeds its memory cap; no memory policy changed" >&2; exit 75
  fi
done
while read -r unit property value; do
  if [[ $property == MemoryMax ]]; then
    current=$(systemctl show "$unit" -p MemoryCurrent --value)
    # Loaded but inactive units have no cgroup at boot and report [not set].
    if [[ "$current" == '[not set]' &&
          $(systemctl show "$unit" -p LoadState --value) == loaded &&
          -z $(systemctl show "$unit" -p ControlGroup --value) ]]; then current=0; fi
    [[ "$current" =~ ^[0-9]+$ ]] || { echo "cannot read $unit memory" >&2; exit 69; }
    (( current <= value )) || { echo "$unit exceeds its memory cap; no memory policy changed" >&2; exit 75; }
  fi
done < <(properties)
drift=$priority_drift
while read -r unit property value; do
  actual=$(systemctl show "$unit" -p "$property" --value)
  if [[ $actual != "$value" ]]; then
    if [[ $mode == --check ]]; then echo "DRIFT $unit $property=$actual expected=$value"; drift=1
    else systemctl set-property "$unit" "$property=$value"; fi
  fi
done < <(properties)
# CPUQuotaPerSecUSec uses human timespan formatting; compare the effective
# kernel ratio instead. Inactive slices use their persistent unit-file policy.
normal_path=$(systemctl show beelinkgate-normal.slice -p ControlGroup --value)
if [[ -n "$normal_path" ]]; then
  read -r quota period < "/sys/fs/cgroup$normal_path/cpu.max"
  if [[ ! "$quota" =~ ^[0-9]+$ ]] || (( quota * normal_period != normal_cpu * period || period != normal_period )); then
    if [[ "$mode" == --check ]]; then echo 'DRIFT managed normal CPU ceiling'; drift=1
    else systemctl set-property beelinkgate-normal.slice "CPUQuota=$(( $(getconf _NPROCESSORS_ONLN) * normal_percent ))%" "CPUQuotaPeriodSec=${normal_period}us"; fi
  fi
fi
dev_path=$(systemctl show beelinkgate-dev.slice -p ControlGroup --value)
if [[ -n "$dev_path" ]]; then
  read -r quota _ < "/sys/fs/cgroup$dev_path/cpu.max"
  if [[ "$quota" != max ]]; then
    if [[ "$mode" == --check ]]; then echo 'DRIFT managed dev CPU ceiling'; drift=1
    else systemctl set-property beelinkgate-dev.slice CPUQuota=; fi
  fi
fi
# Rootless image builds are charged to the user manager, outside runner units.
# Carry the floor through its app slice to Docker's service, too.
docker_floor=deferred
if systemctl is-active --quiet "user@${uid}.service"; then
# The ancestor's 8G floor is shared by daemon and container scopes. Defaults
# protect future scopes; enforce the kernel floor on already-running scopes.
userctl() { sudo -n -H -u ghrunner-adcprod env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user "$@"; }
# Install defaults before listing scopes so concurrent containers inherit them.
for unit in user.slice app.slice docker.service; do
  props=(MemoryMin)
  [[ $unit != user.slice ]] || props+=(DefaultMemoryMin)
  for property in "${props[@]}"; do
    actual=$(userctl show "$unit" -p "$property" --value)
    if [[ $actual != "$((8*GiB))" ]]; then
      if [[ $mode == --check ]]; then echo "DRIFT production Docker $unit $property=$actual"; drift=1
      else userctl set-property "$unit" "$property=8G"; fi
    fi
  done
done
# Scopes are transient; never retain a configuration file per container ID.
# A scope disappearing while we read/write is safe; all other errors fail.
scopes=$(userctl list-units --type=scope --no-legend --plain 'docker-*.scope')
while read -r unit _; do
  [[ -n "$unit" ]] || continue
  # DefaultMemoryMin inheritance is reflected in the kernel, not raw MemoryMin.
  path=$(userctl show "$unit" -p ControlGroup --value)
  if [[ -z "$path" ]] || ! actual=$(cat "/sys/fs/cgroup$path/memory.min") || [[ ! $actual =~ ^[0-9]+$ ]]; then
    [[ $(userctl show "$unit" -p LoadState --value) == not-found ]] && continue
    echo "cannot read production Docker $unit memory.min" >&2; exit 69
  fi
  [[ $actual != "$((8*GiB))" ]] || continue
  if [[ $mode == --check ]]; then
    [[ $(userctl show "$unit" -p LoadState --value) != not-found ]] || continue
    echo "DRIFT production Docker $unit MemoryMin=$actual"; drift=1
  elif ! userctl set-property --runtime "$unit" MemoryMin=8G; then
    [[ $(userctl show "$unit" -p LoadState --value) == not-found ]] || exit 1
  fi
done <<<"$scopes"
docker_floor=8G
else
  echo 'DEFERRED production Docker app/service floors: user manager inactive' >&2
  [[ $mode != --check ]] || drift=1
fi
for entry in "beelink-gate $normal_memory" "beelink-gate-dev $dev_memory"; do
  read -r group value <<<"$entry"
  file="/sys/fs/cgroup/$group/memory.max"
  if [[ $(cat "$file") != "$value" ]]; then
    if [[ $mode == --check ]]; then echo "DRIFT $group memory.max expected=$value"; drift=1
    else echo "$value" >"$file"; fi
  fi
done
(( drift == 0 )) || exit 1
echo "Beelink resource policy OK: gate CPU priority, configured IOWeight, memory containment, Docker=$docker_floor floor"
