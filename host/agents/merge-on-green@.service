[Unit]
Description=Merge green tangle-network/%i PRs (instance <repo>:<base>; dotfiles claude/tools/merge-on-green)
Documentation=file://%h/bin/merge-on-green

[Service]
Type=oneshot
Environment=FLEET_LANE=op-company:merge-on-green
# Every check on the head is the gate; a head with no checks merges only on its beelink-gate receipt.
Environment=MERGE_ON_GREEN_REQUIRED=*
# These repos hold under 25 open PRs (oldest first past that); a full read costs about 28 GraphQL points, and
# with --probe a tick costs 2 until something changes.
Environment=MERGE_ON_GREEN_PAGE=25
ExecStart=/bin/bash -lc 'i="%i"; exec %h/bin/merge-on-green --probe --repo "tangle-network/$${i%%%%:*}" --base "$${i#*:}" --state-dir "%h/.local/state/merge-on-green-org/$${i%%%%:*}"'
TimeoutStartSec=10min
