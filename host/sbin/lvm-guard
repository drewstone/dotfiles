#!/usr/bin/env bash
# lvm wrapper, installed under every mutating lvm verb name and as `lvm`.
# A verb passes only when every /dev argument and every physical volume of
# every named VG or LV is off the root disk. Loop-backed VGs pass. Query verbs
# pass untouched.
set -uo pipefail
. /usr/local/lib/host-blast-guard.sh
real=/usr/sbin/lvm
[ -x "$real" ] || exit 127
verb="$(basename "$0")"
args=("$@")
if [ "$verb" = "lvm" ]; then
  verb="${1:-}"
  args=("${@:2}")
  [ -n "$verb" ] || exec "$real"
fi
hbg_off && exec "$real" "$verb" "${args[@]}"
case "$verb" in
  pvcreate|vgcreate|lvcreate|lvremove|vgremove|pvremove|lvchange|vgchange|lvconvert|lvresize|lvextend|lvreduce|vgextend|vgreduce|pvresize|vgrename|lvrename|vgmerge|vgsplit|pvmove|vgcfgrestore|vgimportclone|lvmconfig) ;;
  *) exec "$real" "$verb" "${args[@]}" ;;
esac
check_vg() {
  local vg="$1" pv
  [ -n "$vg" ] || return 0
  while read -r pv; do
    [ -n "$pv" ] || continue
    hbg_on_root_disk "$pv" && hbg_refuse "$verb" "VG $vg has physical volume $pv on the root disk"
  done < <("$real" pvs --noheadings -o pv_name -S "vg_name=$vg" 2>/dev/null | tr -d ' ')
  return 0
}
for a in "${args[@]}"; do
  case "$a" in
    /dev/*) hbg_check_dev_arg "$verb" "$a" ;;
    -*) ;;
    *)
      check_vg "${a%%/*}"
      ;;
  esac
done
exec "$real" "$verb" "${args[@]}"
