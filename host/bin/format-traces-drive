#!/usr/bin/env bash
# Erase one named drive and make it the ext4 trace drive, labelled "traces".
# Then host/provision.sh traces mounts it at /mnt/traces for the calling user.
#
# Usage: sudo host/bin/format-traces-drive --model MODEL --serial SERIAL [--transport TRAN]
#
# Drew runs this himself, in a terminal outside Claude and Codex. Two checks
# stop an agent that runs it by mistake: the Claude host-blast-guard hook
# refuses any command that names this script, except one read-only command
# such as cat or grep, also over ssh; and this script refuses when a claude or
# codex process is one of its ancestors. They do not stop an agent that means
# to erase a disk, because an agent with sudo can erase one without it.
#
# It refuses unless exactly one whole disk has SERIAL and that disk also has
# MODEL (and TRAN, when given). It also refuses the disk that holds / or /boot,
# a disk with a mounted or active partition, and a disk that is part of LVM,
# RAID, LUKS or ZFS. After ERASE it checks all of that again, then writes only
# through the /dev/disk/by-id name that carries SERIAL, so a disk that was
# unplugged or renamed while the prompt waited is never erased.
#
# Find the values with: lsblk -dno NAME,MODEL,SERIAL,TRAN,SIZE
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WANT_MODEL=""
WANT_SERIAL=""
WANT_TRAN=""

die() { printf 'REFUSING: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '5p' "$0" | sed 's/^# //'; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --model) WANT_MODEL="${2:-}"; shift 2 ;;
    --serial) WANT_SERIAL="${2:-}"; shift 2 ;;
    --transport) WANT_TRAN="${2:-}"; shift 2 ;;
    -h | --help) usage ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage ;;
  esac
done
if [ -z "$WANT_MODEL" ] || [ -z "$WANT_SERIAL" ]; then usage; fi
[ "$(id -u)" = 0 ] || die "run with sudo"
if [ -z "${SUDO_USER:-}" ] || [ "$SUDO_USER" = root ]; then die "run with sudo from the account that will own /mnt/traces"; fi

# agent_ancestor: print the first claude or codex process above this one.
agent_ancestor() {
  local pid=$PPID comm
  while [ "${pid:-0}" -gt 1 ]; do
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || return 1
    case "$comm" in
      claude | codex) printf '%s (pid %s)\n' "$comm" "$pid"; return 0 ;;
    esac
    pid="$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)"
  done
  return 1
}
if agent=$(agent_ancestor); then
  die "an agent started this: $agent is an ancestor. Drew runs it in a terminal outside Claude and Codex"
fi

trim() { sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }
field() { lsblk -dno "$1" "$2" 2>/dev/null | trim; }

# check_disk: set DEV and BYID for the one disk that matches, or refuse.
check_disk() {
  local name m src n link
  local -a matches=()
  while read -r name; do
    [ "$(field SERIAL "$name")" = "$WANT_SERIAL" ] && matches+=("$name")
  done < <(lsblk -dnpo NAME,TYPE | awk '$2 == "disk" { print $1 }')
  [ ${#matches[@]} -eq 1 ] || die "${#matches[@]} disks have serial '$WANT_SERIAL' (want exactly 1)"
  DEV="${matches[0]}"

  [ "$(field MODEL "$DEV")" = "$WANT_MODEL" ] || die "$DEV has model '$(field MODEL "$DEV")', not '$WANT_MODEL'"
  if [ -n "$WANT_TRAN" ] && [ "$(field TRAN "$DEV")" != "$WANT_TRAN" ]; then
    die "$DEV is on transport '$(field TRAN "$DEV")', not '$WANT_TRAN'"
  fi

  # The disks under /, /boot and /boot/efi. A mount point can carry several
  # stacked mounts, one source per line. -l lists plain names; the default tree
  # output prefixes them with drawing characters.
  for m in / /boot /boot/efi; do
    while read -r src; do
      src="${src%%\[*}"
      for n in $(lsblk -snlpo NAME "$src" 2>/dev/null); do
        [ "$n" = "$DEV" ] && die "$DEV holds $m"
      done
    done < <(findmnt -nro SOURCE --mountpoint "$m" 2>/dev/null)
  done
  if lsblk -nro MOUNTPOINTS "$DEV" 2>/dev/null | grep . >/dev/null; then
    die "$DEV has a mounted partition or active swap: $(lsblk -nro NAME,MOUNTPOINTS "$DEV" | awk 'NF > 1' | tr '\n' ' ')"
  fi
  if lsblk -nro FSTYPE "$DEV" | grep -E 'LVM2_member|linux_raid_member|crypto_LUKS|zfs_member' >/dev/null; then
    die "$DEV is part of LVM, RAID, LUKS or ZFS"
  fi
  if [ -n "$(find "/sys/class/block/${DEV#/dev/}/holders" "/sys/class/block/${DEV#/dev/}"/*/holders -mindepth 1 -maxdepth 1 2>/dev/null)" ]; then
    die "$DEV or one of its partitions is held by device-mapper or RAID"
  fi

  BYID=""
  for link in /dev/disk/by-id/*"$WANT_SERIAL"*; do
    case "$link" in *-part[0-9]*) continue ;; esac
    if [ -L "$link" ] && [ "$(readlink -f "$link")" = "$DEV" ]; then
      BYID="$link"
      break
    fi
  done
  [ -n "$BYID" ] || die "no /dev/disk/by-id name for $DEV carries serial '$WANT_SERIAL'"
}

check_disk
echo "About to ERASE every partition and all data on:"
lsblk -o NAME,MODEL,SERIAL,TRAN,SIZE,FSTYPE,LABEL "$DEV"
echo "($BYID)"
[ -r /dev/tty ] || die "no terminal to confirm on"
read -r -p "Type ERASE to continue: " answer </dev/tty
[ "$answer" = ERASE ] || { echo "aborted"; exit 1; }

# The prompt can wait for hours. Check the disk again, and write through the
# by-id name from here on: it names this serial, never the next disk that
# takes the /dev/sdX name.
seen_dev="$DEV"
seen_byid="$BYID"
check_disk
[ "$DEV" = "$seen_dev" ] && [ "$BYID" = "$seen_byid" ] ||
  die "the disk changed while the prompt waited ($seen_dev is now $DEV); run it again"

shopt -s nullglob
parts=("$BYID"-part*)
shopt -u nullglob
wipefs -a ${parts[@]+"${parts[@]}"} "$BYID"
parted -s "$BYID" mklabel gpt mkpart traces ext4 0% 100%
udevadm settle
PART="$BYID-part1"
[ -b "$PART" ] || die "no partition appeared on $BYID"
mkfs.ext4 -F -L traces -m 0 -E lazy_itable_init=1,lazy_journal_init=1 "$PART"
udevadm settle
echo "Formatted $PART ($(readlink -f "$PART")) as ext4, label traces (UUID $(blkid -s UUID -o value "$PART"))."

# Mounting belongs to the provisioning module, as the user it mounts for.
exec sudo -u "$SUDO_USER" -H "$SCRIPT_DIR/../provision.sh" traces
