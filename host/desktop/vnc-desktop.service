[Unit]
Description=Shared virtual desktop on :1 for the kiosk monitor and Mac

[Service]
Type=simple
Environment=XAUTHORITY=%h/.Xauthority
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY
ExecStartPre=-/usr/bin/vncserver -kill :1
ExecStart=/usr/bin/vncserver :1 -fg -localhost yes -geometry 2560x1440 -depth 24 -SecurityTypes VncAuth -rfbauth %h/.vnc/passwd -xstartup %h/.vnc/xstartup
ExecStop=/usr/bin/vncserver -kill :1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
